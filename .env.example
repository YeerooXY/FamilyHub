# Paths and role IDs only. No secrets. Copy to .env if a later service needs them.
FAMILYHUB_ROOT=/srv/familyhub
FAMILYHUB_DATA=/srv/familyhub/data
FAMILYHUB_APPDATA=/srv/familyhub/appdata
FAMILYHUB_DATABASES=/srv/familyhub/databases
# Future container mapping of FAMILYHUB_DATA
FAMILYHUB_CONTAINER_DATA=/data

# Service roles (user and group share one ID)
FAMILYHUB_WRITER_NAME=familyhub-writer
FAMILYHUB_WRITER_ID=2000
FAMILYHUB_READER_NAME=familyhub-reader
FAMILYHUB_READER_ID=2001

# Sample playback images (compose.playback.yaml)
JELLYFIN_IMAGE=jellyfin/jellyfin:12.4@sha256:fea863d0cd9ec445985d9c75fc6ed64e38a1d2766cf0c250a33d553f4fc1b771
NAVIDROME_IMAGE=deluan/navidrome:0.64.2@sha256:38dc2727bfcfd5ede290f8ada114fc90368146f265ae4701ddddbcbe2a44ee52
