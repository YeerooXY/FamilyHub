<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(FamilyHubTargetFramework)' != ''">$(FamilyHubTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FamilyHub.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>FamilyHub Music</ApplicationTitle>
    <ApplicationId>org.familyhub.music</ApplicationId>
    <ApplicationDisplayVersion>0.1.79</ApplicationDisplayVersion>
    <ApplicationVersion>80</ApplicationVersion>
    <Version>$(ApplicationDisplayVersion)</Version>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Resources\AppIcon\appicon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\familyhub.svg" ForegroundFile="Resources\AppIcon\familyhub_foreground.svg" ForegroundScale="1" Color="#000000" Resize="true" BaseSize="1024,1024" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#07101F" Resize="true" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Resources\AppIcon\appicon.ico" Link="FamilyHub.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Install-Windows.ps1" Link="Install-Windows.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Platforms\Windows\Apply-Update.ps1" Link="Apply-Update.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\music_web\static\shell.css" Link="wwwroot\shell.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\music_web\static\notices.css" Link="wwwroot\notices.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\music_web\static\notices.js" Link="wwwroot\notices.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\music_web\static\vendor\hls.light.min.js" Link="wwwroot\vendor\hls.light.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\music_web\static\vendor\hls.LICENSE" Link="wwwroot\vendor\hls.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\FamilyHub.Client.Core\FamilyHub.Client.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.130" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  <Target Name="SyncSharedEffects" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../packages/paddock-effects/effects.css;$(MSBuildProjectDirectory)/../../packages/paddock-effects/effects.js"
          DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/paddock-theme.css;$(MSBuildProjectDirectory)/wwwroot/paddock-theme.js"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
