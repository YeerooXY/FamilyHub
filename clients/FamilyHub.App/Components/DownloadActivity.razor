<svg class="icon download-activity @(Percent is null ? "is-indeterminate" : "")" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle class="download-track" cx="12" cy="12" r="9" />
    <circle class="download-arc" cx="12" cy="12" r="9" pathLength="100" stroke-dasharray="@Dash" />
    <path d="M12 8v8m-3-3 3 3 3-3" />
</svg>

@code {
    [Parameter] public double? Percent { get; set; }
    private string Dash => (Percent ?? 28).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + " 100";
}
