@inject IJSRuntime JS
@inject MusicSession Session

<button id="genre-toggle" type="button" class="quiet library-genre-toggle" aria-haspopup="dialog"
        aria-controls="genre-dialog" aria-expanded="@Aria(open)" aria-label="@ToggleLabel" @onclick="Open">
    <span>@(Selected?.Label ?? "Genre")</span><MusicIcon Name="chevron-down" />
</button>
<dialog id="genre-dialog" class="popup-panel popup-centered genre-dialog" aria-labelledby="genre-heading" @onclose="Reset">
    <div class="dialog-heading">
        <h2 id="genre-heading">@L["Genre"]</h2>
        <button id="genre-close" type="button" class="quiet" aria-label="@L["Close genre chooser"].Value" data-popup-close><MusicIcon Name="close" /></button>
    </div>
    <div class="collection-search genre-search">
        <label class="sr" for="genre-search">@L["Search genres"]</label>
        <MusicIcon Name="search" />
        <input id="genre-search" role="combobox" type="text" autocomplete="off" spellcheck="false" maxlength="100"
               placeholder="@L["Search genres"].Value" aria-autocomplete="list" aria-controls="genre-options"
               aria-expanded="@Aria(open && suggestions.Count > 0)" aria-activedescendant="@(active >= 0 ? OptionId(active) : null)"
               value="@query" @oninput="Search" @onkeydown="KeyDown" />
    </div>
    <ul id="genre-options" role="listbox" aria-label="@L["Genres"].Value" hidden="@(suggestions.Count == 0)">
        @for (var i = 0; i < suggestions.Count; i++)
        {
            var option = suggestions[i];
            <li id="@OptionId(i)" @key="option.Key" role="option" aria-selected="@Aria(active < 0 ? option.Key == Value : i == active)"
                @onmousedown:preventDefault @onclick="() => Choose(option.Key)">
                <span>@option.Label</span>
                @if (option.Key == Value) { <MusicIcon Name="check" /> }
            </li>
        }
    </ul>
    @if (suggestions.Count == 0) { <Notice Level="empty" Message="@L["No genres match this search."].Value" /> }
</dialog>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MusicTrack> Tracks { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private sealed record Genre(string Key, string Label);
    private static readonly Genre AllGenres = new("", "All genres");
    private List<Genre> genres = [], suggestions = [AllGenres];
    private string query = "";
    private bool open;
    private int active = -1;
    private long historyRevision = -1;
    private IReadOnlyList<MusicTrack>? previousTracks;
    private Genre? Selected => genres.Find(option => option.Key == Value);
    private string ToggleLabel => Selected is { } selected ? "Genre: " + selected.Label : "Genre";
    private static string Aria(bool value) => value ? "true" : "false";
    private static string OptionId(int index) => $"genre-option-{index}";

    protected override void OnParametersSet()
    {
        if (historyRevision == Session.HistoryRevision && previousTracks is not null &&
            (ReferenceEquals(previousTracks, Tracks) || previousTracks.SequenceEqual(Tracks))) return;
        previousTracks = Tracks;
        historyRevision = Session.HistoryRevision;
        var plays = Session.GenrePlayCounts();
        genres = Tracks.GroupBy(track => GenreNames.Key(track.Genre)).Where(group => group.Key.Length > 0)
            .Select(group => new Genre(group.Key, GenreNames.MostCommon(group.Select(track => GenreNames.Label(track.Genre)))))
            .OrderByDescending(option => option.Key == "unsorted" ? 0 : plays.GetValueOrDefault(option.Key))
            .ThenBy(option => option.Label, StringComparer.CurrentCultureIgnoreCase).ToList();
        UpdateSuggestions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("familyhub.bindGenreSearch");
        if (open && active >= 0) await JS.InvokeVoidAsync("familyhub.revealGenreOption", OptionId(active));
    }

    private async Task Open()
    {
        open = true;
        await JS.InvokeVoidAsync("familyhub.showDialog", "genre-dialog", "genre-close", "genre-toggle");
    }

    private void Reset()
    {
        open = false;
        query = "";
        UpdateSuggestions();
    }

    private void UpdateSuggestions()
    {
        var text = query.Trim();
        var key = GenreNames.Key(text);
        suggestions = text.Length == 0 ? [AllGenres, .. genres]
            : genres.Where(option => (key.Length > 0 && option.Key.Contains(key, StringComparison.Ordinal))
                || option.Label.Contains(text, StringComparison.CurrentCultureIgnoreCase))
                .OrderByDescending(option => option.Key == key).ToList();
        active = -1;
    }

    private void Search(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";
        UpdateSuggestions();
    }

    private async Task Choose(string key)
    {
        await JS.InvokeVoidAsync("familyhub.closeDialog", "genre-dialog", "genre-toggle");
        await ValueChanged.InvokeAsync(key);
    }

    private async Task KeyDown(KeyboardEventArgs args)
    {
        if (suggestions.Count == 0) return;
        switch (args.Key)
        {
            case "ArrowDown":
                active = (active + 1) % suggestions.Count;
                break;
            case "ArrowUp":
                active = active <= 0 ? suggestions.Count - 1 : active - 1;
                break;
            case "Enter":
                await Choose(suggestions[Math.Max(0, active)].Key);
                break;
        }
    }
}
