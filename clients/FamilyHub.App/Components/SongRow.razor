@implements IDisposable
@inject MusicSession Session
@inject IJSRuntime JS

<article data-recording-id="@Track.Id" class="library-record native-song-row song-row @(!FindRecording && !Track.Saved && !PlaylistColumns ? "has-library-add" : "") @(PlaylistColumns ? "has-playlist-columns" : "") @(Current ? "is-current" : "")">
    @if (PlaylistColumns) { <span class="playlist-track-number">@Number</span> }
    <button class="song-primary @(Current ? "is-current" : "") @(Current && Playing ? "is-playing" : "")" @onclick="Play" aria-label="@((FindRecording ? "Find recording for " : "Play ") + Track.Title)">
        <span class="song-artwork"><TrackCover Track="Track" /><span class="artwork-play" aria-hidden="true"><MusicIcon Name="@(FindRecording ? "search" : "play")" /></span></span>
        <span class="song-text"><strong>@Track.Title</strong><small>@Track.Channel</small></span>
    </button>
    @if (PlaylistColumns)
    {
        <span class="playlist-track-album" title="@Album">@Album</span>
        <span class="playlist-track-added">
            <span class="playlist-track-date" title="@AddedExact">@AddedAgo</span>
            <span class="playlist-track-author" title="@AddedBy?.Name"><span class="sr">Added by </span><ProfileAvatar Profile="AddedBy" Size="24" ShowCrown="false" /><span>@(AddedBy?.Name ?? "Unknown")</span></span>
        </span>
        <span class="playlist-track-bpm">@Track.Bpm</span>
        <span class="playlist-track-key" title="@Track.KeyName">@Track.Key</span>
        <span class="playlist-track-duration">@(Track.Duration > 0 ? $"{(int)Track.Duration / 60}:{(int)Track.Duration % 60:00}" : "")</span>
    }
    @{ var storage = StorageState; }
    <span class="storage-state @storage.Style" role="img" aria-label="@storage.Label" title="@storage.Label"><MusicIcon Name="@storage.Icon" /></span>
    @* Fixed columns preserve action alignment across every row. *@
    <div class="row-actions">
    @if (!FindRecording && AddToPlaylist.HasDelegate)
    {
        <button id="@playlistButtonId" class="row-action song-playlist-add @(InPlaylist ? "is-added" : "")"
                @onclick="() => AddToPlaylist.InvokeAsync((Track, playlistButtonId))" aria-label="Add @Track.Title to playlist"
                title="Add to playlist" aria-haspopup="dialog">
            <MusicIcon Name="@(InPlaylist ? "check-circle" : "plus-circle")" />
        </button>
    }
    @if (!FindRecording && !Track.Saved && !PlaylistColumns)
    {
        <button class="row-action row-reveal" aria-disabled="@SaveDisabled" @onclick="SaveToLibrary" aria-label="@($"{SaveLabel}: {Track.Title}")" title="@SaveLabel"><MusicIcon Name="@(saveState == "Saved" ? "cloud-check" : "cloud-empty")" /><span class="sr" role="status">@saveState</span></button>
    }
    <button id="@moreId" class="row-action row-reveal row-more" @onclick="OpenMenu" aria-label="More options for @Track.Title" title="More options" aria-haspopup="dialog"><MusicIcon Name="more" /></button>
    <dialog id="@menuId" class="popup-panel popup-menu song-menu" aria-labelledby="@(menuId + "-heading")">
        <div class="dialog-heading"><h2 id="@(menuId + "-heading")">@Track.Title</h2><button id="@(menuId + "-close")" class="quiet" aria-label="Close song options" @onclick="CloseMenu"><MusicIcon Name="close" /></button></div>
        @if (AddToPlaylist.HasDelegate && !FindRecording) { <button id="@(menuId + "-playlist")" @onclick="MenuPlaylist"><MusicIcon Name="plus-circle" />Add to playlist</button> }
        @if (!FindRecording) { <button @onclick="MenuQueue"><MusicIcon Name="queue" />Add to queue</button> }
        @if (!FindRecording) { <SongMenuActions @key="Track.Id" @ref="menuActions" Track="Track" Keep="Keep" /> }
        @if (!FindRecording && !Track.Saved) { <button aria-disabled="@SaveDisabled" @onclick="SaveToLibrary"><MusicIcon Name="plus-circle" />@SaveLabel</button> }
        @if (saveState.Length > 0) { <p role="status">@saveState</p> }
        @if (Track.Saved) { <TrimRequest Track="Track" ShowText="true" /> }
        @if (Track.Saved && Report.HasDelegate)
        {
            <button id="@(menuId + "-report")" aria-haspopup="dialog" @onclick='() => Report.InvokeAsync((Track, menuId + "-report"))'><MusicIcon Name="alert" /><span>Report problem</span></button>
        }
        @if (Remove.HasDelegate) { <button class="song-menu-remove" @onclick="MenuRemove"><MusicIcon Name="trash" />@RemoveLabel</button> }
    </dialog>
    </div>
</article>

@code {
    [Parameter] public bool PlaylistColumns { get; set; }
    [Parameter] public int Number { get; set; }
    [Parameter] public string Album { get; set; } = "";
    [Parameter] public string? AddedAt { get; set; }
    [Parameter] public ListenerProfile? AddedBy { get; set; }
    private string AddedAgo => RelativeDate.Describe(AddedAt, DateTimeOffset.Now);
    private string? AddedExact => RelativeDate.Exact(AddedAt);
    [Parameter, EditorRequired] public MusicTrack Track { get; set; } = null!;
    [Parameter] public EventCallback Play { get; set; }
    private readonly string playlistButtonId = "song-playlist-" + Guid.NewGuid().ToString("N");
    private bool InPlaylist => Session.Playlists.Any(p => p.CanEdit && p.Tracks.Any(t => t.RecordingId == Track.Id));
    [Parameter] public EventCallback<(MusicTrack Track, string Opener)> AddToPlaylist { get; set; }
    [Parameter] public EventCallback<(MusicTrack Track, string Opener)> Report { get; set; }
    [Parameter] public EventCallback Queue { get; set; }
    [Parameter] public EventCallback Keep { get; set; }
    [Parameter] public EventCallback Remove { get; set; }
    [Parameter] public bool Current { get; set; }
    [Parameter] public bool Playing { get; set; }
    [Parameter] public bool FindRecording { get; set; }
    [Parameter] public string RemoveLabel { get; set; } = "Remove";
    private readonly string moreId = "song-more-" + Guid.NewGuid().ToString("N");
    private string menuId => moreId + "-menu";
    private SongMenuActions? menuActions;
    private async Task OpenMenu()
    {
        await JS.InvokeVoidAsync("familyhub.showDialog", menuId, menuId + "-close", moreId);
        if (menuActions is not null) await menuActions.Refresh();
    }
    private Task CloseMenu() => JS.InvokeVoidAsync("familyhub.closeDialog", menuId, moreId).AsTask();
    private Task MenuPlaylist() => AddToPlaylist.InvokeAsync((Track, menuId + "-playlist"));
    private async Task MenuQueue() { await CloseMenu(); await Queue.InvokeAsync(); }
    private async Task MenuRemove() { await CloseMenu(); await Remove.InvokeAsync(); await JS.InvokeVoidAsync("familyhub.focus", "content"); }
    private bool saveBusy;
    private string saveState = "";
    private CancellationTokenSource? saveLifetime;
    private bool followsSaveStatus;
    private string SaveDisabled => saveBusy || saveState is "Saved" or "Queued" or "Working" ? "true" : "false";
    private string SaveLabel => saveState == "Failed" ? "Retry add to library" : saveState.Length > 0 ? saveState : "Add to library";

    private async Task SaveToLibrary()
    {
        if (SaveDisabled == "true" || Session.Api is not { } api || !Session.Connected) return;
        saveBusy = true;
        saveState = "Queuing...";
        using var request = saveLifetime = new CancellationTokenSource();
        try
        {
            var result = await api.RequestJsonAsync<LibraryAdditionPage>(HttpMethod.Post, "/api/library/additions",
                new { urls = new[] { "https://www.youtube.com/watch?v=" + Track.Id } }, request.Token);
            if (request.IsCancellationRequested || !ReferenceEquals(api, Session.Api)) return;
            var job = result.Jobs.FirstOrDefault();
            UpdateSaveState(job);
            if (job is not null)
            {
                if (!followsSaveStatus)
                {
                    Session.LibraryAdditionUpdated += FollowSaveStatus;
                    followsSaveStatus = true;
                }
                Session.ReportLibraryAddition(job);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception) { saveState = "Failed"; }
        finally { saveBusy = false; saveLifetime = null; }
    }

    private void UpdateSaveState(LibraryAddition? job)
    {
        saveState = job?.State switch
        {
            "queued" => "Queued",
            "running" => "Working",
            "done" => "Saved",
            _ => job?.Saved == true ? "Saved" : "Failed"
        };
        StateHasChanged();
    }

    private void FollowSaveStatus(LibraryAddition job)
    {
        if (job.SourceId == Track.Id) _ = InvokeAsync(() => UpdateSaveState(job));
    }

    public void Dispose()
    {
        saveLifetime?.Cancel();
        if (followsSaveStatus) Session.LibraryAdditionUpdated -= FollowSaveStatus;
    }
    private bool kept => Session.KeptOnDevice(Track);
    private bool Downloading => !FindRecording && Session.DownloadingId == Track.Id;
    private string? DownloadError => !FindRecording && Session.DownloadFailure is { } failure && failure.TrackId == Track.Id ? failure.Message : null;
    private (string Label, string Icon, string Style) StorageState => kept ? ("Downloaded", "device-check", "is-kept")
        : Downloading ? ("Downloading", "clock", "is-server")
        : DownloadError is not null ? ("Download failed", "alert", "")
        : Session.OnThisDevice(Track) ? ("Cached", "device", "is-cached")
        : Track.Saved ? ("On server", "cloud-check", "is-server") : ("Not on server", "cloud-empty", "");
}
