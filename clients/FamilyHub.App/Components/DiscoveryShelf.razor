@implements IDisposable
@inject IJSRuntime JS
@inject MusicSession Session
@if (items.Count > 0 || loadFailed)
{
    <section class="home-section" aria-labelledby="discovery-title">
        <div class="home-section-heading"><h2 id="discovery-title" tabindex="-1">New from artists you play</h2></div>
        <ServiceStatus Active="loadFailed" Detail="Reconnect to load new releases." RetryLabel="Retry new releases"
                       Retry="RetryLoad" Busy="loading" AutoRetry="true" FocusTarget="#discovery-title" />
        <ShelfArrows Target="discovery-shelf" Label="new releases"><div class="home-shelf" id="discovery-shelf">
            @foreach (var item in items)
            {
                var cover = failedCovers.Contains(item.Id) ? null : item.CoverUrl;
                <div class="home-card-holder discovery-card" @key="item.Id">
                    <div class="home-card">
                        <div class="discovery-art">
                            <span class="cover discovery-cover" aria-hidden="true">
                                <span class="discovery-cover-empty"><MusicIcon Name="music" /></span>
                                @if (cover is not null) { <img src="@cover" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" @onerror="() => failedCovers.Add(item.Id)" /> }
                            </span>
                            <button id="@("discovery-play-" + item.Id)" class="discovery-play" aria-disabled="@(busy ? "true" : "false")" aria-label="Play @item.Title" title="Play" @onclick="() => Play(item)"><MusicIcon Name="play" /></button>
                            <button id="@("discovery-dismiss-" + item.Id)" class="discovery-dismiss" aria-disabled="@(busy ? "true" : "false")" aria-label="Dismiss @item.Title" title="Dismiss" @onclick="() => Dismiss(item)"><MusicIcon Name="close" /></button>
                        </div>
                        <strong title="@item.Title">@item.Title</strong>
                        <span>@item.Artist</span>
                    </div>
                </div>
            }
        </div></ShelfArrows>
        <Notice Level="@(busy ? "info" : "error")" Message="@message" />
        @if (choices.Count > 0)
        {
            <h3>Choose a recording</h3>
            @foreach (var track in choices) { <SongRow Track="track" Play="() => PlayTracks.InvokeAsync((new[] { track }, MusicPlayer.PlaybackTimestamp()))" /> }
            <button @onclick="() => choices.Clear()">Close recording choices</button>
        }
    </section>
}
@code {
    [Parameter] public EventCallback<(IEnumerable<MusicTrack> Tracks, long RequestedAt)> PlayTracks { get; set; }
    private List<DiscoveryItem> items = [];
    private List<MusicTrack> choices = [];
    private readonly HashSet<string> failedCovers = [];
    private string message = "";
    private bool busy, loadFailed, loading;
    private FamilyHubApi? loadedApi;
    private string? loadedUser;
    private bool disposed;
    protected override async Task OnInitializedAsync() { Session.Changed += Changed; await Load(); }
    public void Dispose() { disposed = true; Session.Changed -= Changed; }
    private void Changed() => _ = InvokeAsync(async () => { await Load(background: true); if (!disposed) StateHasChanged(); });
    private Task RetryLoad() => Load(background: true, retry: true);
    private async Task Load(bool background = false, bool retry = false)
    {
        if (disposed) return;
        if (!Session.Connected) { loadedApi = null; loadedUser = null; items.Clear(); choices.Clear(); loadFailed = false; return; }
        var api = Session.Api; var user = Session.User;
        if (api is null || (ReferenceEquals(api, loadedApi) && loadedUser == user && (!retry || loading))) return;
        loadedApi = api; loadedUser = user; items.Clear(); choices.Clear(); loading = true;
        try {
            var result = await api.RequestJsonAsync<DiscoveryPage>(HttpMethod.Get, "/api/discovery", background: background);
            if (!disposed && ReferenceEquals(api, Session.Api) && user == Session.User)
            { items = result.Items; loadFailed = false; }
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            if (!disposed && ReferenceEquals(api, Session.Api) && user == Session.User)
                loadFailed = e is HttpRequestException or FamilyHubApiException { StatusCode: >= 500 };
        }
        finally { if (ReferenceEquals(api, loadedApi) && user == loadedUser) loading = false; }
    }
    private async Task Dismiss(DiscoveryItem item)
    {
        if (busy || Session.Api is null) return;
        busy = true;
        try
        {
            await Session.Api.RequestJsonAsync<object>(HttpMethod.Post, "/api/discovery/" + item.Id + "/state", new { state = "dismissed" });
            var at = items.IndexOf(item); items.Remove(item); await InvokeAsync(StateHasChanged);
            // Focus stays in the shelf: the card that took the dismissed one's place, else the heading of Home.
            var next = items.Count == 0 ? null : items[Math.Clamp(at, 0, items.Count - 1)];
            await JS.InvokeVoidAsync("familyhub.focus", next is null ? "view-title" : "discovery-play-" + next.Id);
        }
        catch (Exception e) when (e is not OperationCanceledException) { message = "The release could not be dismissed. Try again."; }
        finally { busy = false; }
    }
    private async Task Play(DiscoveryItem item)
    {
        if (busy || Session.Api is null) return;
        var requestedAt = MusicPlayer.PlaybackTimestamp();
        busy = true; choices.Clear(); message = "Finding recordings...";
        try {
            var query = await Session.Api.RequestJsonAsync<DiscoveryQuery>(HttpMethod.Post, "/api/discovery/" + item.Id + "/play", new { });
            item.Seen = true;
            var saved = Session.Library.FirstOrDefault(t => t.Title.Equals(item.Title, StringComparison.OrdinalIgnoreCase) && t.Channel.Equals(item.Artist, StringComparison.OrdinalIgnoreCase));
            if (saved is not null) { await PlayTracks.InvokeAsync((new[] { saved }, requestedAt)); message = ""; return; }
            choices = (await Session.Api.RequestJsonAsync<SearchPage>(HttpMethod.Post, "/api/search", new { query = query.Query })).Tracks;
            message = choices.Count == 0 ? "No recordings found for this release." : "";
        }
        catch (Exception e) when (e is not OperationCanceledException) { message = "Recordings could not be loaded. Try again later."; }
        finally { busy = false; }
    }
}
