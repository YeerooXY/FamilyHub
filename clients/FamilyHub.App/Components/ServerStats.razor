@implements IDisposable
@using System.Globalization
@inject MusicSession Session
@inject IJSRuntime JS

<div class="server-stats @(Leaderboard ? "leaderboard-page" : "server-page")" aria-busy="@Aria(Leaderboard && Refreshing && data is null)">
    <div class="stats-toolbar">
        @if (Leaderboard)
        {
            <div class="lb-periods" role="group" aria-label="Listening period">
                @foreach (var choice in new[] { ("week", "7 days"), ("month", "This month"), ("all", "All time") })
                { <button class="lb-period" aria-pressed="@Aria(period == choice.Item1)" @onclick="() => SetPeriod(choice.Item1)">@choice.Item2</button> }
            </div>
        }
        else
        {
            <div class="stats-server-status" hidden="@Offline"><i class="stats-online-dot is-online" aria-hidden="true"></i><span>Server online</span></div>
        }
        <button id="server-stats-refresh" class="quiet stats-refresh @(Refreshing ? "is-refreshing" : "")" aria-label="@(Leaderboard ? "Refresh leaderboard" : "Refresh server work")" title="Refresh" @onclick="RefreshPage" aria-disabled="@Aria(Refreshing)"><MusicIcon Name="refresh" /></button>
    </div>
    <ServiceStatus Active="@(Offline || error is not null || Refreshing && reconnecting)"
                   Title="@(needsSignIn ? "Session expired" : "Can't reach your server")"
                   Detail="@(data is null ? "Reconnect to load server statistics." : "Showing the last loaded statistics.")"
                   RetryLabel="@(Leaderboard ? "Retry leaderboard" : "Retry server work")"
                   Retry="RefreshNow" Busy="Refreshing" AutoRetry="@(!needsSignIn)" FocusTarget="#server-stats-refresh" />
    <Notice Message="@(fetching && data is null && !Offline && error is null ? "Loading server statistics…" : null)" />
    @if (Leaderboard && SnapshotStale) { <small class="catalogue-timestamp">Server updated @snapshotAt.ToLocalTime().ToString("t")</small> }
    @if (data is { } stats && Leaderboard)
    {
        var ranking = Ranking.ToList();
        var leader = Math.Max(1, ranking.Select(PeriodSeconds).DefaultIfEmpty(0).Max());
        var total = SelectedTotal;
        var days = Days;
        var peak = Math.Max(1, days.Select(d => d.Seconds).DefaultIfEmpty(0).Max());
        var present = stats.Profiles.Where(p => p.Listening || p.Online).OrderByDescending(p => p.Listening).ThenBy(p => p.Name).ToList();
        @if (ranking.Count == 0)
        {
            <Notice Level="empty" Message="No listening time recorded for this period. Play a song with listening history enabled to appear here." />
        }
        else
        {
        <section class="lb-podium stats-leaderboard" aria-label="@("Top listeners, " + PeriodLabel)">
            @foreach (var place in new[] { 1, 0, 2 }.Where(i => i < ranking.Count))
            {
                var profile = ranking[place];
                <div class="lb-place lb-place-@(place + 1)" data-profile-key="@profile.Id" @key="profile.Id">
                    <div class="lb-avatar">
                        @if (place == 0) { <span class="lb-crown"><MusicIcon Name="crown" /></span> }
                        <ProfileAvatar Profile="ProfileFor(profile)" Size="@(place == 0 ? 84 : 64)" ShowCrown="false" />
                        @if (profile.Listening) { <span class="lb-live" title="Listening now"><span class="sr">Listening now</span></span> }
                    </div>
                    <strong>@profile.Name</strong>
                    <span class="lb-time">@Duration(PeriodSeconds(profile))</span>
                    <span class="lb-saved">@Huf(profile.SavedHuf) Ft saved</span>
                    <div class="lb-step"><span>@(place + 1)</span></div>
                </div>
            }
        </section>
        }
        @if (ranking.Count > 3)
        {
            <ol class="lb-list stats-leaderboard" start="4" aria-label="Other listeners">
                @for (var i = 3; i < ranking.Count; i++)
                {
                    var profile = ranking[i];
                    <li class="lb-row" data-profile-key="@profile.Id" @key="profile.Id">
                        <span class="lb-rank">@(i + 1)</span>
                        <ProfileAvatar Profile="ProfileFor(profile)" Size="44" />
                        <div class="lb-who">
                            <strong>@profile.Name</strong>
                            <small class="lb-status @(profile.Listening ? "is-listening" : profile.Online ? "is-online" : "")"><i aria-hidden="true"></i>@if (profile.Listening && profile.CurrentTrack is { } song) { <span class="sr">Listening now: </span><span>@song.Title</span> } else { <span>@(profile.Listening ? "Listening now" : profile.Online ? "Online" : "Offline")</span> }</small>
                        </div>
                        <div class="lb-figures"><strong>@Duration(PeriodSeconds(profile))</strong><small>@Huf(profile.SavedHuf) Ft saved</small></div>
                        <span class="lb-bar" aria-hidden="true"><i style="width:@((100 * PeriodSeconds(profile) / leader).ToString("0.#", Inv))%"></i></span>
                        <ListenerMenu Profile="profile" />
                    </li>
                }
            </ol>
        }
        <section class="lb-now glass-panel" aria-labelledby="lb-now-title">
            <h2 id="lb-now-title">Who's here</h2>
            @foreach (var profile in present)
            {
                <div class="lb-live-row" @key="profile.Id"><ProfileAvatar Profile="ProfileFor(profile)" Size="36" /><div><strong>@profile.Name</strong><small>@(profile.Listening ? profile.CurrentTrack is { } song ? song.Title + ", " + song.Channel : "Listening now" : "Online")</small></div>@if (profile.Listening) { <span class="listener-equalizer is-playing" aria-hidden="true">@for (var bar = 0; bar < 5; bar++) { <i style="--bar:@bar"></i> }</span> }<ListenerMenu Profile="profile" /></div>
            }
            @if (present.Count == 0) { <Notice Level="empty" Message="Nobody is online right now." /> }
        </section>
        <section class="stats-listening glass-panel" aria-labelledby="stats-listening-title">
            <div class="stats-section-heading"><h2 id="stats-listening-title">Family listening time</h2><span>@PeriodLabel</span></div>
            @if (total > 0) { <strong class="stats-time">@Duration(total)</strong> }
            else { <Notice Level="empty" Message="The chart fills in after family members listen to music." /> }
            @if (total > 0 && days.Count > 0)
            {
                <p class="stats-latest">Latest: @ExactDay(days[^1].Day), <strong>@ExactDuration(days[^1].Seconds)</strong></p>
                <div class="stats-chart-frame">
                    <div class="stats-chart-axis" aria-hidden="true"><span>@Duration(peak)</span><span>0 s</span></div>
                    <div class="stats-chart-scroll" role="region" aria-label="Daily listening chart, scroll for more dates" tabindex="0">
                    <div class="stats-chart-plot">
                    <div class="stats-chart-surface">
                <svg class="stats-line-chart" viewBox="0 0 560 156" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <defs><linearGradient id="stats-chart-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--accent-blue)" stop-opacity=".28" /><stop offset="100%" stop-color="var(--accent-blue)" stop-opacity="0" /></linearGradient></defs>
                    <path class="stats-chart-grid" d="M0 16H560M0 80H560M0 144H560" />
                    @if (days.Count > 1) { <path class="stats-chart-area" d="@("M0,144 L" + Points(days,peak).Replace(" ", " L") + " L560,144 Z")" /><polyline class="stats-chart-line" points="@Points(days,peak)" vector-effect="non-scaling-stroke" /> }
                </svg>
                    @for (var i = 0; i < days.Count; i++)
                    {
                        var day = days[i];
                        var label = ExactDay(day.Day) + ": " + ExactDuration(day.Seconds);
                        <button @key="day.Day" id="@("stats-point-" + day.Day)" type="button" class="stats-chart-point-button" style="left:@ChartX(i,days.Count)%;top:@ChartY(day.Seconds,peak)%" aria-label="@label" data-tooltip="@label"><span aria-hidden="true"></span></button>
                    }
                    </div>
                <div class="stats-chart-labels"><span>@DayLabel(days[0].Day)</span><span>@DayLabel(days[^1].Day)</span></div>
                    </div></div>
                </div>
                <table class="sr"><caption>Daily listening, @PeriodLabel</caption><thead><tr><th scope="col">Date</th><th scope="col">Time listened</th></tr></thead><tbody>@foreach (var day in days) { <tr><th scope="row">@ExactDay(day.Day)</th><td>@ExactDuration(day.Seconds)</td></tr> }</tbody></table>
            }
        </section>
        @if (stats.WrappedYear is { } year)
        {
            var members = stats.Profiles;
            var member = members.Find(p => p.Id == wrappedMemberId) ?? members.Find(p => p.Id == Session.User) ?? members.FirstOrDefault();
            <section class="lb-wrapped" aria-labelledby="lb-wrapped-title">
                <header class="lb-person-header">
                    <h2 id="lb-wrapped-title">@year listening</h2>
                    @if (member is not null)
                    {
                        <button type="button" id="lb-wrapped-member" class="lb-person-picker" aria-haspopup="dialog" aria-label="@($"Choose listener, {member.Name}")" @onclick="() => OpenMemberPicker(member.Id)">
                            <ProfileAvatar Profile="ProfileFor(member)" Size="30" ShowCrown="false" /><span>@member.Name</span><MusicIcon Name="chevron-down" />
                        </button>
                        <dialog id="lb-person-menu" class="popup-panel popup-menu" data-popup-anchor="lb-wrapped-member" aria-label="Choose listener">
                            @foreach (var person in members)
                            {
                                <button id="@("lb-person-" + person.Id)" type="button" @key="person.Id" aria-pressed="@Aria(person.Id == member.Id)" @onclick="() => SelectMember(person.Id)">
                                    <ProfileAvatar Profile="ProfileFor(person)" Size="30" ShowCrown="false" /><span>@person.Name</span>
                                </button>
                            }
                        </dialog>
                    }
                </header>
                @if (member is null)
                {
                    <Notice Level="empty" Message="No profiles have listening history enabled." />
                }
                else if (member.Wrapped is not { } summary || summary.TotalMinutes <= 0 && summary.SongsAdded <= 0)
                {
                    <Notice Level="empty" Message="@($"No listening or song additions recorded for {member.Name} in {year}.")" />
                }
                else
                {
                    var chartDate = summary.ChartDate;
                    <dl class="lb-year-metrics glass-panel" aria-label="@($"Listening statistics for {member.Name}")">
                        @foreach (var metric in WrappedMetrics)
                        {
                            <div @key="metric.Label"><dt>@metric.Label</dt><dd>@metric.Value(summary)</dd></div>
                        }
                    </dl>
                    <details class="lb-wrapped-help">
                        <summary id="lb-wrapped-help">How scores are counted</summary>
                        <p>Listening time and streaks use recorded daily playback. Favourites and replays use song history.</p>
                        <p>Night owl is the share of completed plays that started from 00:00 to 05:59 UTC. Replays count each time you listen to a song again this year.</p>
                        <p>Mainstream score is the share of your top 10 artists and top 10 songs that appear in Deezer’s chart. Early listener marks artists you played before FamilyHub observed them enter the chart.</p>
                        @if (chartDate is null)
                        {
                            <ServiceStatus Title="Deezer chart unavailable" Detail="Retry to check for the latest chart."
                                           RetryLabel="Retry Deezer chart" Retry="RefreshNow" Busy="Refreshing" FocusTarget="#server-stats-refresh" />
                        }
                        else { <p>Deezer chart checked @ExactDay(chartDate).</p> }
                    </details>
                }
            </section>
        }
    }
    else if (!Leaderboard)
    {
        <section class="glass-panel srv-automatic" aria-labelledby="stats-work-title" aria-busy="@Aria(Refreshing && data is null)">
            <h2 id="stats-work-title">Automatic work</h2>
            @if (data is { } server)
            {
                var jobs = server.Workers.Where(worker => worker.State == "working").ToList();
                <div class="srv-worker-summary" role="status">
                    <span>@(jobs.Count == 1 ? "1 active worker" : $"{jobs.Count} active workers")</span>
                    @if (server.WorkerStages is { } stages)
                    {
                        <span>@stages.Sum(stage => stage.Queued) queued</span>
                        <span>@stages.Sum(stage => stage.BackingOff) waiting to retry</span>
                    }
                    @if (server.CataloguePaused) { <span>Catalogue work paused while the server is in use.</span> }
                </div>
                @if (SnapshotStale || Offline || error is not null) { <small class="catalogue-timestamp">Server updated @snapshotAt.ToLocalTime().ToString("t")</small> }
                <details class="srv-worker-details">
                    <summary><MusicIcon Name="chevron-down" />Workers, queues and retries</summary>
                    @if (jobs.Count > 0)
                    {
                        <ul class="srv-work-list srv-current-jobs" aria-label="Active jobs">
                            @foreach (var job in jobs)
                            {
                                <li class="srv-work-job" @key="job.Id">
                                    <strong>@job.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(job.CurrentTitle)) { <span class="stats-current-action">@job.CurrentTitle</span> }
                                    @if (job.Phase.Length > 0) { <small>@job.Phase</small> }
                                    @if (job.Progress is { } percent) { <div class="stats-meter" role="progressbar" aria-label="@job.Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent.ToString("0", Inv)"><i style="width:@percent.ToString("0.###", Inv)%"></i></div> }
                                    @if (job.Owner.Length > 0) { <span class="stats-job-requester"><ProfileAvatar Profile="WorkProfile(job)" Size="24" /><span>@job.User</span></span> }
                                </li>
                            }
                        </ul>
                    }
                    @if (server.WorkerStages is null && server.PlaylistBacklog is null)
                    {
                        <Notice Level="warning" Message="Update the server to see queue and retry counts." />
                    }
                    else if (server.WorkerStages is { Count: 0 } && server.PlaylistBacklog is null)
                    {
                        <Notice Level="empty" Message="No resource jobs are waiting or running." />
                    }
                    else
                    {
                        <ul class="srv-stage-cards">
                        @foreach (var stage in server.WorkerStages ?? [])
                        {
                            var (title, icon) = StageDisplay(stage.Stage);
                            <li class="srv-stage-card" @key="stage.Stage">
                                <h3><MusicIcon Name="@icon" />@title</h3>
                                <dl>
                                    <div><dt>Queued</dt><dd class="music-admin-count">@stage.Queued</dd></div>
                                    <div><dt>Waiting to retry</dt><dd class="music-admin-count">@stage.BackingOff</dd></div>
                                    <div><dt>Running</dt><dd class="music-admin-count">@stage.Running</dd></div>
                                </dl>
                            </li>
                        }
                        @if (server.PlaylistBacklog is { } backlog)
                        {
                            <li class="srv-stage-card">
                                <h3><MusicIcon Name="playlist" />Playlist backlog</h3>
                                <dl>
                                    <div><dt>Pending</dt><dd class="music-admin-count">@backlog.Pending</dd></div>
                                    <div><dt>Waiting to retry</dt><dd class="music-admin-count">@backlog.WaitingToRetry</dd></div>
                                    <div><dt>Running</dt><dd class="music-admin-count">@backlog.Running</dd></div>
                                </dl>
                            </li>
                        }
                        </ul>
                    }
                </details>
            }
            else if (!Offline && error is null)
            {
                <p class="srv-work-empty" role="status">Loading automatic work…</p>
            }
        </section>
        @ChildContent
        @if (Session.ServerHealthAdmin)
        {
            var seeding = seedingIdentity == Identity ? seedingData : null;
            var seedingProblem = Offline ? "Connect to the server to load seeding." : seedingIdentity == Identity ? seedingError : null;
            <section class="srv-seeding srv-automatic glass-panel" aria-labelledby="srv-seeding-title">
                <div class="stats-section-heading">
                    <h2 id="srv-seeding-title">Seeding</h2>
                    <button id="seeding-refresh" type="button" class="quiet" @onclick="RefreshSeedingFromButton" aria-disabled="@Aria(seedingFetching)">
                        Refresh seeding
                    </button>
                </div>
                <ServiceStatus Active="@(seedingProblem is not null || seeding?.Stale == true)"
                    Title="@(seedingNeedsSignIn ? "Session expired" : seedingProblem is null ? "Seeding records are out of date" : "Can't reach your server")"
                    Detail="@(seeding is null ? "Reconnect to load seeding records." : "Showing the last recorded ratios.")"
                    RetryLabel="Retry seeding" Retry="RefreshSeedingFromButton" Busy="seedingFetching"
                    AutoRetry="@(!Offline && !seedingNeedsSignIn)" FocusTarget="#seeding-refresh" />
                @if (seedingFetching && seedingProblem is null && seeding?.Stale != true) { <Notice Message="Loading seeding records…" /> }
                @if (seeding is not null)
                {
                    <p class="srv-seeding-sample">@(seeding.Stale || seedingProblem is not null || seedingFetching ? "Last snapshot" : "Sampled") <time datetime="@seeding.LastSampleAt.ToString("o", Inv)">@seeding.LastSampleAt.ToLocalTime().ToString("g")</time></p>
                    @if (seeding.Items.Count == 0)
                    {
                        <Notice Level="empty" Message="No torrents in the last sample." />
                    }
                    else
                    {
                        <ul class="srv-work-list srv-seeding-list">
                            @foreach (var torrent in seeding.Items)
                            {
                                var share = $"{torrent.Ratio.ToString("0.0##", Inv)} / {seeding.Goal.ToString("0.0", Inv)}";
                                <li @key="torrent.Hash">
                                    <div class="srv-seeding-line"><strong>@torrent.Name</strong><span>@torrent.State</span></div>
                                    <div class="srv-seeding-ratio">
                                        <progress max="@seeding.Goal.ToString("R", Inv)" value="@(Math.Min(seeding.Goal, torrent.Ratio).ToString("R", Inv))"
                                                  aria-label="@($"Share ratio for {torrent.Name}")" aria-valuetext="@share"></progress>
                                        <span aria-hidden="true">@share</span>
                                    </div>
                                    <dl class="srv-seeding-facts">
                                        <div><dt>Uploaded</dt><dd>@Bytes(torrent.Uploaded)</dd></div>
                                        <div><dt>Downloaded</dt><dd>@Bytes(torrent.Downloaded)</dd></div>
                                        <div><dt>Goal recorded</dt><dd>
                                            @if (torrent.ReachedGoalAt is { } reached)
                                            {
                                                <time datetime="@reached.ToString("o", Inv)">@reached.ToLocalTime().ToString("g")</time>
                                            }
                                            else { <text>Pending</text> }
                                        </dd></div>
                                    </dl>
                                </li>
                            }
                        </ul>
                    }
                }
                <span class="sr" role="status">@(seeding is { Stale: false } && !seedingFetching && seedingProblem is null ? "Seeding updated." : "")</span>
            </section>
        }
        @if (data is { } details)
        {
            var used = Math.Max(0, details.StorageTotalBytes - details.StorageFreeBytes);
            var usedPercent = details.StorageTotalBytes > 0 ? Math.Clamp(100d * used / details.StorageTotalBytes, 0, 100) : 0;
            <details class="srv-details">
                <summary>Server details</summary>
                <div class="srv-grid">
                    <section class="srv-work glass-panel" aria-labelledby="srv-workers-title">
                        <h2 id="srv-workers-title">Workers</h2>
                    @if (details.Workers.Count > 0)
                    {
                        <details class="srv-worker-details">
                            <summary><MusicIcon Name="chevron-down" />Worker slots</summary>
                            <ul class="srv-work-list">
                            @foreach (var group in WorkGroups(details.Workers))
                            {
                                var working = group.Workers.Where(w => w.State == "working").ToList();
                                var first = group.Workers[0];
                                <li class="srv-work-row is-@(working.Count > 0 ? "working" : first.State)" @key="group.Name">
                                    <div class="srv-work-line">
                                        <strong>@group.Name</strong>
                                        <span class="srv-work-status">@(group.Workers.Count > 1 && working.Count > 0 ? $"{working.Count} of {group.Workers.Count} active" : Label(first.State))</span>
                                    </div>
                                    @if (working.Count == 0 && first.WaitingFor.Length > 0)
                                    {
                                        <small class="srv-work-wait">Waiting for @(char.ToLowerInvariant(first.WaitingFor[0]) + first.WaitingFor[1..])</small>
                                    }
                                </li>
                            }
                            </ul>
                        </details>
                    }
                    @if (details.CatalogueWorkers is { } settings)
                    {
                        <details class="srv-worker-details">
                            <summary><MusicIcon Name="chevron-down" />Catalogue worker configuration</summary>
                            <dl class="srv-storage-facts">
                                <div><dt>Playlist matching and downloads</dt><dd>@OnOff(settings.PlaylistMatching)</dd></div>
                                <div><dt>Metadata lookup</dt><dd>@OnOff(settings.Metadata)</dd></div>
                                <div><dt>Source quality scan</dt><dd>@OnOff(settings.SourceScan)</dd></div>
                                <div><dt>Automatic source replacement</dt><dd>@OnOff(settings.SourceAutoReplace)</dd></div>
                                <div><dt>Automatic catalogue attempts per hour</dt><dd>@settings.AttemptsPerHour</dd></div>
                            </dl>
                        </details>
                    }
                    </section>
                    <section class="srv-savings glass-panel" aria-labelledby="srv-savings-title">
                        <h2 id="srv-savings-title">Savings</h2>
                        <div class="srv-figures">
                            <div class="srv-figure"><span>Total saved</span><strong>@Huf(details.SavedHuf)<small> Ft</small></strong></div>
                            <div class="srv-figure"><span>Per month</span><strong>@Huf(details.MonthlySavedHuf)<small> Ft</small></strong></div>
                            <div class="srv-figure"><span>Withheld from streamers</span><strong>@Usd(details.RoyaltyUsd)</strong><small>@details.TotalQualifiedPlays.ToString("N0", Inv) plays</small></div>
                        </div>
                    </section>
                    <section class="srv-storage glass-panel" aria-labelledby="srv-storage-title">
                        <h2 id="srv-storage-title">Storage</h2>
                        <div class="srv-ring" style="--used:@usedPercent.ToString("0.#", Inv)" role="img" aria-label="@($"{usedPercent:0} percent of storage used")"><span><strong>@usedPercent.ToString("0", Inv)%</strong><small>used</small></span></div>
                        <dl class="srv-storage-facts"><div><dt>Used</dt><dd>@Bytes(used)</dd></div><div><dt>Free</dt><dd>@Bytes(details.StorageFreeBytes)</dd></div><div><dt>Total</dt><dd>@Bytes(details.StorageTotalBytes)</dd></div></dl>
                    </section>
                </div>
            </details>
        }
    }
    @if (Leaderboard && data is { Records.Count: > 0 } recordStats)
    {
        <section class="stats-records" aria-labelledby="stats-records-title">
            <h2 id="stats-records-title">Records</h2>
            <div class="stats-record-table glass-panel">
            <table>
                <thead><tr><th scope="col">Record</th><th scope="col">Held by</th><th scope="col" class="num">Result</th><th scope="col">When</th></tr></thead>
                @foreach (var group in RecordGroups(recordStats.Records))
                {
                    <tbody @key="group.Key">
                    @for (var i = 0; i < group.Rows.Count; i++)
                    { var record = group.Rows[i];
                        <tr @key="record.Id" class="@(i == 0 ? "is-first" : "")">
                            @if (i == 0) { <th scope="rowgroup" rowspan="@group.Rows.Count">@group.Title</th> }
                            <td><span class="stats-record-holder">@if (record.Owner.Length > 0) { <ProfileAvatar Profile="RecordProfile(record)" Size="28" /> } else { <span class="stats-record-family" aria-hidden="true"><MusicIcon Name="crown" /></span> }@(record.User.Length > 0 ? record.User : "Family")</span></td>
                            <td class="num"><strong>@RecordValue(record)</strong></td>
                            <td>@ExactDay(record.Day)@(record.EndDay.Length > 0 && record.EndDay != record.Day ? " to " + ExactDay(record.EndDay) : "")</td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
            </div>
        </section>
    }
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static readonly (string Label, Func<WrappedStatistics, string> Value)[] WrappedMetrics =
    [
        ("Songs added", wrapped => wrapped.SongsAdded.ToString("N0", Inv)),
        ("Listening time", wrapped => $"{wrapped.TotalMinutes.ToString("0.#", Inv)} min"),
        ("Favourite artist", wrapped => wrapped.FavouriteArtist ?? "—"),
        ("Favourite genre", wrapped => wrapped.FavouriteGenre ?? "—"),
        ("Longest streak", wrapped => wrapped.LongestStreakDays == 1 ? "1 day" : $"{wrapped.LongestStreakDays} days"),
        ("Night owl", wrapped => Percent(wrapped.NightOwlShare)),
        ("Most replayed", wrapped => ReplayValue(wrapped.MostReplayedSong)),
        ("Mainstream score", wrapped => Percent(wrapped.MainstreamScore)),
        ("Early listener", wrapped => wrapped.EarlyListeners.Count > 0 ? string.Join(", ", wrapped.EarlyListeners) : "—"),
    ];
    private string? wrappedMemberId;
    private Task OpenMemberPicker(string id) =>
        JS.InvokeVoidAsync("familyhub.showDialog", "lb-person-menu", "lb-person-" + id, "lb-wrapped-member").AsTask();
    private async Task SelectMember(string id)
    {
        wrappedMemberId = id;
        await JS.InvokeVoidAsync("familyhub.closeDialog", "lb-person-menu", "lb-wrapped-member");
    }
    private static string ReplayValue(WrappedSong? replay)
    {
        if (replay is null) return "—";
        var count = $"{replay.Replays.ToString("N0", Inv)} {(replay.Replays == 1 ? "replay" : "replays")}";
        var artist = string.IsNullOrEmpty(replay.Artist) ? "" : $", {replay.Artist}";
        return $"{replay.Title ?? "Unknown song"} ({count}{artist})";
    }
    private ServerStatistics? data;
    private string period = "month";
    private string PeriodLabel => period == "week" ? "7 days" : period == "all" ? "All time" : "This month";
    private string StartDay => period == "week" ? DateTime.UtcNow.Date.AddDays(-6).ToString("yyyy-MM-dd",Inv) : DateTime.UtcNow.ToString("yyyy-MM-01",Inv);
    private IReadOnlyList<DailyListening> Days => (data?.Daily ?? []).Where(d => period == "all" || string.CompareOrdinal(d.Day,StartDay) >= 0).ToArray();
    private double SelectedTotal => period == "week" ? Days.Sum(d => d.Seconds) : data?.Profiles.Sum(PeriodSeconds) ?? 0;
    private double PeriodSeconds(ListenerStatistics profile) => period == "all" ? profile.Seconds : period == "month" ? profile.MonthSeconds : profile.Daily.Where(d => string.CompareOrdinal(d.Day,StartDay) >= 0).Sum(d => d.Seconds);
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback RefreshReview { get; set; }
    private async Task RefreshPage()
    {
        if (disposed || Refreshing) return;
        if (Offline || needsSignIn)
        {
            await RefreshNow();
            if (!disposed && !Offline) await Task.WhenAll(RefreshReview.InvokeAsync(), RefreshSeeding());
            return;
        }
        await Task.WhenAll(Refresh(), RefreshReview.InvokeAsync(), RefreshSeeding());
    }

    [Parameter] public bool Leaderboard { get; set; }
    private async Task SetPeriod(string value) { if (period == value) return; await JS.InvokeVoidAsync("familyhub.captureLeaderboard"); period = value; }
    private static string X(int i,int count) => (count <= 1 ? 280d : i * 560d / (count - 1)).ToString("0.##",Inv);
    private static string Y(double seconds,double peak) => (144 - 128 * seconds / peak).ToString("0.##",Inv);
    private static string ChartX(int i, int count) => (count <= 1 ? 50d : i * 100d / (count - 1)).ToString("0.###", Inv);
    private static string ChartY(double seconds, double peak) => ((144 - 128 * seconds / peak) * 100 / 156).ToString("0.###", Inv);
    private static string Points(IReadOnlyList<DailyListening> days,double peak) => string.Join(" ",days.Select((d,i) => X(i,days.Count) + "," + Y(d.Seconds,peak)));
    private IEnumerable<ListenerStatistics> Ranking => (data?.Profiles ?? []).Where(profile => PeriodSeconds(profile) > 0).OrderByDescending(PeriodSeconds).ThenBy(p => p.Name);
    private ListenerProfile ProfileFor(ListenerStatistics row) => Session.Profiles.FirstOrDefault(p => p.Id == row.Id) ?? new() { Id = row.Id, Name = row.Name };
    private ListenerProfile RecordProfile(ListeningRecord row) => Session.Profiles.FirstOrDefault(p => p.Id == row.Owner) ?? new() { Id = row.Owner, Name = row.User };
    private static string DayLabel(string day) => DateTime.TryParse(day, out var date) ? date.ToString("d MMM", Inv) : day;
    private static string OnOff(bool enabled) => enabled ? "On" : "Off";
    private static string ExactDay(string day) => DateTime.TryParse(day, Inv, DateTimeStyles.None, out var date) ? date.ToString("d MMM yyyy", Inv) : day;
    private static string ExactDuration(double seconds)
    {
        // Whole minutes read well; seconds only matter below an hour.
        var total = (long)Math.Round(Math.Max(0, seconds));
        if (total >= 3600) return $"{total / 3600} h {total % 3600 / 60} min";
        return total >= 60 ? $"{total / 60} min {total % 60} s" : $"{total} s";
    }
    private string? error;
    private bool fetching, reconnecting, needsSignIn, disposed;
    private string? requestedIdentity;
    private readonly CancellationTokenSource lifetime = new();

    private bool Offline => !Session.Connected || Session.Api is null;
    private bool Refreshing => fetching || reconnecting;

    protected override void OnInitialized()
    {
        Session.Changed += Changed;
    }

    private async Task RefreshNow()
    {
        if (Refreshing) return;
        if (Offline || needsSignIn)
        {
            reconnecting = true;
            try { await Session.ReconnectAsync(); }
            finally { reconnecting = false; }
        }
        await Refresh();
    }
    private string Identity => Session.Server + "\n" + Session.User;

    private ServerSeeding? seedingData;
    private string? seedingIdentity, seedingError;
    private bool seedingFetching, seedingNeedsSignIn;

    private Task RefreshSeedingFromButton() => RefreshSeeding(reconnect: true);

    private async Task RefreshSeeding(bool reconnect = false)
    {
        if (Leaderboard || !Session.ServerHealthAdmin || disposed || seedingFetching || (Offline && !reconnect)) return;
        var identity = Identity;
        if (seedingIdentity != identity)
        {
            seedingData = null;
            seedingError = null;
            seedingNeedsSignIn = false;
            seedingIdentity = identity;
        }
        seedingFetching = true;
        StateHasChanged();
        try
        {
            using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            request.CancelAfter(TimeSpan.FromSeconds(5));
            if (reconnect && (Offline || seedingNeedsSignIn))
                await Session.ReconnectAsync().WaitAsync(request.Token);
            if (identity != Identity || Session.Api is not { } api || Offline) return;
            var result = await api.GetServerSeedingAsync(request.Token).WaitAsync(request.Token);
            for (var retry = 0; retry < 2 && result.Stale; retry++)
            {
                if (disposed || identity != Identity) return;
                seedingData = result;
                await Task.Delay(TimeSpan.FromMilliseconds(750), request.Token);
                result = await api.GetServerSeedingAsync(request.Token).WaitAsync(request.Token);
            }
            if (!disposed && identity == Identity)
            {
                seedingData = result;
                seedingError = null;
                seedingNeedsSignIn = false;
            }
        }
        catch (OperationCanceledException) when (!disposed && identity == Identity)
        { seedingError = "Seeding took too long to load."; }
        catch (FamilyHubApiException failure) when (!disposed && identity == Identity && failure.RequiresSignIn)
        { seedingNeedsSignIn = true; seedingError = "Your session expired. Retry seeding to reconnect."; }
        catch (Exception) when (!disposed && identity == Identity)
        { seedingError = "Could not load seeding records."; }
        catch (Exception) when (disposed || identity != Identity) { }
        finally
        {
            seedingFetching = false;
            if (!disposed && identity != Identity) await RefreshSeeding();
            if (!disposed) StateHasChanged();
        }
    }

    private DateTimeOffset snapshotAt;
    private int snapshotRetries;
    private bool followingUp;
    private bool SnapshotStale => data?.SnapshotAgeSeconds > 1;
    private void QueueSnapshotRefresh()
    {
        if (disposed) return;
        if (!SnapshotStale) return;
        if (snapshotRetries >= 3) return;
        snapshotRetries++;
        _ = Task.Delay(TimeSpan.FromSeconds(2.5), lifetime.Token).ContinueWith(
            async t => { if (!t.IsCanceled && !disposed) await InvokeAsync(() => { followingUp = true; return Refresh(); }); },
            TaskScheduler.Default);
    }

    private async Task Refresh()
    {
        if (Refreshing || disposed || Offline) return;
        if (!followingUp) snapshotRetries = 0;
        followingUp = false;
        var identity = requestedIdentity = Identity;
        fetching = true;
        StateHasChanged();
        try
        {
            using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            request.CancelAfter(TimeSpan.FromSeconds(5));
            var api = Session.Api!;
            ServerStatistics result;
            try
            {
                result = await api.GetServerStatsAsync(request.Token, leaderboard: Leaderboard).WaitAsync(request.Token);
            }
            catch (FamilyHubApiException failure) when (Leaderboard && data is null && failure.StatusCode == 503)
            {
                // A cold snapshot can still be building after the first request returns.
                await Task.Delay(TimeSpan.FromSeconds(1), request.Token);
                result = await api.GetServerStatsAsync(request.Token, leaderboard: true).WaitAsync(request.Token);
            }
            if (disposed || identity != Identity) return;
            if (Leaderboard) await JS.InvokeVoidAsync("familyhub.captureLeaderboard").AsTask().WaitAsync(request.Token);
            await JS.InvokeVoidAsync("familyhub.captureStatsFocus").AsTask().WaitAsync(request.Token);
            data = result; Session.UpdateTopListener(result);
            needsSignIn = false;
            error = null;
            snapshotAt = DateTimeOffset.UtcNow.AddSeconds(-Math.Max(0, result.SnapshotAgeSeconds));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
        catch (OperationCanceledException) { error = "The server did not answer in time. Check your connection and try again."; }
        catch (FamilyHubApiException failure) when (failure.RequiresSignIn)
        { needsSignIn = true; error = "Your session expired. Retry to reconnect."; }
        catch (Exception) { error = Leaderboard ? "Could not load the leaderboard." : "Could not load automatic work."; }
        finally
        {
            fetching = false;
            if (!disposed) { await UpdateIdentity(); QueueSnapshotRefresh(); }
        }
    }

    private void Changed() { if (!disposed) _ = InvokeAsync(UpdateIdentity); }
    private async Task UpdateIdentity()
    {
        if (disposed) return;
        var seeding = seedingIdentity != Identity ? RefreshSeeding() : Task.CompletedTask;
        if (requestedIdentity != Identity)
        {
            data = null;
            wrappedMemberId = null;
            if (!fetching) await Refresh();
        }
        await seeding;
        StateHasChanged();
    }
    public void Dispose() { disposed = true; Session.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Leaderboard) _ = RefreshVisibleLeaderboard();
            await UpdateIdentity();
        }
        await JS.InvokeVoidAsync("familyhub.animateLeaderboard");
        await JS.InvokeVoidAsync("familyhub.restoreStatsFocus");
    }
    private async Task RefreshVisibleLeaderboard()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (Leaderboard && Session.UiActive && !Offline)
                    await InvokeAsync(Refresh);
        }
        catch (OperationCanceledException) when (disposed) { }
    }

