@implements IDisposable
@using System.Globalization
@inject MusicSession Session
@inject IJSRuntime JS

<div class="server-stats @(Leaderboard ? "leaderboard-page" : "server-page")" aria-busy="@Aria(Refreshing && data is null)">
    <div class="stats-toolbar">
        @if (Leaderboard)
        {
            <div class="lb-periods" role="group" aria-label="Listening period">
                @foreach (var choice in new[] { ("week", "7 days"), ("month", "This month"), ("all", "All time") })
                { <button class="lb-period" aria-pressed="@Aria(period == choice.Item1)" @onclick="() => SetPeriod(choice.Item1)">@choice.Item2</button> }
            </div>
        }
        else
        {
            <div class="stats-server-status"><i class="stats-online-dot @(!Offline ? "is-online" : "")" aria-hidden="true"></i><span>@(Offline ? "Server offline" : "Server online")</span>@if (data is not null) { <span>@data.Profiles.Count(p => p.Listening) listening now</span> }</div>
        }
        <button id="server-stats-refresh" class="quiet stats-refresh @(Refreshing ? "is-refreshing" : "")" aria-label="@(Leaderboard ? "Refresh leaderboard" : "Refresh server work")" title="Refresh" @onclick="RefreshNow" aria-disabled="@Aria(Refreshing)"><MusicIcon Name="refresh" /></button>
    </div>
    <Notice Message="@StatusText" Level="@(error is not null && !Offline ? "error" : Offline ? "warning" : "info")"
        ActionLabel="@(error is not null && !Offline ? Leaderboard ? "Retry leaderboard" : "Retry server work" : null)"
        Action="RefreshNow" Busy="@Refreshing" FocusTarget="#server-stats-refresh" />
    @if (ShowSnapshotNotice) { <Notice Level="warning" Message="Showing the last server snapshot. Refresh to check for updates." /> }
    @if (data is { } stats && Leaderboard)
    {
        var ranking = Ranking.ToList();
        var leader = Math.Max(1, ranking.Select(PeriodSeconds).DefaultIfEmpty(0).Max());
        var total = SelectedTotal;
        var days = Days;
        var peak = Math.Max(1, days.Select(d => d.Seconds).DefaultIfEmpty(0).Max());
        var present = stats.Profiles.Where(p => p.Listening || p.Online).OrderByDescending(p => p.Listening).ThenBy(p => p.Name).ToList();
        @if (ranking.Count == 0)
        {
            <Notice Level="empty" Message="No listening time recorded for this period. Play a song with listening history enabled to appear here." />
        }
        else
        {
        <section class="lb-podium stats-leaderboard" aria-label="@("Top listeners, " + PeriodLabel)">
            @foreach (var place in new[] { 1, 0, 2 }.Where(i => i < ranking.Count))
            {
                var profile = ranking[place];
                <div class="lb-place lb-place-@(place + 1)" data-profile-key="@profile.Id" @key="profile.Id">
                    <div class="lb-avatar">
                        @if (place == 0) { <span class="lb-crown"><MusicIcon Name="crown" /></span> }
                        <ProfileAvatar Profile="ProfileFor(profile)" Size="@(place == 0 ? 84 : 64)" ShowCrown="false" />
                        @if (profile.Listening) { <span class="lb-live" title="Listening now"><span class="sr">Listening now</span></span> }
                    </div>
                    <strong>@profile.Name</strong>
                    <span class="lb-time">@Duration(PeriodSeconds(profile))</span>
                    <span class="lb-saved">@Huf(profile.SavedHuf) Ft saved</span>
                    <div class="lb-step"><span>@(place + 1)</span></div>
                </div>
            }
        </section>
        }
        @if (ranking.Count > 3)
        {
            <ol class="lb-list stats-leaderboard" start="4" aria-label="Other listeners">
                @for (var i = 3; i < ranking.Count; i++)
                {
                    var profile = ranking[i];
                    <li class="lb-row" data-profile-key="@profile.Id" @key="profile.Id">
                        <span class="lb-rank">@(i + 1)</span>
                        <ProfileAvatar Profile="ProfileFor(profile)" Size="44" />
                        <div class="lb-who">
                            <strong>@profile.Name</strong>
                            <small class="lb-status @(profile.Listening ? "is-listening" : profile.Online ? "is-online" : "")"><i aria-hidden="true"></i>@if (profile.Listening && profile.CurrentTrack is { } song) { <span class="sr">Listening now: </span><span>@song.Title</span> } else { <span>@(profile.Listening ? "Listening now" : profile.Online ? "Online" : "Offline")</span> }</small>
                        </div>
                        <div class="lb-figures"><strong>@Duration(PeriodSeconds(profile))</strong><small>@Huf(profile.SavedHuf) Ft saved</small></div>
                        <span class="lb-bar" aria-hidden="true"><i style="width:@((100 * PeriodSeconds(profile) / leader).ToString("0.#", Inv))%"></i></span>
                        <ListenerMenu Profile="profile" />
                    </li>
                }
            </ol>
        }
        <section class="lb-now glass-panel" aria-labelledby="lb-now-title">
            <h2 id="lb-now-title">Who's here</h2>
            @foreach (var profile in present)
            {
                <div class="lb-live-row" @key="profile.Id"><ProfileAvatar Profile="ProfileFor(profile)" Size="36" /><div><strong>@profile.Name</strong><small>@(profile.Listening ? profile.CurrentTrack is { } song ? song.Title + ", " + song.Channel : "Listening now" : "Online")</small></div>@if (profile.Listening) { <span class="listener-equalizer is-playing" aria-hidden="true">@for (var bar = 0; bar < 5; bar++) { <i style="--bar:@bar"></i> }</span> }<ListenerMenu Profile="profile" /></div>
            }
            @if (present.Count == 0) { <Notice Level="empty" Message="Nobody is online right now." /> }
        </section>
        <section class="stats-listening glass-panel" aria-labelledby="stats-listening-title">
            <div class="stats-section-heading"><h2 id="stats-listening-title">Family listening time</h2><span>@PeriodLabel</span></div>
            @if (total > 0) { <strong class="stats-time">@Duration(total)</strong> }
            else { <Notice Level="empty" Message="The chart fills in after family members listen to music." /> }
            @if (total > 0 && days.Count > 0)
            {
                <p class="stats-latest">Latest: @ExactDay(days[^1].Day), <strong>@ExactDuration(days[^1].Seconds)</strong></p>
                <div class="stats-chart-frame">
                    <div class="stats-chart-axis" aria-hidden="true"><span>@Duration(peak)</span><span>0 s</span></div>
                    <div class="stats-chart-scroll" role="region" aria-label="Daily listening chart, scroll for more dates" tabindex="0">
                    <div class="stats-chart-plot">
                    <div class="stats-chart-surface">
                <svg class="stats-line-chart" viewBox="0 0 560 156" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <defs><linearGradient id="stats-chart-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--accent-blue)" stop-opacity=".28" /><stop offset="100%" stop-color="var(--accent-blue)" stop-opacity="0" /></linearGradient></defs>
                    <path class="stats-chart-grid" d="M0 16H560M0 80H560M0 144H560" />
                    @if (days.Count > 1) { <path class="stats-chart-area" d="@("M0,144 L" + Points(days,peak).Replace(" ", " L") + " L560,144 Z")" /><polyline class="stats-chart-line" points="@Points(days,peak)" vector-effect="non-scaling-stroke" /> }
                </svg>
                    @for (var i = 0; i < days.Count; i++)
                    {
                        var day = days[i];
                        var label = ExactDay(day.Day) + ": " + ExactDuration(day.Seconds);
                        <button @key="day.Day" id="@("stats-point-" + day.Day)" type="button" class="stats-chart-point-button" style="left:@ChartX(i,days.Count)%;top:@ChartY(day.Seconds,peak)%" aria-label="@label" data-tooltip="@label"><span aria-hidden="true"></span></button>
                    }
                    </div>
                <div class="stats-chart-labels"><span>@DayLabel(days[0].Day)</span><span>@DayLabel(days[^1].Day)</span></div>
                    </div></div>
                </div>
                <table class="sr"><caption>Daily listening, @PeriodLabel</caption><thead><tr><th scope="col">Date</th><th scope="col">Time listened</th></tr></thead><tbody>@foreach (var day in days) { <tr><th scope="row">@ExactDay(day.Day)</th><td>@ExactDuration(day.Seconds)</td></tr> }</tbody></table>
            }
        </section>
        @if (stats.WrappedYear is { } year)
        {
            var wrappedProfiles = stats.Profiles.Where(p => p.Wrapped is { } wrapped && (wrapped.TotalMinutes > 0 || wrapped.SongsAdded > 0)).ToList();
            <section class="lb-wrapped" aria-labelledby="lb-wrapped-title">
                <h2 id="lb-wrapped-title">@year listening</h2>
                @if (stats.Profiles.Count == 0)
                {
                    <Notice Level="empty" Message="No profiles have listening history enabled." />
                }
                else if (wrappedProfiles.Count == 0)
                {
                    <Notice Level="empty" Message="Play or add songs to see this year's listening summary." />
                }
                <div class="lb-wrapped-grid">
                    @foreach (var profile in wrappedProfiles)
                    {
                        var wrapped = profile.Wrapped!;
                        var replay = wrapped.MostReplayedSong;
                        <article class="lb-wrapped-card glass-panel" @key="profile.Id">
                            <h3><ProfileAvatar Profile="ProfileFor(profile)" Size="36" ShowCrown="false" /> <span>@profile.Name</span></h3>
                            <dl>
                                <div><dt><MusicIcon Name="plus-circle" />Songs added</dt><dd>@wrapped.SongsAdded.ToString("N0", Inv)</dd></div>
                                <div><dt><MusicIcon Name="clock" />Listening time</dt><dd>@wrapped.TotalMinutes.ToString("0.#", Inv) min</dd></div>
                                <div><dt><MusicIcon Name="person" />Favourite artist</dt><dd>@(wrapped.FavouriteArtist ?? "—")</dd></div>
                                <div><dt><MusicIcon Name="music" />Favourite genre</dt><dd>@(wrapped.FavouriteGenre ?? "—")</dd></div>
                                <div><dt><MusicIcon Name="crown" />Longest streak</dt><dd>@(wrapped.LongestStreakDays == 1 ? "1 day" : $"{wrapped.LongestStreakDays} days")</dd></div>
                                <div><dt><MusicIcon Name="moon" />Night owl</dt><dd>@Percent(wrapped.NightOwlShare)</dd></div>
                                <div><dt><MusicIcon Name="repeat" />Most replayed</dt><dd>@(replay is null ? "—" : replay.Title ?? "Unknown song")@if (replay is not null) { <small>@replay.Replays × replayed@(string.IsNullOrEmpty(replay.Artist) ? "" : " · " + replay.Artist)</small> }</dd></div>
                                <div><dt><MusicIcon Name="radio" />Mainstream score</dt><dd>@Percent(wrapped.MainstreamScore)</dd></div>
                            </dl>
                            @if (wrapped.EarlyListeners.Count > 0)
                            {
                                <p class="lb-early"><MusicIcon Name="sparkle" /><span><strong>Early listener</strong> @string.Join(", ", wrapped.EarlyListeners)</span></p>
                            }
                        </article>
                    }
                </div>
                @if (wrappedProfiles.Count > 0)
                {
                    var chartDate = wrappedProfiles.Select(p => p.Wrapped?.ChartDate).FirstOrDefault(d => d is not null);
                    <details class="lb-wrapped-help">
                        <summary>How scores are counted</summary>
                        <p>Night owl is the share of completed plays that started from 00:00 to 05:59 UTC. Replays count each time you listen to a song again this year.</p>
                        <p>Mainstream score is the share of your top 10 artists and top 10 songs that appear in Deezer’s chart. Early listener marks artists you played before FamilyHub observed them enter the chart.</p>
                        <p>@(chartDate is null ? "Deezer chart unavailable. Refresh the leaderboard to check again." : $"Deezer chart checked {ExactDay(chartDate)}.")</p>
                    </details>
                }
            </section>
        }
    }
    else if (!Leaderboard && data is not null)
    {
        <div class="srv-grid">
            @if (data is { } server)
            {
                <section class="stats-work srv-work glass-panel" aria-labelledby="stats-work-title">
                    <div class="stats-section-heading"><h2 id="stats-work-title">Worker activity</h2></div>
                    @if (server.WorkerStages is null && server.PlaylistBacklog is null)
                    {
                        <Notice Level="warning" Message="Update the server to see queue and retry counts." />
                    }
                    else if (server.WorkerStages is { Count: 0 } && server.PlaylistBacklog is null)
                    {
                        <Notice Level="empty" Message="No resource jobs are waiting or running." />
                    }
                    else
                    {
                        <ul class="srv-stage-cards">
                        @foreach (var stage in server.WorkerStages ?? [])
                        {
                            var (title, icon) = StageDisplay(stage.Stage);
                            <li class="srv-stage-card" @key="stage.Stage">
                                <h3><MusicIcon Name="@icon" />@title</h3>
                                <dl>
                                    <div><dt>Queued</dt><dd class="music-admin-count">@stage.Queued</dd></div>
                                    <div><dt>Backing off</dt><dd class="music-admin-count">@stage.BackingOff</dd></div>
                                    <div><dt>Running</dt><dd class="music-admin-count">@stage.Running</dd></div>
                                </dl>
                            </li>
                        }
                        @if (server.PlaylistBacklog is { } backlog)
                        {
                            <li class="srv-stage-card">
                                <h3><MusicIcon Name="playlist" />Playlist backlog</h3>
                                <dl>
                                    <div><dt>Pending</dt><dd class="music-admin-count">@backlog.Pending</dd></div>
                                    <div><dt>Waiting to retry</dt><dd class="music-admin-count">@backlog.WaitingToRetry</dd></div>
                                    <div><dt>Running</dt><dd class="music-admin-count">@backlog.Running</dd></div>
                                </dl>
                            </li>
                        }
                        </ul>
                    }
                    @if (server.Workers.Count > 0)
                    {
                        <details class="srv-worker-details">
                            <summary><MusicIcon Name="chevron-down" />Worker slots</summary>
                            <ul class="srv-work-list">
                            @foreach (var group in WorkGroups(server.Workers))
                            {
                                var working = group.Workers.Where(w => w.State == "working").ToList();
                                var first = group.Workers[0];
                                <li class="srv-work-row is-@(working.Count > 0 ? "working" : first.State)" @key="group.Name">
                                    <div class="srv-work-line">
                                        <strong>@group.Name</strong>
                                        <span class="srv-work-status">@(group.Workers.Count > 1 && working.Count > 0 ? $"{working.Count} of {group.Workers.Count} active" : Label(first.State))</span>
                                    </div>
                                    @if (working.Count == 0 && first.WaitingFor.Length > 0)
                                    {
                                        <small class="srv-work-wait">Waiting for @(char.ToLowerInvariant(first.WaitingFor[0]) + first.WaitingFor[1..])</small>
                                    }
                                    @foreach (var job in working)
                                    {
                                        var percent = job.Progress;
                                        <div class="srv-work-job" @key="job.Id">
                                            @if (!string.IsNullOrWhiteSpace(job.CurrentTitle)) { <span class="stats-current-action">@job.CurrentTitle</span> }
                                            @if (job.Phase.Length > 0) { <small>@job.Phase</small> }
                                            @if (percent is not null) { <div class="stats-meter" role="progressbar" aria-label="@job.Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent.Value.ToString("0", Inv)"><i style="width:@percent.Value.ToString("0.###", Inv)%"></i></div> }
                                            @if (job.Owner.Length > 0) { <span class="stats-job-requester"><ProfileAvatar Profile="WorkProfile(job)" Size="24" /><span>@job.User</span></span> }
                                        </div>
                                    }
                                </li>
                            }
                            </ul>
                        </details>
                    }
                </section>
            }
            @if (data is { } figures)
            {
                var used = Math.Max(0, figures.StorageTotalBytes - figures.StorageFreeBytes);
                var usedPercent = figures.StorageTotalBytes > 0 ? Math.Clamp(100d * used / figures.StorageTotalBytes, 0, 100) : 0;
                <section class="srv-savings glass-panel" aria-labelledby="srv-savings-title">
                    <h2 id="srv-savings-title">Savings</h2>
                    <div class="srv-figures">
                        <div class="srv-figure"><span>Total saved</span><strong>@Huf(figures.SavedHuf)<small> Ft</small></strong></div>
                        <div class="srv-figure"><span>Per month</span><strong>@Huf(figures.MonthlySavedHuf)<small> Ft</small></strong></div>
                        <div class="srv-figure"><span>Withheld from streamers</span><strong>@Usd(figures.RoyaltyUsd)</strong><small>@figures.TotalQualifiedPlays.ToString("N0", Inv) plays</small></div>
                    </div>
                </section>
                <section class="srv-storage glass-panel" aria-labelledby="srv-storage-title">
                    <h2 id="srv-storage-title">Storage</h2>
                    <div class="srv-ring" style="--used:@usedPercent.ToString("0.#", Inv)" role="img" aria-label="@($"{usedPercent:0} percent of storage used")"><span><strong>@usedPercent.ToString("0", Inv)%</strong><small>used</small></span></div>
                    <dl class="srv-storage-facts"><div><dt>Used</dt><dd>@Bytes(used)</dd></div><div><dt>Free</dt><dd>@Bytes(figures.StorageFreeBytes)</dd></div><div><dt>Total</dt><dd>@Bytes(figures.StorageTotalBytes)</dd></div></dl>
                </section>
            }
        </div>
    }
    @if (Leaderboard && data is { Records.Count: > 0 } recordStats)
    {
        <section class="stats-records" aria-labelledby="stats-records-title">
            <h2 id="stats-records-title">Records</h2>
            <div class="stats-record-table glass-panel">
            <table>
                <thead><tr><th scope="col">Record</th><th scope="col">Held by</th><th scope="col" class="num">Result</th><th scope="col">When</th></tr></thead>
                @foreach (var group in RecordGroups(recordStats.Records))
                {
                    <tbody @key="group.Key">
                    @for (var i = 0; i < group.Rows.Count; i++)
                    { var record = group.Rows[i];
                        <tr @key="record.Id" class="@(i == 0 ? "is-first" : "")">
                            @if (i == 0) { <th scope="rowgroup" rowspan="@group.Rows.Count">@group.Title</th> }
                            <td><span class="stats-record-holder">@if (record.Owner.Length > 0) { <ProfileAvatar Profile="RecordProfile(record)" Size="28" /> } else { <span class="stats-record-family" aria-hidden="true"><MusicIcon Name="crown" /></span> }@(record.User.Length > 0 ? record.User : "Family")</span></td>
                            <td class="num"><strong>@RecordValue(record)</strong></td>
                            <td>@ExactDay(record.Day)@(record.EndDay.Length > 0 && record.EndDay != record.Day ? " to " + ExactDay(record.EndDay) : "")</td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
            </div>
        </section>
    }
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private ServerStatistics? data;
    private string period = "month";
    private string PeriodLabel => period == "week" ? "7 days" : period == "all" ? "All time" : "This month";
    private string StartDay => period == "week" ? DateTime.UtcNow.Date.AddDays(-6).ToString("yyyy-MM-dd",Inv) : DateTime.UtcNow.ToString("yyyy-MM-01",Inv);
    private IReadOnlyList<DailyListening> Days => (data?.Daily ?? []).Where(d => period == "all" || string.CompareOrdinal(d.Day,StartDay) >= 0).ToArray();
    private double SelectedTotal => period == "week" ? Days.Sum(d => d.Seconds) : data?.Profiles.Sum(PeriodSeconds) ?? 0;
    private double PeriodSeconds(ListenerStatistics profile) => period == "all" ? profile.Seconds : period == "month" ? profile.MonthSeconds : profile.Daily.Where(d => string.CompareOrdinal(d.Day,StartDay) >= 0).Sum(d => d.Seconds);
    [Parameter] public bool Leaderboard { get; set; }
    private async Task SetPeriod(string value) { if (period == value) return; await JS.InvokeVoidAsync("familyhub.captureLeaderboard"); period = value; }
    private static string X(int i,int count) => (count <= 1 ? 280d : i * 560d / (count - 1)).ToString("0.##",Inv);
    private static string Y(double seconds,double peak) => (144 - 128 * seconds / peak).ToString("0.##",Inv);
    private static string ChartX(int i, int count) => (count <= 1 ? 50d : i * 100d / (count - 1)).ToString("0.###", Inv);
    private static string ChartY(double seconds, double peak) => ((144 - 128 * seconds / peak) * 100 / 156).ToString("0.###", Inv);
    private static string Points(IReadOnlyList<DailyListening> days,double peak) => string.Join(" ",days.Select((d,i) => X(i,days.Count) + "," + Y(d.Seconds,peak)));
    private IEnumerable<ListenerStatistics> Ranking => (data?.Profiles ?? []).Where(profile => PeriodSeconds(profile) > 0).OrderByDescending(PeriodSeconds).ThenBy(p => p.Name);
    private ListenerProfile ProfileFor(ListenerStatistics row) => Session.Profiles.FirstOrDefault(p => p.Id == row.Id) ?? new() { Id = row.Id, Name = row.Name };
    private ListenerProfile RecordProfile(ListeningRecord row) => Session.Profiles.FirstOrDefault(p => p.Id == row.Owner) ?? new() { Id = row.Owner, Name = row.User };
    private static string DayLabel(string day) => DateTime.TryParse(day, out var date) ? date.ToString("d MMM", Inv) : day;
    private static string ExactDay(string day) => DateTime.TryParse(day, Inv, DateTimeStyles.None, out var date) ? date.ToString("d MMM yyyy", Inv) : day;
    private static string ExactDuration(double seconds)
    {
        // Whole minutes read well; seconds only matter below an hour.
        var total = (long)Math.Round(Math.Max(0, seconds));
        if (total >= 3600) return $"{total / 3600} h {total % 3600 / 60} min";
        return total >= 60 ? $"{total / 60} min {total % 60} s" : $"{total} s";
    }
    private string? error;
    private bool fetching, reconnecting, needsSignIn, disposed;
    private string? requestedIdentity;
    private readonly CancellationTokenSource lifetime = new();

    private bool Offline => !Session.Connected || Session.Api is null;
    private bool Refreshing => fetching || reconnecting;
    private string StatusText => reconnecting ? "Reconnecting to the server…"
        : Offline ? data is null ? "Server offline. Use Refresh to reconnect." : "Showing the last loaded statistics. Use Refresh to reconnect."
        : error ?? (fetching && data is null ? "Loading server statistics…" : "");

    protected override void OnInitialized()
    {
        Session.Changed += Changed;
    }

    private async Task RefreshNow()
    {
        if (Refreshing) return;
        if (Offline || needsSignIn)
        {
            reconnecting = true;
            try { await Session.ReconnectAsync(); }
            finally { reconnecting = false; }
        }
        await Refresh();
    }
    private string Identity => Session.Server + "\n" + Session.User;

    private int snapshotRetries;
    private bool followingUp;
    private bool SnapshotStale => data?.SnapshotAgeSeconds > 1;
    private bool snapshotExhausted;
    private bool ShowSnapshotNotice => snapshotExhausted && SnapshotStale;
    private void QueueSnapshotRefresh()
    {
        if (disposed) return;
        if (!SnapshotStale) { snapshotExhausted = false; return; }
        if (snapshotRetries >= 3) { snapshotExhausted = true; StateHasChanged(); return; }
        snapshotRetries++;
        _ = Task.Delay(TimeSpan.FromSeconds(2.5), lifetime.Token).ContinueWith(
            async t => { if (!t.IsCanceled && !disposed) await InvokeAsync(() => { followingUp = true; return Refresh(); }); },
            TaskScheduler.Default);
    }

    private async Task Refresh()
    {
        if (Refreshing || disposed || Offline) return;
        if (!followingUp) { snapshotRetries = 0; snapshotExhausted = false; }
        followingUp = false;
        var identity = requestedIdentity = Identity;
        fetching = true;
        needsSignIn = false;
        error = null;
        StateHasChanged();
        try
        {
            using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            request.CancelAfter(TimeSpan.FromSeconds(5));
            var api = Session.Api!;
            var result = await api.GetServerStatsAsync(request.Token, leaderboard: Leaderboard).WaitAsync(request.Token);
            if (disposed || identity != Identity) return;
            if (Leaderboard) await JS.InvokeVoidAsync("familyhub.captureLeaderboard").AsTask().WaitAsync(request.Token);
            await JS.InvokeVoidAsync("familyhub.captureStatsFocus").AsTask().WaitAsync(request.Token);
            data = result; Session.UpdateTopListener(result);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
        catch (OperationCanceledException) { error = "The server did not answer in time. Check your connection and try again."; }
        catch (FamilyHubApiException failure) when (failure.RequiresSignIn)
        { needsSignIn = true; error = "Your session expired. Retry to reconnect."; }
        catch (Exception) { error = "Could not load listening and server statistics."; }
        finally
        {
            fetching = false;
            if (!disposed) { await UpdateIdentity(); QueueSnapshotRefresh(); }
        }
    }

    private void Changed() { if (!disposed) _ = InvokeAsync(UpdateIdentity); }
    private async Task UpdateIdentity()
    {
        if (disposed) return;
        if (requestedIdentity != Identity)
        {
            data = null;
            if (!fetching) await Refresh();
        }
        StateHasChanged();
    }
    public void Dispose() { disposed = true; Session.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await UpdateIdentity();
        await JS.InvokeVoidAsync("familyhub.animateLeaderboard");
        await JS.InvokeVoidAsync("familyhub.restoreStatsFocus");
    }
    private static (string Title, string Icon) StageDisplay(string stage) => stage switch
    {
        "analysis" => ("Audio analysis", "music"),
        "fetch" => ("Downloads", "download"),
        "finished" => ("Playback preparation", "player"),
        "import" => ("Library imports", "library"),
        "matching" => ("Playlist matching", "playlist"),
        "opus" => ("Opus encoding", "device"),
        "preview" => ("Audio previews", "play"),
        "search" => ("Source lookup", "search"),
        _ => (Label(stage), "queue")
    };

    // Numbered slots of the same kind share a row.
    private static IEnumerable<(string Name, List<ServerWork> Workers)> WorkGroups(IEnumerable<ServerWork> workers) =>
        workers.GroupBy(w => System.Text.RegularExpressions.Regex.Replace(w.Title, @"\s+\d+$", "")).Select(g => (g.Key, g.ToList()));
    // One row group per record, family-wide records first; records held by several people (listening streaks) are ranked inside their group.
    private static IEnumerable<(string Key, string Title, List<ListeningRecord> Rows)> RecordGroups(IReadOnlyList<ListeningRecord> records) =>
        records.GroupBy(r => r.Title).OrderBy(g => g.Any(r => r.Owner.Length > 0)).ThenBy(g => g.Count())
            .Select(g => ("record-" + g.Key.ToLowerInvariant().Replace(' ', '-'), g.Key, g.OrderByDescending(r => r.Days ?? 0).ThenByDescending(r => r.Seconds ?? 0).ThenBy(r => r.User).ToList()));
    private static string RecordValue(ListeningRecord record) => record.Days is { } count ? count + (count == 1 ? " day" : " days") : ExactDuration(record.Seconds ?? 0);
    private ListenerProfile WorkProfile(ServerWork job) => Session.Profiles.FirstOrDefault(p => p.Id == job.Owner) ?? new() { Id = job.Owner, Name = job.User };
    private static string Aria(bool value) => value ? "true" : "false";
    private static string Usd(double value) => "$" + value.ToString("N2", Inv);
    private static string Huf(double value) => value.ToString("N0", Inv);
    private static string Percent(double? value) => value is { } share ? share.ToString("0%", Inv) : "—";
    private static string Duration(double seconds)
    {
        var total = (long)Math.Max(0, seconds);
        return total >= 3600 ? $"{total / 3600} h {total % 3600 / 60} min" : total >= 60 ? $"{total / 60} min" : $"{total} s";
    }
    private static string Bytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = (double)Math.Max(0, bytes); var unit = 0;
        while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; }
        return unit == 0 ? $"{value:0} B" : $"{value.ToString("0.0", Inv)} {units[unit]}";
    }
    private static string Label(string text) => string.IsNullOrWhiteSpace(text) ? "" : char.ToUpperInvariant(text[0]) + text[1..].Replace('_', ' ').Replace('-', ' ');
}
