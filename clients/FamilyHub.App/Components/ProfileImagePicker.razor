@inject MusicSession Session
@inject IJSRuntime JS

<div class="profile-picture-editor">
    <label class="profile-picture-input">
        <ProfileAvatar Profile="Profile" Size="72" ShowCrown="false" />
        <span class="profile-picture-caption" aria-hidden="true">@L[working ? "Saving…" : "Change picture"]</span>
        <InputFile id="profile-image-file" OnChange="ChooseImage" accept="image/jpeg,image/png" aria-label="@L["Change picture"].Value" disabled="@(!Session.Connected)" aria-busy="@(working ? "true" : "false")" />
    </label>
    <form class="profile-display-form" @onsubmit="SaveName" @onsubmit:preventDefault>
        <label for="profile-display-name">@L["Display name"]</label>
        <div class="profile-name-fields">
            <input id="profile-display-name" type="text" @bind="draftName" @bind:event="oninput" @bind:after="() => nameMessage = string.Empty"
                   readonly="@(!Session.Connected || savingName)" autocomplete="off"
                   aria-describedby="@(nameMessage.Length != 0 ? "profile-name-feedback" : null)" />
            <button id="profile-save-name" type="submit" aria-disabled="@(!CanSaveName ? "true" : null)">@L[savingName ? "Saving…" : "Save name"]</button>
        </div>
        <Notice Id="profile-name-feedback" Level="@(nameSaved ? "success" : "error")" Message="@nameMessage" />
    </form>
    <Notice Id="profile-picture-feedback" Level="error" Message="@imageMessage" />
</div>

@code {
    [Parameter] public ListenerProfile? Profile { get; set; }
    private bool working, savingName, nameSaved;
    private string imageMessage = "", nameMessage = "", draftName = "";
    private string? profileId, savedName;
    private bool CanSaveName => Session.Connected && Profile is not null && !savingName &&
        draftName.Trim() is { Length: > 0 } name && name != savedName;

    protected override void OnParametersSet()
    {
        if (Profile?.Id != profileId)
        {
            profileId = Profile?.Id;
            draftName = Profile?.Name ?? "";
            nameMessage = imageMessage = "";
        }
        else if (draftName == savedName) draftName = Profile?.Name ?? "";
        savedName = Profile?.Name;
    }

    private async Task SaveName()
    {
        if (!CanSaveName) return;
        savingName = true; nameSaved = false; nameMessage = "";
        try
        {
            await Session.RenameProfileAsync(draftName);
            draftName = Session.ProfileName;
            nameSaved = true;
            nameMessage = "Name saved.";
        }
        catch (Exception error) { nameMessage = NoticeText.Error(error, "Could not save your display name. Try again."); }
        finally { savingName = false; }
    }

    private async Task ChooseImage(InputFileChangeEventArgs args)
    {
        if (working || !Session.Connected) return;
        working = true; imageMessage = "";
        try
        {
            if (args.File.Size > 10 * 1024 * 1024) throw new InvalidOperationException("Choose an image smaller than 10 MB.");
            var image = await args.File.RequestImageFileAsync("image/jpeg", 512, 512);
            await using var input = image.OpenReadStream(512 * 1024);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);
            await Session.SetProfileImageAsync("data:image/jpeg;base64," + Convert.ToBase64String(output.ToArray()));
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", "Profile picture saved.");
        }
        catch (Exception error) { imageMessage = NoticeText.Error(error); }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("familyhub.focus", "profile-image-file");
        }
    }
}
