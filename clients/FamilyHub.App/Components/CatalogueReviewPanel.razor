@implements IDisposable
@using System.Text.Json
@using System.Text.RegularExpressions
@inject MusicSession Session
@inject MusicPlayer Player
@inject IJSRuntime JS

<section id="catalogue-review-title" tabindex="-1" aria-labelledby="srv-review-heading" class="music-admin catalogue-review srv-review" aria-busy="@Aria(loading && data is null)">
    <h2 id="srv-review-heading">@L["Song review"]</h2>
    <p class="sr" role="status" aria-live="polite" aria-atomic="true">@announcement</p>
    <ServiceStatus Active="@(!Online || error is not null)"
                   Detail="@(data is null ? "Reconnect to load song review." : "Showing the last loaded song review.")"
                   RetryLabel="@L["Retry song review"].Value" Retry="RetryReview" Busy="@(loading || saving || reconnecting)"
                   AutoRetry="Online" FocusTarget="#catalogue-review-title" />
    @if (data is not null && (!Online || error is not null || SnapshotStale)) { <small class="catalogue-timestamp">Review updated @snapshotAt.ToLocalTime().ToString("t")</small> }
    else if (data is null && error is null) { <Notice Message="@L["Loading song review…"].Value" /> }
    @if (data is { } snapshot)
    {
        @if (active is null)
        {
            var queued = workView == "queue";
            @if (queued)
            {
                <button type="button" id="catalogue-back" class="quiet catalogue-control" aria-disabled="@Aria(Unavailable)" @onclick='() => ChangeWorkView("choice")'>
                    <MusicIcon Name="chevron-down" />@L["Back to song review"]
                </button>
            }
            <div class="srv-review-overview">
                <section aria-labelledby="review-action-heading">
                    <h3 id="review-action-heading" tabindex="-1">@(queued ? "Queued & retrying" : "Needs your choice")</h3>
                    <ul class="srv-review-links">
                        @foreach (var category in VisibleCategories(snapshot))
                        {
                            <li @key="category.Id">
                                <button type="button" id="@("catalogue-filter-" + category.Id)" class="quiet srv-review-link"
                                        aria-disabled="@Aria(loading || saving)" @onclick="() => SelectCategory(category)">
                                    <span>@category.Label</span><span class="srv-review-count">@Count(category.Id)</span>
                                    <MusicIcon Name="chevron-down" />
                                </button>
                            </li>
                        }
                    </ul>
                </section>
                @if (!queued)
                {
                    <section aria-labelledby="review-activity-heading">
                        <h3 id="review-activity-heading">@L["Activity"]</h3>
                        <ul class="srv-review-links">
                            <li>
                                <button type="button" id="catalogue-view-queue" class="quiet srv-review-link"
                                        aria-disabled="@Aria(Unavailable)" @onclick='() => ChangeWorkView("queue")'>
                                    <span>@L["Queued & retrying"]</span><MusicIcon Name="chevron-down" />
                                </button>
                            </li>
                            @if (snapshot.CanEdit)
                            {
                                <li>
                                    <button type="button" id="catalogue-view-fixed" class="quiet srv-review-link"
                                            aria-disabled="@Aria(loading || saving)" @onclick='() => SelectCategory(Categories.First(c => c.Id == "fixed"))'>
                                        <span>@L["Recently fixed"]</span><span class="srv-review-count">@Count("fixed")</span>
                                        <MusicIcon Name="chevron-down" />
                                    </button>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
        else
        {
        <button type="button" id="catalogue-back" class="quiet catalogue-control" aria-disabled="@Aria(loading || saving)" @onclick="BackToCategoryList">
            <MusicIcon Name="chevron-down" />@(workView == "queue" ? "Back to queued & retrying" : "Back to song review")
        </button>
        var section = Categories.First(c => c.Id == active);
        var limit = Limit(active);
        <section id="catalogue-category-panel" class="glass-panel catalogue-pool" aria-labelledby="catalogue-category-title">
            <header class="music-admin-heading catalogue-section-heading">
                <div>
                    <h2 id="catalogue-category-title" tabindex="-1">@section.Label</h2>
                    @if (active == "fixed" && Count(active) > 0) { <p class="catalogue-description">@L["Undo restores the original recording or details."]</p> }
                </div>
                @if (snapshot.CanEdit)
                {
                    @if (active is "damaged" or "unofficial")
                    {
                        var replaceable = QualityRows(active).Count(r => r.Candidate is not null && !r.Replacing);
                        @if (replaceable > 0)
                        {
                            <button class="primary catalogue-control" aria-disabled="@Aria(Unavailable)"
                                    @onclick="() => ReplaceAll(active)">Replace all (@replaceable)</button>
                        }
                    }
                    else if (active == "trimming" && snapshot.Trimming.Count > 0)
                    {
                        <button class="quiet catalogue-control" aria-disabled="@Aria(Unavailable)"
                                @onclick='() => ResolveAll("trimming", snapshot.Trimming.Take(limit).Select(r => r.Id))'>@L["Resolve shown requests"]</button>
                    }
                    else if (active == "reports" && reports.Take(limit).Any(r => !r.Replacing))
                    {
                        <button class="quiet catalogue-control" aria-disabled="@Aria(Unavailable)"
                                @onclick='() => ResolveAll("reports", reports.Take(limit).Where(r => !r.Replacing).Select(r => r.Key))'>@L["Resolve shown reports"]</button>
                    }
                }
            </header>
            @if (Count(active) == 0) { <Notice Level="empty" Message="@section.Empty" /> }
            else
            {
                @switch (active)
                {
                    case "playlists":
                        @foreach (var row in snapshot.PlaylistGaps.Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            <article class="catalogue-row" @key="(row.OwnerId, row.PlaylistId, row.Index)">
                                <span class="song-artwork">
                                    @if (row.ArtworkUrl is { Length: > 0 } artwork && artwork.StartsWith("/api/playlists/", StringComparison.Ordinal))
                                    {
                                        <PlaylistCover Playlist="@(new MusicPlaylist { Id = row.PlaylistId, Name = row.PlaylistName, CoverUrl = artwork })" />
                                    }
                                    else { <TrackCover Track="@ReviewTrack("", title, row.Artist)" /> }
                                </span>
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@row.Artist</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@row.PlaylistName: @GapReason(row.State)</p>
                                    @Retry(row.RetryAt, row.RetryReason)
                                </div>
                                <div class="catalogue-actions">
                                    <button class="quiet catalogue-control" aria-label="@(row.CanEdit ? $"Review the recording of {title} in {row.PlaylistName}" : $"Open {row.PlaylistName} for {title}")"
                                            aria-disabled="@Aria(Unavailable)" @onclick="() => OpenPlaylist.InvokeAsync(row)">
                                        <MusicIcon Name="playlist" />@(row.CanEdit ? "Review recording" : "Open playlist")
                                    </button>
                                </div>
                            </article>
                        }
                        break;
                    case "damaged":
                    case "unofficial":
                        @foreach (var row in QualityRows(active).Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            <article class="catalogue-row" @key="row.Id" aria-busy="@Aria(row.Replacing)">
                                @Cover(row.Id, title, row.Artist)
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@row.Artist</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@(row.Issue == "decode_failed" ? "The server could not decode part of the audio." : row.Verdict == "suspect" ? "The scan found missing high frequencies." : "Unofficial upload.")</p>
                                    @if (row.Candidate is { } candidate) { <p class="catalogue-reason">Official source: @candidate.Channel</p> }
                                    else if (row.ReplacementChecked && row.RetryReason.Length == 0) { <p class="catalogue-reason">@L["No matching official source found."]</p> }
                                    @Retry(row.RetryAt, row.RetryReason)
                                    @if (row.Replacing) { <p class="catalogue-progress" role="status">@(row.Queued ? "Replacement queued" : "Replacing recording…")</p> }
                                    @if (row.Error is not null) { <Notice Level="error" Message="@NoticeText.Detail(row.Error, "This replacement could not be checked. Refresh song review and try again.")" /> }
                                </div>
                                <div class="catalogue-actions">
                                    @Listen(row.Id, title)
                                    <button id="@RecordingOpener(row.Id, false)" class="primary catalogue-control" aria-label="Choose a recording for @title"
                                            aria-haspopup="dialog" aria-disabled="@Aria(Unavailable || row.Replacing)"
                                            @onclick="() => OpenRecording(row.Id, title, row.Artist, false, row.Replacing, row.Candidate)">@L["Choose recording"]</button>
                                    <button class="quiet catalogue-control" aria-label="Keep @title" aria-disabled="@Aria(Unavailable || row.Replacing)"
                                            @onclick="() => KeepRecording(row)">@L["Keep"]</button>
                                </div>
                            </article>
                        }
                        break;
                    case "metadata":
                        @foreach (var row in snapshot.Metadata.Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            var performer = row.Current.GetValueOrDefault("artist", "");
                            <article class="catalogue-row" @key="row.Id">
                                @Cover(row.Id, title, performer)
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@performer</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@MetadataIssue(row)</p>
                                    @if (row.State == "processing") { <p class="catalogue-progress">@L["Looking up song details…"]</p> }
                                    else if (row.State == "queued" && snapshot.MetadataAutomatic is false) { <p class="catalogue-reason">@L["Automatic lookup is off."]</p> }
                                    else if (row.State == "queued" && row.RetryReason.Length == 0) { <p class="catalogue-reason">@L["Lookup queued"]</p> }
                                    else if (row.State == "queued") { @Retry(row.RetryAt, row.RetryReason) }
                                    else if (row.Source == "No unique title, artist and duration match") { <p class="catalogue-reason">@L["No verified catalogue match."]</p> }
                                    else if (row.Source == "Lookup unavailable; review manually") { <p class="catalogue-reason">@L["Catalogue lookup unavailable."]</p> }
                                    else if (row.Missing.Any(row.Suggested.ContainsKey)) { <p class="catalogue-reason">@L["Suggested details available."]</p> }
                                </div>
                                <div class="catalogue-actions">
                                    @Listen(row.Id, title)
                                    @if (snapshot.CanEdit)
                                    {
                                        <button id="@("metadata-" + row.Id)" class="primary catalogue-control" aria-label="Edit details for @title"
                                                aria-disabled="@Aria(Unavailable)" @onclick="() => Open(row)">@L["Edit details"]</button>
                                    }
                                </div>
                            </article>
                        }
                        break;
                    case "trimming":
                        @foreach (var row in snapshot.Trimming.Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            <article class="catalogue-row" @key="row.Id">
                                @Cover(row.Id, title, row.Artist)
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@row.Artist</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@(row.Positions.Count == 0 ? "Trim requested" : "Check around " + string.Join(", ", row.Positions.Select(Time)))</p>
                                    @if (row.RequestedBy.Count > 0) { <p class="catalogue-reason">Requested by @string.Join(", ", row.RequestedBy.Select(ProfileName))</p> }
                                </div>
                                <div class="catalogue-actions">
                                    @Listen(row.Id, title)
                                    @if (snapshot.CanEdit)
                                    {
                                        <button class="primary catalogue-control" aria-label="Resolve the trimming request for @title" aria-disabled="@Aria(Unavailable)"
                                                @onclick="() => ResolveTrimming(row.Id)">@L["Mark resolved"]</button>
                                    }
                                </div>
                            </article>
                        }
                        break;
                    case "reports":
                        @foreach (var row in reports.Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            <article class="catalogue-row" @key="row.Key" aria-busy="@Aria(row.Replacing)">
                                @Cover(row.Id, title, row.Artist)
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@row.Artist</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@(row.Reason == "bad_quality" ? "Reported for poor audio or a live performance." : "Reported as the wrong recording.")</p>
                                    <p class="catalogue-reason">@ProfileName(row.Profile) @Timestamp(row.Time)</p>
                                    @if (row.Replacing) { <p class="catalogue-progress" role="status">@L["Replacement queued"]</p> }
                                    @if (row.ReplacementError is not null) { <Notice Level="error" Message="@NoticeText.Detail(row.ReplacementError, "Could not prepare the replacement. Choose a recording to try again.")" /> }
                                </div>
                                <div class="catalogue-actions">
                                    @Listen(row.Id, title)
                                    <button id="@RecordingOpener(row.Key, true)" class="primary catalogue-control" aria-label="Choose a recording for @title"
                                            aria-haspopup="dialog" aria-disabled="@Aria(Unavailable || row.Replacing)"
                                            @onclick="() => OpenRecording(row.Key, title, row.Artist, true, row.Replacing)">@L["Choose recording"]</button>
                                    <button class="quiet catalogue-control" aria-label="Resolve the report for @title" aria-disabled="@Aria(Unavailable || row.Replacing)"
                                            @onclick="() => ResolveReport(row)">@L["Mark resolved"]</button>
                                </div>
                            </article>
                        }
                        break;
                    case "fixed":
                        @foreach (var row in FixedRows(snapshot).Take(limit))
                        {
                            var title = DisplayTitle(row.Title);
                            <article class="catalogue-row" @key="(row.IsMetadata, row.Id)">
                                @Cover(row.ListeningId, title, row.Artist)
                                <div class="catalogue-track">
                                    <h3>@title</h3><p class="catalogue-artist">@row.Artist</p>
                                </div>
                                <div class="catalogue-details">
                                    <p class="catalogue-reason">@row.Reason</p>
                                    @Timestamp(row.Time)
                                </div>
                                <div class="catalogue-actions">
                                    @Listen(row.ListeningId, title)
                                    <button class="quiet catalogue-control" aria-label="Undo the fix for @title" aria-disabled="@Aria(Unavailable)"
                                            @onclick="() => Undo(row)">@L["Undo"]</button>
                                </div>
                            </article>
                        }
                        break;
                }
            }
            @if (Count(active) > limit && limit < MaxPageSize)
            {
                <button class="quiet catalogue-control catalogue-more" aria-disabled="@Aria(Unavailable)" @onclick="ShowMore">@L["Show more"]</button>
            }
        </section>
        }
    }
</section>

<dialog id="@RecordingDialog" class="popup-panel metadata-review-dialog" aria-labelledby="recording-review-title" data-return-focus="catalogue-category-title" @onclose="RecordingClosed">
    <div class="dialog-heading">
        <h2 id="recording-review-title">@L["Choose recording"]</h2>
        <button id="recording-review-close" type="button" class="quiet" aria-label="@L["Close recording choice"].Value" @onclick="CloseRecording"><MusicIcon Name="close" /></button>
    </div>
    @if (recordingChoice is { } choice)
    {
        <p>@choice.Title @if (choice.Artist.Length > 0) { <span class="muted">by @choice.Artist</span> }</p>
        @if (YouTubePreview(choice.Candidate) is { } preview)
        {
            <div class="catalogue-recording-suggestion">
                <a class="quiet catalogue-control" href="@preview" target="_blank" rel="noopener noreferrer"
                   aria-label="@L["Preview the suggested recording on YouTube (opens in a new tab)"].Value"><MusicIcon Name="external-link" />@L["Preview suggestion"]</a>
                <button type="button" class="quiet catalogue-control" aria-disabled="@Aria(Unavailable)"
                        @onclick="() => QueueRecording(useSuggestion: true)">@L["Queue suggested recording"]</button>
            </div>
        }
        <form @onsubmit="() => QueueRecording(useSuggestion: false)" @onsubmit:preventDefault aria-busy="@Aria(saving)">
            <a class="quiet catalogue-control" href="@YouTubeSearch(choice.Artist, choice.Title)" target="_blank" rel="noopener noreferrer"
               aria-label="@L["Search for this song on YouTube (opens in a new tab)"].Value"><MusicIcon Name="external-link" />@L["Search YouTube"]</a>
            <label for="recording-review-url">@L["YouTube recording link"]</label>
            <input id="recording-review-url" type="text" inputmode="url" maxlength="2048" @bind="recordingUrl" @bind:event="oninput"
                   readonly="@saving" aria-invalid="@Aria(invalidRecordingUrl)" />
            <Notice Level="error" Message="@recordingError" />
            <button type="submit" class="primary catalogue-control" aria-disabled="@Aria(Unavailable)">@L["Queue replacement"]</button>
        </form>
        <p class="sr" role="status" aria-live="polite">@(saving ? "Queuing replacement." : null)</p>
    }
</dialog>

<dialog id="metadata-review-dialog" class="popup-panel metadata-review-dialog" aria-labelledby="metadata-review-title" data-return-focus="catalogue-category-title">
    <div class="dialog-heading"><h2 id="metadata-review-title">@L["Song metadata"]</h2><button class="quiet" aria-label="@L["Close metadata review"].Value" @onclick="Close"><MusicIcon Name="close" /></button></div>
    @if (editing is { } metadata)
    {
        <p>@metadata.Title</p>
        @if (metadata.Missing.Any(metadata.Suggested.ContainsKey)) { <p class="muted">@L["Check the suggested values before saving."]</p> }
    }
    <form @onsubmit="Save" @onsubmit:preventDefault>
        @if (editing?.Current.ContainsKey("title") == true)
        {
            <label for="metadata-track-title">@L["Title"]</label><input id="metadata-track-title" @bind="trackTitle" maxlength="120" />
        }
        <label for="metadata-artist">@L["Artist"]</label><input id="metadata-artist" @bind="artist" maxlength="120" />
        <label for="metadata-album">@L["Album"]</label><input id="metadata-album" @bind="album" maxlength="120" />
        <label for="metadata-genre">@L["Genre"]</label><input id="metadata-genre" @bind="genre" maxlength="80" />
        @if (editing?.SourceUrl.StartsWith("https://musicbrainz.org/recording/", StringComparison.Ordinal) == true)
        {
            <a href="@editing.SourceUrl" target="_blank" rel="noopener noreferrer"><MusicIcon Name="external-link" />@L["MusicBrainz recording"]</a>
        }
        @if (editError is not null) { <Notice Level="error" Message="@editError" /> }
        <div class="actions"><button type="button" class="quiet" @onclick="Close">@L["Cancel"]</button><button class="primary" aria-disabled="@Aria(Unavailable)">@L["Save"]</button></div>
    </form>
</dialog>

@code {
    [Parameter] public EventCallback<PlaylistReviewGap> OpenPlaylist { get; set; }

    private sealed record Category(string Id, string Label, string Empty, bool AdminOnly = true);
    private sealed record SongReport(string Key, string Id, string Title, string Artist, string Profile, string Reason, long Time,
        bool Replacing = false, [property: System.Text.Json.Serialization.JsonPropertyName("replacement_error")] string? ReplacementError = null);
    private sealed record RecordingChoice(string Key, string Title, string Artist, bool IsReport, SourceQualityCandidate? Candidate);
    private sealed record SongReports(List<SongReport> Reports);
    private sealed record FixedEntry(string Id, string ListeningId, string Title, string Artist, string Reason, long Time, bool IsMetadata);

    private static readonly Category[] Categories =
    [
        new("playlists", "Missing from playlists", "No missing playlist recordings."),
        new("damaged", "Damaged audio", "No damaged audio to review."),
        new("unofficial", "Unofficial uploads", "No unofficial uploads with an official alternative."),
        new("metadata", "Song details", "No song details to review.", false),
        new("trimming", "Trimming", "No trimming requests.", false),
        new("reports", "Song reports", "No open song reports."),
        new("fixed", "Fixed recordings and details", "No recent fixes.")
    ];
    private const int PageSize = 50;
    private const int MaxPageSize = 10000;
    private readonly Dictionary<string, int> limits = new();
    private readonly CancellationTokenSource lifetime = new();
    private CatalogueReviewSnapshot? data;
    private SourceQualitySnapshot quality = new();
    private List<SongReport> reports = [];
    private MetadataRequest? editing;
    private const string RecordingDialog = "recording-review-dialog";
    private RecordingChoice? recordingChoice;
    private string recordingUrl = "";
    private string? recordingError;
    private bool openRecordingAfterRender, invalidRecordingUrl;
    private string trackTitle = "", artist = "", album = "", genre = "";
    private string? active;
    private string? identity, error, editError, announcement, pendingFocus;
    private bool loading, saving, disposed, wasOnline;
    private bool Online => Session.Connected && Session.Api is not null;
    private bool Unavailable => !Online || loading || saving;
    private bool reconnecting;
    private async Task RetryReview()
    {
        if (reconnecting) return;
        reconnecting = true;
        try
        {
            if (!Online) await Session.ReconnectAsync();
            await Refresh();
        }
        finally { reconnecting = false; }
    }
    private string Identity => Session.Server + "\n" + Session.User;

    protected override void OnInitialized() => Session.Changed += Changed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await UpdateConnection();
        if (openRecordingAfterRender && recordingChoice is { } choice)
        {
            openRecordingAfterRender = false;
            await JS.InvokeVoidAsync("familyhub.showDialog", RecordingDialog, "recording-review-close", RecordingOpener(choice.Key, choice.IsReport));
        }
        if (pendingFocus is { } id)
        {
            pendingFocus = null;
            await JS.InvokeVoidAsync("familyhub.focus", id);
        }
    }

    private void Changed()
    {
        if (!disposed) _ = InvokeAsync(UpdateConnection);
    }

    private async Task UpdateConnection()
    {
        if (disposed) return;
        var currentIdentity = Identity;
        var changed = identity != currentIdentity;
        var reconnected = Online && !wasOnline;
        wasOnline = Online;
        if (changed)
        {
            identity = currentIdentity;
            if (data is not null)
                await JS.InvokeVoidAsync("familyhub.focusIfWithin", ".srv-review-overview, #catalogue-back, #catalogue-category-panel", "catalogue-review-title");
            data = null;
            quality = new();
            reports = [];
            limits.Clear();
            workView = "choice";
            active = null;
            error = announcement = null;
            if (editing is not null) await Close();
            if (recordingChoice is not null) await CloseRecording("catalogue-review-title");
        }
        if ((changed || reconnected) && Online && !loading && !saving) await Refresh();
        else StateHasChanged();
    }

    private int snapshotRetries;
    private DateTimeOffset snapshotAt;
    private string workView = "choice";
    private IEnumerable<Category> VisibleCategories(CatalogueReviewSnapshot snapshot) =>
        Categories.Where(c => (snapshot.CanEdit || !c.AdminOnly) && c.Id != "fixed" && (workView != "queue" || (c.Id != "reports" && c.Id != "trimming")));
    private void SelectCategory(Category category)
    {
        if (loading || saving) return;
        active = category.Id;
        pendingFocus = "catalogue-category-title";
    }

    private void BackToCategoryList()
    {
        if (loading || saving) return;
        pendingFocus = active == "fixed" ? "catalogue-view-fixed" : "catalogue-filter-" + active;
        active = null;
    }

    private async Task ChangeWorkView(string view)
    {
        if (Unavailable || view == workView) return;
        await RefreshForView(view);
    }
    private bool followingUp;
    private bool SnapshotStale => data?.SnapshotAgeSeconds > 1;
    private void QueueSnapshotRefresh()
    {
        if (disposed) return;
        if (!SnapshotStale) return;
        if (snapshotRetries >= 3) return;
        snapshotRetries++;
        _ = Task.Delay(TimeSpan.FromSeconds(2.5), lifetime.Token).ContinueWith(
            async t => { if (!t.IsCanceled && !disposed) await InvokeAsync(() => { followingUp = true; return Refresh(); }); },
            TaskScheduler.Default);
    }

    public Task Refresh() => RefreshForView(workView);

    private async Task RefreshForView(string requestedView)
    {
        if (Unavailable || disposed || Session.Api is not { } api) return;
        if (!followingUp) snapshotRetries = 0;
        followingUp = false;
        loading = true;
        var requestIdentity = Identity;
        StateHasChanged();
        try
        {
            using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            request.CancelAfter(TimeSpan.FromSeconds(5));
            var limit = Math.Max(Limit("playlists"), Math.Max(Limit("metadata"), Limit("trimming")));
            var result = await api.RequestJsonAsync<CatalogueReviewSnapshot>(HttpMethod.Get,
                $"/api/catalogue/review?limit={limit}&work={(requestedView == "queue" ? "queue" : "choice")}", cancellationToken: request.Token).WaitAsync(request.Token);
            var newQuality = new SourceQualitySnapshot();
            List<SongReport> newReports = [];
            if (result.CanEdit)
            {
                var qualityTask = api.RequestJsonAsync<SourceQualitySnapshot>(HttpMethod.Get, "/api/catalogue/source-quality", cancellationToken: request.Token);
                var reportTask = api.RequestJsonAsync<SongReports>(HttpMethod.Get, "/api/catalogue/reports", cancellationToken: request.Token);
                await Task.WhenAll(qualityTask, reportTask).WaitAsync(request.Token);
                newQuality = await qualityTask;
                newReports = (await reportTask).Reports;
            }
            if (disposed || Identity != requestIdentity) return;
            if (data?.CanEdit == true && !result.CanEdit)
            {
                if (editing is not null)
                {
                    editing = null;
                    await JS.InvokeVoidAsync("familyhub.closeDialog", "metadata-review-dialog", "catalogue-review-title");
                }
                await JS.InvokeVoidAsync("familyhub.focusIfWithin", "#catalogue-view-fixed, #catalogue-category-panel, #catalogue-filter-playlists, #catalogue-filter-damaged, #catalogue-filter-unofficial, #catalogue-filter-reports", "catalogue-review-title");
                if (recordingChoice is not null) await CloseRecording("catalogue-review-title");
            }
            data = result;
            error = null;
            snapshotAt = DateTimeOffset.UtcNow.AddSeconds(-Math.Max(0, result.SnapshotAgeSeconds));
            quality = newQuality;
            reports = newReports;
            if (workView != requestedView)
                pendingFocus = requestedView == "queue" ? "review-action-heading" : "catalogue-view-queue";
            workView = requestedView;
            if (!result.CanEdit && Categories.Any(c => c.Id == active && c.AdminOnly)) active = null;
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception) { if (Identity == requestIdentity) error = "Could not load song review."; }
        finally
        {
            loading = false;
            if (!disposed)
            {
                if (Identity != requestIdentity && data is null && Online) await Refresh();
                else { StateHasChanged(); QueueSnapshotRefresh(); }
            }
        }
    }

    private static string Aria(bool value) => value ? "true" : "false";
    private int Limit(string category) => limits.GetValueOrDefault(category, PageSize);
    private int Count(string category) => category switch
    {
        "playlists" => data?.PlaylistGapsTotal ?? 0,
        "metadata" => data?.MetadataTotal ?? 0,
        "trimming" => data?.TrimmingTotal ?? 0,
        "reports" => reports.Count,
        "fixed" => quality.Fixed.Count + (data?.MetadataFixed.Count ?? 0),
        _ => QualityRows(category).Count()
    };
    private IEnumerable<SourceQualitySong> QualityRows(string category) =>
        quality.Songs.Where(r => (r.Verdict == "suspect") == (category == "damaged")
            && (r.RetryAt > 0 || r.Replacing || r.Queued) == (workView == "queue"));
    private IEnumerable<FixedEntry> FixedRows(CatalogueReviewSnapshot snapshot) =>
        quality.Fixed.Select(r => new FixedEntry(r.Id, r.ReplacedBy, r.Title, r.Artist, "Recording replaced.", r.FixedAt, false))
            .Concat(snapshot.MetadataFixed.Select(r => new FixedEntry(r.Id, r.Id, r.Title, r.Artist,
                "Updated " + string.Join(", ", r.Fields) + ".", r.FixedAt, true)))
            .OrderByDescending(r => r.Time);
    private static string GapReason(string state) => state switch
    {
        "review" => "Recording choice needed",
        "ready" => "Matched and waiting to download",
        "queued" => "Download queued",
        "running" => "Preparing recording",
        "preparing" => "Preparing audio",
        "error" => "Recording preparation failed",
        _ => "Waiting for a match"
    };
    private async Task ShowMore()
    {
        if (Unavailable || active is not { } category) return;
        var previous = Limit(category);
        limits[category] = Math.Min(MaxPageSize, previous + PageSize);
        if (category is "playlists" or "metadata" or "trimming")
        {
            await Refresh();
            if (error is not null) { limits[category] = previous; return; }
        }
        if (active == category && (Count(category) <= Limit(category) || Limit(category) == MaxPageSize))
            pendingFocus = "catalogue-category-title";
        announcement = $"{Math.Clamp(Count(category) - previous, 0, PageSize)} more songs shown.";
    }

    private MusicTrack ReviewTrack(string id, string title, string artist) =>
        Session.Library.FirstOrDefault(t => t.Id == id) ?? new MusicTrack { Id = id, Title = title, Channel = artist };
    private RenderFragment Cover(string id, string title, string artist) => @<span class="song-artwork"><TrackCover Track="@ReviewTrack(id, title, artist)" /></span>;
    private RenderFragment Listen(string id, string title) => @<text>
        @if (Session.Library.Any(t => t.Id == id && t.Saved))
        {
            <button class="quiet catalogue-control" aria-label="Listen to @title in FamilyHub" aria-disabled="@Aria(Player.FollowingHost)" @onclick="() => Play(id)">
                <MusicIcon Name="play" />@L["Listen"]
            </button>
        }
    </text>;
    private static string DisplayTitle(string title)
    {
        var clean = Regex.Replace(title, @"(?:\s*[\[(]\s*(?:official (?:music )?(?:audio|video)|lyrics?|lyric video|hd|hq|4k)\s*[\])])+\s*$", "", RegexOptions.IgnoreCase);
        return clean.Length > 0 ? clean : title;
    }
    private static string? YouTubePreview(SourceQualityCandidate? candidate) =>
        candidate is not null && Regex.IsMatch(candidate.Id, "^[A-Za-z0-9_-]{11}$") ? "https://www.youtube.com/watch?v=" + candidate.Id : null;
    private static string YouTubeSearch(string artist, string title) =>
        "https://www.youtube.com/results?search_query=" + Uri.EscapeDataString(artist + " " + title + " official audio");
    private string ProfileName(string id) => Session.Profiles.FirstOrDefault(p => p.Id == id)?.Name ?? id;
    private static string Time(double seconds) => $"{(int)seconds / 60}:{(int)seconds % 60:00}";
    private static string MetadataIssue(MetadataRequest row)
    {
        var fields = row.Missing.Where(field => field != "title").ToList();
        var missing = fields.Count > 0 ? "Missing " + string.Join(", ", fields) : "";
        return row.Missing.Contains("title") ? fields.Count > 0 ? "Verify title. " + missing : "Verify title." : missing;
    }
    private static RenderFragment Timestamp(double seconds) => @<text>
        @if (seconds > 0 && seconds <= 253402300799)
        {
            var time = DateTimeOffset.FromUnixTimeSeconds((long)seconds);
            <time class="catalogue-timestamp" datetime="@time.ToString("O")">@time.ToLocalTime().ToString("g")</time>
        }
    </text>;
    private static RenderFragment Retry(double at, string reason) => @<text>
        @if (at > 0)
        {
            <p class="catalogue-reason">@(reason.Length > 0 ? reason + ". " : "")Retry after @Timestamp(at)</p>
        }
        else if (reason.Length > 0) { <p class="catalogue-reason">@(reason + ".")</p> }
    </text>;

    private async Task Play(string id)
    {
        var requestedAt = MusicPlayer.PlaybackTimestamp();
        if (Player.FollowingHost || Session.Library.FirstOrDefault(t => t.Id == id && t.Saved) is not { } track) return;
        try { await Player.PlayAsync(track, requestedAt: requestedAt); }
        catch (Exception) { error = "Could not play this recording. Try listening again."; }
    }

    private Task KeepRecording(SourceQualitySong row) => row.Replacing ? Task.CompletedTask :
        Write(HttpMethod.Post, "/api/catalogue/source-quality/" + Uri.EscapeDataString(row.Id) + "/dismiss", new { }, "Recording kept.");
    private Task ReplaceAll(string category) =>
        Mutate(async api =>
        {
            var result = await api.RequestJsonAsync<JsonElement>(HttpMethod.Post, "/api/catalogue/source-quality/replace-all",
                new { group = category }, lifetime.Token);
            return $"{result.GetProperty("queued").GetInt32()} replacements queued.";
        });
    private Task ResolveTrimming(string id) =>
        Write(HttpMethod.Post, $"/api/catalogue/trimming/{id}/resolve", new { }, "Trimming request resolved.");
    private Task ResolveReport(SongReport row) => row.Replacing ? Task.CompletedTask :
        Write(HttpMethod.Post, "/api/catalogue/reports/resolve", new { key = row.Key }, "Song report resolved.");
    private Task ResolveAll(string category, IEnumerable<string> visibleIds) =>
        Mutate(async api =>
        {
            var resolved = 0;
            foreach (var ids in visibleIds.Chunk(100))
            {
                var result = await api.RequestJsonAsync<JsonElement>(HttpMethod.Post, $"/api/catalogue/{category}/resolve-all", new { ids }, lifetime.Token);
                resolved += result.GetProperty("resolved").GetInt32();
            }
            return $"{resolved} items marked resolved.";
        });
    private Task Undo(FixedEntry row) =>
        Write(HttpMethod.Post, $"/api/catalogue/{(row.IsMetadata ? "metadata" : "source-quality")}/{row.Id}/undo", new { },
            row.IsMetadata ? "Automatic details removed." : "Original recording restored.", reloadLibrary: true);

    private Task Write(HttpMethod method, string path, object body, string success, bool reloadLibrary = false) =>
        Mutate(async api =>
        {
            await api.RequestJsonAsync<JsonElement>(method, path, body, lifetime.Token);
            return success;
        }, reloadLibrary);

    private async Task Mutate(Func<FamilyHubApi, Task<string>> change, bool reloadLibrary = false)
    {
        if (Unavailable || disposed || Session.Api is not { } api) return;
        var requestIdentity = Identity;
        var category = active;
        saving = true;
        error = null;
        string? failureMessage = null;
        try
        {
            var result = await change(api);
            if (disposed || Identity != requestIdentity) return;
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", result);
            if (active == category) pendingFocus = "catalogue-category-title";
            if (reloadLibrary) await Session.RefreshAsync(background: true);
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception failure)
        {
            failureMessage = SafeError(failure, "Could not update song review. Refresh and try again.");
        }
        finally
        {
            saving = false;
            if (!disposed) await Refresh();
            if (!disposed && Identity == requestIdentity && failureMessage is not null) error = failureMessage;
        }
    }

    private static string RecordingOpener(string key, bool isReport) => (isReport ? "report-recording-" : "quality-recording-") + key;

    private void OpenRecording(string key, string title, string artist, bool isReport, bool replacing, SourceQualityCandidate? candidate = null)
    {
        if (Unavailable || replacing || data?.CanEdit != true) return;
        recordingChoice = new(key, title, artist, isReport, candidate);
        recordingUrl = "";
        recordingError = null;
        invalidRecordingUrl = false;
        openRecordingAfterRender = true;
    }

    private Task CloseRecording() => CloseRecording(saving ? "catalogue-category-title" : null);

    private void RecordingClosed()
    {
        if (recordingChoice is not null && saving) pendingFocus = "catalogue-category-title";
        recordingChoice = null;
    }

    private async Task CloseRecording(string? successor)
    {
        recordingChoice = null;
        openRecordingAfterRender = false;
        await JS.InvokeVoidAsync("familyhub.closeDialog", RecordingDialog, successor);
    }

    private async Task QueueRecording(bool useSuggestion)
    {
        if (Unavailable || data?.CanEdit != true || recordingChoice is not { } choice || Session.Api is not { } api) return;
        var url = recordingUrl.Trim();
        if (useSuggestion ? choice.Candidate is null : url.Length == 0)
        {
            recordingError = "Enter a YouTube recording link.";
            invalidRecordingUrl = !useSuggestion;
            if (invalidRecordingUrl) await JS.InvokeVoidAsync("familyhub.focus", "recording-review-url");
            return;
        }

        var requestIdentity = Identity;
        saving = true;
        recordingError = null;
        invalidRecordingUrl = false;
        var queued = false;
        try
        {
            var path = choice.IsReport ? "/api/catalogue/reports/replace" : $"/api/catalogue/source-quality/{Uri.EscapeDataString(choice.Key)}/replace";
            object body = choice.IsReport ? new { key = choice.Key, url } :
                useSuggestion ? new { candidate_id = choice.Candidate!.Id } : new { url };
            await api.RequestJsonAsync<JsonElement>(HttpMethod.Post, path, body, lifetime.Token);
            if (disposed || Identity != requestIdentity) return;
            queued = true;
            if (choice.IsReport)
                reports = reports.Select(row => row.Key == choice.Key ? row with { Replacing = true, ReplacementError = null } : row).ToList();
            else
                quality = quality with { Songs = quality.Songs.Select(row => row.Id == choice.Key ? row with { Replacing = true, Queued = true, Error = null } : row).ToList() };
            if (recordingChoice == choice) await CloseRecording("catalogue-category-title");
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", "Replacement queued.");
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception failure)
        {
            if (disposed || Identity != requestIdentity) return;
            var message = SafeError(failure, "Could not queue the replacement. Try again.");
            if (recordingChoice == choice) recordingError = message;
            else error = message;
        }
        finally
        {
            saving = false;
            if (!disposed && (queued || Identity != requestIdentity)) await Refresh();
        }
    }

    private async Task Open(MetadataRequest row)
    {
        if (Unavailable) return;
        editing = row;
        editError = null;
        trackTitle = row.Draft("title");
        artist = Draft(row, "artist");
        album = Draft(row, "album");
        genre = Draft(row, "genre");
        StateHasChanged();
        await JS.InvokeVoidAsync("familyhub.showDialog", "metadata-review-dialog",
            row.Missing.Contains("title") ? "metadata-track-title" : "metadata-artist");
    }
    private static string Draft(MetadataRequest row, string field) =>
        row.Missing.Contains(field) ? row.Suggested.GetValueOrDefault(field, "") : row.Draft(field);
    private async Task Close()
    {
        var successor = editing is { } row && data?.Metadata.Any(r => r.Id == row.Id) == true ? "metadata-" + row.Id : "catalogue-review-title";
        editing = null;
        await JS.InvokeVoidAsync("familyhub.closeDialog", "metadata-review-dialog", successor);
    }
    private async Task Save()
    {
        if (Unavailable || editing is not { } row || Session.Api is not { } api) return;
        var values = new Dictionary<string, string> { ["title"] = trackTitle.Trim(), ["artist"] = artist.Trim(), ["album"] = album.Trim(), ["genre"] = genre.Trim() }
            .Where(p => p.Value.Length > 0 && (p.Value != row.Current.GetValueOrDefault(p.Key)
                || p.Key == "title" && row.Missing.Contains("title"))).ToDictionary(p => p.Key, p => p.Value);
        if (values.Count == 0) { editError = "Enter or change a song detail before saving."; return; }

        saving = true;
        editError = null;
        var requestIdentity = Identity;
        var saved = false;
        try
        {
            await api.RequestJsonAsync<JsonElement>(HttpMethod.Patch, "/api/catalogue/metadata/" + row.Id, new { revision = row.Revision, values }, lifetime.Token);
            if (disposed || Identity != requestIdentity) return;
            await JS.InvokeVoidAsync("familyhub.closeDialog", "metadata-review-dialog", "catalogue-category-title");
            editing = null;
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", "Song details saved.");
            saved = true;
            await Session.RefreshAsync(background: true);
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception failure)
        {
            if (Identity == requestIdentity)
                editError = failure is FamilyHubApiException { StatusCode: 409 }
                    ? "These details changed. Close the editor, refresh song review, and open the song again."
                    : SafeError(failure, "Could not save song details. Try again.");
        }
        finally
        {
            saving = false;
            if (!disposed && (saved || Identity != requestIdentity)) await Refresh();
        }
    }

    private static string SafeError(Exception failure, string fallback) =>
        NoticeText.Error(failure, fallback);

    public void Dispose()
    {
        disposed = true;
        Session.Changed -= Changed;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
