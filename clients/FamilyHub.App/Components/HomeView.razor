@implements IDisposable
@inject MusicSession Session
@inject IJSRuntime JS

<div class="home-view">
    <DiscoveryShelf PlayTracks="PlayTracks" />
    <h1 id="view-title" class="sr" tabindex="-1">Home</h1>

    <section class="home-section home-radio" aria-labelledby="home-radio-title">
        <h2 id="home-radio-title" tabindex="-1">Radio</h2>
        @if (radioSeeds.Count > 0)
        {
            <div class="home-shortcuts">
                @foreach (var seed in radioSeeds)
                {
                    <button id="@RadioId(seed.Key)" @key="seed.Key" class="home-shortcut"
                            @onclick="() => StartShortcut(seed.Key, seed.Tracks)"
                            aria-disabled="@(!Session.Connected || RadioBusy || FollowingHost ? "true" : "false")" aria-label="Play @seed.Label">
                        <TrackCover Track="seed.Tracks[0]" />
                        <span class="radio-shortcut-title"><MusicIcon Name="radio" /><span>@seed.Label</span></span>
                    </button>
                }
            </div>
            <Notice Level="warning" Message="@(Session.Connected && FollowingHost ? "Leave the listening session to start radio." : "")" />
        }
        else if (Session.Connected && !loadingRadio && !radioFailed)
        {
            <p class="note">Add songs to your library to start a mix.</p>
        }
        @if (Session.Connected)
        {
            <div role="status" class="sr">@(loadingRadio ? "Loading radio shortcuts…" : null)</div>
            <Notice Id="home-radio-status" Level="error" Message="@(radioFailed ? "Radio shortcuts could not load." : null)"
                    ActionLabel="Retry radio shortcuts" Action="LoadRadio" Busy="loadingRadio" FocusTarget="#home-radio-title" />
        }
    </section>

    @if (recent.Count > 0)
    {
        <section class="home-section" aria-labelledby="home-recent-title">
            <h2 id="home-recent-title" class="sr">Recently played</h2>
            <div class="home-shortcuts">
                @foreach (var (track, index) in recent.Select((t, i) => (t, i)))
                {
                    <button class="home-shortcut" @key="track.Id" @onclick="() => PlayTracks.InvokeAsync((recent.Skip(index), MusicPlayer.PlaybackTimestamp()))" aria-label="Play @track.Title"><TrackCover Track="track" /><span>@track.DisplayTitle</span></button>
                }
            </div>
        </section>
    }

    @if (Session.Playlists.Count > 0)
    {
        <section class="home-section home-collection" aria-labelledby="home-playlists-title">
            <div class="home-section-heading"><h2 id="home-playlists-title">Your playlists</h2></div>
            <ShelfArrows Target="home-playlists-shelf" Label="your playlists"><div class="home-shelf" id="home-playlists-shelf">
                @foreach (var playlist in Session.Playlists.Take(10))
                {
                    <button class="home-card" @key="playlist.OwnerId + ':' + playlist.Id" @onclick="() => OpenPlaylist.InvokeAsync(playlist)"><PlaylistCover Playlist="playlist" /><strong>@playlist.Name</strong><PlaylistAttribution Playlist="playlist" /><span>@playlist.Tracks.Count @(playlist.Tracks.Count == 1 ? "song" : "songs")</span></button>
                }
            </div></ShelfArrows>
        </section>
    }

    @if (albums.Count > 0)
    {
        <section class="home-section home-collection" aria-labelledby="home-albums-title">
            <div class="home-section-heading"><h2 id="home-albums-title">Albums for you</h2></div>
            <ShelfArrows Target="home-albums-shelf" Label="albums"><div class="home-shelf" id="home-albums-shelf">
                @foreach (var album in albums)
                {
                    var busy = saving == album.Key; var saved = !busy && HasPlaylist(album);
                    var opener = "home-album-" + album.Tracks[0].Id;
                    <div class="home-card-holder" @key="album.Key">
                        <button id="@opener" class="home-card" @onclick="() => OpenAlbum.InvokeAsync((album.Name, album.Artist, album.Tracks, opener))" aria-label="Open @album.Name by @album.Artist"><TrackCover Track="album.Tracks[0]" /><strong>@album.Name</strong><span>@album.Artist</span></button>
                        <button class="home-card-save @(saved ? "is-saved" : "")" @onclick="() => SaveAlbum(album)" aria-disabled="@(saved || busy || saving is not null || !Session.Connected ? "true" : "false")"
                                aria-busy="@(busy ? "true" : "false")" aria-label="@(saved ? $"Library songs from {album.Name} saved as a playlist" : $"Save library songs from {album.Name} as a playlist")" title="@(saved ? "Library songs saved as a playlist" : "Save library songs as a playlist")"><MusicIcon Name="@(saved ? "check" : "plus")" /></button>
                    </div>
                }
            </div></ShelfArrows>
            @if (saveMessage is not null) { <Notice Level="@(saving is null ? "error" : "info")" Message="@saveMessage" /> }
        </section>
    }

</div>

@code {
    [Parameter] public EventCallback<MusicPlaylist> OpenPlaylist { get; set; }
    [Parameter] public EventCallback<(string Name, string Artist, List<MusicTrack> Tracks, string Opener)> OpenAlbum { get; set; }
    [Parameter] public EventCallback<(IEnumerable<MusicTrack> Tracks, long RequestedAt)> PlayTracks { get; set; }
    [Parameter] public EventCallback<(MusicTrack Track, bool ArtistOnly)> StartRadio { get; set; }
    [Parameter] public EventCallback<List<MusicTrack>> PlayMix { get; set; }
    [Parameter] public MusicTrack? CurrentTrack { get; set; }
    [Parameter] public bool RadioBusy { get; set; }
    [Parameter] public bool FollowingHost { get; set; }

    private sealed record Album(string Key, string Name, string Artist, List<MusicTrack> Tracks);
    private List<MusicTrack> recent = [];
    private List<Album> albums = [];
    private readonly List<(string Key, string Label, List<MusicTrack> Tracks)> radioSeeds = [];
    private List<string> renderedRadioKeys = [];
    private long builtHistoryRevision = -1;
    private (string Server, string User, long History, int LibraryCount)? radioSource;
    private List<HomeRadioShortcut> shortcuts = [];
    private CancellationTokenSource? radioLookup;
    private bool loadingRadio, radioFailed;
    private static string RadioId(string key) => "home-radio-" + Uri.EscapeDataString(key);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var keys = radioSeeds.Select(seed => seed.Key).ToList();
        foreach (var key in renderedRadioKeys.Except(keys))
            await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.restoreFocus", RadioId(key), keys.Count > 0 ? RadioId(keys[0]) : "home-radio-title");
        renderedRadioKeys = keys;
    }

    private Task StartShortcut(string key, List<MusicTrack> tracks) => !Session.Connected || RadioBusy || FollowingHost
        ? Task.CompletedTask : key == "song" || key.StartsWith("artist:", StringComparison.Ordinal)
            ? StartRadio.InvokeAsync((tracks[0], key != "song")) : PlayMix.InvokeAsync(tracks);

    private async Task LoadRadio()
    {
        if (!Session.Connected) return;
        radioLookup?.Cancel(); radioLookup?.Dispose();
        radioLookup = new();
        var token = radioLookup.Token;
        loadingRadio = true;
        try
        {
            var result = await Session.HomeRadioAsync(token);
            if (!token.IsCancellationRequested)
            {
                if (radioFailed) await JS.InvokeVoidAsync("familyhub.focusIfWithin", "#home-radio-status .fh-notice-action", "home-radio-title");
                if (token.IsCancellationRequested) return;
                shortcuts = result ?? [];
                radioFailed = false;
            }
        }
        catch (Exception) { if (!token.IsCancellationRequested) radioFailed = true; }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                loadingRadio = false;
                BuildRadio();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void BuildRadio()
    {
        radioSeeds.Clear();
        if (CurrentTrack is { } current && Similarity.Artist(current).Length > 0)
            radioSeeds.Add(("song", Similarity.RadioTitle(current) + " Radio", [current]));
        foreach (var shortcut in shortcuts.Take(7))
        {
            if (radioSeeds.Any(seed => seed.Key == shortcut.Key || seed.Label.Equals(shortcut.Label, StringComparison.OrdinalIgnoreCase))) continue;
            var tracks = shortcut.TrackIds.Select(id => Session.CurrentRecording(new MusicTrack { Id = id }))
                .Where(t => t.Saved).ToList();
            if (tracks.Count > 0) radioSeeds.Add((shortcut.Key, shortcut.Label, tracks));
        }
    }


    private string? saving, saveMessage;
    private readonly Dictionary<(string Server, string Owner, string Album), string> albumDrafts = [];
    private bool HasPlaylist(Album album) => Session.Playlists.Any(p => p.OwnerId == Session.User && p.Name == album.Name &&
        p.Tracks.Select(t => t.RecordingId).SequenceEqual(album.Tracks.Select(t => t.Id)));
    private async Task SaveAlbum(Album album)
    {
        if (saving is not null || HasPlaylist(album) || !Session.Connected) return;
        saving = album.Key; saveMessage = "Saving " + album.Name + "...";
        try
        {
            var key = (Server: Session.Server, Owner: Session.User, Album: album.Key);
            var playlist = Session.Playlists.FirstOrDefault(p => p.OwnerId == key.Owner && p.Id == albumDrafts.GetValueOrDefault(key))
                ?? await Session.CreatePlaylistAsync(album.Name);
            albumDrafts[key] = playlist.Id;
            foreach (var track in album.Tracks)
            {
                if (Session.Server != key.Server || Session.User != key.Owner) return;
                var current = Session.Playlists.First(p => p.Id == playlist.Id && p.OwnerId == playlist.OwnerId);
                if (!current.Tracks.Any(t => t.RecordingId == track.Id))
                    await Session.EditPlaylistAsync(current, new { add_source_id = track.Id });
            }
            albumDrafts.Remove(key);
            saveMessage = null;
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", $"Saved {album.Name} as a playlist.");
        }
        catch (Exception error) when (error is not OperationCanceledException) { saveMessage = "The album could not finish saving. Try again."; }
        finally { saving = null; }
    }

    private object? builtFrom;
    private bool builtConnected;

    // The library often arrives after Home first renders; rebuild the shelves when it does.
    protected override void OnInitialized() => Session.Changed += LibraryChanged;
    private void LibraryChanged() => _ = InvokeAsync(() =>
    {
        if (ReferenceEquals(builtFrom, Session.Connected ? Session.Library : Session.Downloads)
            && builtConnected == Session.Connected && builtHistoryRevision == Session.HistoryRevision) return;
        OnParametersSet(); StateHasChanged();
    });
    public void Dispose()
    {
        Session.Changed -= LibraryChanged;
        radioLookup?.Cancel(); radioLookup?.Dispose();
    }

    protected override void OnParametersSet()
    {
        builtHistoryRevision = Session.HistoryRevision;
        recent = Session.RecentlyPlayed(6);
        if (!Session.Connected)
        {
            radioLookup?.Cancel();
            radioSource = null; shortcuts = []; radioFailed = loadingRadio = false;
        }
        else if (radioSource != (Session.Server, Session.User, builtHistoryRevision, Session.Library.Count))
        {
            if (radioSource is not { } last || last.Server != Session.Server || last.User != Session.User)
            { shortcuts = []; radioFailed = false; }
            radioSource = (Session.Server, Session.User, builtHistoryRevision, Session.Library.Count);
            _ = LoadRadio();
        }
        BuildRadio();
        // Grouping the whole library is costly on phones; redo it only when the library changes.
        var source0 = Session.Connected ? Session.Library : Session.Downloads;
        if (ReferenceEquals(builtFrom, source0) && builtConnected == Session.Connected) return;
        builtFrom = source0; builtConnected = Session.Connected;
        var played = Session.RecentlyPlayed(200).Select(t => t.Id).ToHashSet();
        var source = Session.Connected ? Session.Library : Session.Downloads;
        // Albums with recent plays come first, then the fullest albums.
        albums = source.Where(t => t.LibraryAlbum is { Length: > 0 } name && name is not ("Selected recordings" or "Unknown album"))
            .GroupBy(t => (t.LibraryAlbum, t.Channel))
            .Where(g => g.Count() >= 2)
            // Uploaded albums come right after played ones, so a family member's new uploads show up.
            .OrderByDescending(g => g.Count(t => played.Contains(t.Id))).ThenByDescending(g => g.Any(t => t.Id.StartsWith("local-", StringComparison.Ordinal))).ThenByDescending(g => g.Count())
            .Take(10)
            .Select(g => new Album(g.Key.LibraryAlbum + "\n" + g.Key.Channel, g.Key.LibraryAlbum, g.Key.Channel, g.DistinctBy(t => t.Id).ToList()))
            .ToList();
    }
}
