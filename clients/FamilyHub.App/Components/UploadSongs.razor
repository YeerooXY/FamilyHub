@implements IDisposable
@inject MusicSession Session
@inject IJSRuntime JS

@using System.Text.Json

<div class="create-files">
    <label class="create-file-choice" aria-disabled="@Aria(Disabled || Busy)">
        <MusicIcon Name="music" /><strong>Choose songs</strong><small>One song or several</small>
        <InputFile @key="fileInputGeneration" id="@(Prefix + "-audio-file")" OnChange="Choose"
                   accept="audio/*,.mp3,.flac,.m4a,.opus,.ogg,.oga,.wav,.aac,.webm,.mka,.wv,.aiff,.aif"
                   multiple disabled="@(Disabled || Busy)" aria-label="Choose songs" />
    </label>
    @if (OperatingSystem.IsWindows() || OperatingSystem.IsAndroid())
    {
        <button id="@(Prefix + "-folder")" type="button" class="create-file-choice" @onclick="ChooseFolder"
                aria-disabled="@Aria(Disabled || Busy)"><MusicIcon Name="folder" /><strong>Choose a folder</strong><small>Includes its subfolders</small></button>
    }
    else
    {
        <label class="create-file-choice" aria-disabled="@Aria(Disabled || Busy)">
            <MusicIcon Name="folder" /><strong>Choose a folder</strong><small>Includes its subfolders</small>
            <InputFile @key="fileInputGeneration" id="@(Prefix + "-folder")" OnChange="Choose"
                       webkitdirectory="" directory="" multiple disabled="@(Disabled || Busy)" aria-label="Choose a folder" />
        </label>
    }
</div>
    <p class="upload-limits">Up to 500 songs at a time. 128 MB per song.</p>
    @if (picking) { <p role="status">Reading folder...</p> }
    @if (files.Count > 0) {
        <section class="upload-selection" aria-labelledby="@(Prefix + "-selection-title")"><div><strong id="@(Prefix + "-selection-title")">@files.Count @(files.Count == 1 ? "song" : "songs")</strong><span>@((files.Sum(f => f.Size) / 1048576d).ToString("0.0")) MB</span></div>
        <ul>@foreach (var song in files.Take(6)) { <li><MusicIcon Name="music" /><span>@song.Name</span>@if (completed.Contains(song)) { <MusicIcon Name="check-circle" /> }</li> }</ul>
        @if (files.Count > 6) { <small>and @(files.Count - 6) more</small> }
        </section>
    }
    @if (selectionNote is not null) { <p class="upload-guidance" role="status">@selectionNote</p> }
    @if (problems.Count > 0 || otherFiles > 0)
    {
        <section class="upload-problems" aria-labelledby="@(Prefix + "-problems-title")">
            <strong id="@(Prefix + "-problems-title")">@(problems.Count == 1 ? "1 file wasn't added" : $"{problems.Count} files weren't added")</strong>
            <ul>@foreach (var problem in problems.Take(40)) { <li><MusicIcon Name="music" /><span><span class="upload-problem-name">@problem.Name</span><small>@problem.Reason</small></span></li> }</ul>
            @if (problems.Count > 40) { <small>and @(problems.Count - 40) more</small> }
            @if (otherFiles > 0) { <small class="upload-problem-other">@(otherFiles == 1 ? "1 other file isn't audio" : $"{otherFiles} other files aren't audio") (@string.Join(", ", otherTypes)), so @(otherFiles == 1 ? "it was" : "they were") left out.</small> }
        </section>
    }
    @if (working || completed.Count > 0) { <div class="upload-status" role="status"><div><strong>@status</strong><span>@completed.Count / @files.Count saved</span></div>@if (currentName is not null) { <small>@currentName</small> }@if (uploading) { <progress aria-label="Uploading song" max="100" value="@percent"></progress> } else if (working) { <progress aria-label="Preparing song on server"></progress> }</div> }
    @if (error is not null) { <p class="entry-error" role="status">@error</p> }
@if (working)
{
    <button id="@(Prefix + "-stop")" type="button" class="quiet upload-stop" @onclick="() => stopping = true"
            aria-disabled="@Aria(stopping)">@(stopping ? "Stopping after this song..." : "Stop after this song")</button>
}

@code {
    [Parameter, EditorRequired] public string Prefix { get; set; } = "";
    [Parameter, EditorRequired] public string SubmitId { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<LibraryAddition> JobChanged { get; set; }
    public int SelectedCount => files.Count;
    public bool Busy => working || picking;
    public bool Finished => files.Count > 0 && Remaining == 0 && !working;
    public string? CreatedPlaylistKey { get; private set; }
    public string FolderName { get; private set; } = "";
    private static string Aria(bool value) => value ? "true" : "false";

    public Task UploadInto(string name, bool shared) => Upload(null, name.Trim(), shared);
    public Task UploadTo(MusicPlaylist? playlist) => Upload(playlist, null, true);
    public void Clear() { if (!Busy) { ResetSelection(); CreatedPlaylistKey = null; fileInputGeneration++; } }

    private List<LocalAudioFile> files = [];
    private readonly HashSet<LocalAudioFile> completed = [];
    private readonly Dictionary<LocalAudioFile,string> acceptedJobs = [];
    private string sourceIdentity = "";
    private bool selectionInvalidated;
    private int fileInputGeneration;
    private string status = "";
    private string? error, selectionNote, currentName, pendingFocus;
    // Files left out of this upload, each with a reason someone can act on.
    private readonly List<(string Name, string Reason)> problems = [];
    private int otherFiles;
    private List<string> otherTypes = [];
    private static string SkipText(string reason) => reason switch { "empty" => "The file is empty.", "too-large" => "Larger than 128 MB, the limit for one song.", _ => "Not an audio format the app can upload." };
    private void AddSkips(IEnumerable<LocalAudioSkip> skips)
    {
        var list = skips.ToList();
        // Pictures, playlists and text files in music folders are expected; count them on one line.
        var other = list.Where(s => s.Reason == "not-audio").ToList();
        otherFiles = other.Count;
        otherTypes = other.Select(s => Path.GetExtension(s.Name).ToLowerInvariant()).Where(e => e.Length > 0).Distinct().Take(5).ToList();
        foreach (var skip in list.Where(s => s.Reason != "not-audio")) problems.Add((skip.Name, SkipText(skip.Reason)));
    }
    private bool working, uploading, picking, stopping, disposed;
    private int percent;
    private int Remaining => files.Count - completed.Count;
    private readonly CancellationTokenSource lifetime = new();
    private string Identity => Session.Server + "\n" + Session.User;
    protected override void OnInitialized() { sourceIdentity = Identity; Session.Changed += SessionChanged; }
    private void ClearChangedIdentity() { ResetSelection(); sourceIdentity = Identity; selectionInvalidated = false; fileInputGeneration++; pendingFocus = (Prefix + "-audio-file"); }
    private void SessionChanged() { if (!disposed) _ = InvokeAsync(() => { if (sourceIdentity != Identity) { selectionInvalidated = true; stopping = true; if (!working && !picking) ClearChangedIdentity(); StateHasChanged(); } }); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocus is { } id)
        {
            pendingFocus = null;
            await JS.InvokeVoidAsync("familyhub.focusInOpenDialog", id);
        }
    }
    private void ResetSelection()
    {
        files = []; FolderName = ""; completed.Clear(); acceptedJobs.Clear();
        error = selectionNote = currentName = null; status = ""; problems.Clear(); otherFiles = 0; otherTypes = [];
    }
    private void Choose(InputFileChangeEventArgs args)
    {
        if (Disabled || Busy) return; ResetSelection(); CreatedPlaylistKey = null;
        if (args.FileCount > 500) { error = "Choose up to 500 songs at a time."; _ = Changed.InvokeAsync(); return; }
        var skipped = 0; var skips = new List<LocalAudioSkip>();
        foreach (var file in args.GetMultipleFiles(500)) {
            if (!LocalAudioFolderPicker.IsSupported(file.Name) || file.Size is <= 0 or > 134217728) { skipped++; skips.Add(new(file.Name, !LocalAudioFolderPicker.IsSupported(file.Name) ? "not-audio" : file.Size <= 0 ? "empty" : "too-large")); continue; }
            files.Add(new(file.Name, file.Size, token => Task.FromResult(file.OpenReadStream(134217728, token))));
        }
        AddSkips(skips); SelectionReady(skipped, false); _ = Changed.InvokeAsync();
    }
    private void SelectionReady(int skipped, bool limited)
    {
        selectionNote = null;
        if (limited) selectionNote = $"The folder is large. Selected {files.Count} songs; choose a smaller folder for the rest.";
        if (files.Count == 0) error = "No supported audio files found.";
        pendingFocus = files.Count > 0 ? SubmitId : Prefix + "-audio-file";
    }
    private async Task ChooseFolder()
    {
        if (Disabled || Busy) return; picking = true; error = null;
        try { var selected = await LocalAudioFolderPicker.PickAsync(lifetime.Token); if (selected is not null && !selectionInvalidated) { ResetSelection(); CreatedPlaylistKey = null; files = selected.Files.ToList(); AddSkips(selected.SkippedFiles ?? []); FolderName = selected.Name.Trim().Length <= 200 ? selected.Name.Trim() : ""; SelectionReady(selected.Skipped, selected.LimitReached); } }
        catch (OperationCanceledException) { }
        catch (Exception exception) { error = exception.Message; }
        finally { picking = false; if (selectionInvalidated) ClearChangedIdentity(); pendingFocus ??= Prefix + "-folder"; await Changed.InvokeAsync(); }
    }
    private async Task Upload(MusicPlaylist? playlist, string? newName, bool shared)
    {
        if (Busy || Remaining == 0 || Session.Api is not { } api || !Session.Connected) return;
        var identity = Identity;
        bool Current() => !selectionInvalidated && ReferenceEquals(api, Session.Api) && identity == Identity;
        working = true;
        stopping = false;
        error = null;
        var token = lifetime.Token;
        var playlistFailures = 0;
        try
        {
            await Changed.InvokeAsync();
            if (newName is not null)
            {
                playlist = Session.Playlists.FirstOrDefault(p => p.CanEdit && p.OwnerId + ":" + p.Id == CreatedPlaylistKey);
                if (playlist is null)
                {
                    status = "Creating playlist...";
                    await InvokeAsync(StateHasChanged);
                    await Session.CreatePlaylistAsync(newName);
                    if (!Current()) return;
                    playlist = Session.Playlists.LastOrDefault(p => p.Name == newName && p.CanEdit)
                        ?? throw new InvalidOperationException("The playlist could not be created.");
                    CreatedPlaylistKey = playlist.OwnerId + ":" + playlist.Id;
                    if (!shared) await Session.EditPlaylistAsync(playlist, new { shared = false });
                }
            }
            foreach (var file in files.Where(f => !completed.Contains(f)).ToArray())
            {
                if (stopping || !Current()) break;
                currentName = file.Name;
                try
                {
                    LibraryAddition? job = null;
                    if (!acceptedJobs.TryGetValue(file, out var acceptedId))
                    {
                        uploading = true;
                        percent = 0;
                        status = "Uploading song...";
                        await InvokeAsync(StateHasChanged);
                        await using var stream = await file.OpenRead(token);
                        if (!Current()) break;
                        var response = await api.UploadAudioAsync(stream, file.Size, file.Name, "", "", "",
                            new Progress<DownloadProgress>(p =>
                            {
                                percent = (int)(p.Received * 100 / Math.Max(1, p.Total));
                                if (!disposed) _ = InvokeAsync(StateHasChanged);
                            }), token, playlist, JobChanged.HasDelegate);
                        job = response.Deserialize<LibraryAdditionStatus>(FamilyHubApi.JsonOptions)?.Job
                            ?? throw new InvalidDataException("The server did not confirm the upload.");
                        acceptedJobs[file] = acceptedId = job.Id;
                        if (Current()) await JobChanged.InvokeAsync(job);
                    }

                    uploading = false;
                    status = job?.Message ?? "Checking upload status...";
                    await InvokeAsync(StateHasChanged);
                    if (job is null || job.Pending)
                    {
                        await foreach (var update in api.WatchJobStatusAsync<LibraryAdditionStatus>("/api/jobs/" + Uri.EscapeDataString(acceptedId), token))
                        {
                            if (!Current()) break;
                            job = update.Job;
                            status = job.Message;
                            await JobChanged.InvokeAsync(job);
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    if (!Current()) break;
                    if (job is null || job.Pending)
                    {
                        error = "Upload status is unavailable. Submit again to check the accepted upload.";
                        break;
                    }
                    acceptedJobs.Remove(file);
                    if (!job.Saved && job.State != "done")
                        throw new InvalidOperationException(job.Message.Length > 0 ? job.Message : "The song could not be prepared.");
                    completed.Add(file);
                    if (job.PlaylistError is not null) playlistFailures++;
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception exception)
                {
                    problems.Add((file.Name, exception switch
                    {
                        FamilyHubApiException { StatusCode: 404 } when acceptedJobs.ContainsKey(file) => "This upload status expired. Check the library before selecting this song again.",
                        FamilyHubApiException or InvalidOperationException => exception.Message,
                        _ => "Could not finish the upload. Check the connection and try again."
                    }));
                    if (acceptedJobs.ContainsKey(file) || !Current() || !Session.Connected || exception is HttpRequestException) break;
                }
                finally { uploading = false; }
            }
            if (Current()) await Session.RefreshAsync(background: true);
            status = stopping ? "Upload stopped" : Remaining == 0 ? "Saved on server" : "Upload finished";
            if (playlistFailures > 0) error = $"{playlistFailures} saved {(playlistFailures == 1 ? "song could" : "songs could")} not be added to the playlist. Add them from your library.";
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) { error = exception is FamilyHubApiException ? exception.Message : "The upload could not finish. Try again."; }
        finally
        {
            working = uploading = false;
            currentName = null;
            if (selectionInvalidated) ClearChangedIdentity();
            if (!disposed)
            {
                await Changed.InvokeAsync();
                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("familyhub.restoreUploadFocus", Prefix + "-stop", SubmitId);
            }
        }
    }
    public void Dispose() { disposed = true; Session.Changed -= SessionChanged; lifetime.Cancel(); lifetime.Dispose(); }
}
