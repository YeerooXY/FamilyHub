@inject IJSRuntime JS

<section class="library-addition-status" aria-label="@L["Save status"].Value">
    <p class="sr" role="status">@Jobs.Count(job => job.Pending) songs pending, @Jobs.Count(job => !job.Pending && job.Saved) saved, @Jobs.Count(job => !job.Pending && !job.Saved) failed.</p>
    <ul class="addition-list">
        @foreach (var job in Jobs.Take(limit))
        {
            <li class="library-addition" id="@(Prefix + "-addition-" + job.Key)" @key="job.Key" tabindex="-1">
                <div class="library-addition-copy"><strong>@job.Title</strong>
                    @if (!string.IsNullOrEmpty(job.PlaylistError) || !string.IsNullOrWhiteSpace(job.Message) && (job.Pending || !job.Saved))
                    {
                        <Notice Level="@(job.Pending && job.PlaylistError is null ? "info" : "error")"
                                Message="@NoticeText.Detail(job.PlaylistError ?? job.Message, "The server could not save this song. Try again.")" />
                    }
                </div>
                <span class="music-admin-count">@Status(job)</span>
                @if (Retry.HasDelegate && job.SourceId is { Length: 11 } && (job.State is "error" or "cancelled" && !job.Saved || job.PlaylistError is not null))
                {
                    <button type="button" class="quiet" aria-label="Retry @job.Title" aria-disabled="@(Busy ? "true" : "false")" @onclick="() => RetryJob(job)">@L["Retry"]</button>
                }
            </li>
        }
    </ul>
    @if (Jobs.Count > limit)
    {
        <button id="@(Prefix + "-addition-more")" class="quiet" type="button" @onclick="More">@L["Show more additions"]</button>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LibraryAddition> Jobs { get; set; } = [];
    [Parameter] public EventCallback<LibraryAddition> Retry { get; set; }
    [Parameter] public string Prefix { get; set; } = "dialog";
    [Parameter] public bool Busy { get; set; }
    private int limit = 5;
    private static string Status(LibraryAddition job) => job.State switch
    {
        "queued" => "Queued",
        "running" => "Working",
        "done" => "Saved",
        "cancelled" => "Cancelled",
        _ => job.Saved ? "Saved" : "Failed"
    };
    private async Task More()
    {
        if (Jobs.Count <= limit + 20)
            await JS.InvokeVoidAsync("familyhub.focus", Prefix + "-addition-" + Jobs[Math.Min(limit, Jobs.Count) - 1].Key);
        limit += 20;
    }
    private async Task RetryJob(LibraryAddition job)
    {
        if (Busy) return;
        await JS.InvokeVoidAsync("familyhub.focus", Prefix + "-addition-" + job.Key);
        await Retry.InvokeAsync(job);
    }
}
