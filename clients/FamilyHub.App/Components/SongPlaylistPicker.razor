@inject MusicSession Session
@inject IJSRuntime JS

<dialog id="song-playlist-dialog" class="popup-panel song-playlist-picker" aria-labelledby="song-playlist-heading">
    <div class="dialog-heading"><h2 id="song-playlist-heading">@L["Add to playlist"]</h2><button id="song-playlist-close" class="quiet" aria-label="@L["Close playlist picker"].Value" @onclick="Close"><MusicIcon Name="close" /></button></div>
    <label class="picker-filter"><MusicIcon Name="search" /><input id="playlist-picker-filter" aria-label="@L["Find a playlist"].Value" placeholder="@L["Find a playlist"].Value" @bind="filter" @bind:event="oninput" /></label>
    <div class="picker-new-row @(creating ? "is-editing" : "")">
        <button id="picker-new-button" class="quiet picker-new" @onclick="BeginCreate" aria-expanded="@(creating ? "true" : "false")"><MusicIcon Name="plus" />@L["New playlist"]</button>
        <form class="picker-create" aria-hidden="@(!creating ? "true" : "false")" inert="@(!creating)" @onsubmit="CreateAndSave" @onsubmit:preventDefault>
            <input id="picker-new-name" aria-label="@L["New playlist name"].Value" @bind="name" maxlength="200" placeholder="@L["Playlist name"].Value" required />
            <button type="submit" class="quiet picker-confirm" aria-label="@L["Create playlist"].Value" title="@L["Create playlist"].Value" aria-disabled="@(saving || creatingPlaylist ? "true" : "false")"><MusicIcon Name="check" /></button>
        </form>
    </div>
    <div class="picker-playlists" aria-label="@L["Your playlists"].Value">
        @foreach (var playlist in Session.Playlists.Where(p => p.CanEdit && p.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)))
        {
            <label class="picker-choice" @key="Key(playlist)"><PlaylistCover Playlist="playlist" /><span><strong>@playlist.Name</strong><small>@playlist.Tracks.Count songs</small></span><input type="checkbox" aria-label="@playlist.Name" checked="@chosen.Contains(Key(playlist))" @onchange="args => Select(Key(playlist), args)" disabled="@saving" /></label>
        }
        @if (!Session.Playlists.Any(p => p.CanEdit && p.Name.Contains(filter, StringComparison.OrdinalIgnoreCase))) { <Notice Level="empty" Message="@(filter.Length > 0 ? "No playlists match this search." : "You have no editable playlists.")"
               ActionLabel="@(filter.Length > 0 ? "Reset playlist search" : null)" Action='() => filter = ""' FocusTarget="#playlist-picker-filter" /> }
    </div>
    <ServiceStatus Active="connectionFailed" Detail="@L["Check the playlist before retrying the save."].Value"
                   RetryLabel="@L["Retry playlist connection"].Value" Retry="RetryConnection" Busy="@(saving || creatingPlaylist || reconnecting)"
                   FocusTarget="#playlist-picker-done" />
    <Notice Level="@(saving && !saveFailed ? "info" : "error")" Message="@(connectionFailed ? null : message)" />
    <div class="actions picker-footer"><button class="quiet" @onclick="Close" aria-disabled="@(saving ? "true" : "false")">@L["Cancel"]</button><button id="playlist-picker-done" class="primary" @onclick="Save" aria-disabled="@(saving ? "true" : "false")">@(saving ? "Saving..." : "Done")</button></div>
</dialog>

@code {
    private MusicTrack? track;
    private string opener = "content", filter = "", name = "", message = "";
    private bool opening, saving, creating, creatingPlaylist, focusName, saveFailed;
    private bool connectionFailed, reconnecting;
    private HashSet<string> chosen = [];
    private HashSet<string> initial = [];
    private static string Key(MusicPlaylist playlist) => playlist.OwnerId + ":" + playlist.Id;
    public void Open(MusicTrack value, string returnId)
    {
        track = value; opener = returnId; filter = name = message = ""; creating = false; connectionFailed = false;
        chosen = Session.Playlists.Where(p => p.CanEdit && p.Tracks.Any(t => t.RecordingId == value.Id)).Select(Key).ToHashSet();
        initial = new(chosen);
        opening = true; StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (opening) { opening = false; await JS.InvokeVoidAsync("familyhub.showDialog", "song-playlist-dialog", "song-playlist-close", opener); }
        if (focusName) { focusName = false; await JS.InvokeVoidAsync("familyhub.focus", "picker-new-name"); }
    }
    private void BeginCreate() { creating = true; focusName = true; }
    private void Select(string id, ChangeEventArgs args) { if (args.Value is true) chosen.Add(id); else chosen.Remove(id); }
    private Task Close() => JS.InvokeVoidAsync("familyhub.closeDialog", "song-playlist-dialog", opener).AsTask();
    private async Task RetryConnection()
    {
        if (reconnecting) return;
        reconnecting = true;
        try
        {
            if (!Session.Connected) await Session.ReconnectAsync();
            else await Session.RefreshAsync();
            if (Session.Connected && track is { } current)
            {
                initial = Session.Playlists.Where(p => p.CanEdit && p.Tracks.Any(t => t.RecordingId == current.Id)).Select(Key).ToHashSet();
                connectionFailed = false;
                message = "";
            }
        }
        finally { reconnecting = false; }
    }
    private async Task CreateAndSave()
    {
        if (saving || creatingPlaylist || string.IsNullOrWhiteSpace(name)) return;
        creatingPlaylist = true;
        try { await Session.CreatePlaylistAsync(name.Trim()); chosen.Add(Key(Session.Playlists.Last())); await Save(); }
        catch (Exception ex) { SaveError(ex); }
        finally { creatingPlaylist = false; }
    }
    private async Task Save()
    {
        if (saving || track is null) return;
        saving = true; saveFailed = false; message = "";
        try
        {
            var targets = new HashSet<string>(chosen);
            targets.SymmetricExceptWith(initial);
            MusicTrack? saved = null;
            foreach (var target in targets)
            {
                var playlist = Session.Playlists.FirstOrDefault(p => p.CanEdit && Key(p) == target)
                    ?? throw new InvalidOperationException("A selected playlist is unavailable. Reopen Add to playlist to see the current list.");
                var positions = playlist.Tracks.Select((t, i) => (t, i)).Where(row => row.t.RecordingId == track.Id).Select(row => row.i).Reverse().ToList();
                if (chosen.Contains(target))
                {
                    if (positions.Count == 0)
                    {
                        message = track.Saved ? "Saving playlist..." : "Saving recording to server...";
                        await InvokeAsync(StateHasChanged);
                        saved ??= await Session.EnsureServerRecordingAsync(track, CancellationToken.None, background: true, prefetch: true);
                        await Session.EditPlaylistAsync(playlist, new { add_source_id = saved.Id });
                    }
                    initial.Add(target);
                }
                else
                {
                    foreach (var position in positions)
                    {
                        playlist = Session.Playlists.First(p => Key(p) == target);
                        await Session.EditPlaylistAsync(playlist, new { remove_index = position });
                    }
                    initial.Remove(target);
                }
            }
            await Close();
            if (targets.Count > 0) await JS.InvokeVoidAsync("FamilyHubNotices.toast", "Playlist selection saved.");
        }
        catch (Exception ex) { SaveError(ex); }
        finally { saving = false; }
    }
    private void SaveError(Exception error)
    {
        saveFailed = true;
        connectionFailed = !Session.Connected || error is HttpRequestException or OperationCanceledException or FamilyHubApiException { StatusCode: >= 500 };
        message = NoticeText.Error(error, "The playlist could not be saved. Try again.");
    }
}
