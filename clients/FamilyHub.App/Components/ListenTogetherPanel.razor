@implements IDisposable
@inject ListenTogether Together
@inject MusicPlayer Player
@inject MusicSession Session
@inject IJSRuntime JS

<button id="listen-together" class="quiet listen-together-button" aria-label="Listen Together" title="Listen Together" aria-pressed="@(Together.Room is not null ? "true" : "false")" @onclick="Open"><MusicIcon Name="people" /><span class="toolbar-label">Listen Together</span></button>
@if (Together.Following)
{
    <button class="quiet local-pause-button" aria-label="@(Together.LocallyPaused ? "Resume live session" : "Pause only for me")" title="@(Together.LocallyPaused ? "Resume live session" : "Pause only for me")" aria-pressed="@Together.LocallyPaused.ToString().ToLowerInvariant()" @onclick="Together.ToggleLocalPauseAsync"><MusicIcon Name="@(Together.LocallyPaused ? "play" : "pause")" /><span class="toolbar-label">@(Together.LocallyPaused ? "Resume live session" : "Pause only for me")</span></button>
}
<dialog id="listen-together-dialog" class="popup-panel listening-dialog" aria-labelledby="listening-heading" @onclose="Closed">
    <div class="dialog-heading"><h2 id="listening-heading">Listen Together</h2><button id="close-listening" class="quiet" aria-label="Close Listen Together" @onclick="Close"><MusicIcon Name="close" /></button></div>
    @if (Together.Room is { } room)
    {
        <div class="listening-session"><MusicIcon Name="people" /><div><strong>@(room.IsHost ? "You're hosting" : "Listening with " + room.HostName)</strong><p>@room.Listeners @(room.Listeners == 1 ? "listener" : "listeners")</p></div></div>
        <p class="setting-help">@(room.IsHost ? "People on this server can join your queue. You control playback and Auto DJ." : "The host controls songs, playback and Auto DJ. Your volume stays private.")</p>
        @if (room.Queue is { Count: 0 }) { <Notice Level="empty" Message="@(room.IsHost ? "Choose a song or playlist to start listening." : "Waiting for the host to choose a song.")" /> }
        @if (room.IsHost)
        {
            var guests = Session.Profiles.Where(p => p.Id != Session.User).ToList();
            <div class="session-invite">
                <h3 id="invite-heading">Invite a listener</h3>
                @if (guests.Count == 0) { <Notice Level="empty" Message="No other profiles on this server." /> }
                else
                {
                    <div class="invite-list" role="radiogroup" aria-labelledby="invite-heading">
                        @foreach (var profile in guests)
                        {
                            var chosen = inviteUser == profile.Id;
                            <button class="invite-choice @(chosen ? "is-chosen" : "")" @key="profile.Id" role="radio" aria-checked="@(chosen ? "true" : "false")" @onclick="() => Choose(profile.Id)">
                                <ProfileAvatar Profile="profile" Size="36" /><span>@profile.Name</span><MusicIcon Name="@(chosen ? "check-circle" : "plus-circle")" />
                            </button>
                        }
                    </div>
                    <button id="send-invitation" class="primary session-action" @onclick="Invite" aria-disabled="@(busy || inviteUser.Length == 0 ? "true" : "false")">@(inviteUser.Length == 0 ? "Choose someone to invite" : "Invite " + guests.FirstOrDefault(p => p.Id == inviteUser)?.Name)</button>
                    <Notice Level="success" Message="@inviteStatus" />
                }
            </div>
        }
        <button id="leave-listening" class="session-action session-leave" @onclick="Leave" aria-disabled="@(busy ? "true" : "false")">@(room.IsHost ? "End session" : "Leave session")</button>
    }
    else
    {
        <button id="start-listening" class="primary" @onclick="Start" aria-disabled="@(busy || !Session.Connected ? "true" : "false")"><MusicIcon Name="people" />@(Together.Rooms.Any(r => r.HostUser == Session.User) ? "Resume hosting" : "Start session")</button>
        <div class="listening-rooms" aria-label="Available sessions">
            <h3>Join a session</h3>
            @foreach (var available in Together.Rooms)
            {
                <button class="listening-room" @key="available.Id" @onclick="() => available.HostUser == Session.User ? Start() : Join(available.Id)" aria-disabled="@(busy ? "true" : "false")"><MusicIcon Name="people" /><span><strong>@available.HostName</strong><small>@available.Title</small></span><span>@(available.HostUser == Session.User ? "Resume hosting" : "Join")</span></button>
            }
            @if (!Session.Connected || refreshFailed)
            { <ServiceStatus Detail="Reconnect to load listening sessions." RetryLabel="Retry listening sessions"
                             Retry="RetrySessions" Busy="refreshing" FocusTarget="#start-listening" /> }
            else if (Together.Rooms.Count == 0) { <Notice Level="empty" Message="No sessions are available." /> }
        </div>
    }
    <Notice Level="@(error is not null ? "error" : "info")" Message="@(error ?? Together.Message)" />
</dialog>

@code {
    private string inviteUser = "", inviteStatus = "";
    private void Choose(string id) { inviteUser = inviteUser == id ? "" : id; inviteStatus = ""; }
    private async Task Invite()
    {
        if (busy || inviteUser.Length == 0) return;
        busy = true; error = null; inviteStatus = "";
        try
        {
            await Together.InviteAsync(inviteUser);
            inviteStatus = "Invitation sent to " + (Session.Profiles.FirstOrDefault(p => p.Id == inviteUser)?.Name ?? "listener");
            inviteUser = "";
        }
        catch (Exception exception) { error = NoticeText.Error(exception); }
        finally { busy = false; }
    }
    private bool open, busy, refreshFailed, refreshing;
    private string? error;
    private CancellationTokenSource? refresh;
    protected override void OnInitialized() => Together.Changed += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private async Task Open()
    {
        open = true; error = null;
        await JS.InvokeVoidAsync("familyhub.showDialog", "listen-together-dialog", "close-listening", "listen-together");
        refresh?.Cancel(); refresh?.Dispose(); refresh = new();
        _ = RefreshLoop(refresh.Token);
    }
    private async Task RefreshLoop(CancellationToken token)
    {
        var background = false;
        var delay = 3000;
        while (open && !token.IsCancellationRequested)
        {
            if (Session.UiActive && Together.Room is null) await LoadSessions(background);
            await InvokeAsync(StateHasChanged);
            background = true;
            delay = refreshFailed ? Math.Min(30000, delay * 2) : 3000;
            try { await Task.Delay(delay, token); } catch (OperationCanceledException) { return; }
        }
    }
    private async Task RetrySessions()
    {
        if (!Session.Connected) await Session.ReconnectAsync();
        await LoadSessions(false);
    }
    private async Task LoadSessions(bool background)
    {
        if (refreshing) return;
        refreshing = true;
        try { await Together.RefreshAsync(background); refreshFailed = false; }
        catch (Exception failure) when (failure is HttpRequestException or FamilyHubApiException or OperationCanceledException)
        { refreshFailed = true; }
        finally { refreshing = false; }
    }
    private void Closed() { open = false; refresh?.Cancel(); }
    private async Task Close() { Closed(); await JS.InvokeVoidAsync("familyhub.closeDialog", "listen-together-dialog", "listen-together"); }
    private async Task Act(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null;
        try { await action(); await InvokeAsync(StateHasChanged); await JS.InvokeVoidAsync("familyhub.focus", "close-listening"); }
        catch (Exception e) { error = NoticeText.Error(e, "The listening session could not update. Try again."); }
        finally { busy = false; }
    }
    private Task Start() => Act(Together.StartAsync);
    private Task Join(string id) => Act(() => Together.JoinAsync(id));
    private Task Leave() => Act(Together.LeaveAsync);
    public void Dispose() { refresh?.Cancel(); refresh?.Dispose(); Together.Changed -= Changed; }
}
