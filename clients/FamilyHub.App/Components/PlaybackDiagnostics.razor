@implements IDisposable
@inject MusicSession Session
@inject IJSRuntime JS
@using System.Text.Json.Serialization

<section id="playback-diagnostics" class="settings-panel glass-panel" aria-labelledby="playback-timing-title">
    <h2 id="playback-timing-title">Playback diagnostics</h2>
    @if (Session.LastExitReason is { } reason)
    {
        <p class="setting-help">The last Android app exit reason was @(ExitReasonLabel(reason)).</p>
    }
    <div class="setting-row">
        <span>Music playback attempts in the last 30 minutes</span>
        <button id="playback-diagnostics-refresh" @onclick="Read" aria-disabled="@(loading ? "true" : "false")">@(actions is null ? "Load attempts" : "Refresh attempts")</button>
    </div>
    @if (!failed) { <p class="setting-help" role="status">@status</p> }
    <ServiceStatus Active="failed" Detail="@(DeviceStatus("Server timings did not load."))"
                   RetryLabel="Retry playback diagnostics" Retry="Read" Busy="loading" AutoRetry="true" FocusTarget="#playback-diagnostics-refresh" />
    @if (actions is { Length: > 0 })
    {
        @foreach (var action in actions)
        {
            var attempt = local.GetValueOrDefault(action.Action);
            var started = attempt?.Started;
            <details @key="action.Action">
                <summary>
                    <strong>@(string.IsNullOrWhiteSpace(attempt?.Title) ? "Unknown song" : attempt.Title)</strong><span>, @(started?.ToLocalTime().ToString("T") ?? "Time unavailable"): </span>
                    @Summary(action, attempt?.Observations)
                </summary>
                @if (attempt?.Observations is { Length: > 0 } observations)
                {
                    <h3>On this device</h3>
                    <dl>
                        @foreach (var observation in observations)
                        {
                            <div class="setting-row">
                                <dt>@ObservationLabel(observation.Stage) @ObservationReason(observation.Reason)</dt>
                                <dd>@observation.Time.ToLocalTime().ToString("T"), song position @SongPosition(observation.Position)</dd>
                            </div>
                        }
                    </dl>
                }
                @foreach (var device in new[] { true, false })
                {
                    var stages = action.Events.Where(e => device
                            ? e.ClientMs.HasValue && (!e.PositionMs.HasValue || attempt?.Observations is not { Length: > 0 })
                            : e.ServerMs.HasValue)
                        .OrderBy(e => device ? e.ClientMs : e.ServerMs).ToArray();
                    if (stages.Length == 0) continue;
                    <h3>@(device ? "Device timings" : "Server timings")</h3>
                    <dl>
                    @foreach (var stage in stages)
                    {
                        var observationStage = stage.PositionMs.HasValue && stage.Stage.StartsWith("client_", StringComparison.Ordinal);
                        <div class="setting-row">
                            <dt>@(observationStage ? ObservationLabel(stage.Stage[7..]) : Label(stage.Stage)) @ObservationReason(stage.Reason)</dt>
                            <dd>
                                @Duration((device ? stage.ClientMs : stage.ServerMs)!.Value)
                                @if (stage.PositionMs is int position)
                                {
                                    <span>at song position @SongPosition(position / 1000d)</span>
                                }
                            </dd>
                        </div>
                    }
                    </dl>
                }
            </details>
        }
    }
</section>

@code {
    private static string ExitReasonLabel(string reason) => reason switch
    {
        "freezer" => "frozen process terminated",
        "anr" => "app stopped responding",
        "signaled" => "process terminated by a signal",
        "crash_native" => "native crash",
        "user_requested" => "user request",
        "user_stopped" => "user profile stopped",
        "dependency_died" => "required process stopped",
        "other" => "other or unknown",
        _ => reason.Replace('_', ' ')
    };

    private sealed record TimingEvent(string Stage, [property: JsonPropertyName("client_ms")] int? ClientMs,
        [property: JsonPropertyName("server_ms")] int? ServerMs,
        [property: JsonPropertyName("position_ms")] int? PositionMs = null, string? Reason = null);
    private sealed record PlayAction(string Action, TimingEvent[] Events);
    private sealed record TimingResult(PlayAction[] Actions);
    private PlayAction[]? actions;
    private Dictionary<string, MusicSession.LocalPlaybackAttempt> local = [];
    private readonly CancellationTokenSource lifetime = new();
    private bool loading;
    private string status = "";
    private bool failed;

    private async Task Read()
    {
        if (loading) return;
        var api = Session.Api;
        loading = true;
        status = "Loading playback attempts…";
        try
        {
            if (!Session.Connected || api is null)
            {
                await UpdateActions([]);
                failed = true;
                return;
            }
            using var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            request.CancelAfter(TimeSpan.FromSeconds(8));
            var result = await api.RequestJsonAsync<TimingResult>(HttpMethod.Get, "/api/playback/diagnostics",
                cancellationToken: request.Token, background: true);
            if (lifetime.IsCancellationRequested || Session.Api != api) return;
            var count = await UpdateActions(result.Actions);
            failed = false;
            status = count == 0 ? "No playback attempts in the last 30 minutes."
                : count == 1 ? "1 playback attempt. Open it for detailed timings."
                : $"{count} playback attempts. Open an attempt for detailed timings.";
        }
        catch (Exception error) when (error is HttpRequestException or FamilyHubApiException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (!lifetime.IsCancellationRequested)
            {
                await UpdateActions([]);
                failed = true;
            }
        }
        finally { loading = false; }
    }

    private string DeviceStatus(string reason) => actions is { Length: > 0 }
        ? $"{reason} Showing playback attempts from this device."
        : $"{reason} This device has no playback attempts in the last 30 minutes.";

    private async Task<int> UpdateActions(PlayAction[] remote)
    {
        var recent = Session.RecentPlaybackAttempts().ToDictionary(item => item.Id);
        var next = Merge(remote, recent);
        if (actions is { Length: > 0 })
        {
            var nextIds = next.Select(action => action.Action).ToHashSet();
            var removed = actions.Select((action, index) => (action, index))
                .Where(row => !nextIds.Contains(row.action.Action))
                .Select(row => $"#playback-diagnostics > details:nth-of-type({row.index + 1})").ToArray();
            if (removed.Length > 0)
                await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.focusIfWithin", string.Join(", ", removed), "playback-diagnostics-refresh");
        }
        local = recent;
        actions = next;
        return next.Length;
    }

    private static PlayAction[] Merge(PlayAction[] remote, Dictionary<string, MusicSession.LocalPlaybackAttempt> local)
    {
        var byId = remote.ToDictionary(action => action.Action);
        var ids = local.Keys.Where(id => !byId.ContainsKey(id)).Concat(remote.Select(action => action.Action));
        return ids.Select(id =>
        {
            var action = byId.GetValueOrDefault(id) ?? new PlayAction(id, []);
            var events = action.Events;
            if (local.TryGetValue(id, out var attempt))
            {
                var seen = events.Select(e => e.Stage).ToHashSet();
                events = [.. events, .. attempt.Stages.Where(s => !seen.Contains(s.Key))
                    .Select(s => new TimingEvent(s.Key, s.Value, null))];
            }
            return action with { Events = events };
        }).OrderByDescending(action => local.GetValueOrDefault(action.Action)?.Started).ToArray();
    }

    private static string Label(string stage) => stage switch
    {
        "client_play" => "Player began handling playback",
        "client_position_advanced" => "Playback position moved",
        "client_fallback_position_advanced" => "Playback position moved after retry",
        "client_ready" => "Player loaded the track",
        "client_playing" => "Player reported playing",
        "client_fallback" => "Retry started",
        "client_fallback_ready" => "Player loaded the retry source",
        "client_stream_failed" => "Stream failed to start or continue",
        "client_cache_miss" => "Track absent from device cache",
        "job_accepted" => "Preparation request accepted",
        "worker_started" => "Preparation started",
        "source_metadata_wait" => "Waiting for a source lookup",
        "source_metadata_started" => "Looking up the audio source",
        "source_metadata_ready" => "Audio source details received",
        "source_transfer_wait" => "Waiting to start the download",
        "source_transfer_admitted" => "Download slot available",
        "source_encoder_admitted" => "Encoder slot available",
        "source_process_started" => "Downloader started",
        "source_bytes_received" => "First source bytes reported",
        "preview_ready" => "First preview segment available",
        "windows_preview_ready" => "Preview ready for Windows",
        "preview_segment_response_ready" => "Preview segment ready to send",
        "stream_response_ready" => "Stream response ready",
        "source_ready" => "Original audio available",
        "client_failed" => "Playback failed",
        "client_cancelled" => "Attempt cancelled",
        _ => (stage.StartsWith("client_", StringComparison.Ordinal) ? stage[7..] : stage).Replace('_', ' ')
    };

    private static string Duration(int ms) => ms < 1000 ? $"{ms} ms" : $"{ms / 1000d:0.##} s";

    private static string ObservationLabel(string stage) => stage switch
    {
        "foreground" => "Returned to the app",
        "background" => "App went into the background",
        "screen_off" => "Screen turned off",
        "screen_on" => "Screen turned on",
        "next_warmup_start" => "Started preparing the next song",
        "next_warmup_finish" => "Next song ready on this device",
        "next_warmup_failed" => "Could not prepare the next song",
        "stream_retry" => "Retrying from the last playback position",
        "stream_skipped" => "Skipped the song after playback retries failed",
        "checkpoint" => "Player position saved",
        "early_end" => "Stream ended early",
        "native_ended" => "Audio player reached the end",
        "buffering" or "native_buffering" => "Waiting for audio",
        "buffer_recovered" or "native_ready" => "Audio ready",
        "unexpected_pause" or "native_paused" => "Player paused while playback was requested",
        "native_suppressed" => "The phone suspended audio playback",
        "player_error" or "native_error" => "Audio player reported an error",
        "interrupted" => "Playback interrupted",
        "resume_seek" => "Requested the saved position",
        "resume_applied" => "Player reached the saved position",
        "resume_failed" => "Player could not reach the saved position",
        "notification_published" => "Sent this song to Android media controls",
        "notification_failed" => "Android media controls could not be updated",
        "notification_verified" => "Android returned this title for the session and notification",
        "notification_mismatch" => "Android returned a different title or no notification",
        "notification_unavailable" => "Could not check the title stored by Android",
        _ => "Player state changed"
    };

    private static string ObservationReason(string? code)
    {
        var reason = code switch
        {
            "audio_focus_loss" or "transient_audio_focus_loss" => "another app or the phone interrupted audio",
            "audio_output_disconnected" => "the audio output disconnected",
            "remote_control" => "a connected control paused playback",
            "user_request" => "received a pause request",
            "end_of_item" => "the player reached the end of its audio",
            "suppressed_too_long" => "audio stayed suspended",
            "unsuitable_audio_output" => "the audio output was unavailable",
            "other" => "cause unavailable",
            "ERROR_CODE_IO_NETWORK_CONNECTION_FAILED" => "the network connection failed",
            "ERROR_CODE_IO_NETWORK_CONNECTION_TIMEOUT" or "ERROR_CODE_TIMEOUT" => "the player timed out",
            "ERROR_CODE_IO_BAD_HTTP_STATUS" => "the server rejected the audio request",
            "ERROR_CODE_IO_FILE_NOT_FOUND" => "the audio file could not be found",
            "ERROR_CODE_IO_READ_POSITION_OUT_OF_RANGE" => "the requested part of the song was unavailable",
            "ERROR_CODE_BEHIND_LIVE_WINDOW" => "the stream moved past the requested position",
            "ERROR_CODE_PARSING_CONTAINER_MALFORMED" or "ERROR_CODE_PARSING_MANIFEST_MALFORMED" => "the audio stream was damaged",
            "ERROR_CODE_DECODER_INIT_FAILED" or "ERROR_CODE_DECODING_FAILED" => "the phone could not decode the audio",
            "ERROR_CODE_DECODING_FORMAT_UNSUPPORTED" or "ERROR_CODE_PARSING_CONTAINER_UNSUPPORTED" => "the audio format was unsupported",
            "ERROR_CODE_AUDIO_TRACK_INIT_FAILED" or "ERROR_CODE_AUDIO_TRACK_WRITE_FAILED"
                or "ERROR_CODE_AUDIO_TRACK_OFFLOAD_INIT_FAILED" or "ERROR_CODE_AUDIO_TRACK_OFFLOAD_WRITE_FAILED" => "the phone could not send audio to the output",
            _ => code
        };
        return string.IsNullOrWhiteSpace(reason) ? "" : $"({reason})";
    }

    private static string SongPosition(double seconds)
    {
        var elapsed = TimeSpan.FromSeconds(seconds);
        return elapsed.TotalHours >= 1 ? elapsed.ToString(@"h\:mm\:ss") : elapsed.ToString(@"m\:ss");
    }

    private static string Summary(PlayAction action, MusicSession.PlaybackObservation[]? observations)
    {
        int? Time(string name) => action.Events.FirstOrDefault(e => e.Stage == name)?.ClientMs;
        if (observations?.Any(item => item.Stage == "stream_skipped") == true || Time("client_stream_skipped").HasValue)
            return "Skipped after playback retries failed.";
        var first = Time("client_position_advanced");
        var retry = Time("client_fallback_position_advanced");
        var started = first ?? retry;
        var interrupted = Time("client_stream_failed");
        var failed = Time("client_failed");
        double? interruptionPosition = null;
        if (observations is { Length: > 0 })
        {
            var issue = failed.HasValue ? observations.LastOrDefault(item => IsInterruption(item.Stage)) : observations[^1];
            if (issue is not null && IsInterruption(issue.Stage)) interruptionPosition = issue.Position;
        }
        else
        {
            var latest = action.Events.Where(e => e.PositionMs.HasValue && e.Stage.StartsWith("client_", StringComparison.Ordinal))
                .OrderByDescending(e => e.ClientMs);
            var issue = failed.HasValue ? latest.FirstOrDefault(e => IsInterruption(e.Stage[7..])) : latest.FirstOrDefault();
            if (issue?.PositionMs is int position && IsInterruption(issue.Stage[7..])) interruptionPosition = position / 1000d;
        }
        if (interruptionPosition is double seconds)
            return started.HasValue || seconds > 0
                ? $"Playback interrupted at {SongPosition(seconds)}." : "Playback was interrupted before the song started.";
        if (failed.HasValue) return started.HasValue ? "Started, then stopped unexpectedly." : "Couldn’t start playing.";
        if (Time("client_cancelled").HasValue) return started.HasValue ? "Started, then stopped." : "Cancelled before the song started.";
        if (first.HasValue && retry.HasValue && interrupted >= first && interrupted <= retry)
            return "Started playing again after a retry.";
        if (started.HasValue && interrupted >= started) return "Started, then the stream stopped.";
        if (retry.HasValue) return "Started playing after a retry.";
        if (first.HasValue) return "Started playing.";
        if (Time("client_fallback_ready").HasValue) return "The retry loaded. Playback start is unconfirmed.";
        if (Time("client_fallback").HasValue) return "A retry began. Playback start is unconfirmed.";
        if (interrupted.HasValue) return "The stream stopped before the song started.";
        return "Playback start is unconfirmed.";
    }

    private static bool IsInterruption(string stage) => stage is "early_end" or "interrupted" or "unexpected_pause"
        or "native_paused" or "native_suppressed" or "native_error" or "player_error" or "resume_failed";

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
