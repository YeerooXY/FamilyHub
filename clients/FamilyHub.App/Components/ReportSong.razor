@inject MusicSession Session
@inject MusicPlayer Player
@inject IJSRuntime JS
<button id="report-song" class="quiet trim-request" aria-haspopup="dialog" aria-label="Report song" title="Report song" @onclick="Open"><MusicIcon Name="alert" /><span class="report-label">Report song</span></button>
<dialog id="report-song-dialog" class="animated-dialog report-dialog" aria-labelledby="report-song-title" aria-describedby="report-song-track" data-return-focus="report-song">
    <header>
        <MusicIcon Name="alert" />
        <div><h2 id="report-song-title">Report song</h2><p id="report-song-track">@reportTrack?.Title</p></div>
        <button class="quiet report-close" aria-label="Close" @onclick="Close"><MusicIcon Name="close" /></button>
    </header>
    <div class="report-choices">
        <button id="report-quality" class="quiet" disabled="@busy" @onclick='() => Send("bad_quality")'><MusicIcon Name="volume" /><span><strong>Bad quality or live performance</strong><small>The audio is poor, or it is a live recording.</small></span></button>
        <button class="quiet" disabled="@busy" @onclick='() => Send("wrong_source")'><MusicIcon Name="refresh" /><span><strong>Wrong source</strong><small>A different song or version plays. An admin picks a new source.</small></span></button>
        <button class="quiet" disabled="@busy" @onclick='() => Send("trimming")'><MusicIcon Name="scissors" /><span><strong>Needs trimming</strong><small>Silence, talking or an intro should be cut.</small></span></button>
    </div>
    <p class="report-status" role="status">@status</p>
</dialog>
<span class="sr" role="status">@announcement</span>
@code {
    [Parameter, EditorRequired] public MusicTrack Track { get; set; } = null!;
    private MusicTrack? reportTrack;
    private string? status, announcement;
    private bool busy;
    private async Task Open()
    {
        reportTrack = Track; status = announcement = null;
        await JS.InvokeVoidAsync("familyhub.showDialog", "report-song-dialog", "report-quality");
    }
    private Task Close() => JS.InvokeVoidAsync("familyhub.closeDialog", "report-song-dialog", "report-song").AsTask();
    private async Task Send(string reason)
    {
        if (busy || reportTrack is null) return;
        if (!Session.Connected || Session.Api is null) { status = "Connect to the server to report this song."; return; }
        busy = true;
        var track = reportTrack;
        try
        {
            object payload = reason == "trimming" ? new { id = track.Id, position = Player.Current?.Id == track.Id ? Player.Position : 0 } : new { id = track.Id, reason };
            await Session.Api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, reason == "trimming" ? "/api/catalogue/trimming" : "/api/catalogue/reports", payload);
            announcement = reason == "trimming" ? "Added to trimming pool." : "Song reported.";
            await Close();
        }
        catch (Exception error) { status = error.Message; }
        finally { busy = false; }
    }
}
