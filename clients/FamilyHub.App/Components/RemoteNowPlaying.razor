@implements IDisposable
@inject PlaybackDevicePoll DevicePoll
@inject MusicPlayer Player
@inject MusicSession Session
@inject IJSRuntime JS
@using System.Diagnostics

@if (Device is { Track: { } track } device)
{
    @* One song bar: the other device's song stands in for this device's idle player (cover, title,
       artist, play/pause), with the "Playing on" line under it. *@
    var known = Session.Library.Concat(Session.Downloads).FirstOrDefault(s => s.Id == track.Id);
    <div id="remote-now-playing" class="remote-mini" role="group" aria-label="@("Playback on " + device.Name)">
        <button id="remote-take-over" class="remote-mini-main" @onclick="() => ConnectAsync(device)" aria-disabled="@(connectingDevice is not null ? "true" : "false")" aria-label="@($"Move {track.Title} to this device")" title="Play on this device">
            <TrackCover Track="@(known ?? new MusicTrack { Id = track.Id, Title = track.Title, Channel = track.Channel })" />
            <span class="remote-mini-copy">
                <strong>@track.Title</strong>
                @if (connectingDevice is not null)
                {
                    <small role="status">Connecting...</small>
                }
                else
                {
                    <small>@track.Channel</small>
                }
            </span>
        </button>
        <button id="remote-toggle" class="remote-mini-toggle" aria-disabled="@(connectingDevice is not null || toggling ? "true" : "false")" aria-label="@((device.IsPlaying ? "Pause on " : "Play on ") + device.Name)" @onclick="() => ToggleAsync(device)"><MusicIcon Name="@(device.IsPlaying ? "pause" : "play")" /></button>
        <span class="remote-mini-line"><MusicIcon Name="volume" /><span>Playing on <strong>@device.Name</strong></span></span>
        @{ var duration = device.Duration ?? known?.Duration ?? 0;
           var position = Math.Clamp(device.PositionAt(Elapsed) ?? 0, 0, Math.Max(0, duration)); }
        @if (duration > 0 && Fresh && connectingDevice is null)
        {
            <span class="remote-mini-progress" aria-hidden="true"><span @key="checkedAt" class="@(device.IsPlaying && device.Position is not null && position < duration ? "is-running" : "")"
                  style="--from:@Number(position / duration * 100);--seconds:@Number(duration - position)s;width:@Number(position / duration * 100)%"></span></span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Func<PlaybackDevice, Task<bool>> TakeOver { get; set; } = default!;
    private PlaybackDevice? device;
    private PlaybackDevice? connectingDevice;
    private long checkedAt;
    private CancellationTokenSource? loop;
    private bool Fresh => device is not null && device.Age + Elapsed < PlaybackDevice.OnlineSeconds;
    private double Elapsed => Stopwatch.GetElapsedTime(checkedAt).TotalSeconds;
    private PlaybackDevice? Device => connectingDevice ?? (Player.RemoteActive || Player.FollowingHost || Player.PlaybackRequested ? null : device);
    private static string Number(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private async Task ConnectAsync(PlaybackDevice source)
    {
        if (connectingDevice is not null || !Fresh) return;
        connectingDevice = source;
        try { if (await TakeOver(source)) device = null; }
        finally { connectingDevice = null; }
    }

    // Play/pause on the other device; this device stays idle. The next check-in confirms the state.
    private bool toggling;
    private async Task ToggleAsync(PlaybackDevice source)
    {
        if (toggling || connectingDevice is not null || !Fresh || Session.Api is not { } api) return;
        toggling = true;
        var playing = source.IsPlaying;
        try
        {
            await api.ControlPlaybackAsync(Session.DeviceId, source.Id, playing ? "pause" : "play");
            if (ReferenceEquals(device, source) && loop is { IsCancellationRequested: false } running)
            {
                var updated = device = source with { Playing = !playing, Status = playing ? "paused" : "playing", Position = source.PositionAt(Elapsed), Age = 0 };
                checkedAt = Stopwatch.GetTimestamp();
                _ = HideWhenExpiredAsync(updated, checkedAt, running.Token);
            }
        }
        catch (Exception e) when (e is HttpRequestException or FamilyHubApiException or OperationCanceledException) { }
        finally { toggling = false; }
    }

    private async Task HideWhenExpiredAsync(PlaybackDevice snapshot, long receivedAt, CancellationToken token)
    {
        var remaining = PlaybackDevice.OnlineSeconds - snapshot.Age - Stopwatch.GetElapsedTime(receivedAt).TotalSeconds;
        try
        {
            if (remaining > 0) await Task.Delay(TimeSpan.FromSeconds(remaining), token);
            await InvokeAsync(() => HideDeviceAsync(snapshot, token));
        }
        catch (OperationCanceledException) { }
    }

    private async Task HideDeviceAsync(PlaybackDevice snapshot, CancellationToken token)
    {
        if (token.IsCancellationRequested || !ReferenceEquals(device, snapshot)) return;
        // This bar stands in for the player bar, which shows again once it goes: focus follows to Play.
        await JS.InvokeVoidAsync("familyhub.handFocusTo", "#remote-now-playing", "play");
        if (token.IsCancellationRequested || !ReferenceEquals(device, snapshot)) return;
        device = null;
        StateHasChanged();
    }

    [Parameter] public bool Visible { get; set; } = true;
    protected override void OnParametersSet()
    {
        if (Visible)
        {
            loop ??= new(); DevicePoll.Watch(DevicesChanged);
        }
        else StopWatching();
    }

    private void DevicesChanged(List<PlaybackDevice> devices) => _ = InvokeAsync(async () =>
    {
        if (loop is null) return;
        var token = loop.Token;
        var found = PlaybackDevicePoll.FindRemoteSource(devices);
        if (found is null)
        {
            if (device is { } snapshot) await HideDeviceAsync(snapshot, token);
            return;
        }
        device = found; checkedAt = Stopwatch.GetTimestamp(); StateHasChanged();
        _ = HideWhenExpiredAsync(found, checkedAt, token);
    });

    private void StopWatching()
    {
        DevicePoll.Unwatch(DevicesChanged);
        loop?.Cancel(); loop?.Dispose(); loop = null; device = null;
    }
    protected override void OnAfterRender(bool firstRender) => Player.SetRemotePeek(Device?.Track is not null);
    public void Dispose() { StopWatching(); Player.SetRemotePeek(false); }
}
