@implements IAsyncDisposable
@inject MusicSession Session
@inject IJSRuntime JS

@if (DataOnly)
{
    <section class="settings-panel glass-panel" aria-labelledby="movie-data-heading">
        <h2 id="movie-data-heading">Data</h2>
        <fieldset id="movie-data-saver" class="movie-data-options" disabled="@(!ready)" aria-describedby="movie-data-saver-help">
            <legend>Streaming quality</legend>
            @foreach (var (id, label) in qualityOptions)
            {
                <label class="movie-data-option">
                    <input type="radio" name="movie-data-quality" value="@id" checked="@(preferences.DataSaver == id)" @onchange="() => SaveQuality(id)" />
                    <span>@label</span>
                    @if (estimates.TryGetValue(id, out var estimate))
                    {
                        <span class="muted">@estimate</span>
                    }
                </label>
            }
        </fieldset>
        <p class="setting-help" id="movie-data-saver-help">Estimates for a typical film. Auto uses Original on Wi-Fi and Saver on mobile data.</p>
        <p class="setting-help" role="status">@message</p>
    </section>
    <section class="settings-panel glass-panel" aria-labelledby="movie-data-month">
        <h2 id="movie-data-month">This month</h2>
        <div class="setting-row"><span>Movies &amp; TV streamed on mobile data</span><span id="movie-data-used">@monthlyUsage</span></div>
    </section>
}
else
{
<section class="settings-panel glass-panel" aria-labelledby="movie-settings-heading">
    <h2 id="movie-settings-heading">Movie playback</h2>
    <div class="setting-row">
        <label for="movie-screen">My screen</label>
        <select id="movie-screen" @bind="preferences.Screen" @bind:after="Save" disabled="@(!ready)" aria-describedby="movie-screen-help">
            <option value="auto">Automatic</option>
            <option value="1080">1080p / Full HD</option>
            <option value="1440">1440p</option>
            <option value="2160">4K / UHD</option>
            <option value="4320">8K</option>
            <option value="projector">Projector or very large screen</option>
        </select>
    </div>
    <p class="setting-help" id="movie-screen-help">This sets the resolution limit for converted playback and flags larger downloads. Automatic uses your display’s pixel size. The projector setting allows up to 8K.</p>
    <div class="setting-row">
        <label for="movie-background-style">Background style</label>
        <select id="movie-background-style" @bind="preferences.BackgroundStyle" @bind:after="Save" disabled="@(!ready)" aria-describedby="movie-background-style-help">
            <option value="auto">Automatic</option>
            <option value="preset">Always preset</option>
            <option value="backdrop">Always backdrop</option>
        </select>
    </div>
    <p class="setting-help" id="movie-background-style-help">For titles missing a backdrop, Automatic uses the preset and Always backdrop uses a neutral background.</p>
    <div class="setting-row">
        <label for="movie-preferred-audio">Preferred audio</label>
        <select id="movie-preferred-audio" @bind="preferences.Audio" @bind:after="Save" disabled="@(!ready)">
            <option value="default">Media default</option>
            <option value="hu">Hungarian</option>
            <option value="en">English</option>
        </select>
    </div>
    <div class="setting-row">
        <label for="movie-backup-audio">Backup audio</label>
        <select id="movie-backup-audio" @bind="preferences.BackupAudio" @bind:after="Save" disabled="@(!ready)" aria-describedby="movie-backup-audio-help">
            <option value="none">None</option>
            <option value="hu">Hungarian</option>
            <option value="en">English</option>
        </select>
    </div>
    <p class="setting-help" id="movie-backup-audio-help">Used when a movie has no preferred audio. Has no effect while Preferred audio is Media default.</p>
    <div class="setting-row">
        <label for="movie-preferred-subtitles">Preferred subtitles</label>
        <select id="movie-preferred-subtitles" @bind="preferences.Subtitles" @bind:after="Save" disabled="@(!ready)">
            <option value="default">Media default</option>
            <option value="off">Off</option>
            <option value="hu">Hungarian</option>
            <option value="en">English</option>
        </select>
    </div>
    <label class="setting-row movie-playback-toggle" for="movie-auto-skip-intro">
        <span>Skip intros automatically</span>
        <input id="movie-auto-skip-intro" type="checkbox" role="switch" @bind="preferences.AutoSkipIntro" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <label class="setting-row movie-playback-toggle" for="movie-auto-skip-recap">
        <span>Skip recaps automatically</span>
        <input id="movie-auto-skip-recap" type="checkbox" role="switch" @bind="preferences.AutoSkipRecap" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <label class="setting-row movie-playback-toggle" for="movie-auto-next">
        <span>Play the next episode automatically</span>
        <input id="movie-auto-next" type="checkbox" role="switch" @bind="preferences.AutoNext" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <label class="setting-row movie-playback-toggle" for="movie-parental-guide">
        <span>Show the parental guide</span>
        <input id="movie-parental-guide" type="checkbox" role="switch" @bind="preferences.ParentalGuide" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <label class="setting-row movie-playback-toggle" for="movie-chapter-marks">
        <span>Chapter marks on the seek bar</span>
        <input id="movie-chapter-marks" type="checkbox" role="switch" @bind="preferences.ChapterMarks" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <label class="setting-row movie-playback-toggle" for="movie-seek-pictures">
        <span>Picture previews when seeking</span>
        <input id="movie-seek-pictures" type="checkbox" role="switch" @bind="preferences.SeekPictures" @bind:after="Save" disabled="@(!ready)" />
    </label>
    <div class="setting-row">
        <label for="movie-home-background">Preset colour</label>
        <select id="movie-home-background" @bind="preferences.HomeBackground" @bind:after="Save" disabled="@(!ready)">
            <option value="auto">Match genre</option>
            <option value="violet">Violet</option>
            <option value="blue">Blue</option>
            <option value="green">Green</option>
            <option value="amber">Amber</option>
            <option value="red">Red</option>
            <option value="slate">Slate</option>
        </select>
    </div>
    <div class="setting-row">
        <label for="movie-layout-preview">Layout preview</label>
        <input id="movie-layout-preview" type="checkbox" role="switch" @bind="preferences.LayoutPreview" @bind:after="Save"
               disabled="@(!ready)" aria-describedby="movie-layout-preview-help" />
    </div>
    <p class="setting-help" id="movie-layout-preview-help">Show demo titles in Movies Home. Playback and downloads are unavailable in preview.</p>
    <div class="setting-row">
        <label for="movie-ratings">Ratings on title pages</label>
        <input id="movie-ratings" type="checkbox" role="switch" @bind="preferences.Ratings" @bind:after="Save"
               disabled="@(!ready)" aria-describedby="movie-ratings-help" />
    </div>
    <p class="setting-help" id="movie-ratings-help">Show IMDb, Rotten Tomatoes and Metacritic scores when they are known.</p>
    <p class="setting-help">Saved on this device for your profile.</p>
    <div class="setting-row">
        <span id="movie-customise-label">Movies Home layout</span>
        <button type="button" id="movie-customise-home" aria-labelledby="movie-customise-label" @onclick="CustomiseHome" disabled="@(!ready)">Customise Home</button>
    </div>
    <p class="setting-help">Rows, the banner, Continue watching, title pages and OLED black. Saved to your profile on the server.</p>
    <p class="setting-help" role="status">@message</p>
</section>
@if (MovieNotifications.Supported && Session.MoviesEnabled)
{
    <section class="settings-panel glass-panel" aria-labelledby="movie-notifications-heading">
        <h2 id="movie-notifications-heading">Notifications</h2>
        <label class="setting-row movie-playback-toggle" for="movie-notify-episodes">
            <span>New episode available</span>
            <input id="movie-notify-episodes" type="checkbox" role="switch" checked="@notifyEpisodes" @onchange="args => SaveNotification(true, args.Value is true)" aria-disabled="@(notificationSaving ? "true" : null)" />
        </label>
        <label class="setting-row movie-playback-toggle" for="movie-notify-downloads">
            <span>Download ready</span>
            <input id="movie-notify-downloads" type="checkbox" role="switch" checked="@notifyDownloads" @onchange="args => SaveNotification(false, args.Value is true)" aria-disabled="@(notificationSaving ? "true" : null)" />
        </label>
        <p class="setting-help">Notifications appear when FamilyHub syncs. Allow notifications in your device settings.</p>
        <p class="setting-help" role="status">@notificationMessage</p>
    </section>
}
}

@code {
    [Parameter] public bool DataOnly { get; set; }

    private static readonly (string Id, string Label)[] qualityOptions =
        [("auto", "Auto"), ("full", "Original"), ("good", "Good (720p)"), ("saver", "Saver (480p)"), ("lowest", "Lowest (360p)")];
    private Dictionary<string, string> estimates = new();
    private string monthlyUsage = "";
    private readonly CancellationTokenSource lifetime = new();

    private sealed record Preferences
    {
        public Preferences() { }
        public string Audio { get; set; } = "default";
        public string BackupAudio { get; set; } = "none";
        public string Subtitles { get; set; } = "default";
        public string DataSaver { get; set; } = "auto";
        public string Screen { get; set; } = "auto";
        public string HomeBackground { get; set; } = "auto";
        public string BackgroundStyle { get; set; } = "auto";
        public bool LayoutPreview { get; set; }
        public bool AutoSkipIntro { get; set; }
        public bool AutoSkipRecap { get; set; }
        public bool AutoNext { get; set; } = true;
        public bool ParentalGuide { get; set; }
        public bool Ratings { get; set; } = true;
        public bool ChapterMarks { get; set; } = true;
        public bool SeekPictures { get; set; } = true;
        public bool? DownloadAudio { get; set; }
        public bool? DownloadSubtitles { get; set; }
    }

    private Preferences preferences = new();
    private IJSObjectReference? module;
    private object viewer = default!;
    private string message = "Loading preferences…";
    private bool ready, disposed;
    private bool notifyEpisodes, notifyDownloads, notificationSaving;
    private string notificationMessage = "";

    protected override void OnInitialized()
    {
        if (DataOnly || !MovieNotifications.Supported || !Session.MoviesEnabled) return;
        notifyEpisodes = Session.MovieNotificationEnabled(true);
        notifyDownloads = Session.MovieNotificationEnabled(false);
    }

    private async Task SaveNotification(bool episodes, bool enabled)
    {
        if (notificationSaving) return;
        notificationSaving = true;
        var saved = await Session.SetMovieNotificationAsync(episodes, enabled);
        notificationSaving = false;
        notifyEpisodes = Session.MovieNotificationEnabled(true);
        notifyDownloads = Session.MovieNotificationEnabled(false);
        notificationMessage = saved ? "" : "Could not save notifications. Try again.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        viewer = new { server = Session.Server, profile = Session.User };
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./movies.js");
            if (disposed) { await DisposeModule(imported); return; }
            module = imported;
            preferences = await module.InvokeAsync<Preferences>("readMoviePreferences", viewer);
            if (DataOnly)
            {
                estimates = await module.InvokeAsync<Dictionary<string, string>>("movieQualityEstimates", (object?)null);
                monthlyUsage = await module.InvokeAsync<string>("formatMovieBytes", MovieDataUsage.ThisMonth);
            }
            ready = true;
            message = "";
        }
        catch (JSException)
        {
            message = "Movie preferences are unavailable. Reopen Settings to try again.";
        }
        if (!disposed) StateHasChanged();
        if (DataOnly && ready && !disposed && Session.MoviesEnabled) await ReadOriginalEstimate();
    }

    private async Task ReadOriginalEstimate()
    {
        if (module is null || Session.Api is not { } api) return;
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        timeout.CancelAfter(TimeSpan.FromSeconds(11));
        try
        {
            var reply = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, "/api/movies/estimate", null, timeout.Token);
            if (disposed || !ReferenceEquals(api, Session.Api)) return;
            if (reply.ValueKind != System.Text.Json.JsonValueKind.Object ||
                !reply.TryGetProperty("originalEstimate", out var estimate) ||
                estimate.ValueKind != System.Text.Json.JsonValueKind.Number) return;
            estimates = await module.InvokeAsync<Dictionary<string, string>>("movieQualityEstimates", estimate.GetDouble());
            if (!disposed) StateHasChanged();
        }
        catch (Exception error) when (error is FamilyHubApiException or HttpRequestException or OperationCanceledException
            or InvalidDataException or ObjectDisposedException or JSException)
        {
            if (!disposed)
            {
                try
                {
                    using var reportTimeout = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
                    reportTimeout.CancelAfter(TimeSpan.FromSeconds(3));
                    await api.RequestJsonAsync<System.Text.Json.JsonElement?>(HttpMethod.Post, "/api/movies/report",
                        new { kind = "film-estimate-unavailable", diagnostics = new { reason = timeout.IsCancellationRequested ? "timeout" : "request_failed" } },
                        cancellationToken: reportTimeout.Token);
                }
                catch (Exception reportError) when (reportError is FamilyHubApiException or HttpRequestException or OperationCanceledException
                    or InvalidDataException or ObjectDisposedException) { }
            }
        }
    }

    private Task SaveQuality(string id)
    {
        preferences.DataSaver = id;
        return Save();
    }

    [Parameter] public EventCallback OpenMovies { get; set; }

    // Movies Home opens the Customise Home sheet once it has loaded.
    private async Task CustomiseHome()
    {
        if (module is null || disposed) return;
        try
        {
            await module.InvokeVoidAsync("requestCustomiseHome", viewer);
            await OpenMovies.InvokeAsync();
        }
        catch (JSException)
        {
            message = "Could not open Movies. Try again.";
        }
    }

    private async Task Save()
    {
        if (module is null || disposed) return;
        try
        {
            message = await module.InvokeAsync<bool>("saveMoviePreferences", viewer, preferences)
                ? ""
                : "This device could not save your movie preferences. Reopen Settings to try again.";
        }
        catch (JSException)
        {
            message = "This device could not save your movie preferences. Reopen Settings to try again.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
        if (module is not null) await DisposeModule(module);
    }

    private static async ValueTask DisposeModule(IJSObjectReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
