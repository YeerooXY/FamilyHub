@implements IAsyncDisposable
@inject MusicPlayer Player
@inject IJSRuntime JS
@using System.Globalization

<div class="seek-row">
    <span class="seek-elapsed">@Time(Position)</span>
    <div class="seek-control" style="@($"--seek-position:{Percent.ToString("0.###", CultureInfo.InvariantCulture)}%")">
        <output class="seek-tooltip" aria-hidden="true"></output>
        <input @ref="slider" aria-label="@L["Playback position"].Value" aria-valuetext="@Time(Position)" disabled="@(!CanSeek)"
               aria-disabled="@(CanSeek ? "false" : "true")" type="range"
               min="0" max="@RangeNumber(RangeMaximum)" value="@RangeNumber(Position)" step="0.1"
               @oninput="Preview" @onchange="Commit"
               @onpointercancel="Cancel" @onblur="Cancel" @onkeydown="KeyDown" />
    </div>
    <span>@Time(Duration)</span>
</div>

@code {
    private ElementReference slider;
    private DotNetObjectReference<SeekBar>? visibility;
    private IJSObjectReference? observer;
    private bool bindingObserver;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (observer is not null || bindingObserver) return;
        bindingObserver = true;
        try
        {
            visibility ??= DotNetObjectReference.Create(this);
            observer = await PlaybackInterop.InvokeOrAsync<IJSObjectReference?>(JS, "familyhub.observeSeekBar", null, slider, visibility);
        }
        finally { bindingObserver = false; }
    }
    [JSInvokable] public void SeekVisibility(bool visible) => Player.SetSeekBarVisible(visible);
    private double? preview;
    private string? track;
    private double Duration => Seconds(Player.Duration);
    private double RangeMaximum => Duration is > 0 and var length ? length : 1;
    private double Position => Math.Min(Seconds(preview ?? Player.Position), Duration);
    private double Percent => Duration is > 0 and var length ? Math.Min(1, Position / length) * 100 : 0;
    private bool CanSeek => Duration > 0 && Player.CanSeek && !Player.FollowingHost;
    private static double Seconds(double value) => double.IsFinite(value) ? Math.Max(0, value) : 0;
    private static string RangeNumber(double value) => value.ToString(CultureInfo.InvariantCulture);
    private static string Time(double seconds) => $"{(int)Math.Max(0, seconds) / 60}:{(int)Math.Max(0, seconds) % 60:00}";
    protected override void OnInitialized() { track = Player.Current?.Id; Player.Changed += Changed; Player.RemotePositionChanged += Changed; }
    private long lastRender;
    private void Changed() => _ = InvokeAsync(() => {
        if (!Player.UiActive || track == Player.Current?.Id && Environment.TickCount64 - lastRender < 1000) return;
        lastRender = Environment.TickCount64;
        if (track != Player.Current?.Id) { track = Player.Current?.Id; preview = null; }
        StateHasChanged();
    });
    private void Cancel() => preview = null;
    private void KeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") Cancel(); }
    private void Preview(ChangeEventArgs args)
    {
        if (!CanSeek) return;
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && double.IsFinite(value))
            preview = Math.Clamp(value, 0, Duration);
    }
    private async Task Commit(ChangeEventArgs args)
    {
        Preview(args);
        try { if (preview is { } value && CanSeek) await Player.SeekAsync(value); }
        finally { preview = null; }
    }
    public async ValueTask DisposeAsync()
    {
        Player.Changed -= Changed; Player.RemotePositionChanged -= Changed;
        if (observer is not null)
        {
            try { await observer.InvokeVoidAsync("disconnect"); await observer.DisposeAsync(); }
            catch (Exception error) when (PlaybackInterop.IsUnavailable(error))
            { PlaybackInterop.Report("familyhub.observeSeekBar.disconnect", error); }
        }
        visibility?.Dispose(); Player.SetSeekBarVisible(false);
    }
}
