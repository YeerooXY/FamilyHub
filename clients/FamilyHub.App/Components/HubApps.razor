@if (Current is null)
{
    <section class="hub-apps" aria-labelledby="view-title">
        <h1 id="view-title" class="hub-title">FamilyHub</h1>
        @AppGrid
    </section>
}
else
{
    @AppGrid
}

@code {
    [Parameter] public EventCallback<string> Open { get; set; }
    [Parameter] public string? Current { get; set; }

    private static readonly (string Route, string Label, string Icon, string Art, string Note)[] Apps =
    [
        ("Home", "Music", "music", "music", "Songs, playlists and radio"),
        ("Wordle", "Daily Wordle", "wordle", "word", "Puzzle, family boards and stats"),
        ("Movies & TV", "Movies & TV", "film", "movies", "Browse or continue watching"),
        ("Files", "Files", "folder", "files", "Family and private folders")
    ];
    public static string AppIcon(string route) => Apps.FirstOrDefault(app => app.Route == route).Icon ?? "home";
    public static string AppLabel(string route) => Apps.FirstOrDefault(app => app.Route == route).Label ?? "FamilyHub";

    private readonly ElementReference[] cards = new ElementReference[Apps.Length];
    private RenderFragment AppGrid => @<nav class="@(Current is null ? "hub-grid" : "switcher-grid")" aria-label="Apps">
        @for (var i = 0; i < Apps.Length; i++)
        {
            var index = i;
            var (route, label, icon, art, note) = Apps[index];
            <button id="@(Current is null ? null : $"switcher-app-{index}")" type="button"
                    class="@(Current is null ? $"hub-card hub-{art}" : null)" aria-current='@(Current == route ? "true" : null)'
                    @ref="cards[index]" @onkeydown="e => MoveFocus(index, e)" @onclick="() => Open.InvokeAsync(route)">
                @if (Current is not null)
                {
                    <MusicIcon Name="@icon" /><span>@label</span>
                }
                else
                {
                    <span class="hub-art" aria-hidden="true">
                        @if (route == "Wordle")
                        {
                            <span class="hub-board">
                                @foreach (var mark in BoardMarks) { <i class="@mark"></i> }
                            </span>
                        }
                        else
                        {
                            <img class="hub-image" src="@($"hub-art/{art}.webp")" alt="" width="768" height="768" decoding="async" />
                        }
                    </span>
                    <span class="hub-text"><span class="hub-label">@label</span><span class="hub-note">@note</span></span>
                }
            </button>
        }
    </nav>;

    // A game in progress: three guesses narrow the word, the fourth solves it, and two rows stay empty.
    private static readonly string[] BoardMarks = "absent present absent absent absent absent correct present absent correct correct correct present absent correct correct correct correct correct correct empty empty empty empty empty empty empty empty empty empty".Split(' ');

    // Arrow keys move between the four tiles, two by two, for a remote or a keyboard.
    private async Task MoveFocus(int from, KeyboardEventArgs e)
    {
        var next = e.Key switch
        {
            "ArrowRight" when from % 2 == 0 => from + 1,
            "ArrowLeft" when from % 2 == 1 => from - 1,
            "ArrowDown" when from < 2 => from + 2,
            "ArrowUp" when from >= 2 => from - 2,
            _ => -1
        };
        if (next >= 0) await cards[next].FocusAsync();
    }
}
