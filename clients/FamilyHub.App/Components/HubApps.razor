@implements IAsyncDisposable
@inject MusicSession Session
@inject IJSRuntime JS

@if (Current is null)
{
    <section class="hub-apps" aria-labelledby="view-title">
        <h1 id="view-title" class="hub-title">FamilyHub</h1>
        @AppGrid
    </section>
}
else
{
    @AppGrid
}

@code {
    [Parameter] public EventCallback<string> Open { get; set; }
    [Parameter] public string? Current { get; set; }

    private static readonly (string Route, string Label, string Icon, string Art, string Note)[] Apps =
    [
        ("Home", "Music", "music", "music", "Songs, playlists and radio"),
        ("Wordle", "Daily Wordle", "wordle", "word", "Puzzle, family boards and stats"),
        ("Movies & TV", "Movies & TV", "film", "movies", "Browse or continue watching"),
        ("Files", "Files", "folder", "files", "Family and private folders")
    ];
    public static string AppIcon(string route) => Apps.FirstOrDefault(app => app.Route == route).Icon ?? "home";
    public static string AppLabel(string route) => Apps.FirstOrDefault(app => app.Route == route).Label ?? "FamilyHub";

    private readonly ElementReference[] cards = new ElementReference[Apps.Length];
    private RenderFragment AppGrid => @<nav class="@(Current is null ? "hub-grid" : "switcher-grid")" aria-label="Apps">
        @for (var i = 0; i < Apps.Length; i++)
        {
            var index = i;
            var (route, label, icon, art, note) = Apps[index];
            <button id="@(Current is null ? null : $"switcher-app-{index}")" type="button"
                    class="@(Current is null ? $"hub-card hub-{art}" : null)" aria-current='@(Current == route ? "true" : null)'
                    @ref="cards[index]" @onkeydown="e => MoveFocus(index, e)" @onclick="() => Open.InvokeAsync(route)">
                @if (Current is not null)
                {
                    <MusicIcon Name="@icon" /><span>@label</span>
                }
                else
                {
                    <span class="hub-art" aria-hidden="true">
                        @if (route == "Wordle")
                        {
                            <span class="hub-board">
                                @foreach (var mark in BoardMarks) { <i class="@mark"></i> }
                            </span>
                        }
                        else
                        {
                            <img class="hub-image" src="@($"hub-art/{art}.webp")" alt="" width="768" height="768" decoding="async" />
                        }
                    </span>
                    <span class="hub-text">
                        <span class="hub-label">
                            @label
                            @if (route == "Movies & TV")
                            {
                                <span @ref="downloadIndicator" class="hub-download-ring" role="img" aria-label="Downloading" hidden></span>
                            }
                        </span>
                        <span class="hub-note">@note</span>
                    </span>
                }
            </button>
        }
    </nav>;

    private ElementReference downloadIndicator;
    private readonly CancellationTokenSource downloadWatch = new();
    private IJSObjectReference? downloadModule, downloadWatcher;
    private DotNetObjectReference<HubApps>? downloadCallback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Current is not null || Session.Api is null) return;
        try
        {
            downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./movies.js");
            if (downloadWatch.IsCancellationRequested) { await downloadModule.DisposeAsync(); return; }
            downloadCallback = DotNetObjectReference.Create(this);
            downloadWatcher = await downloadModule.InvokeAsync<IJSObjectReference>("watchHubDownloads",
                downloadIndicator, new { server = Session.Server, profile = Session.User }, downloadCallback);
            if (downloadWatch.IsCancellationRequested) await CloseDownloadWatcher();
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task<System.Text.Json.JsonElement?> HubMovieDownloads()
    {
        if (downloadWatch.IsCancellationRequested || Session.Api is not { } api) return null;
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(downloadWatch.Token);
        timeout.CancelAfter(TimeSpan.FromSeconds(5));
        try
        {
            return await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, "/api/movies/downloads",
                cancellationToken: timeout.Token);
        }
        catch (FamilyHubApiException error) when (error.StatusCode == 403)
        {
            return System.Text.Json.JsonSerializer.SerializeToElement(new { available = true, items = Array.Empty<object>() });
        }
        catch (Exception) { return null; }
    }

    private async ValueTask CloseDownloadWatcher()
    {
        if (downloadWatcher is not { } watcher) return;
        downloadWatcher = null;
        try { await watcher.InvokeVoidAsync("close"); await watcher.DisposeAsync(); }
        catch (Exception error) when (error is JSException or JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await downloadWatch.CancelAsync();
        await CloseDownloadWatcher();
        try { if (downloadModule is not null) await downloadModule.DisposeAsync(); }
        catch (Exception error) when (error is JSException or JSDisconnectedException) { }
        downloadCallback?.Dispose();
        downloadWatch.Dispose();
    }

    // A game in progress: three guesses narrow the word, the fourth solves it, and two rows stay empty.
    private static readonly string[] BoardMarks = "absent present absent absent absent absent correct present absent correct correct correct present absent correct correct correct correct correct correct empty empty empty empty empty empty empty empty empty empty".Split(' ');

    // Arrow keys move between the four tiles, two by two, for a remote or a keyboard.
    private async Task MoveFocus(int from, KeyboardEventArgs e)
    {
        var next = e.Key switch
        {
            "ArrowRight" when from % 2 == 0 => from + 1,
            "ArrowLeft" when from % 2 == 1 => from - 1,
            "ArrowDown" when from < 2 => from + 2,
            "ArrowUp" when from >= 2 => from - 2,
            _ => -1
        };
        if (next >= 0) await cards[next].FocusAsync();
    }
}
