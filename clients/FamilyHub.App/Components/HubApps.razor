<section class="hub-apps" aria-labelledby="view-title">
    <h1 id="view-title">FamilyHub</h1>
    <nav class="hub-grid" aria-label="Apps">
        <button class="hub-card hub-music" @ref="cards[0]" @onkeydown="e => MoveFocus(0, e)" @onclick='() => Open.InvokeAsync("Home")'>
            <span class="hub-art" aria-hidden="true"><img class="hub-image" src="hub-art/music.webp" alt="" width="768" height="768" decoding="async" /></span>
            <span class="hub-text"><span class="hub-label">Music</span><span class="hub-note">Songs, playlists and radio</span></span>
        </button>
        <button class="hub-card hub-word" @ref="cards[1]" @onkeydown="e => MoveFocus(1, e)" @onclick='() => Open.InvokeAsync("Wordle")'>
            <span class="hub-art" aria-hidden="true"><img class="hub-image" src="hub-art/wordle.webp" alt="" width="768" height="768" decoding="async" /></span>
            <span class="hub-text"><span class="hub-label">Daily Wordle</span><span class="hub-note">One word a day</span></span>
        </button>
        <button class="hub-card hub-movies" @ref="cards[2]" @onkeydown="e => MoveFocus(2, e)" @onclick='() => Open.InvokeAsync("Movies & TV")'>
            <span class="hub-art" aria-hidden="true"><img class="hub-image" src="hub-art/movies.webp" alt="" width="768" height="768" decoding="async" /></span>
            <span class="hub-text"><span class="hub-label">Movies &amp; TV</span><span class="hub-note">Your films and series</span></span>
        </button>
        <button class="hub-card hub-files" @ref="cards[3]" @onkeydown="e => MoveFocus(3, e)" @onclick='() => Open.InvokeAsync("Files")'>
            <span class="hub-art" aria-hidden="true"><img class="hub-image" src="hub-art/files.webp" alt="" width="768" height="768" decoding="async" /></span>
            <span class="hub-text"><span class="hub-label">Files</span><span class="hub-note">Family and private folders</span></span>
        </button>
    </nav>
</section>
@code {
    [Parameter] public EventCallback<string> Open { get; set; }
    private readonly ElementReference[] cards = new ElementReference[4];

    // Arrow keys move between the four tiles, two by two, for a remote or a keyboard.
    private async Task MoveFocus(int from, KeyboardEventArgs e)
    {
        var next = e.Key switch
        {
            "ArrowRight" when from % 2 == 0 => from + 1,
            "ArrowLeft" when from % 2 == 1 => from - 1,
            "ArrowDown" when from < 2 => from + 2,
            "ArrowUp" when from >= 2 => from - 2,
            _ => -1
        };
        if (next >= 0) await cards[next].FocusAsync();
    }
}
