    private Task OpenPlaylistReviewGap(PlaylistReviewGap gap) => Run(async () =>
    {
        MusicPlaylist? FindPlaylist() => Session.Playlists.FirstOrDefault(p => p.Id == gap.PlaylistId
            && (p.OwnerId == gap.OwnerId || p.OwnerId.Length == 0 && gap.OwnerId == Session.User));
        var playlist = FindPlaylist();
        if (playlist is null || playlist.Tracks.ElementAtOrDefault(gap.Index) is not { } current
            || current.Title != gap.Title || current.Artist != gap.Artist)
        {
            await Session.RefreshAsync();
            if (view != "Stats") return;
            playlist = FindPlaylist();
        }
        if (playlist is null)
        {
            error = "This playlist is unavailable. Refresh the review and try again.";
            return;
        }

        bool SameSong(PlaylistTrack entry) => entry.Title == gap.Title && entry.Artist == gap.Artist;
        var index = gap.Index >= 0 && gap.Index < playlist.Tracks.Count && SameSong(playlist.Tracks[gap.Index])
            ? gap.Index : -1;
        if (index < 0)
        {
            var matches = Enumerable.Range(0, playlist.Tracks.Count).Where(i => SameSong(playlist.Tracks[i])).Take(2).ToList();
            if (matches.Count == 1) index = matches[0];
        }

        await OpenPlaylist(playlist);
        if (index >= 0 && playlist.CanEdit && gap.CanEdit)
        {
            initialPlaylistReviewIndex = index;
            pendingFocus = "playlist-transfer-progress";
        }
        else
        {
            songSearch = gap.Title;
            songSearchOpen = true;
            pendingFocus = "view-title";
        }
    });
