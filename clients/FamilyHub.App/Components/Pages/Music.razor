    private async Task CheckStartupUpdate(string origin, bool background = false)
    {
        if (updateChecksStopped || updateCheckInFlight || AppUpdater.Platform is null || Session.Api is null || (background && DateTime.UtcNow - lastUpdateCheck < TimeSpan.FromMinutes(1))) return;
        updateCheckInFlight = true; lastUpdateCheck = DateTime.UtcNow;
        try
        {
            using var api = new FamilyHubApi(new Uri(origin));
            var release = await AppUpdater.CheckAsync(api);
            if (!updateChecksStopped && Session.Server == origin && release is not null && release.Version != startupUpdate?.Version)
            {
                startupUpdate = release; updateNoticeDismissed = background; updateDialogOpened = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* Retry quietly on the next scheduled check. */ }
        finally { updateCheckInFlight = false; }
    }
