        if (EntryScreen)
        {
            if (view != "Settings" || string.IsNullOrEmpty(Session.User) || Session.NeedsProfileSelection) return false;
            view = "Home"; StateHasChanged(); return true;
        }
        if (playerToolsOpen) await ClosePlayerTools();
        else if (lyricsOpen) { var sheet = lyricsReopenSheet; SetLyricsOpen(false); pendingFocus = sheet ? "lyrics-preview" : "player-more"; }
        else if (playerExpanded) CollapsePlayer();
        else if (profileMenu) { profileMenu = false; pendingFocus = "profile-toggle"; }
        else if (view == "Playlists" && Selected is not null) await AllPlaylists();
        else if (backViews.Count > 0) GoBack();
        else if (view != "Home") await Navigate("Home");
        else return false;
        StateHasChanged();
        return true;
    }
    public void Dispose() { if (BackNavigation.Handler is not null) BackNavigation.Handler = null; updateChecksStopped = true; _ = JS.InvokeVoidAsync("familyhub.stopUpdatePolling"); resizeReference?.Dispose(); queueNoticeTimer?.Cancel(); queueNoticeTimer?.Dispose(); radioCancellation?.Cancel(); radioCancellation?.Dispose(); CancelSearch(); Session.Changed -= Changed; Player.Changed -= PlayerChanged; }
    private void RememberView(string tab)
    {
        if (view == tab) return;
        backViews.Push(view); forwardViews.Clear(); view = tab;
    }
    private async Task Navigate(string tab)
    {
        if (tab != "Search") CancelSearch();
        initialPlaylistReviewIndex = null;
        if (tab == "Playlists") selectedId = "";
        RememberView(tab); profileMenu = false; error = null; genre = "";
        if (tab == "Settings") server = Session.Server;
        pendingFocus = tab == "Stats" ? "view-title" : "content";
        await Task.CompletedTask;
    }
    private void GoBack()
    {
        if (!backViews.TryPop(out var tab)) return;
        initialPlaylistReviewIndex = null;
        var albumOpener = view == "Album" && tab == "Home" ? selectedAlbum?.Opener : null;
        CancelSearch(); forwardViews.Push(view); view = tab; profileMenu = false; error = null; pendingFocus = albumOpener ?? "content";
    }
    private void GoForward()
    {
        if (!forwardViews.TryPop(out var tab)) return;
        initialPlaylistReviewIndex = null;
        CancelSearch(); backViews.Push(view); view = tab; profileMenu = false; error = null; pendingFocus = "content";
    }
    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null;
        try { await action(); }
        catch (Exception exception) { error = exception is OperationCanceledException ? "The request timed out. Try again." : exception.Message; }
        finally { busy = false; }
    }
    private async Task RunPlayback(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (Exception exception) { error = exception.Message; }
    }
    private Task Connect() => Run(async () => { await Session.SavePlaybackAsync(Player.CaptureResume()); await Player.StopAsync(); await Session.ConnectServerAsync(server); ResetProfileView(); });
    private void CancelSearch()
    {
        searchVersion++; searchCancellation?.Cancel(); searchCancellation?.Dispose();
        searchCancellation = null; searching = false; searchStatus = ""; loadingMore = false; nextSearchOffset = null; moreSearchFailed = false;
    }
    private async Task SearchInput(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";
        CancelSearch();
        if (query.Trim().Length < 2) { searchResults = []; return; }
        var cancellation = searchCancellation = new CancellationTokenSource();
        var version = searchVersion;
        var token = cancellation.Token;
        try { await Task.Delay(450, token); await SearchResults(version, token); }
        catch (OperationCanceledException) { }
    }
    private async Task Search()
    {
        CancelSearch();
        if (string.IsNullOrWhiteSpace(query)) { await JS.InvokeVoidAsync("familyhub.focus", "q"); return; }
        searchCancellation = new CancellationTokenSource();
        await SearchResults(searchVersion, searchCancellation.Token, submitted: true);
    }
    private async Task SearchResults(int version, CancellationToken cancellationToken, bool submitted = false)
    {
        if (version != searchVersion || cancellationToken.IsCancellationRequested) return;
        RememberView("Search"); error = null; recommendations = null;
        var searchQuery = query.Trim();
        var words = searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        searchResults = Session.Library.Where(t => words.All(w =>
            (t.Title + " " + t.Channel).Contains(w, StringComparison.OrdinalIgnoreCase))).Take(8).ToList();
        searching = searchResults.Count == 0; searchStatus = "Searching";
        await InvokeAsync(StateHasChanged);
        if (submitted) await JS.InvokeVoidAsync("familyhub.searchSubmitted");
        try
        {
            SearchPage results;
            var background = false;
            do
            {
                results = await Session.SearchPageAsync(searchQuery, 0, cancellationToken, background);
                background = true;
                if (version != searchVersion || cancellationToken.IsCancellationRequested) return;
                SearchPage.AppendNew(searchResults, results.Tracks);
                searching = searchResults.Count == 0 && !results.Complete;
                nextSearchOffset = results.Complete ? results.NextOffset : null;
                searchStatus = results.Complete ? $"{searchResults.Count} search results" : $"{searchResults.Count} results. Searching for more songs";
                await InvokeAsync(StateHasChanged);
                if (!results.Complete) await Task.Delay(500, cancellationToken);
            } while (!results.Complete);
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) { if (version == searchVersion) error = exception.Message; }
        finally { if (version == searchVersion) searching = false; }
    }
    [JSInvokable] public Task LoadMoreSearchInBackground(int version) => LoadMoreSearch(version, background: true);
    private async Task LoadMoreSearch(int version, bool background = false)
    {
        if (version != searchVersion || view != "Search" || searching || loadingMore || nextSearchOffset is not { } offset || searchCancellation is null) return;
        loadingMore = true; moreSearchFailed = false; error = null;
        var token = searchCancellation.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            var page = await Session.SearchPageAsync(query.Trim(), offset, token, background);
            if (version != searchVersion || token.IsCancellationRequested) return;
            SearchPage.AppendNew(searchResults, page.Tracks);
            nextSearchOffset = page.NextOffset > offset ? page.NextOffset : null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (version == searchVersion) { error = ex.Message; moreSearchFailed = true; } }
        finally { if (version == searchVersion) { loadingMore = false; await InvokeAsync(StateHasChanged); } }
    }
    private Task PlayRow(MusicTrack track, List<MusicTrack> sequence, int? position) => view == "Search" ? PlaySearchResult(track) : RunPlayback(() => Player.PlayAsync(track, sequence, position, source: view == "Similar songs" ? "auto_dj" : "library"));
    private Task PlaySearchResult(MusicTrack track) => RunPlayback(() => Player.PlayAsync(track, Session.AutoplayQueue(track), source: "search"));
    private CancellationTokenSource? radioCancellation;
    private string? radioProgress;
    // The normal library refresh is every three minutes; radio needs each new recording now.
    private async Task FillRadioQueue(MusicPlaylist radio, MusicTrack seed, string identity, CancellationToken token)
    {
        var api = Session.Api!;
        var queued = new HashSet<string> { seed.Id };
        var songs = new HashSet<string> { Similarity.SongKey(seed) };
        var paused = false;
        bool Current() => !token.IsCancellationRequested && identity == AppearanceKey && Session.Connected && !Player.FollowingHost && !Player.RemoteActive
            && Player.Current is { } current && queued.Contains(current.Id) && Player.Queue.All(t => queued.Contains(t.Id));
        try
        {
            while (Current())
            {
                var status = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, "/api/playlists/" + radio.Id + "/prepare", cancellationToken: token, background: true);
                if (!Current()) return;
                await Session.RefreshAsync(background: true);
                if (!Current()) return;
                var playlist = Session.Playlists.FirstOrDefault(p => PlaylistKey(p) == PlaylistKey(radio));
                if (playlist is null) return;
                foreach (var track in Session.RankRecommendations(playlist.Tracks.Select(Session.Resolve).OfType<MusicTrack>()))
                    if (track is not null && songs.Add(Similarity.SongKey(track)) && queued.Add(track.Id)
                        && !Player.Queue.Any(t => t.Id == track.Id)) Player.AddToQueue(track, manual: false);
                var ready = playlist.Tracks.Count(t => Session.Resolve(t) is not null);
                var state = status.GetProperty("state").GetString();
                if (state == "error")
                {
                    error = "Radio could not find songs. Try another radio.";
                    return;
                }
                paused = state is "paused" or "pausing";
                radioProgress = paused ? "Radio preparation paused. Resume in the playlist."
                    : playlist.Tracks.Count == 0 ? "Finding radio songs..."
                    : $"Radio: {ready} of {playlist.Tracks.Count} songs ready.";
                await InvokeAsync(StateHasChanged);
                var downloadQueued = status.TryGetProperty("download_after_matching", out var download) && download.ValueKind == System.Text.Json.JsonValueKind.True;
                if (paused || state == "done" && !downloadQueued) return;
                await Task.Delay(1500, token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception) { if (Current()) { error = "Radio preparation was interrupted. Open the playlist to check its progress."; await InvokeAsync(StateHasChanged); } }
        finally { if (!token.IsCancellationRequested && identity == AppearanceKey) { if (!paused || !Current()) radioProgress = null; await InvokeAsync(StateHasChanged); } }
    }
    private Task StartSongRadio(MusicTrack seed) => !Session.Connected || Player.FollowingHost || busy ? Task.CompletedTask : Run(async () =>
    {
        radioCancellation?.Cancel(); radioCancellation?.Dispose(); radioProgress = null;
        var identity = AppearanceKey;
        var origin = view;
        var originPlaylist = selectedId;
        var revision = Player.UserPlaybackRevision + 1;
        await Player.PlayAsync(seed, [seed], source: "radio");
        bool RadioIsCurrent() => identity == AppearanceKey && !Player.FollowingHost && !Player.RemoteActive
            && Player.Current?.Id == seed.Id && Player.UserPlaybackRevision == revision;
        if (!RadioIsCurrent()) return;

        MusicPlaylist radio;
        radioProgress = "Finding radio songs...";
        try { radio = await Session.StartRadioAsync(Similarity.Artist(seed), Similarity.RadioTitle(seed)); }
        finally { radioProgress = null; }
        if (!RadioIsCurrent()) return;
        radioCancellation = new();
        _ = FillRadioQueue(radio, seed, identity, radioCancellation.Token);
        if (view == origin && selectedId == originPlaylist)
        {
            await JS.InvokeVoidAsync("familyhub.focus", "content");
            playerToolsOpen = false; playerExpanded = false; lyricsOpen = false;
            await OpenPlaylist(radio);
        }
    });
    private Task Recommend() => Run(async () =>
    {
        if (Player.Current is null) throw new InvalidOperationException("Play a song first.");
        var seed = Player.Current;
        recommendationTitle = seed.Title; recommendations = await Session.SimilarAsync(seed);
        if (recommendations.Count > 0 && !Player.ReplaceUpcoming(seed.Id, recommendations))
            throw new InvalidOperationException("The playing song changed. Press Similar songs again.");
        await Navigate("Similar songs");
    });
    private void PlaylistCreated(MusicPlaylist playlist) { selectedId = PlaylistKey(playlist); pendingFocus = "view-title"; StateHasChanged(); }
    private Task RemoveEntry(MusicPlaylist playlist, int index) => Run(async () => { await JS.InvokeVoidAsync("familyhub.focus", "content"); await Session.EditPlaylistAsync(playlist, new { remove_index = index }); pendingFocus = "view-title"; });
    private Task PlayPlaylist(List<MusicTrack> tracks) => RunPlayback(async () =>
    {
        var available = Session.Connected ? tracks : tracks.Where(t => Session.LocalPath(t) is not null).ToList();
        if (available.Count == 0) throw new InvalidOperationException("No playable recordings are available. Download songs while connected.");
        // Shuffle starts at a random song but keeps the list's order; the player picks each next song
        // at random, so turning shuffle off continues in playlist order from the current song.
        if (Player.Shuffle) { var start = Random.Shared.Next(available.Count); available = available.Skip(start).Concat(available.Take(start)).ToList(); }
        await Player.PlayAsync(available[0], available, source: view == "Playlists" && Selected is { } playlist ? "playlist:" + playlist.Id : "library");
    });
    private ListenerProfile PlaylistOwner(MusicPlaylist playlist) => Session.Profiles.FirstOrDefault(p => p.Id == playlist.OwnerId) ?? new() { Id = playlist.OwnerId, Name = playlist.OwnerName };
    private ListenerProfile PlaylistContributor(MusicPlaylist playlist, PlaylistTrack entry) => string.IsNullOrEmpty(entry.AddedBy)
        ? PlaylistOwner(playlist)
        : Session.Profiles.FirstOrDefault(p => p.Id == entry.AddedBy)
            ?? new() { Id = entry.AddedBy, Name = entry.AddedBy == playlist.OwnerId ? playlist.OwnerName : "Unknown" };
    private static string PlaylistLength(MusicPlaylist playlist)
    {
        var seconds = (long)Math.Max(0, playlist.Tracks.Sum(t => t.Duration));
        return seconds >= 3600 ? $"{seconds / 3600} hr {seconds % 3600 / 60} min" : $"{seconds / 60} min {seconds % 60} sec";
    }
