    // The opening screen plays once per launch. It stays for at least MinimumSplash and until the app is ready: the saved
    // profile is read, the first server check has settled (or 6 seconds passed) and the layout is prepared. It then
    // fades out over the app, so no half-loaded screen, empty list or connection notice shows first.
    private enum SplashState { Showing, Leaving, Gone }
    private static bool splashPlayed;
    private SplashState splash = splashPlayed ? SplashState.Gone : SplashState.Showing;
    private const int MinimumSplash = 2800;
    private async Task RunSplash()
    {
        splashPlayed = true;
        var minimum = Task.Delay(MinimumSplash);
        while (!(Session.Ready && chromeReady)) await Task.Delay(40);
        await Task.WhenAll(minimum, Task.WhenAny(Session.FirstConnection, Task.Delay(6000)));
        splash = SplashState.Leaving;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(820);
        splash = SplashState.Gone;
        await InvokeAsync(StateHasChanged);
    }

