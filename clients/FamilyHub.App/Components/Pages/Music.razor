    private Task PlayPlaylist(IEnumerable<MusicTrack> tracks, string source, long? originalRequest = null,
        MusicPlaylist? follow = null, List<int>? positions = null) => RunPlaybackAt(async requestedAt =>
    {
        var available = Session.Connected ? tracks as List<MusicTrack> ?? tracks.ToList() : tracks.Where(t => Session.LocalPath(t) is not null).ToList();
        if (available.Count == 0) throw new InvalidOperationException("No playable recordings are available. Download songs while connected.");
        // Shuffle starts at a random song but keeps the list's order; the player picks each next song
        // at random, so turning shuffle off continues in playlist order from the current song.
        if (Player.Shuffle) { var start = Random.Shared.Next(available.Count); available = available.Skip(start).Concat(available.Take(start)).ToList(); }
        var revision = Player.UserPlaybackRevision + 1;
        var identity = AppearanceKey;
        await Player.PlayAsync(available[0], available, source: source, requestedAt: requestedAt);
        if (follow is not null && positions is not null && Session.Connected && Player.UserPlaybackRevision == revision)
            _ = FollowPlaylistPreparation(follow, positions, available, revision, identity);
    }, originalRequest);
    private bool musicDisposed;
    private async Task FollowPlaylistPreparation(MusicPlaylist playlist, List<int> positions, List<MusicTrack> initial,
        long revision, string identity, long? startAt = null, long? startRequest = null)
    {
        var api = Session.Api!;
        var owner = string.IsNullOrEmpty(playlist.OwnerId) ? "" : "&owner_id=" + Uri.EscapeDataString(playlist.OwnerId);
        var path = "/api/playlists/" + Uri.EscapeDataString(playlist.Id) + "/prepare?follow=1" + owner;
        var queued = initial.Select(t => t.Id).ToHashSet();
        var originalEntries = positions.Count == playlist.Tracks.Count ? null
            : positions.Select(i => PlaylistSongs.EntryKey(playlist.Tracks[i])).ToHashSet();
        bool Current() => !musicDisposed && identity == AppearanceKey && Session.Connected
            && Player.UserPlaybackRevision == revision && !Player.FollowingHost && !Player.RemoteActive
            && (startAt is null || playbackNoticeVersion == startRequest);
        try
        {
            using var timeout = new CancellationTokenSource();
            while (Current())
            {
                timeout.CancelAfter(TimeSpan.FromSeconds(20));
                var status = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, path,
                    cancellationToken: timeout.Token, background: true);
                if (!Current()) return;
                await Session.RefreshCatalogueAsync(timeout.Token);
                if (!Current()) return;
                var updated = Session.Playlists.FirstOrDefault(p => PlaylistKey(p) == PlaylistKey(playlist));
                if (updated is null) return;
                var active = PlaylistSongs.PreparationActive(status);
                var ready = PlaylistSongs.NewlyPrepared(updated, Session.Resolve, originalEntries, queued, active);
                if (startAt is { } requestedAt)
                {
                    var available = ready.ToList();
                    if (available.Count > 0)
                    {
                        await Player.PlayAsync(available[0], available, source: "playlist:" + playlist.Id, requestedAt: requestedAt);
                        revision++;
                        startAt = null;
                        if (albumWaiting == startRequest) { albumWaiting = null; await InvokeAsync(StateHasChanged); }
                        if (!Current()) return;
                    }
                    else if (!active)
                        Session.SetMessage("No album songs could start. Retry playing the album or check its playlist for recording choices.", "warning");
                }
                else
                {
                    var appended = false;
                    foreach (var track in ready)
                    {
                        Player.AddToQueue(track, manual: false);
                        appended = true;
                    }
                    if (appended) _ = ContinuePreparedQueue(revision);
                }
                if (!active)
                {
                    if (startRequest is not null && startAt is null && positions.Any(i => updated.Tracks.ElementAtOrDefault(i) is { } entry && Session.Resolve(entry) is null))
                        Session.SetMessage("Some album songs are still missing. Play the album again to retry, or open its playlist to choose recordings.", "warning");
                    return;
                }
                timeout.CancelAfter(Timeout.InfiniteTimeSpan);
                await Task.Delay(TimeSpan.FromSeconds(3));
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or FamilyHubApiException or IOException or OperationCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            if (Current()) Session.SetMessage(startRequest is null
                ? "Playlist progress could not load. Play the playlist again to check for more songs."
                : "Album progress could not load. Play the album again to check for more songs.", "warning");
        }
        finally
        {
            if (startRequest is not null && albumWaiting == startRequest)
            {
                albumWaiting = null;
                if (!musicDisposed) await InvokeAsync(StateHasChanged);
            }
        }
    }
    private async Task ContinuePreparedQueue(long revision)
    {
        try { await Player.ContinueQueueAsync(revision); }
        catch (Exception) { if (!musicDisposed && Player.UserPlaybackRevision == revision) Session.SetMessage("The next song could not start. Choose a song from the queue.", "error"); }
    }
