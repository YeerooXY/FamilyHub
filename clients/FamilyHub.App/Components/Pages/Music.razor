            Player.RemoteActive, Player.RemotePeek, Player.Queue.Count, Player.QueueIndex, NextTrack?.Id, Player.Shuffle, Player.RepeatMode, Player.Volume, Player.AudioOutputId, Together.LocallyPaused);
        if (Equals(state, playerState)) return;
        if (Player.Current is not { Saved: true })
            await JS.InvokeVoidAsync("familyhub.focusIfWithin", ".player-tools .trim-request", "recommend-similar");
        if (Player.Current is null)
            await JS.InvokeVoidAsync("familyhub.focusIfWithin", "#sheet-add-playlist,#sheet-queue,#sheet-lyrics", "listen-together");
        playerState = state; StateHasChanged();
    });
