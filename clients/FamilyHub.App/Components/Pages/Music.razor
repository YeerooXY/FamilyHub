    private CancellationTokenSource? radioCancellation;
    private string? radioProgress;
    // The normal library refresh is every three minutes; radio needs each new recording now.
    private async Task FillRadioQueue(MusicPlaylist radio, MusicTrack seed, string identity, bool startedSeed, CancellationToken token)
    {
        var api = Session.Api!;
        var queued = Player.Queue.Select(t => t.Id).Append(seed.Id).ToHashSet();
        var songs = new HashSet<string> { Similarity.SongKey(seed) };
        var paused = false;
        var started = false;
        var revision = Player.UserPlaybackRevision;
        var currentId = Player.Current?.Id;
        bool Current() => !token.IsCancellationRequested && identity == AppearanceKey && Session.Connected && !Player.FollowingHost && !Player.RemoteActive
            && (started ? Player.Current is { } current && queued.Contains(current.Id) && Player.Queue.All(t => queued.Contains(t.Id))
                        : Player.Current?.Id == currentId && Player.UserPlaybackRevision == revision);
        try
        {
            while (Current())
            {
                var status = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, "/api/playlists/" + radio.Id + "/prepare", cancellationToken: token, background: true);
                if (!Current()) return;
                await Session.RefreshAsync(background: true);
                if (!Current()) return;
                var playlist = Session.Playlists.FirstOrDefault(p => PlaylistKey(p) == PlaylistKey(radio));
                if (playlist is null) return;
                var candidates = Session.RankRecommendations(playlist.Tracks.Select(Session.Resolve).OfType<MusicTrack>())
                    .Where(t => t.Id != seed.Id && Similarity.SongKey(t) != Similarity.SongKey(seed)).ToList();
                if (!started && candidates.Count > 0)
                {
                    if (!startedSeed && !Player.ReplaceUpcoming(seed.Id, candidates, source: "radio"))
                    {
                        await Task.Delay(1500, token);
                        continue;
                    }
                    started = true;
                    queued = Player.Queue.Select(t => t.Id).Append(seed.Id).ToHashSet();
                    songs = Player.Queue.Select(Similarity.SongKey).Append(Similarity.SongKey(seed)).ToHashSet();
                }
                foreach (var track in started ? candidates : [])
                    if (track is not null && songs.Add(Similarity.SongKey(track)) && queued.Add(track.Id)
                        && !Player.Queue.Any(t => t.Id == track.Id)) Player.AddToQueue(track, manual: false);
                var ready = playlist.Tracks.Count(t => Session.Resolve(t) is not null);
                var state = status.GetProperty("state").GetString();
                if (state == "error")
                {
                    error = started || startedSeed ? "Radio could not find more songs. Try another artist."
                        : "Radio could not find songs. Your queue is unchanged. Retry from the radio playlist or choose another artist.";
                    return;
                }
                paused = state is "paused" or "pausing";
                radioProgress = paused ? "Radio preparation paused. Resume in the playlist."
                    : playlist.Tracks.Count == 0 ? "Finding radio songs..."
                    : $"Radio: {ready} of {playlist.Tracks.Count} songs ready.";
                await InvokeAsync(StateHasChanged);
                var downloadQueued = status.TryGetProperty("download_after_matching", out var download) && download.ValueKind == System.Text.Json.JsonValueKind.True;
                if (paused || (state is "done" or "idle") && !downloadQueued)
                {
                    if (!started) error = startedSeed ? "Radio has no more songs ready. Retry from the radio playlist or choose another artist."
                        : "Radio has no songs ready. Your queue is unchanged. Retry from the radio playlist or choose another artist.";
                    return;
                }
                await Task.Delay(1500, token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception) { if (Current()) { error = "Radio preparation was interrupted. Open the playlist to check its progress."; await InvokeAsync(StateHasChanged); } }
        finally { if (!token.IsCancellationRequested && identity == AppearanceKey) { if (!paused || !Current()) radioProgress = null; await InvokeAsync(StateHasChanged); } }
    }
    private Task StartHomeRadio((MusicTrack Track, bool ArtistOnly) seed) => StartSongRadio(seed.Track, seed.ArtistOnly);
