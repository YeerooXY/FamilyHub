    private static readonly (string Id, string Label, string Icon)[] SettingsCategories =
    [
        ("general", "Profile", "person"),
        ("music", "Music", "music"),
        ("movies", "Movies & TV", "film"),
        ("wordle", "Wordle", "wordle"),
        ("appearance", "Appearance", "sparkle"),
        ("storage", "Storage and downloads", "download"),
        ("about", "Server and updates", "info-circle"),
        ("server", "Server", "device")  // Administrators only; the list above hides it from everyone else.
    ];
    private string settingsSection = "general";
    private bool ServerSettingsOpen => view == "Preferences" && settingsSection == "server";
    private bool settingsDrilled, appSwitcherOpen;
    private string SwitcherApp => view is "Hub" or "Wordle" or "Movies & TV" or "Files" ? view : "Home";

    private async Task OpenAppSwitcher()
    {
