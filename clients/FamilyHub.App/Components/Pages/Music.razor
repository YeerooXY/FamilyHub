    private async Task StepHistory(bool forward, bool header = false)
    {
        if (steppingHistory) return;
        var current = CurrentRoute;
        ViewRoute destination;
        if (!(forward ? viewHistory.TryForward(current, out destination) : viewHistory.TryBack(current, out destination))) return;
        steppingHistory = true;
        try
        {
            initialPlaylistReviewIndex = null;
            CancelSearch();
            CancelAlbumLookup();
            if (destination.Album is { } album && selectedAlbum != destination.Album)
            {
                selectedAlbum = album;
                fullAlbum = preparedAlbum = null;
                albumFailed = false; albumWaiting = null;
            }
            view = destination.Tab;
            if (view == "Preferences") settingsDrilled = false;
            movieRoute = destination.Movie;
            if (view == "Playlists") selectedId = destination.Playlist;
            profileMenu = false; error = null; playbackRetry = null;
            var arrow = header && !(forward ? viewHistory.CanForward : viewHistory.CanBack)
                ? (forward ? "header-forward" : "header-back") : null;
            keepMovieInitialFocus = view == "Movies & TV" && arrow is not null;
            if (view == "Movies & TV" && current.Tab == view && moviesView is not null)
            {
                await moviesView.RestoreNavigation(movieRoute, arrow is not null);
                if (arrow is not null && view == destination.Tab && movieRoute == destination.Movie) pendingFocus = arrow;
            }
            else
                pendingFocus = arrow ?? (view == "Home" && current.Album is { } previousAlbum ? previousAlbum.Opener :
                    view == "Playlists" && Selected is null && current.Playlist.Length > 0 &&
                    FilteredPlaylists().Any(playlist => PlaylistKey(playlist) == current.Playlist) ? "playlist-card-" + current.Playlist :
                    view is "Album" or "Playlists" or "Preferences" ? "view-title" : "content");
            if (view == "Album" && fullAlbum is null) _ = LoadAlbum();
        }
        finally { steppingHistory = false; }
    }
    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null; playbackRetry = null; searchFailed = false;
        try { await action(); }
        catch (FamilyHubApiException failure) when (failure.RequiresSignIn && !EntryScreen)
        {
            await Session.ReconnectAsync();
            error = Session.Connected ? "Your session was restored. Try the action again." : NoticeText.Error(failure);
        }
        catch (Exception exception) { error = NoticeText.Error(exception); }
        finally { busy = false; }
    }
    private async Task RunPlayback(Func<Task> action)
    {
        var version = ++playbackNoticeVersion;
        error = null; playbackRetry = null; searchFailed = false;
        if (Session.PlaybackMessage) Session.SetMessage("");
        try { await action(); }
        catch (Exception exception)
        {
            if (version != playbackNoticeVersion) return;
            error = NoticeText.Error(exception, "Playback could not start. Try again.");
            playbackRetry = action;
        }
    }
    private Task RunPlaybackAt(Func<long, Task> action, long? originalRequest = null)
    {
        originalRequest ??= MusicPlayer.PlaybackTimestamp();
        return RunPlayback(() =>
        {
            var requestedAt = originalRequest ?? MusicPlayer.PlaybackTimestamp();
            originalRequest = null;
            return action(requestedAt);
        });
    }
    private Task Connect() => Run(async () =>
    {
        try
        {
            await Session.ConnectServerAsync(server, async () =>
            {
                await Session.SavePlaybackAsync(Player.CaptureResume());
                await Player.StopAsync();
            });
            connectFailed = false;
            ResetProfileView();
        }
        catch (Exception failure) when (failure is OperationCanceledException or FamilyHubApiException { StatusCode: >= 500 } ||
            failure.InnerException is HttpRequestException { HttpRequestError: not HttpRequestError.SecureConnectionError })
        {
            connectFailed = true;
        }
        catch { connectFailed = false; throw; }
    });
    private void CancelSearch()
    {
        searchVersion++; searchCancellation?.Cancel(); searchCancellation?.Dispose();
        searchCancellation = null; searching = false; searchStatus = ""; loadingMore = false; nextSearchOffset = null; moreSearchFailed = false; searchFailed = false;
    }
    private async Task SearchInput(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";
        CancelSearch();
        if (query.Trim().Length < 2) { searchResults = []; return; }
        var cancellation = searchCancellation = new CancellationTokenSource();
        var version = searchVersion;
        var token = cancellation.Token;
        try { await Task.Delay(450, token); await SearchResults(version, token); }
        catch (OperationCanceledException) { }
    }
    private async Task Search()
    {
        CancelSearch();
        if (string.IsNullOrWhiteSpace(query)) { await JS.InvokeVoidAsync("familyhub.focus", "q"); return; }
        searchCancellation = new CancellationTokenSource();
        await SearchResults(searchVersion, searchCancellation.Token, submitted: true);
    }
    private async Task RetrySongSearch()
    {
        if (retryingSearch || searchCancellation is null) return;
        retryingSearch = true;
        try { await SearchResults(searchVersion, searchCancellation.Token); }
        finally { retryingSearch = false; }
    }
    private async Task SearchResults(int version, CancellationToken cancellationToken, bool submitted = false)
    {
        if (version != searchVersion || cancellationToken.IsCancellationRequested) return;
        RememberView("Search"); error = null; playbackRetry = null;
        var searchQuery = query.Trim();
        var words = searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        searchResults = Session.Library.Where(t => words.All(w =>
            (t.Title + " " + t.Channel).Contains(w, StringComparison.OrdinalIgnoreCase))).Take(8).ToList();
        searching = searchResults.Count == 0; searchStatus = "Searching";
        await InvokeAsync(StateHasChanged);
        if (submitted) await JS.InvokeVoidAsync("familyhub.searchSubmitted");
        try
        {
            SearchPage results;
            var background = false;
            do
            {
                results = await Session.SearchPageAsync(searchQuery, 0, cancellationToken, background);
                background = true;
                if (version != searchVersion || cancellationToken.IsCancellationRequested) return;
                SearchPage.AppendNew(searchResults, results.Tracks);
                searching = searchResults.Count == 0 && !results.Complete;
                nextSearchOffset = results.Complete ? results.NextOffset : null;
                searchStatus = results.Complete ? $"{searchResults.Count} search results" : $"{searchResults.Count} results. Searching for more songs";
                await InvokeAsync(StateHasChanged);
                if (!results.Complete) await Task.Delay(500, cancellationToken);
            } while (!results.Complete);
            searchFailed = searchUnavailable = false;
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            if (version == searchVersion)
            {
                error = NoticeText.Error(exception, "Search could not finish.");
                searchFailed = true;
                searchUnavailable = !Session.Connected || exception is HttpRequestException or FamilyHubApiException { StatusCode: >= 500 };
            }
        }
        finally { if (version == searchVersion) searching = false; }
    }
    [JSInvokable] public Task LoadMoreSearchInBackground(int version) => LoadMoreSearch(version, background: true);
    private async Task LoadMoreSearch(int version, bool background = false)
    {
        if (version != searchVersion || view != "Search" || searching || loadingMore || nextSearchOffset is not { } offset || searchCancellation is null) return;
        loadingMore = true; moreSearchFailed = false; error = null;
        var token = searchCancellation.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            var page = await Session.SearchPageAsync(query.Trim(), offset, token, background);
            if (version != searchVersion || token.IsCancellationRequested) return;
            SearchPage.AppendNew(searchResults, page.Tracks);
            nextSearchOffset = page.NextOffset > offset ? page.NextOffset : null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (version == searchVersion) { error = NoticeText.Error(ex, "More songs could not load. Try again."); moreSearchFailed = true; } }
        finally { if (version == searchVersion) { loadingMore = false; await InvokeAsync(StateHasChanged); } }
    }
