        else await Navigate("Hub");
        pendingFocus = "profile-toggle";
    }
    private string view = "Hub", server = "", filter = "", query = "", genre = "", profileName = "";
    private string selectedId = "", recommendationTitle = "";
    private string playlistFilter = "All", playlistSearch = "", playlistSort = "Recent";
    public sealed record PlaylistCollection(List<string> Pinned, List<string> Recent);
    private PlaylistCollection playlistCollection = new([], []);
    private bool showPlaybackCache;
    private string songSearch = "", songSort = "Custom order";
    private bool songSearchOpen, mixesOnly, songDescending;
    private int playlistLimit = ListPage;
    private MusicTrack? CurrentMixSong => Player.Current is { } current
        ? Session.CurrentRecording(current) : null;
    private List<int> VisiblePlaylistPositions(MusicPlaylist playlist) =>
        PlaylistSongs.Positions(playlist, Session.Resolve, songSearch, songSort, mixesOnly, CurrentMixSong, songDescending, entry => PlaylistContributor(playlist, entry).Name);
    private void ToggleSongSearch()
    {
        songSearchOpen = !songSearchOpen;
