    private Task StartSongRadio(MusicTrack seed, bool artistOnly) => !Session.Connected || Player.FollowingHost || busy ? Task.CompletedTask : Run(async () =>
    {
        var requestedAt = MusicPlayer.PlaybackTimestamp();
        radioCancellation?.Cancel(); radioCancellation?.Dispose(); radioProgress = null;
        var identity = AppearanceKey;
        var origin = view;
        var originPlaylist = selectedId;
        var revision = Player.UserPlaybackRevision;
        var currentId = Player.Current?.Id;
        bool RadioIsCurrent() => identity == AppearanceKey && !Player.FollowingHost && !Player.RemoteActive
            && Player.Current?.Id == currentId && Player.UserPlaybackRevision == revision;
        if (!RadioIsCurrent()) return;

        MusicPlaylist radio;
        radioProgress = "Finding radio songs...";
        try { radio = await Session.StartRadioAsync(Similarity.Artist(seed), artistOnly ? "" : Similarity.RadioTitle(seed)); }
        catch (Exception)
        {
            if (!RadioIsCurrent()) return;
            throw new InvalidOperationException("Radio is unavailable. Your queue is unchanged. Try again later or choose another artist.");
        }
        finally { radioProgress = null; }
        if (!RadioIsCurrent()) return;
        var startedSeed = currentId != seed.Id;
        if (startedSeed)
        {
            await Player.PlayAsync(seed, source: "radio", requestedAt: requestedAt);
            if (identity != AppearanceKey || Player.FollowingHost || Player.RemoteActive
                || Player.Current?.Id != seed.Id || Player.UserPlaybackRevision != revision + 1) return;
        }
        radioCancellation = new();
        _ = FillRadioQueue(radio, seed, identity, startedSeed, radioCancellation.Token);
        if (view == origin && selectedId == originPlaylist)
        {
            await JS.InvokeVoidAsync("familyhub.focus", "content");
            playerToolsOpen = false; playerExpanded = false; lyricsOpen = false;
            await OpenPlaylist(radio);
        }
    });
    private async Task Recommend()
    {
        if (CannotRecommend || Player.Current is not { } seed) return;
        var identity = AppearanceKey;
        var revision = Player.UserPlaybackRevision;
        using var lookup = new CancellationTokenSource();
        recommendationLookup = lookup;
        bool IsCurrent() => !lookup.IsCancellationRequested && identity == AppearanceKey;
        bool CanQueue() => IsCurrent() && revision == Player.UserPlaybackRevision && !Player.FollowingHost && !Player.RemoteActive;
        var matches = new List<MusicTrack>();
        var songs = new HashSet<string> { Similarity.SongKey(seed) };
        var queued = false;
        void Append(IEnumerable<MusicTrack> found)
        {
            if (!IsCurrent()) return;
            var added = found.Where(t => songs.Add(Similarity.SongKey(t))).ToList();
            matches.AddRange(added);
            if (added.Count == 0 || !CanQueue()) return;
            var changedQueue = !queued && Player.ReplaceUpcoming(seed.Id, added);
            if (!changedQueue)
                foreach (var track in added)
                    if (!Player.Queue.Any(t => t.Id == track.Id || Similarity.SongKey(t) == Similarity.SongKey(track)))
                    {
                        Player.AddToQueue(track, manual: false);
                        changedQueue = true;
                    }
            if (!changedQueue) return;
            if (!queued) Session.SetMessage("Similar songs added to the queue.", "success");
            queued = true;
            _ = ContinuePreparedQueue(revision);
        }
        try
        {
            recommendations = matches;
            recommendationTitle = seed.Title;
            recommendationError = null;
            Append(Session.KnownSimilar(seed));
            await Navigate("Similar songs");
            playerToolsOpen = playerExpanded = lyricsOpen = lyricsReopenSheet = false;
            pendingFocus = "view-title";
            await InvokeAsync(StateHasChanged);
            await Session.SimilarAsync(seed, found =>
            {
                Append(found);
                StateHasChanged();
            }, lookup.Token);
            if (IsCurrent() && matches.Count > 0 && !queued && !CanQueue())
                recommendationError = Player.FollowingHost || Player.RemoteActive
                    ? "Control playback on this device to update the queue."
                    : "Playback changed. Try again to queue songs similar to the current song.";
        }
        catch (OperationCanceledException) when (!IsCurrent()) { }
        catch (FamilyHubApiException failure) when (failure.RequiresSignIn && IsCurrent())
        {
            await Session.ReconnectAsync();
            if (IsCurrent()) recommendationError = Session.Connected ? "Your session was restored. Try again." : NoticeText.Error(failure);
        }
        catch (Exception failure)
        {
            if (IsCurrent()) recommendationError = NoticeText.Error(failure, "Similar songs are unavailable. Try again.");
        }
        finally
        {
            if (recommendationLookup == lookup) recommendationLookup = null;
        }
    }
