    private Task PlayVisiblePlaylist(MusicPlaylist playlist, List<int> positions) =>
        PlayPlaylist(positions.Select(i => Session.Resolve(playlist.Tracks[i])).OfType<MusicTrack>(), "playlist:" + playlist.Id,
            follow: positions.Any(i => !Session.OnServer(playlist.Tracks[i])) ? playlist : null, positions: positions);
    private RenderFragment PlaylistShelf(List<MusicPlaylist> playlists, string? heading) => @<text>
        @if (playlists.Count > 0)
        {
            <section class="playlist-collection" aria-label="@(heading ?? "Playlists")">
                @if (heading is not null) { <h2>@heading</h2> }
                <div class="playlist-grid">
                    @foreach (var playlist in playlists)
                    {
                        var key = PlaylistKey(playlist);
                        <button id="@("playlist-card-" + key)" data-playlist-key="@key" class="playlist-card glass-panel" @key="key" @onclick="() => OpenPlaylist(playlist)">
                            <PlaylistCover Playlist="playlist" /><strong>@playlist.Name</strong><PlaylistAttribution Playlist="playlist" />
                            <span>@playlist.Tracks.Count @(playlist.Tracks.Count == 1 ? "song" : "songs")</span>
                        </button>
                    }
                </div>
            </section>
        }
    </text>;

    private IEnumerable<MusicPlaylist> FilteredPlaylists()
    {
        var text = playlistSearch.Trim();
        var comparison = System.Globalization.CultureInfo.CurrentCulture.CompareInfo;
        const System.Globalization.CompareOptions options = System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;
        var playlists = Session.Playlists.Where(p =>
            (playlistFilter switch
            {
                "Mine" => IsPlaylistOwner(p),
                "Shared with me" => !IsPlaylistOwner(p) && (p.Shared || p.CoAuthors.Contains(Session.User)),
                "Radio & mixes" => p.Radio || p.SourceUrl?.StartsWith("familyhub-radio:", StringComparison.Ordinal) == true
                    || System.Text.RegularExpressions.Regex.IsMatch(p.Name, @"\bmix(?:es)?\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase),
                _ => true
            }) && (text.Length == 0 || comparison.IndexOf(p.Name, text, options) >= 0 || comparison.IndexOf(p.OwnerName ?? "", text, options) >= 0));
        return playlistSort switch
        {
            "Alphabetical" => playlists.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase),
            "Most songs" => playlists.OrderByDescending(p => p.Tracks.Count),
            _ => playlists.OrderBy(p => playlistCollection.Recent.Contains(PlaylistKey(p))
                ? playlistCollection.Recent.IndexOf(PlaylistKey(p)) : int.MaxValue)
        };
    }
    private bool IsPlaylistOwner(MusicPlaylist playlist) => string.IsNullOrEmpty(playlist.OwnerId) || playlist.OwnerId == Session.User;
    private void SearchPlaylists(ChangeEventArgs args)
    {
        var text = args.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(playlistSearch) && !string.IsNullOrWhiteSpace(text)) playlistFilter = "All";
        playlistSearch = text;
    }
    private async Task ClearPlaylistSearch()
    {
        playlistSearch = "";
        await JS.InvokeVoidAsync("familyhub.focus", "playlist-search");
    }
