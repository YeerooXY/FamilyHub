    private void OpenPreload()
    {
        if (!Session.Connected || busy || Session.DownloadingId is not null || Selected is not { } playlist
            || playlist.Tracks.Any(track => !Session.OnServer(track))) return;
        preloadTracks = PlaylistDeviceTracks(playlist).Where(track => !Session.KeptOnDevice(track)).ToList();
