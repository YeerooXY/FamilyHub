    [JSInvokable] public Task CheckForBackgroundUpdate(bool connectionRestored) => CheckStartupUpdate(Session.Server, !connectionRestored);
    private async Task CheckStartupUpdate(string origin, bool background = false)
    {
        if (updateChecksStopped || updateCheckInFlight || AppUpdater.Platform is null
            || (background && updateCheckOrigin == origin && DateTime.UtcNow - lastUpdateCheck < TimeSpan.FromMinutes(1))) return;
        updateCheckInFlight = true; lastUpdateCheck = DateTime.UtcNow;
        try
        {
            if (updateCheckOrigin != origin)
            {
                await SetAvailableUpdate(null);
                updateCheckOrigin = origin; serverRelease = null; updateStatusError = null;
                await InvokeAsync(StateHasChanged);
            }
            using var api = Session.Api is not null ? new FamilyHubApi(Session.Api.ServerOrigin) : null;
            var release = await AppUpdater.CheckAsync(api, PublicReleases);
            if (!updateChecksStopped && Session.Server == origin)
            {
                await SetAvailableUpdate(release is not null && AppUpdater.CompareToInstalled(release) > 0 ? release : null);
                serverRelease = release; updateStatusError = null;
            }
        }
        catch (FamilyHubApiException error) when (error.StatusCode == 404)
        {
            if (!updateChecksStopped && Session.Server == origin)
            {
                await SetAvailableUpdate(null);
                serverRelease = null; updateStatusError = null;
            }
        }
        catch (Exception error) when (error is HttpRequestException or FamilyHubApiException or OperationCanceledException or System.IO.InvalidDataException or System.Text.Json.JsonException)
        {
            if (!updateChecksStopped && Session.Server == origin)
                updateStatusError = serverRelease is { } last ? $"Could not refresh. Last seen: {last.Version}" : "Could not check for updates";
        }
        finally
        {
            updateCheckInFlight = false;
            if (!updateChecksStopped) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetAvailableUpdate(AppRelease? release)
    {
        if (release?.Version != startupUpdate?.Version)
        {
            if (startupUpdate is not null && release is null)
            {
                if (updateDialogOpened) await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.closeDialog", "update-dialog");
                updateFocusPending = true;
            }
            updateNoticeDismissed = false; updateDialogOpened = false;
        }
        startupUpdate = release;
    }
