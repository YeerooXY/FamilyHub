        var target = uri.Fragment.TrimStart('#');
        if (target.Length == 0) target = RouteView ?? uri.AbsolutePath.Trim('/');
        var section = Uri.UnescapeDataString(target).ToLowerInvariant().Replace(' ', '-') switch
        {
            "artist-mappings" or "artist-mappings-title" => "artist-mappings-title",
            "review" or "song-review" or "songs-that-need-work" or "catalogue-review-title" => "catalogue-review-title",
            "stats" or "server-stats" or "server-work" or "stats-work-title" => "view-title",
            _ => null
        };
        if (section is null) return;
        view = "Stats";
