    private RenderFragment SortHeader(string column, string? label = null) => @<button type="button"
        class="playlist-column-label" data-tooltip="@column" data-sort="@column"
        data-direction="@(songSort == column ? songDescending ? "descending" : "ascending" : null)"
        aria-label="@($"Sort by {column}")" @onclick="() => SortPlaylistSongs(column)">
        @if (column == "Duration") { <MusicIcon Name="clock" /> } else { @(label ?? column) }
    </button>;
    private void SortPlaylistSongs(string column)
    {
        if (songSort != column) { songSort = column; songDescending = false; }
        else if (!songDescending) songDescending = true;
        else { songSort = "Custom order"; songDescending = false; }
