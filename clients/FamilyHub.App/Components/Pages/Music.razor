    private async Task LoadAlbum()
    {
        if (!Session.Connected || albumLoading || view != "Album" || selectedAlbum is not { } album) return;
        albumLookup = new();
        var token = albumLookup.Token;
        var identity = AppearanceKey;
        albumLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Session.HomeAlbumAsync(album.Tracks[0].Id, cancellationToken: token);
            if (token.IsCancellationRequested || identity != AppearanceKey || view != "Album") return;
            await JS.InvokeVoidAsync("familyhub.focusIfWithin", "#album-lookup-status .fh-notice-action, .unified-song-list .song-primary, .unified-song-list .row-action", "view-title");
            if (token.IsCancellationRequested || view != "Album") return;
            fullAlbum = result;
            albumFailed = false;
        }
        catch (Exception) { if (!token.IsCancellationRequested && identity == AppearanceKey) albumFailed = true; }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                CancelAlbumLookup();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelAlbumLookup()
    {
        albumLookup?.Cancel(); albumLookup?.Dispose(); albumLookup = null;
        albumLoading = false;
    }

    private Task PlayAlbum(int? position = null)
    {
        if ((albumLoading && position is null) || albumStarting || albumWaiting is not null || Player.FollowingHost || Player.RemoteActive || selectedAlbum is not { } album)
            return Task.CompletedTask;
        var start = position ?? 0;
        if (fullAlbum is not { } full) return PlayPlaylist(album.Tracks.Skip(start), "library");
        var entries = AlbumEntries ?? full;
        if (!Session.Connected || entries.Tracks.All(t => Session.Resolve(t) is not null))
            return PlayPlaylist(entries.Tracks.Skip(start).Select(Session.Resolve).OfType<MusicTrack>(), "library");

        return RunPlaybackAt(async requestedAt =>
        {
            if (view != "Album" || selectedAlbum != album || albumStarting) return;
            albumStarting = true;
            var identity = AppearanceKey;
            var revision = Player.UserPlaybackRevision;
            var request = playbackNoticeVersion;
            try
            {
                var playlist = await Session.HomeAlbumAsync(album.Tracks[0].Id, full.Id);
                if (identity != AppearanceKey || view != "Album" || selectedAlbum != album || !Session.Connected
                    || request != playbackNoticeVersion || Player.UserPlaybackRevision != revision || Player.FollowingHost || Player.RemoteActive) return;
                preparedAlbum = playlist;
                if (start >= playlist.Tracks.Count) return;
                var positions = Enumerable.Range(start, playlist.Tracks.Count - start).ToList();
                albumWaiting = request;
                _ = FollowPlaylistPreparation(playlist, positions, [], revision, identity, requestedAt, request);
            }
            finally { albumStarting = false; }
        });
    }
