    // Android Back gives the open dialog or Settings the first chance to handle it.
    private async Task<bool> StepBack()
    {
        if (await PlaybackInterop.InvokeOrAsync(JS, "familyhub.closeTopLayer", false)) return true;
        if (EntryScreen)
        {
            if (protectedProfile is not null && view != "Settings") { ClosePasswordCard(); StateHasChanged(); return true; }
            if (view != "Settings" || string.IsNullOrEmpty(Session.User) || Session.NeedsProfileSelection) return false;
            view = "Home"; StateHasChanged(); return true;
        }
        if (view == "Preferences") await BackFromSettings();
        else if (playerToolsOpen) await ClosePlayerTools();
        else if (lyricsOpen)
        {
            if (!await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.press", "lyrics-close"))
            {
                SetLyricsOpen(false);
                pendingFocus = "show-queue";
            }
        }
        else if (playerExpanded) CollapsePlayer();
        else if (profileMenu) { profileMenu = false; pendingFocus = "profile-toggle"; }
        else if (view == "Playlists" && Selected is not null) await AllPlaylists();
        else if (viewHistory.CanBack) await StepHistory(false);
        else if (view != "Hub") await Navigate("Hub");
        else return false;
        StateHasChanged();
        return true;
    }
