    private void ApplyDeepLink()
    {
        if (lastRoute == Navigation.Uri) return;
        lastRoute = Navigation.Uri;
        var uri = new Uri(lastRoute);
        var target = uri.Fragment.TrimStart('#');
        if (target.Length == 0) target = RouteView ?? uri.AbsolutePath.Trim('/');
        if (target is "hub" or "wordle") { view = target == "hub" ? "Hub" : "Wordle"; pendingFocus = "content"; return; }
        // The leaderboard moved to Home, so old links to it open Home.
        if (target is "leaderboard") { view = "Home"; pendingFocus = "content"; return; }
        var section = Uri.UnescapeDataString(target).ToLowerInvariant().Replace(' ', '-') switch
        {
            "artist-mappings" or "artist-mappings-title" => "artist-mappings-title",
            "review" or "song-review" or "songs-that-need-work" or "catalogue-review-title" => "catalogue-review-title",
            "stats" or "server-stats" or "server-work" or "stats-work-title" => "view-title",
            _ => null
        };
        if (section is null) return;
        // The server page is the admin-only Server section of Settings.
        view = "Preferences"; settingsSection = "server"; settingsDrilled = true;
        if (section == "artist-mappings-title") mappingsLoaded = mappingsOpen = true;
        pendingFocus = section;
        if (section != "view-title") pendingReveal = section;
    }
