    private void PlayerChanged() => _ = InvokeAsync(async () =>
    {
        var state = (Player.Current?.Id, Player.Playing, Player.Seeking, Player.PlaybackRequested, Player.Preparing, Player.CanSeek, Player.FollowingHost,
            Player.RemoteActive, Player.RemotePeek, Player.Queue.Count, Player.QueueIndex, NextTrack?.Id, Player.Shuffle, Player.RepeatMode, Player.Volume, Player.AudioOutputId, Together.LocallyPaused);
        if (Equals(state, playerState)) return;
        if (Session.UiActive && Player.Current is not { Saved: true })
            await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.focusIfWithin", ".player-tools .trim-request", "recommend-similar");
        if (Session.UiActive && Player.Current is null)
            await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.focusIfWithin", "#sheet-add-playlist,#sheet-queue,#sheet-lyrics", "listen-together");
        playerState = state; StateHasChanged();
