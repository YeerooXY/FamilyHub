    private async Task BackFromSettings()
    {
        if (settingsDrilled && await PlaybackInterop.InvokeOrAsync(JS, "familyhub.isPhone", PhoneVolume))
        {
            await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.focus", "settings-exit");
            settingsDrilled = false;
            pendingFocus = "settings-" + settingsSection;
