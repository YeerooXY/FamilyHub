@code {
    private SongPlaylistPicker? playlistPicker;
    private bool chromeReady = !OperatingSystem.IsWindows();
    private bool preparingChrome;
    private readonly HashSet<string> spotifyAsked = [];
    private Task AnswerSpotify(bool value) => Run(async () => { await Session.SaveSpotifyStatusAsync(value); await JS.InvokeVoidAsync("familyhub.closeDialog", "spotify-question-dialog", view == "Preferences" ? "spotify-premium" : "profile-toggle"); });
    // Pause appears only once audio is playing; preparing a song keeps the play icon with a loading state.
    private bool ShowPause => Player.RemoteActive ? Player.RemotePlaying : (Player.Playing || Player.Seeking) && Player.PlaybackRequested && !Player.Preparing;
    private void OpenPlaylistPicker((MusicTrack Track, string Opener) value) => playlistPicker?.Open(value.Track, value.Opener);
    private Task SetHistoryPaused(ChangeEventArgs args) => Run(async () =>
    {
        await Session.SavePreferencesAsync(SavedVolume, Session.PlaybackPreferences.Shuffle, listeningHistoryPaused: args.Value is true);
        Session.SetMessage(Session.PreferencesPending ? "History preference saved on this device. It will sync when connected." : args.Value is true ? "Listening history paused." : "Listening history resumed.");
    });
    private Task ClearHistory() => Run(async () =>
    {
        try { await Session.ClearListeningHistoryAsync(); }
        catch (Exception failure) when (failure is FamilyHubApiException or HttpRequestException or IOException)
        {
            error = "Could not clear listening history. Try again.";
            return;
        }
        await JS.InvokeVoidAsync("familyhub.closeDialog", "clear-history-dialog", "clear-history");
    });
    private bool deletePlaylistOpen;
    private void OpenDeletePlaylist() { if (Session.Connected && !busy) { error = ""; deletePlaylistOpen = true; } }
    private Task DeletePlaylist() => Run(async () =>
    {
        if (Selected is not { CanDelete: true } playlist) return;
        await Session.DeletePlaylistAsync(playlist);
        selectedId = "";
        await JS.InvokeVoidAsync("familyhub.closeDialog", "delete-playlist-dialog", "create-playlist");
        pendingFocus = "create-playlist";
    });
    private bool preloadOpen;
    private string preloadQuality = "max";
    private List<MusicTrack> preloadTracks = [];
    private int preloadMissing;
    private List<MusicTrack> PlaylistDeviceTracks(MusicPlaylist playlist) =>
        playlist.Tracks.Select(Session.Resolve).OfType<MusicTrack>().DistinctBy(t => t.Id).ToList();
    private void OpenPreload()
    {
        if (!Session.Connected || busy || Session.DownloadingId is not null || Selected is not { } playlist) return;
        preloadTracks = PlaylistDeviceTracks(playlist);
        if (Session.DownloadFailure is { } failure && preloadTracks.Any(t => t.Id == failure.TrackId))
            preloadTracks.RemoveAll(track => track.Id != failure.TrackId && Session.KeptOnDevice(track));
        if (preloadTracks.Count == 0) return;
        preloadMissing = playlist.Tracks.Count(t => Session.Resolve(t) is null);
        preloadQuality = Session.DownloadQuality; error = null; preloadOpen = true;
    }
    private async Task StartPreload()
    {
        if (busy || preloadTracks.Count == 0) return;
        Session.SetDownloadQuality(preloadQuality);
        await JS.InvokeVoidAsync("familyhub.closeDialog", "preload-dialog", "keep-playlist");
        await RunDeviceDownload(preloadTracks);
    }
    private bool songPickerOpen, songPickerShown, playlistTransitionPending;
    private AddSongs? addSongs;
    private async Task<bool> TakeOverFromBar(PlaybackDevice device)
    {
        error = await Connection.ChooseAsync(device.Id, Session.DeviceId);
        StateHasChanged();
        return error is null;
    }
    private IReadOnlyList<LibraryAddition> additionJobs = [];
    private string? additionIdentity;
    private IReadOnlyList<LibraryAddition> CurrentAdditionJobs => additionIdentity == AppearanceKey ? additionJobs : [];
    private void SetAdditionJobs(IReadOnlyList<LibraryAddition> jobs)
    {
        additionIdentity = AppearanceKey;
        additionJobs = jobs;
    }
    private PlaylistTransfer? playlistTransfer;
    private int? initialPlaylistReviewIndex;
    private string songFilter = "";
    private List<MusicTrack> SongPickerMatches => Session.Library.Where(t => string.IsNullOrWhiteSpace(songFilter) || (t.Title + " " + t.Channel).Contains(songFilter, StringComparison.OrdinalIgnoreCase)).Take(61).ToList();
    private HashSet<string> songPickerRows = [];
    private async Task OpenSongPicker()
    {
        await JS.InvokeVoidAsync("familyhub.closeDialog", "playlist-options", "playlist-menu-toggle");
        songFilter = ""; error = null; songPickerOpen = songPickerShown = true;
    }
    private async Task AppendPlaylistLink()
    {
        if (busy || playlistTransfer is null || Selected is not { CanEdit: true }) return;
        await JS.InvokeVoidAsync("familyhub.closeDialog", "playlist-options", "playlist-menu-toggle");
        await playlistTransfer.OpenAppendImport();
    }
    private async Task AddPickedSong(MusicTrack song)
    {
        if (busy || Selected is not { } playlist) return;
        await Run(async () => {
            await Session.EditPlaylistAsync(playlist, new { add_source_id = song.Id });
            await JS.InvokeVoidAsync("familyhub.closeDialog", "add-song-dialog", "playlist-menu-toggle");
        });
    }
    private string view = "Home", server = "", filter = "", query = "", genre = "", profileName = "";
    private string selectedId = "", recommendationTitle = "";
    private string playlistFilter = "All", playlistSearch = "", playlistSort = "Recent";
    private string songSearch = "", songSort = "Custom order";
    private bool songSearchOpen, mixesOnly;
    private MusicTrack? CurrentMixSong => Player.Current is { } current
        ? Session.CurrentRecording(current) : null;
    private List<int> VisiblePlaylistPositions(MusicPlaylist playlist) =>
        PlaylistSongs.Positions(playlist, Session.Resolve, songSearch, songSort, mixesOnly, CurrentMixSong);
    private void PlaylistSearchChanged() => shown = ListPage;
    private void ToggleSongSearch()
    {
        songSearchOpen = !songSearchOpen;
        if (!songSearchOpen) { songSearch = ""; shown = ListPage; }
        pendingFocus = songSearchOpen ? "playlist-song-search" : "playlist-song-search-toggle";
    }
    private void PlaylistSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { songSearch = ""; shown = ListPage; pendingFocus = "playlist-song-search"; }
    }
    private void ToggleMixFilter() { mixesOnly = !mixesOnly; shown = ListPage; pendingFocus = "playlist-mixes"; }
    private Task OpenSongSort() => JS.InvokeVoidAsync("familyhub.showPanel", "playlist-song-sort-options", "playlist-song-sort", "playlist-song-sort-custom").AsTask();
    private async Task SortPlaylistSongs(string order)
    {
        songSort = order; shown = ListPage;
        await JS.InvokeVoidAsync("familyhub.closeDialog", "playlist-song-sort-options", "playlist-song-sort");
    }
    private Task PlayVisiblePlaylist(MusicPlaylist playlist) =>
        PlayPlaylist(VisiblePlaylistPositions(playlist).Select(i => Session.Resolve(playlist.Tracks[i])).OfType<MusicTrack>().ToList());
    private IEnumerable<MusicPlaylist> FilteredPlaylists()
    {
        var playlists = Session.Playlists.Where(p =>
            (playlistFilter switch
            {
                "Yours" => p.CanEdit,
                "Shared with you" => !p.CanEdit,
