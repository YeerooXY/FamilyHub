@page "/"
@page "/hub"
@page "/leaderboard"
@page "/wordle"
@page "/server-work"
@page "/server-stats"
@page "/stats"
@page "/song-review"
@page "/review"
@page "/artist-mappings"
@implements IDisposable
@inject PlaybackConnection Connection
@inject MusicSession Session
@inject MusicPlayer Player
@inject ListenTogether Together
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject PublicAppReleases PublicReleases

<span class="sr" role="status" aria-live="polite" aria-atomic="true">@Session.ServerStatusMessage</span>

@if (splash != SplashState.Gone)
{
    <StartupSplash Leaving="@(splash == SplashState.Leaving)" />
}
@if (splash == SplashState.Showing || !Session.Ready || !chromeReady)
{
}
else if (EntryScreen)
{
    <main id="content" class="entry-screen" tabindex="-1">
        <div class="shell-status">
            <Notice Id="server-restart-status" Level="@(Session.ReconnectingToServer ? "info" : "warning")" Message="@Session.ServerStatusMessage" Announce="false" />
        </div>
        @if (Session.NeedsProfileSelection && view != "Settings")
        {
            <section class="profile-picker" aria-labelledby="@(protectedProfile is null ? "profile-heading" : "profile-password-title")" @onkeydown="ProfilePickerKeyDown">
                <div class="profile-stage">
                    <div class="profile-choices" inert="@(protectedProfile is not null)">
                        <h1 id="profile-heading">Choose a profile</h1>
                        <div class="profile-grid">
                            @foreach (var profile in Session.Profiles)
                            {
                                <button id="@("profile-choice-" + profile.Id)" class="@(protectedProfile?.Id == profile.Id ? "profile-choice is-selected" : "profile-choice")" @key="profile.Id" @onclick="() => PickProfile(profile)" aria-disabled="@Aria(busy)">
                                    <ProfileAvatar Profile="profile" Size="112" /><span>@profile.Name</span>
                                </button>
                            }
                            <button id="add-profile" class="profile-choice" @onclick="ShowAddProfile" aria-disabled="@Aria(busy)"><span class="profile-image profile-add" aria-hidden="true"><MusicIcon Name="plus" /></span><span>Add profile</span></button>
                        </div>
                    </div>
                    @if (protectedProfile is { } selected)
                    {
                        var creating = selected.NeedsPasswordSetup;
                        <form class="profile-password-card" novalidate @onsubmit="SignInToProfile" @onsubmit:preventDefault aria-labelledby="profile-password-title" aria-busy="@Aria(busy)">
                            <header class="profile-sign-in-identity">
                                <ProfileAvatar Profile="selected" Size="128" />
                                <h1 id="profile-password-title">@selected.Name</h1>
                            </header>
                            <div class="profile-sign-in-fields">
                                <label for="profile-password">@(creating ? "New password" : "Password")</label>
                                @if (creating) { <p id="profile-password-requirement">Use at least 8 characters.</p> }
                                <div class="password-field">
                                    <input id="profile-password" type="@(showPassword ? "text" : "password")" @bind="profilePassword" @bind:event="oninput" minlength="@(creating ? 8 : 1)" maxlength="256" autocomplete="@(creating ? "new-password" : "current-password")" aria-describedby="@(creating ? "profile-password-requirement" : null)" readonly="@busy" required />
                                    <button type="button" class="password-eye" @onclick="() => showPassword = !showPassword" aria-pressed="@(showPassword ? "true" : "false")" aria-label="Show password" title="Show password"><MusicIcon Name="@(showPassword ? "eye-off" : "eye")" /></button>
                                </div>
                                @if (creating)
                                {
                                    <label for="profile-password-confirm">Repeat password</label>
                                    <div class="password-field">
                                        <input id="profile-password-confirm" type="@(showPassword ? "text" : "password")" @bind="profilePasswordRepeat" @bind:event="oninput" maxlength="256" autocomplete="new-password" readonly="@busy" required />
                                    </div>
                                    @if (profilePasswordRepeat.Length > 0 && profilePasswordRepeat != profilePassword) { <p class="password-hint" role="status">The passwords do not match yet.</p> }
                                }
                                <div class="password-actions">
                                    <button class="primary" type="submit" aria-disabled="@Aria(busy || profilePassword.Length == 0 || (creating && (profilePassword.Length < 8 || profilePassword != profilePasswordRepeat)))">@(busy ? "Signing in…" : creating ? "Create password and sign in" : "Sign in")</button>
                                    <button class="quiet" type="button" @onclick="ClosePasswordCard" aria-disabled="@Aria(busy)">Back to profiles</button>
                                </div>
                                <Notice Level="error" Message="@error" />
                            </div>
                        </form>
                    }
                </div>
                @if (addingProfile)
                {
                    <form class="profile-name-form" @onsubmit="CreateProfile" @onsubmit:preventDefault>
                        <label class="sr" for="new-profile-name">Name</label><input id="new-profile-name" @bind="profileName" placeholder="Name" maxlength="40" required />
                        <button class="primary" type="submit" aria-disabled="@Aria(busy)">Create profile</button><button type="button" @onclick="CancelAddProfile">Cancel</button>
                    </form>
                }
                @if (protectedProfile is null) { <Notice Level="@(error is null ? Session.MessageLevel : "error")" Message="@(error ?? EntryMessage)" /> }
                <button class="quiet change-server" @onclick='() => Navigate("Settings")'>Change server</button>
                <AppUpdate InitialRelease="startupUpdate" />
            </section>
        }
        else
        {
            <form class="connect-form" @onsubmit="Connect" @onsubmit:preventDefault>
                <img class="connect-mark" src="familyhub-mark.png" alt="FamilyHub" />
                <div class="connect-fields"><label class="sr" for="server">Server address</label><input id="server" type="url" @bind="server" placeholder="Server address" autocomplete="url" autocapitalize="off" autocorrect="off" spellcheck="false" inputmode="url" required /><button class="primary" type="submit" aria-disabled="@Aria(busy)">@(busy ? "Connecting..." : "Connect")</button></div>
                <ServiceStatus Active="@(Session.ServerStatusMessage is null && (connectFailed || ConnectionLost))" FullSection="true"
                               Detail="Check the server address and your connection." RetryLabel="Retry server connection"
                               Retry="Connect" Busy="busy" FocusTarget="#server" />
                <Notice Level="@(error is null ? Session.MessageLevel : "error")" Message="@(Session.ServerStatusMessage is not null || connectFailed || ConnectionLost ? null : error ?? EntryMessage)" />
                @if (!string.IsNullOrEmpty(Session.User)) { <button class="quiet change-server" type="button" @onclick='() => Navigate("Library")'>Back</button> }
                <AppUpdate @key="Session.Server" InitialRelease="startupUpdate" />
            </form>
        }
    </main>
}
else
{
<a class="skip" href="#content">Skip to content</a>
<header class="app-header @(AppFullscreen ? "app-fullscreen" : "")">
    <div class="header-start">
        <button id="open-hub" type="button" class="brand hub-launcher" @onclick="OpenAppSwitcher" aria-label="Switch apps" aria-describedby="current-app" title="Switch apps" aria-haspopup="dialog" aria-controls="app-switcher" aria-expanded="@Aria(appSwitcherOpen)"><MusicIcon Name="@(appSwitcherOpen ? "apps" : HubApps.AppIcon(SwitcherApp))" /><span id="current-app" hidden>@HubApps.AppLabel(SwitcherApp)</span></button>
        <dialog id="app-switcher" class="popup-panel" aria-label="Switch apps" data-popup-anchor="open-hub" @onclose="() => appSwitcherOpen = false">
            <HubApps Current="@SwitcherApp" Open="SwitchApp" />
            <button id="switcher-hub" type="button" @onclick='() => SwitchApp("Hub")'><MusicIcon Name="home" /> FamilyHub home</button>
        </dialog>
        <nav class="view-history" aria-label="View history">
            <button id="header-back" class="header-icon header-history" @onclick="() => StepHistory(false, true)" aria-label="Go back" title="Go back" aria-disabled="@Aria(!viewHistory.CanBack)"><MusicIcon Name="back" /></button>
            <button id="header-forward" class="header-icon header-history" @onclick="() => StepHistory(true, true)" aria-label="Go forward" title="Go forward" aria-disabled="@Aria(!viewHistory.CanForward)"><MusicIcon Name="forward" /></button>
        </nav>
    </div>
    <div class="header-search">
    <button class="header-icon home-button" @onclick='() => Navigate("Home")' aria-label="Home" title="Home"><MusicIcon Name="home" /></button>
    <form id="search-form" class="@(searching ? "is-searching" : "")" role="search" @onsubmit="Search" @onsubmit:preventDefault>
        <label class="sr" for="q">Song or artist</label>
        <button class="search-submit" type="submit" aria-label="Search songs" aria-disabled="@Aria(busy)"><MusicIcon Name="search" /></button>
        <input id="q" type="search" value="@query" @oninput="SearchInput" placeholder="Search songs or artists" maxlength="200" autocomplete="off" />
        @if (!string.IsNullOrEmpty(query)) { <button id="clear-search" type="button" aria-label="Clear search" @onclick="ClearSearch"><MusicIcon Name="close" /></button> }
    </form>
    </div>
    <div class="sidebar-account"><AppUpdate Id="header-update" Compact="true" InitialRelease="startupUpdate" Available="ShowAvailableUpdate" />
    @if (SupportsAppFullscreen)
    {
        <button id="app-fullscreen-toggle" type="button" class="header-icon" @onclick="ToggleAppFullscreen" aria-label="@FullscreenLabel" title="@FullscreenLabel" aria-pressed="@Aria(AppFullscreen)"><MusicIcon Name="fullscreen" /></button>
    }
    <button id="profile-toggle" @onclick="OpenProfileMenu" aria-label="Profile menu" title="@Session.ProfileName" aria-expanded="@Aria(profileMenu)" aria-controls="profile-menu" aria-haspopup="dialog"><ProfileAvatar Profile="CurrentProfile" Size="32" /></button>
    @if (profileMenu)
    {
        <dialog id="profile-menu" class="popup-panel popup-menu" aria-labelledby="profile-menu-heading" data-popup-anchor="profile-toggle" @onclose="() => profileMenu = false">
            <div class="dialog-heading"><h2 id="profile-menu-heading">@Session.ProfileName</h2><button id="profile-menu-close" class="quiet" aria-label="Close profile menu" data-popup-close><MusicIcon Name="close" /></button></div>
            <button @onclick="SwitchProfile"><MusicIcon Name="person" />Switch profile</button>
            <button id="open-settings" @onclick="OpenSettings"><MusicIcon Name="settings" />Settings</button>
            <button id="open-feedback" aria-haspopup="dialog" @onclick="OpenProfileFeedback"><MusicIcon Name="alert" />Feedback</button>
        </dialog>
    }
    </div>
</header>
<aside class="sidebar">
    <nav id="music-navigation" aria-label="FamilyHub">
    <button id="open-home" class="nav-button" aria-label="Home" title="Home" aria-current='@(view == "Home" ? "page" : null)' @onclick='() => Navigate("Home")'><MusicIcon Name="home" /><span class="nav-label">Home</span></button>
    <button class="nav-button phone-nav" aria-label="Search" aria-current='@(view == "Search" ? "page" : null)' @onclick="OpenSearchTab"><MusicIcon Name="search" /><span class="nav-label">Search</span></button>
    <button class="nav-button phone-nav" aria-label="Playlists" aria-current='@(LibraryViews.Contains(view) ? "page" : null)' @onclick='() => Navigate("Playlists")'><MusicIcon Name="playlist" /><span class="nav-label">Playlists</span></button>
    <button id="open-library" class="nav-button desktop-nav" aria-label="Your library" title="Your library" aria-current='@(view == "Library" ? "page" : null)' @onclick='() => Navigate("Library")'><MusicIcon Name="library" /><span class="nav-label">Your library</span></button>
    @foreach (var tab in new[] { "Downloads", "Playlists" })
    { <button class="nav-button desktop-nav" aria-label="@NavLabel(tab)" title="@NavLabel(tab)" aria-current="@(view == tab ? "page" : null)" @onclick="() => Navigate(tab)"><MusicIcon Name="@NavIcon(tab)" /><span class="nav-label">@NavLabel(tab)</span></button> }
    </nav>
    <div id="sidebar-resize" role="separator" tabindex="0" aria-label="Resize library sidebar" aria-orientation="vertical" aria-valuemin="72" aria-valuemax="420" aria-valuenow="@(sidebarCollapsed ? 72 : sidebarWidth)"></div>
</aside>
<div class="workspace" data-app-view="@view"><main id="content" class="@(Session.ReconnectingToServer ? "server-reconnecting" : null)" tabindex="-1">
    @{ var restartBanner = Session.ServerStatusMessage;
       var searchBanner = restartBanner is null && view == "Search" && searchFailed && searchUnavailable;
       var connectionBanner = restartBanner is null && !searchBanner && error is null && ConnectionLost && view is not ("Movies & TV" or "Files") && !ServerSettingsOpen; }
    <div class="shell-status">
    <Notice Id="server-restart-status" Level="@(Session.ReconnectingToServer ? "info" : "warning")" Message="@restartBanner" Announce="false" />
    <ServiceStatus Active="@connectionBanner"
                   Detail="@ConnectionDetail" RetryLabel="Retry server connection" Retry="Reconnect" Busy="reconnecting" AutoRetry="true"
                   FocusTarget="@(view == "Home" ? "#open-home" : view == "Library" ? "#open-library" : "#open-hub")" />
    <ServiceStatus Active="@searchBanner" Detail="Reconnect to search for songs."
                   RetryLabel="Retry search" Retry="RetrySongSearch" Busy="retryingSearch" AutoRetry="true" FocusTarget="#q" />
    <Notice Id="feedback" Level="@(error is not null ? "error" : radioProgress is not null ? "info" : Session.MessageLevel)"
        Message="@(restartBanner is not null || searchBanner || connectionBanner ? null : error ?? radioProgress ?? (!ConnectionLost && Session.DownloadingId is null && Session.MessageLevel != "success" ? Session.Message : ""))"
        ActionLabel="@(restartBanner is not null || searchBanner || connectionBanner ? null : RecoveryLabel)" Action="RetryNotice" FocusTarget="@(searchFailed ? "#view-title" : "#play")" />
    </div>
    @if (view is not ("Playlists" or "Home" or "Album" or "Hub" or "Wordle" or "Preferences")) { <h1 id="view-title" tabindex="-1">@NavLabel(view)</h1> }
    @if (error is not null && playbackRetry is not null)
    { <button id="report-playback-problem" class="quiet" type="button" aria-haspopup="dialog" @onclick="OpenPlaybackFeedback">Report this problem</button> }
    @if (Session.DownloadingId is not null) { <DeviceDownloadProgress Status="@Session.DownloadStatus" /> }
    @if (LibraryViews.Contains(view) && (view != "Playlists" || Selected is null))
    {
        <div class="library-switch-row @(view == "Playlists" ? "playlist-switch-row" : "")">
            <div class="library-switch" role="group" aria-label="Library sections">@foreach (var (tab, label) in new[] { ("Playlists", "Playlists"), ("Library", "Songs"), ("Downloads", "Downloaded") }) { <button aria-pressed="@Aria(view == tab)" @onclick="() => Navigate(tab)">@label</button> }</div>
            @if (view == "Playlists")
            {
                <button id="create-playlist" class="quiet round" aria-label="Create playlist" title="Create playlist" aria-haspopup="dialog" aria-controls="create-playlist-dialog" @onclick="NewPlaylist"><MusicIcon Name="plus" /></button>
            }
        </div>
    }
    @if (view == "Hub")
    {
        <HubApps Open="Navigate" />
    }
    else if (view == "Wordle")
    {
        <DailyWordle @key="AppearanceKey" />
    }
    else if (view == "Home")
    {
        <HomeView OpenPlaylist="OpenPlaylist" OpenAlbum="OpenAlbum" PlayTracks="PlayHomeTracks" StartRadio="StartHomeRadio" PlayMix="PlayHomeMix" CurrentTrack="Player.Current" RadioBusy="busy" FollowingHost="Player.FollowingHost" />
    }
    else if (view == "Movies & TV")
    {
        <MoviesView @key="AppearanceKey" @ref="moviesView" InitialRoute="@movieRoute" KeepInitialFocus="@keepMovieInitialFocus" NavigationChanged="MovieNavigationChanged" />
    }
    else if (view == "Files")
    {
        <FilesView @key="AppearanceKey" />
    }
    else if (view == "Album" && selectedAlbum is { } album)
    {
        var entries = AlbumEntries;
        var tracks = entries is null ? album.Tracks : entries.Tracks.Select(t => Session.Resolve(t) ?? PlaylistSongs.CatalogueTrack(t)).ToList();
        var count = tracks.Count(t => t.Saved);
        <section class="playlist-hero glass-panel home-album-hero">
            <div class="playlist-band">
                <button class="quiet playlist-back" @onclick="GoBack"><MusicIcon Name="back" />Home</button>
                <div class="playlist-identity">
                    <TrackCover Track="album.Tracks[0]" />
                    <div class="playlist-heading">
                        <h1 id="view-title" tabindex="-1">@album.Name</h1>
                        <p class="playlist-summary">@album.Artist</p>
                        <p id="album-library-count" class="playlist-summary" role="status"><span>@(entries is not null ? $"{count} of {tracks.Count} in your library" : albumLoading ? "Loading full album…" : $"{tracks.Count} library songs")</span></p>
                    </div>
                </div>
            </div>
            <div class="playlist-action-bar">
                @{ var playLabel = entries is null && !albumLoading ? "Play library songs" : "Play album"; }
                @{ var missingSongs = Session.Connected && entries is not null && count < tracks.Count; }
                <button id="play-album" class="primary round playlist-play" @onclick="() => PlayAlbum()" aria-label="@playLabel" title="@playLabel" aria-describedby="@(missingSongs ? "album-play-detail" : null)" aria-disabled="@Aria(Player.FollowingHost || Player.RemoteActive || albumLoading || albumStarting || albumWaiting is not null)"><MusicIcon Name="play" /></button>
                @if (missingSongs) { <span id="album-play-detail" class="playlist-summary">Playing downloads missing songs.</span> }
            </div>
        </section>
        <Notice Id="album-lookup-status" Level="error" Message="@(albumFailed ? "The full album could not load from Deezer." : null)"
                ActionLabel="Retry album" Action="LoadAlbum" Busy="albumLoading" FocusTarget="#view-title" />
        <Notice Message="@(albumStarting || albumWaiting is not null ? "Preparing album songs…" : null)" />
        <div class="library-list unified-song-list">
            @foreach (var (track, position) in tracks.Take(Shown(album.Opener)).Select((track, position) => (track, position)))
            { @TrackRow(track, tracks, false, position) }
        </div>
        @PageEnd(tracks.Count)
    }
    else if (view == "Library" || view == "Downloads")
    {
        var downloadedView = view == "Downloads";
        var deviceTracks = downloadedView ? Session.DeviceTracks : null;
        var source = LibrarySource(deviceTracks);
        var searchText = filter.Trim();
        var tracks = source.Where(t => Matches(t, searchText) && (genre.Length == 0 || GenreNames.Key(t.Genre) == genre)).ToList();
        <div class="library-toolbar">
            <div class="collection-search" role="search" aria-label="Search songs">
                <label class="sr" for="library-filter">Search songs</label>
                <MusicIcon Name="search" />
                <input id="library-filter" type="search" @bind="filter" @bind:event="oninput" placeholder="Search songs" maxlength="200" />
                @if (filter.Length > 0)
                { <button class="quiet collection-search-clear" type="button" aria-label="Clear song search" @onclick="ClearLibrarySearch"><MusicIcon Name="close" /></button> }
            </div>
            <GenreFilter @key="view" Tracks="source" @bind-Value="genre" />
            @if (!downloadedView)
            { <button id="library-add-songs" class="quiet upload-open" aria-haspopup="dialog" @onclick='() => addSongs?.Open("library-add-songs")'><MusicIcon Name="plus" />Add songs</button> }
        </div>
        @if (deviceTracks is not null)
        {
            <DeviceDownloadCounts Tracks="deviceTracks" ShowSizes="true" CacheSelected="showPlaybackCache" CacheSelectedChanged="SelectDownloadSource" />
            @if (showPlaybackCache) { <p class="note playback-cache-note">The app may clear cached songs to free up space.</p> }
        }
        <span class="sr" role="status">@tracks.Count @(tracks.Count == 1 ? "song" : "songs")</span>
        @if (CurrentAdditionJobs.Count > 0 && view == "Library")
        {
            <details class="library-additions glass-panel" open><summary>Library additions <span class="music-admin-count">@CurrentAdditionJobs.Count</span></summary><LibraryAdditions Jobs="CurrentAdditionJobs" Prefix="library" /></details>
        }
        @if (tracks.Count == 0)
        {
            <Notice Level="empty" Message="@(source.Count > 0 ? "No songs match these filters." : downloadedView ? showPlaybackCache ? "The playback cache is empty." : "No kept downloads on this device." : Session.Connected ? "No saved songs." : null)"
                    ActionLabel="@(source.Count > 0 ? "Reset song filters" : downloadedView ? "Browse songs" : Session.Connected ? "Find music" : "Change server connection")"
                    Action="ResetLibraryNotice" FocusTarget="#library-filter" />
        }
        <div class="library-list">
            @foreach (var track in tracks.Take(Shown($"{view}:{showPlaybackCache}")))
            { @TrackRow(track, tracks, downloadedView && !showPlaybackCache) }
        </div>
        @PageEnd(tracks.Count)
    }
    else if (view == "Preferences")
    {
        <div class="settings-shell @(settingsDrilled ? "settings-drilled" : null)">
            <header class="settings-header">
                <h1 id="view-title" tabindex="-1">Settings</h1>
                <button id="settings-exit" class="quiet" type="button" @onclick="BackFromSettings">
                    <span class="settings-close"><MusicIcon Name="close" /><span class="sr">Close settings</span></span>
                    <span class="settings-back"><MusicIcon Name="back" /><span class="sr">Back to settings categories</span></span>
                </button>
            </header>
            <nav class="settings-sections" aria-label="Settings categories">
                @foreach (var (id, label, icon) in SettingsCategories.Where(category => category.Id != "server" || Session.ServerHealthAdmin))
                {
                    <button id="settings-@id" type="button" aria-current='@(settingsSection == id ? "true" : null)' @onclick="() => SelectSettingsSection(id)">
                        <MusicIcon Name="@icon" /><span>@label</span><span class="settings-chevron"><MusicIcon Name="forward" /></span>
                    </button>
                }
            </nav>
            <div id="settings-category" @key="settingsSection" class="settings-page" role="region" aria-label="@($"{SettingsCategories.First(category => category.Id == settingsSection).Label} settings")" tabindex="-1">
            @if (settingsSection == "general")
            {
                <section class="settings-panel glass-panel" aria-labelledby="profile-settings-heading">
                    <h2 id="profile-settings-heading">Profile</h2>
                    <ProfileImagePicker Profile="CurrentProfile" />
                </section>
            }
            else if (settingsSection == "appearance")
            {
                <section class="settings-panel glass-panel" aria-labelledby="appearance-settings-heading">
                    <h2 id="appearance-settings-heading">Appearance</h2>
                    <div class="setting-row"><label for="appearance-theme">Theme</label><select id="appearance-theme" value="@theme" @onchange="SetTheme">@foreach (var option in themes) { <option value="@option.Id">@option.Label</option> }</select></div>
                    <label class="setting-toggle"><input type="checkbox" checked="@themeEffects" @onchange="SetEffects" /><span>Theme effects</span></label>
                </section>
            }
            else if (settingsSection == "about")
            {
                <section class="settings-panel glass-panel" aria-labelledby="connection-settings-heading">
                    <h2 id="connection-settings-heading">Server and updates</h2>
                    <div class="setting-row"><span>Server <span class="settings-connection-state">@(Session.Connected ? "Connected" : "Offline")</span></span><button @onclick='() => Navigate("Settings")'>Change server</button></div>
                    <div class="setting-row"><span>Installed version</span><span id="installed-app-version">@($"{AppUpdater.CurrentVersion} (build {AppUpdater.CurrentBuild}), {AppUpdater.PlatformDisplay}")</span></div>
                    <div class="setting-row"><span>Latest release</span><span id="settings-update-status" role="status">@UpdateStatus</span></div>
                    <div class="setting-row"><button id="settings-release-history" type="button" @onclick="OpenReleaseHistory">Release history</button></div>
                    <AppUpdate Id="settings-app-update" @key="Session.Server" InitialRelease="@(updateCheckOrigin == Session.Server ? startupUpdate : null)" VersionInHeading="true" />
                    <p id="settings-tmdb-credit" class="muted"><strong>TMDB</strong> <span>Film data from TMDB. This product uses the TMDB API but is not endorsed or certified by TMDB.</span></p>
                </section>
            }
            else if (settingsSection == "music")
            {
                <section class="settings-panel glass-panel" aria-label="Spotify"><SpotifyProfilePreference /></section>
                <section class="settings-panel glass-panel" aria-labelledby="playback-settings-heading">
                    <h2 id="playback-settings-heading">Music playback</h2>
                    <div class="setting-crossfade">
                        <label for="crossfade-seconds">Crossfade songs</label>
                        <output for="crossfade-seconds" aria-live="polite">@(CrossfadeShown == 0 ? "Off" : CrossfadeShown + " s")</output>
                        <span class="crossfade-scale" aria-hidden="true">0 s</span>
                        <input id="crossfade-seconds" type="range" min="0" max="12" step="1" value="@CrossfadeShown" @oninput="PreviewCrossfade" @onchange="SetCrossfade" disabled="@Player.FollowingHost" aria-valuetext="@(CrossfadeShown == 0 ? "Off" : CrossfadeShown + " seconds")" style="--crossfade-fill:@(CrossfadeShown * 100 / 12)%" />
                        <span class="crossfade-scale" aria-hidden="true">12 s</span>
                    </div>
                    <p class="setting-help">The end of a song fades into the start of the next. At 0 each song plays to the end.</p>
                    <label class="setting-toggle"><input type="checkbox" checked="@Session.EvenSongVolume" @onchange="args => Player.SetEvenSongVolumeAsync(args.Value is true)" aria-describedby="even-song-volume-help" /><span>Even out song volume</span></label>
                    <p class="setting-help" id="even-song-volume-help">Limits loud peaks on this device, including in Listen Together.</p>
                    <div class="setting-row"><label for="volume-level">Volume level</label><select id="volume-level" disabled="@(!Session.EvenSongVolume)" value="@Session.PlaybackPreferences.VolumeLevel" @onchange='args => Session.SavePreferencesAsync(SavedVolume, Session.PlaybackPreferences.Shuffle, volumeLevel: args.Value?.ToString() ?? "normal")'><option value="loud">Loud</option><option value="normal">Normal</option><option value="quiet">Quiet</option></select></div>
                    <label class="setting-toggle"><input type="checkbox" checked="@Session.DataSaver" @onchange="SetMusicDataSaver" aria-describedby="music-data-saver-help" /><span>Data saver</span></label>
                    <p class="setting-help" id="music-data-saver-help">@(OperatingSystem.IsAndroid() ? "Uses Low quality on mobile data and skips early song downloads." : "Uses Low quality and skips preloading songs on mobile data.")</p>
                    <div class="setting-row"><label for="streaming-wifi">Streaming on Wi-Fi</label><select id="streaming-wifi" value="@Session.StreamingQualityWifi" @onchange="SetStreamingQualityWifi" disabled="@Player.Preparing"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="max">Max</option></select></div>
                    <div class="setting-row"><label for="streaming-mobile">Streaming on mobile data</label><select id="streaming-mobile" value="@Session.StreamingQualityMobile" @onchange="SetStreamingQualityMobile" disabled="@Player.Preparing"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="max">Max</option></select></div>
                    @if (OperatingSystem.IsAndroid())
                    {
                        <div class="setting-row">
                            <span id="screen-off-playback-help">On Samsung, set FamilyHub’s Battery option to Unrestricted if music stops with the screen off.</span>
                            <button type="button" aria-describedby="screen-off-playback-help" @onclick="OpenPlaybackAppSettingsAsync"><MusicIcon Name="external-link" /> Open app settings</button>
                        </div>
                    }
                    @if (OperatingSystem.IsWindows() && DiscordPresence.ApplicationId.Length > 0)
                    {
                        <label class="setting-toggle"><input type="checkbox" checked="@DiscordPresence.Enabled" @onchange="args => DiscordPresence.SetEnabled(args.Value is true)" /><span>Show what I'm listening to on Discord</span></label>
                        <p class="setting-help">Friends on Discord see the song and artist while the Discord app is open.</p>
                    }
                </section>
                <section class="settings-panel glass-panel" aria-labelledby="listening-history-heading">
                    <h2 id="listening-history-heading">Listening history</h2>
                    <label class="setting-toggle"><input type="checkbox" checked="@Session.PlaybackPreferences.ListeningHistoryPaused" @onchange="SetHistoryPaused" disabled="@busy" /><span>Pause history</span></label>
                    <div class="setting-row"><span>Family profiles can see your Leaderboard stats. Admins can see individual plays.</span><button id="clear-history" @onclick='() => JS.InvokeVoidAsync("familyhub.showDialog", "clear-history-dialog", "cancel-clear-history", "clear-history").AsTask()' disabled="@(!Session.Connected)">Clear listening history</button></div>
                    @if (!Session.Connected) { <p class="setting-help">Connect to clear shared listening history.</p> }
                </section>
                <PlaybackDiagnostics @key="(Session.Server, Session.User)" />
            }
            else if (settingsSection == "storage")
            {
                <section class="settings-panel glass-panel" aria-labelledby="storage-settings-heading">
                    <h2 id="storage-settings-heading">Storage and downloads</h2>
                    <div class="setting-row"><label for="downloads-quality">Downloads</label><select id="downloads-quality" value="@Session.DownloadQuality" @onchange="SetDownloadQuality" disabled="@Player.Preparing"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="max">Max</option></select></div>
                    <p class="setting-help">Max uses the original file, lossless when available. Downloaded songs always play from the device.</p>
                    <div class="setting-row"><label for="cache-limit">Music cache</label><select id="cache-limit" value="@Session.CacheLimitGb" @onchange="SetMusicCacheLimit"><option value="1">1 GB</option><option value="3">3 GB</option><option value="5">5 GB</option><option value="10">10 GB</option></select></div>
                    <p class="setting-help">Stores songs prepared for playback. Songs you choose to download are stored separately.</p>
                    <label class="setting-toggle"><input type="checkbox" checked="@Session.DownloadsWifiOnly" @onchange="args => Session.SetDownloadsWifiOnly(args.Value is true)" /><span>Wi-Fi-only downloads</span></label>
                </section>
            }
            else if (settingsSection == "wordle")
            {
                <WordleSettings @key="AppearanceKey" />
            }
            else if (settingsSection == "server" && !Session.ServerHealthAdmin)
            {
                <Notice Level="error" Message="Only an administrator can view server statistics." />
            }
            else if (settingsSection == "server")
            {
                <div class="server-work-page">
                    <ServerHealth @key="(Session.Server, Session.User)" Api="Session.Api" />
                    <ServerStats RefreshReview="RefreshSongReview">
                        @if (Session.MoviesEnabled)
                        {
                            <MoviesServerStatus @key="AppearanceKey" @ref="moviesStatus" />
                        }
                        <CatalogueReviewPanel @ref="songReview" OpenPlaylist="OpenPlaylistReviewGap" />
                    </ServerStats>
                    <details class="server-work-mappings glass-panel" open="@mappingsOpen">
                        <summary id="artist-mappings-title" @onclick="ToggleMappings" @onclick:preventDefault><MusicIcon Name="chevron-down" />Artist mappings</summary>
                        @if (mappingsLoaded) { <ArtistMappings @key="(Session.Server, Session.User)" /> }
                    </details>
                </div>
            }
            else
            {
                <MoviePreferences @key="AppearanceKey" />
            }
            </div>
        </div>
    }
    else if (view == "Playlists")
    {
        @if (Selected is not { } selected)
        {
            var playlists = FilteredPlaylists().ToList();
            var showSections = playlistFilter == "All" && string.IsNullOrWhiteSpace(playlistSearch);
            var pinned = showSections ? playlists.Where(p => playlistCollection.Pinned.Contains(PlaylistKey(p)))
                .OrderBy(p => playlistCollection.Pinned.IndexOf(PlaylistKey(p))).ToList() : [];
            var recent = showSections ? playlists.Where(p => playlistCollection.Recent.Contains(PlaylistKey(p)) && !pinned.Contains(p))
                .OrderBy(p => playlistCollection.Recent.IndexOf(PlaylistKey(p))).ToList() : [];
            var more = playlists.Except(pinned).Except(recent).ToList();
            <h1 id="view-title" class="sr" tabindex="-1">Playlists</h1>
            <div class="playlist-tools">
                <div class="genre-pills playlist-filters" role="group" aria-label="Filter playlists">
                    @foreach (var chip in new[] { "All", "Mine", "Shared with me", "Radio & mixes" })
                    { <button id="@(chip == "All" ? "playlist-filter-all" : null)" aria-pressed="@Aria(playlistFilter == chip)" @onclick="() => playlistFilter = chip">@chip</button> }
                </div>
                <div class="collection-search playlist-search" role="search" aria-label="Search playlists">
                    <MusicIcon Name="search" /><label class="sr" for="playlist-search">Search playlists</label>
                    <input id="playlist-search" type="search" placeholder="Search playlists" maxlength="200" value="@playlistSearch" @oninput="SearchPlaylists" />
                    @if (playlistSearch.Length > 0)
                    { <button class="quiet collection-search-clear" type="button" aria-label="Clear playlist search" @onclick="ClearPlaylistSearch"><MusicIcon Name="close" /></button> }
                </div>
                <button id="playlist-sort" class="quiet" aria-label="@($"Sort playlists: {playlistSort}")" title="@($"Sort playlists: {playlistSort}")" aria-haspopup="dialog" aria-controls="playlist-sort-options" @onclick="OpenPlaylistSort"><span>@playlistSort</span><MusicIcon Name="sort" /></button>
                <dialog id="playlist-sort-options" class="popup-panel popup-menu playlist-options playlist-sort-options" aria-labelledby="playlist-sort-options-heading">
                    <div class="dialog-heading"><h2 id="playlist-sort-options-heading">Sort playlists</h2><button class="quiet" aria-label="Close sort playlists" data-popup-close><MusicIcon Name="close" /></button></div>
                    @foreach (var order in new[] { "Recent", "Alphabetical", "Most songs" })
                    { <button id="@(order == "Recent" ? "playlist-sort-recent" : null)" class="quiet" aria-pressed="@Aria(playlistSort == order)" @onclick="() => SortPlaylists(order)"><MusicIcon Name="@(playlistSort == order ? "check" : "sort")" /><span>@order</span></button> }
                </dialog>
            </div>
            <span class="sr" role="status">@playlists.Count @(playlists.Count == 1 ? "playlist" : "playlists")</span>
            @PlaylistShelf(pinned, "Pinned")
            @PlaylistShelf(recent, "Recent")
            @PlaylistShelf(more, pinned.Count + recent.Count > 0 ? "More playlists" : null)
            @if (playlists.Count == 0)
            { <Notice Level="empty" Message="@(Session.Playlists.Count == 0 ? "No playlists yet." : "No playlists match.")"
                      ActionLabel="@(Session.Playlists.Count == 0 ? null : "Reset playlist filters")" Action="ClearPlaylistFilters" FocusTarget="#playlist-search" /> }
        }
        else
        {
            var playlistPositions = VisiblePlaylistPositions(selected);
            var deviceTracks = PlaylistDeviceTracks(selected);
            <PlaylistTransfer @ref="playlistTransfer" @key="PlaylistKey(selected)" Playlist="selected" InitialReviewIndex="initialPlaylistReviewIndex" ReportProblem="OpenImportFeedback">
            <Header Context="transfer">
            <div class="playlist-sticky" inert><PlaylistCover Playlist="selected" /><strong>@selected.Name</strong><button class="primary round" tabindex="-1" @onclick="() => PlayVisiblePlaylist(selected, playlistPositions)" aria-label="Play playlist" aria-disabled="@Aria(playlistPositions.Count == 0 || Player.FollowingHost)"><MusicIcon Name="play" /></button></div>
            <section class="playlist-hero glass-panel">
                <div class="playlist-band">
                <button class="quiet playlist-back" @onclick="AllPlaylists"><MusicIcon Name="back" />All playlists</button>
                <div class="playlist-identity">
                @if (selected.CanEdit)
                {
                    <label class="playlist-image-picker" title="Choose playlist image"><PlaylistCover Playlist="selected" /><span class="image-picker-caption">Choose image</span><InputFile id="playlist-image" OnChange="ChoosePlaylistImage" accept="image/jpeg,image/png" aria-label="Choose playlist image" /></label>
                }
                else { <PlaylistCover Playlist="selected" /> }
                <div class="playlist-heading">
                    <span class="playlist-kind">@(selected.Shared ? "Shared playlist" : "Private playlist")</span>
                    <h1 id="view-title" tabindex="-1">@selected.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(selected.Description)) { <p class="playlist-description">@selected.Description</p> }
                    <div class="playlist-summary"><ProfileAvatar Profile="PlaylistOwner(selected)" Size="28" /><strong>@PlaylistOwner(selected).Name</strong><span>@selected.Tracks.Count songs</span><span>@PlaylistLength(selected)</span>
                        @if (selected.Tracks.Count > 0)
                        { <span class="playlist-server-count" role="status">@transfer.OnServerCount of @selected.Tracks.Count on server</span> }
                    </div>
                </div>
                </div>
                </div>
            <div class="playlist-action-bar">
                <button id="play-playlist" class="primary round playlist-play" @onclick="() => PlayVisiblePlaylist(selected, playlistPositions)" aria-label="Play playlist" title="Play playlist" aria-disabled="@Aria(playlistPositions.Count == 0 || Player.FollowingHost)"><MusicIcon Name="play" /></button>
                <button id="shuffle-playlist" class="quiet playlist-shuffle" @onclick="ToggleShuffle" aria-label="Shuffle playlist" title="Shuffle playlist" aria-pressed="@Aria(Player.Shuffle)" aria-disabled="@Aria(Player.FollowingHost)"><MusicIcon Name="shuffle" /></button>
                <PlaylistDownloadButton Transfer="transfer" Tracks="deviceTracks" Unavailable="busy" Download="OpenPreload" Remove="OpenRemovePlaylistDownloads" />
                @if (selected.CanManageAuthors)
                { <button id="share-playlist" class="quiet playlist-sharing" aria-pressed="@Aria(selected.Shared)" aria-label="@(selected.Shared ? "Shared playlist; make private" : "Private playlist; share with family")" title="@(selected.Shared ? "Shared playlist" : "Private playlist")" aria-disabled="@Aria(!Session.Connected || busy)" @onclick="() => SharePlaylist(selected, !selected.Shared)"><MusicIcon Name="@(selected.Shared ? "people" : "person")" /></button> }
                else { <span class="playlist-privacy" title="@(selected.Shared ? "Shared playlist" : "Private playlist")"><MusicIcon Name="@(selected.Shared ? "people" : "person")" /><span class="sr">@(selected.Shared ? "Shared playlist" : "Private playlist")</span></span> }
                <button id="playlist-menu-toggle" class="quiet" aria-label="Playlist options" title="Playlist options" aria-haspopup="dialog" @onclick="OpenPlaylistOptions"><MusicIcon Name="more" /></button>
                @if (selected.CanEdit) { <button id="add-playlist-song" class="quiet playlist-add-song" aria-haspopup="dialog" @onclick='() => addSongs?.Open("add-playlist-song", selected)'><MusicIcon Name="plus" />Add songs</button> }
            </div>
            </section>
            </Header>
            <ChildContent Context="transfer">
            <dialog id="playlist-options" class="popup-panel popup-menu playlist-options" aria-labelledby="playlist-options-heading">
                <div class="dialog-heading"><h2 id="playlist-options-heading">Playlist options</h2><button class="quiet" aria-label="Close playlist options" data-popup-close><MusicIcon Name="close" /></button></div>
                <button id="queue-playlist" class="quiet" @onclick="() => QueuePlaylist(selected, playNext: false)" aria-disabled="@Aria(Player.FollowingHost || selected.Tracks.Count == 0)"><MusicIcon Name="queue" />Add to queue</button>
                <button class="quiet" @onclick="() => QueuePlaylist(selected, playNext: true)" aria-disabled="@Aria(Player.FollowingHost || selected.Tracks.Count == 0)"><MusicIcon Name="next" />Play next</button>
                <button id="pin-playlist" class="quiet" @onclick="() => TogglePlaylistPin(selected)"><MusicIcon Name="pin" />@(playlistCollection.Pinned.Contains(PlaylistKey(selected)) ? "Unpin playlist" : "Pin playlist")</button>
                @if (selected.CanEdit)
                {
                    <button id="playlist-saved-songs" class="quiet" aria-haspopup="dialog" @onclick="OpenSongPicker"><MusicIcon Name="library" />Choose saved songs</button>
                    <button id="playlist-import-link" class="quiet" aria-haspopup="dialog" @onclick="AppendPlaylistLink"><MusicIcon Name="link" />Import playlist link</button>
                }
                @if (selected.CanEdit) { <button id="playlist-details-open" class="quiet" @onclick="() => playlistDetails?.Open() ?? Task.CompletedTask"><MusicIcon Name="pencil" />Edit details</button> }
                @if (selected.CanManageAuthors) { <button id="playlist-coauthors" class="quiet" @onclick="() => playlistAuthors?.Open() ?? Task.CompletedTask"><MusicIcon Name="people" />Invite collaborators</button> }
                @if (selected.CanDelete) { <button id="delete-playlist" class="quiet playlist-delete" aria-disabled="@Aria(!Session.Connected || busy)" @onclick="DeleteFromMenu"><MusicIcon Name="trash" />Delete playlist</button> }
            </dialog>
            <PlaylistDetails @ref="playlistDetails" Playlist="selected" ReturnFocusId="playlist-menu-toggle" HideTrigger="true" />
            <PlaylistCoAuthors @ref="playlistAuthors" Playlist="selected" ReturnFocusId="playlist-menu-toggle" HideTrigger="true" />
            <div class="playlist-tools playlist-song-tools">
                <div class="playlist-song-search @(songSearchOpen ? "is-open" : "")">
                    <button id="playlist-song-search-toggle" class="quiet" aria-label="@(songSearchOpen ? "Close playlist search" : "Open playlist search")" aria-expanded="@Aria(songSearchOpen)" aria-controls="playlist-song-search" @onclick="ToggleSongSearch"><MusicIcon Name="search" /></button>
                    <input id="playlist-song-search" type="search" aria-label="Search in playlist" placeholder="Search in playlist" disabled="@(!songSearchOpen)" @bind="songSearch" @bind:event="oninput" @onkeydown="PlaylistSearchKey" />
                </div>
                <button id="playlist-mixes" class="quiet mix-filter" aria-pressed="@Aria(mixesOnly)" @onclick="ToggleMixFilter">Mixes with current song</button>
            </div>
            <span class="sr" role="status">@playlistPositions.Count songs. @(songSort == "Custom order" ? "Playlist order" : $"{songSort}, {(songDescending ? "descending" : "ascending")}")</span>
            @if (mixesOnly && !PlaylistSongs.MixesWith(CurrentMixSong, CurrentMixSong))
            { <p class="note">Play a song with BPM and key to find compatible songs.</p> }
            else if (playlistPositions.Count == 0)
            { <Notice Level="empty" Message="@(selected.Tracks.Count == 0 ? "No songs in this playlist." : "No songs match these filters.")"
                ActionLabel="@(selected.Tracks.Count == 0 ? (selected.CanEdit ? "Choose songs for this playlist" : "Browse other playlists") : "Reset playlist song filters")"
                Action="PlaylistEmptyAction" FocusTarget="#playlist-song-search-toggle" /> }
            <div class="playlist-column-headings" role="group" aria-label="Sort playlist songs">
                <span>@SortHeader("Position", "#")</span><span class="playlist-title-heading">@SortHeader("Title") @SortHeader("Artist")</span>
                <span>@SortHeader("Album")</span><span class="playlist-added-heading">@SortHeader("Date added") @SortHeader("Added by")</span>
                <span class="playlist-track-bpm">@SortHeader("BPM")</span><span class="playlist-track-key">@SortHeader("Key")</span><span>@SortHeader("Duration")</span>
            </div>
            @{ var pageLimit = playlistLimit; var pagePlaylist = selectedId; }
            @{ var retryUnavailable = busy || transfer.DownloadUnavailable; }
            <div class="library-list unified-song-list playlist-song-list">
            @{ var canReorder = Session.Connected && selected.CanEdit && songSort == "Custom order" && string.IsNullOrWhiteSpace(songSearch) && !mixesOnly; }
            @for (var visibleIndex = 0; visibleIndex < Math.Min(playlistPositions.Count, pageLimit); visibleIndex++)
            {
                var position = playlistPositions[visibleIndex];
                var entry = selected.Tracks[position]; var track = Session.Resolve(entry);
                var metadata = track ?? new MusicTrack { Id = entry.SpotifyUri, Title = entry.Title, Channel = entry.Artist, Duration = entry.Duration };
                <SongRow PlaylistColumns="true" Number="@(position + 1)" Album="@PlaylistAlbum(entry, track)" AddedAt="@entry.AddedAt" AddedBy="@PlaylistContributor(selected, entry)"
                    @key="(selectedId, position)" Track="metadata" FindRecording="@(track is null)" Current="@(track is not null && Player.Current?.Id == track.Id)" Playing="ShowPause"
                    Play="() => track is null ? FindPlaylistRecording(entry) : PlayEntry(selected, playlistPositions, position)" AddToPlaylist="OpenPlaylistPicker" Report="OpenReportSong"
                    Queue="() => QueueTrack(metadata)" Keep="() => Download(metadata)" ServerDownload="@transfer.SongDownload(position)"
                    RetryServerDownload="@(selected.CanEdit ? EventCallback.Factory.Create(transfer, transfer.StartDownload) : default)"
                    ServerRetryUnavailable="retryUnavailable"
                    OptionsId="@PlaylistRowOptionsId(position)"
                    MoveEarlier="@(canReorder && position > 0 ? EventCallback.Factory.Create(this, () => MoveEntry(selected, position, position - 1)) : default)"
                    MoveLater="@(canReorder && position < selected.Tracks.Count - 1 ? EventCallback.Factory.Create(this, () => MoveEntry(selected, position, position + 1)) : default)"
                    Remove="@(selected.CanEdit ? EventCallback.Factory.Create(this, () => RemoveEntry(selected, position)) : default)" RemoveLabel="Remove from playlist" />
            }
            </div>
            @if (pageLimit < playlistPositions.Count)
            {
                <PlaylistPageEnd @key="(pagePlaylist, pageLimit)" Reached="() => AppendPlaylistPage(pagePlaylist, pageLimit)" />
            }
            </ChildContent>
            </PlaylistTransfer>
        }
    }
    else if (view == "Queue")
    {
        @if (Player.Queue.Count == 0) { <Notice Level="empty" Message="No songs queued." ActionLabel="Browse saved songs" Action='() => Navigate("Library")' /> }
        <div id="queue" class="library-list unified-song-list">
        @{ var queuedTracks = Player.Queue.ToList(); }
        @{ var queueStart = Math.Max(0, Player.QueueIndex - 3); }
        @foreach (var position in Enumerable.Range(queueStart, Math.Max(0, Math.Min(queuedTracks.Count - queueStart, Shown("queue")))))
        { @TrackRow(queuedTracks[position], queuedTracks, false, position) }
        </div>
        @PageEnd(queuedTracks.Count - queueStart)
    }
    else if (view == "Search")
    {
        @if (!searching && error is null && searchResults.Count == 0 && searchStatus.Length > 0) { <Notice Level="empty" Message="No songs match this search." ActionLabel="Edit search" Action='() => JS.InvokeVoidAsync("familyhub.focus", "q").AsTask()' FocusTarget="#view-title" /> }
        <div id="pick" class="search-workspace" aria-busy="@Aria(searching)"><span class="sr" role="status">@searchStatus</span><div class="search-loading song-placeholders" aria-hidden="true">@for (var i = 0; i < 5; i++) { <div class="song-placeholder"><span class="placeholder-cover"></span><span class="placeholder-text"><span></span><span></span></span><span class="placeholder-action"></span></div> }</div><div id="results" class="library-list unified-song-list search-results" tabindex="0" aria-label="Search results"><Virtualize Items="searchResults" Context="track" ItemSize="100" OverscanCount="3">@TrackRow(track, searchResults, false)</Virtualize>@if (nextSearchOffset is not null) { <div id="search-more-sentinel"><button id="search-more" data-notice-focus="#results" class="quiet" @onclick="() => LoadMoreSearch(searchVersion)" aria-disabled="@Aria(loadingMore)">@(loadingMore ? "Loading more songs..." : moreSearchFailed ? "Retry loading songs" : "More songs")</button></div> }</div></div>

    }
    @if (view == "Similar songs")
    {
        <p class="muted">Based on @recommendationTitle</p>
        <Notice Id="similar-status" Level="@(recommendationError is null ? "info" : recommendations is { Count: > 0 } ? "warning" : "error")"
            Message="@(recommendationError ?? (recommendationLookup is not null ? recommendations is { Count: > 0 } ? "Checking for more similar songs…" : "Finding similar songs…" : ""))"
            ActionLabel='@(recommendationError is not null ? "Try again" : null)' Action="Recommend" Busy="CannotRecommend" FocusTarget="#view-title" />
        <section aria-label="Similar songs" aria-busy="@Aria(recommendationLookup is not null)">
            <span class="sr" role="status">@(recommendations is { Count: > 0 } ? $"{recommendations.Count} similar songs found." : "")</span>
            @if (recommendationLookup is null && recommendationError is null && recommendations is { Count: 0 }) { <Notice Level="empty" Message="No similar songs found." ActionLabel="Browse your library" Action='() => Navigate("Library")' /> }
            @if (recommendations is { Count: > 0 })
            {
                <div class="library-list unified-song-list">
                    @foreach (var track in recommendations) { @TrackRow(track, recommendations, false) }
                </div>
            }
        </section>
    }
</main></div>
<RemoteNowPlaying Visible="@(!playerExpanded && !lyricsOpen && !Player.RemoteActive && !Player.PlaybackRequested && !Player.FollowingHost)" TakeOver="TakeOverFromBar" />
<DeviceStrip />
<footer class="player-bar @(playerExpanded && !lyricsOpen ? "is-expanded" : "") @(Player.RemotePeek && !playerExpanded ? "is-remote-peek" : "")" @onkeydown="PlayerKeyDown">
    @if (playerExpanded)
    {
        <button id="player-collapse" class="quiet player-collapse" aria-label="Close Now Playing" title="Close Now Playing" @onclick="CollapsePlayer"><MusicIcon Name="chevron-down" /></button>
    }
    <div class="now-playing-group"><button id="show-queue" class="now-playing" @onclick="PlayerArea" aria-label='@(Player.Current is null ? "Quick play" : "Open playback queue")'>
        @if (Player.Current is null) { <span class="cover quick-play-art"><MusicIcon Name="play" /></span> } else { <TrackCover @key="Player.Current.Id" Track="Player.Current" /> }
        <span class="now-copy"><strong id="now-title"><span class="marquee-text">@(Player.Current?.DisplayTitle ?? "Quick play")</span></strong><span id="now-artist">@(Player.Preparing ? "Preparing song..." : Player.Current?.Channel ?? (Player.Queue.Count > 0 ? "Play your queue" : Session.HasListeningHistory ? "Based on your listening" : "Shuffle your library"))</span></span>
    </button>
    @if (Player.Current is { } currentSong)
    {
        var inPlaylist = Session.Playlists.Any(p => p.Tracks.Any(t => t.RecordingId == currentSong.Id));
        <button id="now-add-playlist" type="button" class="quiet row-action song-playlist-add @(inPlaylist ? "is-added" : "")" @onclick='() => OpenPlaylistPicker((currentSong, "now-add-playlist"))' aria-label="Add @currentSong.Title to playlist" title="Add to playlist" aria-haspopup="dialog"><MusicIcon Name="@(inPlaylist ? "check-circle-outline" : "plus-circle")" /></button>
    }
    </div>
    <div class="transport"><div class="transport-buttons">
        <button id="shuffle-toggle" class="quiet" @onclick="ToggleShuffle" aria-disabled="@Aria(Player.FollowingHost)" aria-label="Shuffle" aria-pressed="@Aria(Player.Shuffle)"><MusicIcon Name="shuffle" /></button>
        <button class="quiet" @onclick="() => RunPlayback(Player.PreviousAsync)" aria-disabled="@Aria(Player.FollowingHost)" aria-label="Previous song"><MusicIcon Name="previous" /></button>
        <button id="play" class="primary round @(Player.Preparing ? "is-preparing" : "")" @onclick="TogglePlayback" aria-busy="@Aria(Player.Preparing || Session.HandoffPending)" aria-label="@PlaybackButtonLabel"><MusicIcon Name='@(ShowPause ? "pause" : "play")' /></button>
        <button class="quiet" @onclick="() => RunPlayback(Player.NextAsync)" aria-disabled="@Aria(Player.FollowingHost)" aria-label="Next song"><MusicIcon Name="next" /></button>
        <button id="repeat-toggle" class="quiet" @onclick="ToggleRepeat" aria-disabled="@Aria(Player.FollowingHost)" aria-pressed="@Aria(Player.RepeatMode != "off")" aria-label="@("Repeat " + Player.RepeatMode)" title="@("Repeat " + Player.RepeatMode)"><MusicIcon Name="@(Player.RepeatMode == "one" ? "repeat-one" : "repeat")" /></button>
        @if (playerExpanded)
        {
            <button id="player-queue" class="quiet player-queue" aria-label="Open playback queue" title="Queue" @onclick="OpenQueueFromPlayer"><MusicIcon Name="queue" /></button>
        }
