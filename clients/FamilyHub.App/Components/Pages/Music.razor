    private PlaylistCoAuthors? playlistAuthors;
    private Task OpenPlaylistOptions() => JS.InvokeVoidAsync("familyhub.showPanel", "playlist-options", "playlist-menu-toggle", "queue-playlist").AsTask();
    private Task ClosePlaylistOptions() => JS.InvokeVoidAsync("familyhub.closeDialog", "playlist-options", "playlist-menu-toggle").AsTask();
    private async Task DeleteFromMenu() { await ClosePlaylistOptions(); OpenDeletePlaylist(); }
    private Task QueuePlaylist(MusicPlaylist playlist, bool playNext) => RunPlayback(async () =>
    {
        if (Player.FollowingHost || playlist.Tracks.Count == 0) return;
        await ClosePlaylistOptions();
        var playable = playlist.Tracks.Select(Session.Resolve).OfType<MusicTrack>()
            .Where(track => Session.Connected || Session.LocalPath(track) is not null).ToList();
        if (playable.Count > 0) Player.AddToQueue(playable, playNext);
        var missing = playlist.Tracks.Count - playable.Count;
        var added = playable.Count == 0 ? "No playable songs." : "Playable songs added to the queue.";
        var unavailable = missing == 1 ? "1 song unavailable" : $"{missing} songs unavailable";
        Session.SetMessage(missing == 0 ? added : $"{added} {unavailable}{(Session.Connected ? "." : " offline.")}");
    });
    private Task PlayEntry(MusicPlaylist playlist, int position) => RunPlayback(async () =>
    {
        var entries = VisiblePlaylistPositions(playlist).Select(i => (Track: Session.Resolve(playlist.Tracks[i]), Position: i))
            .Where(item => item.Track is not null && (Session.Connected || Session.LocalPath(item.Track) is not null)).ToList();
        var start = entries.FindIndex(item => item.Position == position);
        if (start < 0) throw new InvalidOperationException("Download this song while connected to play it offline.");
        await Player.PlayAsync(entries[start].Track!, entries.Select(item => item.Track!), start, source: "playlist:" + playlist.Id);
    });
    private Task Seek(ChangeEventArgs args) => double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var seconds) ? Player.SeekAsync(seconds) : Task.CompletedTask;
    private static bool Matches(MusicTrack track, string text) => (track.Title + " " + track.Channel).Contains(text, StringComparison.OrdinalIgnoreCase);
    private static string Time(double seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(@"m\:ss");
    private static string Size(long bytes) => bytes >= 1L << 30 ? $"{bytes / (double)(1L << 30):0.0} GB" : $"{bytes / (double)(1L << 20):0.0} MB";
    private RenderFragment TrackRow(MusicTrack track, List<MusicTrack> sequence, bool removable, int? position = null) => @<SongRow @key="(track.Id, position)" Track="track" Current="@(Player.Current?.Id == track.Id && (view != "Queue" || position == Player.QueueIndex))" Playing="ShowPause" Play="() => PlayRow(track, sequence, position)" AddToPlaylist="OpenPlaylistPicker" Queue="() => QueueTrack(track)" Keep="() => Download(track)" Remove="@(removable ? EventCallback.Factory.Create(this, () => RemoveDownload(track)) : default)" RemoveLabel="Remove download" />;
    private Task RemoveDownload(MusicTrack track) => Run(async () =>
    { if (Player.Current?.Id == track.Id) await Player.StopAsync(); await JS.InvokeVoidAsync("familyhub.focus", "library-filter"); await Session.RemoveDownloadAsync(track); });
    private Task Download(MusicTrack track) => Session.KeptOnDevice(track) ? Task.CompletedTask : RunDeviceDownload([track]);
    private Task RunDeviceDownload(IEnumerable<MusicTrack> tracks) => Run(async () =>
    {
        try { await Session.DownloadAsync(tracks); }
        catch (Exception exception) { throw new InvalidOperationException(MusicSession.DownloadErrorMessage(exception) + " Try the download again.", exception); }
    });
