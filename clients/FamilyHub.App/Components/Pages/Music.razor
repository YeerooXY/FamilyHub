    private Task QueuePlaylist(MusicPlaylist playlist, bool playNext) => RunPlayback(async () =>
    {
        if (Player.FollowingHost || playlist.Tracks.Count == 0) return;
        await ClosePlaylistOptions();
        var playable = playlist.Tracks.Select(Session.Resolve).OfType<MusicTrack>()
            .Where(track => Session.Connected || Session.LocalPath(track) is not null).ToList();
        if (playable.Count > 0) Player.AddToQueue(playable, playNext);
        var missing = playlist.Tracks.Count - playable.Count;
        var added = playable.Count == 0 ? "No playable songs." : "Playable songs added to the queue.";
        var unavailable = missing == 1 ? "1 song unavailable" : $"{missing} songs unavailable";
        Session.SetMessage(missing == 0 ? added : $"{added} {unavailable}{(Session.Connected ? "." : " offline.")}",
            missing == 0 && playable.Count > 0 ? "success" : "warning");
    });
    private Task PlayEntry(MusicPlaylist playlist, List<int> positions, int position) => RunPlaybackAt(async requestedAt =>
    {
        var entries = positions.Select(i => (Track: Session.Resolve(playlist.Tracks[i]), Position: i))
            .Where(item => item.Track is not null && (Session.Connected || Session.LocalPath(item.Track) is not null)).ToList();
        var start = entries.FindIndex(item => item.Position == position);
        if (start < 0) throw new InvalidOperationException("Download this song while connected to play it offline.");
        await Player.PlayAsync(entries[start].Track!, entries.Select(item => item.Track!), start, source: "playlist:" + playlist.Id, requestedAt: requestedAt);
    });
