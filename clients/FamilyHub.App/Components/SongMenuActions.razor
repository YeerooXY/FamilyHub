@inject MusicSession Session

@if (Track.Bpm is > 0 || !string.IsNullOrWhiteSpace(Track.Key))
{
    <p>
        @if (Track.Bpm is > 0) { <span>@Track.Bpm BPM@(string.IsNullOrWhiteSpace(Track.Key) ? "" : ",")</span> }
        @if (!string.IsNullOrWhiteSpace(Track.Key))
        {
            <span>Key @(string.IsNullOrWhiteSpace(Track.KeyName) ? Track.Key : $"{Track.KeyName} ({Track.Key})")</span>
        }
    </p>
}
@if (!FindRecording && Keep.HasDelegate)
{
    <button @onclick="Download" aria-disabled="@(DownloadUnavailable ? "true" : "false")">
        <MusicIcon Name="@(Kept ? "check" : Downloading ? "clock" : Failure is not null ? "refresh" : "download")" />
        <span>@(Kept ? "Downloaded" : Downloading ? "Downloading song to this device" : Failure is not null ? "Retry song download" : "Download song to this device")</span>
    </button>
    @if (Failure is { } failure) { <Notice Level="error" Message="@failure" /> }
}
@if (!FindRecording)
{
    <button aria-disabled="@(followBusy || !Session.Connected ? "true" : "false")" @onclick="FollowArtist">
        <MusicIcon Name="@(followed ? "check-circle-outline" : "plus-circle")" /><span>@(followed ? "Unfollow " : "Follow ")@Track.Channel</span>
    </button>
    @if (followError is not null) { <Notice Level="error" Message="@followError" /> }
}
@if (SaveState.Length > 0)
{
    <Notice Level="@(SaveState == "Saved" ? "success" : SaveState is "Queued" or "Working" or "Queuing..." ? "info" : "error")"
            Message="@(SaveState == "Failed" ? "The song could not be saved. Retry adding it to the library." : SaveState)" />
}
@if (MoveEarlier.HasDelegate) { <button @onclick="MoveEarlier"><MusicIcon Name="chevron-up" /><span>@L["Move earlier"]</span></button> }
@if (MoveLater.HasDelegate) { <button @onclick="MoveLater"><MusicIcon Name="chevron-down" /><span>@L["Move later"]</span></button> }

@code {
    [Parameter, EditorRequired] public MusicTrack Track { get; set; } = null!;
    [Parameter] public EventCallback Keep { get; set; }
    [Parameter] public bool FindRecording { get; set; }
    [Parameter] public string SaveState { get; set; } = "";
    [Parameter] public EventCallback MoveEarlier { get; set; }
    [Parameter] public EventCallback MoveLater { get; set; }
    private bool followed, followBusy;
    private int followRevision;
    private string? followError;
    private bool Kept => Session.KeptOnDevice(Track);
    private bool Downloading => Session.DownloadingId == Track.Id;
    private bool DownloadUnavailable => Kept || !Session.Connected || Session.DownloadingId is not null;
    private string? Failure => Session.DownloadFailure is { } failure && failure.TrackId == Track.Id ? failure.Message : null;

    private Task Download() => DownloadUnavailable ? Task.CompletedTask : Keep.InvokeAsync();

    public async Task Refresh()
    {
        followError = null;
        if (FindRecording || !Session.Connected || Session.Api is not { } api) return;
        var revision = followRevision;
        try
        {
            var result = await api.RequestJsonAsync<FollowedArtists>(HttpMethod.Get, "/api/discovery/follow");
            var artist = System.Text.RegularExpressions.Regex.Replace(Track.Channel.ToLowerInvariant(), @"\W+", " ").Trim();
            if (!followBusy && revision == followRevision && ReferenceEquals(api, Session.Api))
                followed = result.Artists.Contains(artist);
            StateHasChanged();
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { }
    }

    private async Task FollowArtist()
    {
        if (followBusy || !Session.Connected || Session.Api is not { } api) return;
        followBusy = true;
        followRevision++;
        followError = null;
        try
        {
            await api.RequestJsonAsync<object>(HttpMethod.Post, "/api/discovery/follow", new { artist = Track.Channel, follow = !followed });
            followed = !followed;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            followError = "Artist follow could not be saved. Try again.";
        }
        finally { followBusy = false; }
    }
}
