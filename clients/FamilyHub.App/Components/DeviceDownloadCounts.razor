@inject MusicSession Session

@{
    var downloaded = Tracks.Count(Session.KeptOnDevice);
    var cached = Tracks.Count(Session.OnThisDevice) - downloaded;
}
@if (ShowSizes)
{
    <div class="device-sizes" role="group" aria-label="@L["Songs on this device"].Value">
        <button id="kept-downloads" type="button" aria-pressed="@(!CacheSelected ? "true" : "false")" @onclick="() => CacheSelectedChanged.InvokeAsync(false)">
            <strong>@L["Kept downloads"]</strong><span class="device-size">@Songs(downloaded), @Size(Session.DownloadedBytes)</span>
        </button>
        <button id="cached-downloads" type="button" aria-pressed="@(CacheSelected ? "true" : "false")" @onclick="() => CacheSelectedChanged.InvokeAsync(true)">
            <strong>@L["Playback cache"]</strong><span class="device-size">@Songs(cached), @Size(Math.Max(0, Session.DeviceBytes - Session.DownloadedBytes))</span>
        </button>
    </div>
}
else
{
    <span class="playlist-device-count">@downloaded downloaded</span>
    <span class="playlist-device-count">@cached cached</span>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MusicTrack> Tracks { get; set; } = [];
    [Parameter] public bool ShowSizes { get; set; }
    [Parameter] public bool CacheSelected { get; set; }
    [Parameter] public EventCallback<bool> CacheSelectedChanged { get; set; }
    private static string Songs(int count) => $"{count} {(count == 1 ? "song" : "songs")}";
    private static string Size(long bytes) => bytes >= 1L << 30 ? $"{bytes / (double)(1L << 30):0.0} GB" : $"{bytes / (double)(1L << 20):0.0} MB";
}
