@implements IDisposable
@using System.Text.Json.Serialization
@inject MusicSession Session
@inject IJSRuntime JS

@Header?.Invoke(this)
@if (Playlist.CanEdit)
{
    <section id="playlist-transfer-progress" class="playlist-transfer" tabindex="-1" aria-label="Playlist import and server downloads">
        @if (CanMatch)
        {
            <div class="transfer-actions"><button id="transfer-match" class="quiet" @onclick='() => Start("match")' aria-disabled="@Aria(Working || requesting || !Session.Connected)"><MusicIcon Name="search" />@(Status?.State == "paused" && Status.Mode != "download" ? "Resume matching" : "Find recordings")</button></div>
        }
        @if (ShowProgress && Status is { } state)
        {
            <div class="transfer-status glass-panel @(state.Mode == "download" ? "transfer-server-status" : "")" aria-busy="@Aria(Working)">
                @if (state.Mode != "download")
                {
                <div class="transfer-heading" role="status" aria-atomic="true"><strong>@Heading</strong><span>@CountLabel</span></div>
                <div class="transfer-meter @(Working && state.Phase == "reading" && state.Total == 0 ? "is-indeterminate" : "")" role="progressbar" aria-label="@Heading" aria-valuemin="0" aria-valuemax="@Math.Max(1, state.Total)" aria-valuenow="@(state.Total > 0 ? ProgressCount : (int?)null)"><span style="width:@Percent%"></span></div>
                }
                <div class="transfer-current">
                    @if (state.Mode != "download")
                    {
                    <span class="transfer-activity @(Working && watchError is null ? "is-active" : "")" aria-hidden="true"></span>
                    <span><strong>@state.Title</strong><small>@state.Message</small></span>
                    }
                    else if (DownloadFailed) { <span role="status">Some songs could not be downloaded to the server.</span> }
                    else if (state.State == "paused") { <span role="status">Server download paused.</span> }
                    <button id="transfer-progress-action" class="quiet" @onclick="ProgressAction" aria-disabled="@Aria(requesting || watchError is null && state.State == "pausing")">
                        @(watchError is not null ? "Reconnect to progress" : Working ? state.State == "pausing" ? "Pausing..." : state.Mode == "download" ? "Pause server download" : "Pause matching" : "Close")
                    </button>
                </div>
                @if (state.Mode != "download" && state.Recent.Any(RecentNeedsAttention))
                {
                    <ul class="transfer-recent" aria-label="Recently checked songs">
                    @foreach (var item in state.Recent.Where(RecentNeedsAttention))
                    {
                        <li @key="item.Index"><span><strong>@item.Title</strong><small>@item.Artist</small></span><span class="transfer-result @item.State">@StateLabel(item.State)</span>@if (item.State is "review" or "error") { <button id="@("review-recent-" + item.Index)" class="quiet transfer-review-button" @onclick="() => OpenReview(item.Index - 1)" aria-disabled="@Aria(Working || requesting)">Review</button> }</li>
                    }
                    </ul>
                }
            </div>
        }
        @if (Playlist.Tracks.Count(NeedsAttention) is > 0 and var reviewCount)
        {
            <details class="transfer-results"><summary id="review-recordings-summary">Review recordings <span>@reviewCount @(reviewCount == 1 ? "needs review" : "need review")</span></summary><ul>
                @for (var i = 0; i < Playlist.Tracks.Count; i++)
                {
                    var index = i; var track = Playlist.Tracks[i];
                    if (!NeedsAttention(track)) continue;
                    <li><span><strong>@track.Title</strong><small>@track.Artist</small></span><span class="transfer-result @track.State">@StateLabel(track.State)</span>@if (track.State != "saved") { <button id="@("review-recording-" + index)" class="quiet transfer-review-button" @onclick="() => OpenReview(index)" aria-disabled="@Aria(Working || requesting)">Review</button> }</li>
                }
            </ul></details>
        }
        <p class="sr" role="status">@(appendImport && Status?.State == "done" ? "Playlist import finished." : "")</p>
        @if (watchError is not null)
        {
            <Notice Level="error" Message="@watchError" />
            @if (!ShowProgress) { <button id="transfer-reconnect" class="quiet" @onclick="ReconnectProgress" aria-disabled="@Aria(requesting)">Reconnect to progress</button> }
        }
        @if (!string.IsNullOrEmpty(error)) { <Notice Level="error" Message="@error" /> }
    </section>
    <dialog id="transfer-review-dialog" class="popup-panel transfer-review-dialog" aria-labelledby="transfer-review-heading">
        <div class="dialog-heading"><h2 id="transfer-review-heading">Review recording</h2><button id="transfer-review-close" class="quiet" aria-label="Close recording choices" @onclick="CloseReview"><MusicIcon Name="close" /></button></div>
        <p class="transfer-review-song"><strong>@reviewTitle</strong><span>@reviewArtist</span></p>
        @if (reviewLoading) { <Notice Message="Finding recording choices…" /> }
        @if (!string.IsNullOrEmpty(reviewError)) { <Notice Level="error" Message="@reviewError" /> }
        <div class="transfer-candidates" aria-busy="@Aria(reviewLoading)">
        @for (var i = 0; i < choices.Count; i++)
        {
            var choice = i; var recording = choices[i];
            <article class="transfer-candidate">
                <div><strong>@recording.Title</strong><span>@recording.Channel, @RecordingTime(recording.Duration) @if (recording.Saved) { <span class="transfer-result saved">On server</span> }</span></div>
                <div class="transfer-candidate-actions"><button class="quiet" @onclick="() => OpenOnYouTube(recording)" aria-label="@($"Open {recording.Title} from {recording.Channel} on YouTube")"><MusicIcon Name="external-link" />YouTube</button><button class="primary" @onclick="() => UseRecording(choice, recording)" aria-label="@($"Use recording {recording.Title} from {recording.Channel}")" aria-disabled="@Aria(reviewLoading || requesting)">Use recording</button></div>
            </article>
        }
        </div>
        @if (!reviewLoading && choices.Count == 0 && string.IsNullOrEmpty(reviewError)) { <Notice Level="empty" Message="No recording choices found." /> }
        <button class="quiet" @onclick="SearchChoicesAgain" aria-disabled="@Aria(reviewLoading || requesting)"><MusicIcon Name="search" />Search again</button>
    </dialog>
    <dialog id="transfer-import-dialog" class="popup-panel" aria-labelledby="transfer-import-heading">
        <div class="dialog-heading"><h2 id="transfer-import-heading">Import playlist link</h2><button class="quiet" aria-label="Close playlist import" @onclick="CloseImport"><MusicIcon Name="close" /></button></div>
        <form @onsubmit="Import" @onsubmit:preventDefault>
            <label for="transfer-url">Playlist link</label><input id="transfer-url" type="url" @bind="url" required />
            <p>Spotify, YouTube, Deezer or SoundCloud. Songs already in this playlist are skipped.</p>
            <Notice Level="error" Message="@error" />
            <div class="actions"><button class="primary" type="submit" aria-disabled="@Aria(requesting)">@(requesting ? "Starting..." : "Import playlist")</button><button type="button" @onclick="CloseImport">Cancel</button></div>
        </form>
    </dialog>
}
@ChildContent?.Invoke(this)

@code {
    [Parameter, EditorRequired] public MusicPlaylist Playlist { get; set; } = null!;
    [Parameter] public EventCallback Updated { get; set; }
    [Parameter] public RenderFragment<PlaylistTransfer>? Header { get; set; }
    [Parameter] public RenderFragment<PlaylistTransfer>? ChildContent { get; set; }
    [Parameter] public int? InitialReviewIndex { get; set; }
    private bool NeedsAttention(PlaylistTrack track) => track.State is "review" or "error" && !Session.OnServer(track);
    private bool RecentNeedsAttention(TransferItem item) => item.State is "review" or "error" && item.Index > 0 && item.Index <= Playlist.Tracks.Count
        && NeedsAttention(Playlist.Tracks[item.Index - 1]);
    private bool reviewOpen, reviewClose, reviewLoading;
    private HashSet<string> previousControls = [];
    private int reviewIndex, reviewRevision;
    private string reviewTitle = "", reviewArtist = "";
    private string? reviewError;
    private List<MusicTrack> choices = [];
    private static string RecordingTime(double seconds) => $"{(int)Math.Max(0, seconds) / 60}:{(int)Math.Max(0, seconds) % 60:00}";
    private async Task OpenReview(int index)
    {
        if (Working || requesting || reviewLoading || index < 0 || index >= Playlist.Tracks.Count) return;
        reviewIndex = index; reviewTitle = Playlist.Tracks[index].Title; reviewArtist = Playlist.Tracks[index].Artist;
        choices = []; reviewError = null; reviewOpen = true; reviewLoading = true;
        try
        {
            var response = await Api.RequestJsonAsync<RecordingChoices>(HttpMethod.Get, Path + "/match?index=" + index + "&revision=" + Playlist.Revision + "&" + OwnerQuery, cancellationToken: lifetime!.Token);
            reviewRevision = response.Revision; choices = response.Track.Candidates;
            if (choices.Count == 0) await LoadSearchedChoices();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { reviewError = ReviewError(ex, "Could not load recording choices. Try Search again."); }
        finally { reviewLoading = false; }
    }
    private async Task LoadSearchedChoices()
    {
        await Api.RequestJsonAsync<RecordingChoices>(HttpMethod.Post, Path + "/match", new { index = reviewIndex, revision = reviewRevision, owner_id = Playlist.OwnerId }, lifetime!.Token);
        var response = await Api.RequestJsonAsync<RecordingChoices>(HttpMethod.Get, Path + "/match?index=" + reviewIndex + "&revision=" + reviewRevision + "&" + OwnerQuery, cancellationToken: lifetime.Token);
        reviewRevision = response.Revision; choices = response.Track.Candidates;
    }
    private async Task SearchChoicesAgain()
    {
        if (reviewLoading || requesting) return;
        reviewLoading = true; reviewError = null;
        try { await LoadSearchedChoices(); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { reviewError = ReviewError(ex, "Could not find recordings. Try Search again."); }
        finally { reviewLoading = false; }
    }
    private async Task UseRecording(int choice, MusicTrack recording)
    {
        if (reviewLoading || requesting) return;
        requesting = true; reviewError = null;
        try
        {
            await Api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, Path + "/recording",
                new { index = reviewIndex, choice, source_id = recording.Id, revision = reviewRevision, owner_id = Playlist.OwnerId }, lifetime!.Token);
            await Session.RefreshAsync();
            Status = await Api.RequestJsonAsync<TransferStatus>(HttpMethod.Get, PreparePath, cancellationToken: lifetime.Token);
            reviewClose = true;
            await Updated.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { reviewError = ReviewError(ex, "Could not save this recording choice. Try again."); }
        finally { requesting = false; }
    }
    private Task CloseReview() => JS.InvokeVoidAsync("familyhub.closeDialog", "transfer-review-dialog", "playlist-transfer-progress").AsTask();
    private static string ReviewError(Exception error, string fallback) => error switch
    {
        FamilyHubApiException { StatusCode: 403 } => "Only the playlist owner or a co-author can choose a recording.",
        FamilyHubApiException failure when !failure.Message.StartsWith("The server returned HTTP ", StringComparison.Ordinal) => failure.Message,
        _ => fallback
    };
    private async Task OpenOnYouTube(MusicTrack recording)
    {
        try
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(recording.Id, "^[A-Za-z0-9_-]{11}$"))
                await Launcher.Default.OpenAsync(new Uri("https://www.youtube.com/watch?v=" + recording.Id));
        }
        catch { reviewError = "Could not open YouTube. Check your browser and try again."; }
    }
    private sealed record RecordingChoices
    {
        [JsonPropertyName("revision")] public int Revision { get; init; }
        [JsonPropertyName("track")] public ChoiceTrack Track { get; init; } = new();
    }
    private sealed record ChoiceTrack
    {
        [JsonPropertyName("candidates")] public List<MusicTrack> Candidates { get; init; } = [];
    }
    public int OnServerCount => Playlist.Tracks.Count(Session.OnServer);
    public bool AllOnServer => Playlist.Tracks.Count > 0 && OnServerCount == Playlist.Tracks.Count;
    private bool CanMatch => !AllOnServer && !ServerDownloading && Playlist.Tracks.Any(t => t.State is "unmatched" or "review" or "error" or "ready");
    private bool DownloadFailed => !AllOnServer && Status is { Mode: "download", State: "done", Failed: > 0 };
    private bool ShowProgress => !dismissed && (Working || DownloadFailed || Status is { State: not ("idle" or "done") });
    private bool hadProgress, hadReconnect;
    private TransferStatus? Status;
    private CancellationTokenSource? lifetime;
    private string key = "", provider = "spotify", url = "";
    private string? error, watchError;
    private bool requesting, dismissed, openDialog, closeDialog, polling, disposed, wasConnected;
    private (string Phase, string State, int Processed, int Saved, int Found, int Review, int Failed)? published;
    private CancellationToken pollingToken;
    private bool Working => Status?.State is "running" or "pausing" || Status is { State: "done", DownloadAfterMatching: true };
    public bool DownloadUnavailable => !Playlist.CanEdit || Playlist.Tracks.Count == 0 || AllOnServer ||
        requesting || !Session.Connected || Working && Status?.DownloadAfterMatching == true || Status?.State == "pausing" || ServerDownloading;
    public bool ServerDownloading => Working && Status?.Mode == "download";
    public string DownloadLabel => ServerDownloading ? "Downloading to server"
        : Status?.State == "paused" && (Status.Mode == "download" || Status.DownloadAfterMatching) ? "Resume server download"
        : DownloadFailed ? "Retry server download"
        : Status?.DownloadAfterMatching == true ? "Download queued" : "Download to server";
    public Task StartDownload() => Start("download");

    public (string State, double? Percent) SongDownload(int position)
    {
        var track = Playlist.Tracks[position];
        if (Session.OnServer(track)) return ("server", null);
        if (Working && watchError is null && Status is { } status
            && (status.PlaylistRevision == 0 || status.PlaylistRevision == Playlist.Revision)
            && position >= status.StartIndex && (status.Mode == "download" || status.DownloadAfterMatching))
        {
            if (status.Mode == "download")
            {
                var file = status.ActiveDownloads.FirstOrDefault(item => item.Index == position + 1);
                // Older servers expose only the current file.
                if (file is null && status.ActiveDownloads.Count == 0 && status.Index == position + 1) file = status;
                if (file?.FilePhase == "queued") return ("waiting", null);
                if (file?.FilePhase is "downloading" or "purifying")
                    return ("downloading", file is { FilePhase: "downloading", DownloadTotalBytes: > 0 }
                        ? Math.Clamp(file.DownloadBytes * 100d / file.DownloadTotalBytes.Value, 0, 100) : null);
                if (file?.FilePhase == "error" && track.State != "review") return ("failed", null);
            }
            if (position >= status.Cursor && !status.CompletedAfter.Contains(position)) return ("waiting", null);
        }
        return (track.State switch { "error" => "failed", "review" => "review", _ => "missing" }, null);
    }
    private int ProgressCount => Status?.Phase == "reading" ? Status.Loaded : Status?.Processed ?? 0;
    private string Percent => (Status is { Total: > 0 } s ? Math.Clamp(ProgressCount * 100d / s.Total, 0, 100) : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private string Heading => Status?.Phase == "reading" ? "Reading playlist" : "Finding recordings";
    private string CountLabel => Status is { Total: > 0 } s ? $"{ProgressCount} / {s.Total}" : "";
    private static string Aria(bool value) => value ? "true" : "false";
    private static string StateLabel(string state) => state switch { "saved" => "On server", "ready" => "Found", "review" => "Needs review", "error" => "Failed", "preparing" => "Purifying", _ => "Not checked" };
    private FamilyHubApi Api => Session.Connected && Session.Api is { } api ? api : throw new InvalidOperationException("Connect to import or download playlists.");
    private string Path => "/api/playlists/" + Playlist.Id;
    private string OwnerQuery => "owner_id=" + Uri.EscapeDataString(Playlist.OwnerId);
    private string PreparePath => Path + "/prepare?" + OwnerQuery;
    private bool appendImport;

    protected override async Task OnParametersSetAsync()
    {
        var nextKey = Session.Server + "|" + Session.User + "|" + Playlist.OwnerId + "|" + Playlist.Id;
        var reconnected = Session.Connected && !wasConnected;
        wasConnected = Session.Connected;
        if (nextKey == key)
        {
            if (reconnected) await ReconnectProgress();
            return;
        }
        lifetime?.Cancel(); lifetime?.Dispose(); lifetime = new();
        key = nextKey; Status = null; error = watchError = null; dismissed = requesting = false; published = null;
        if (!Playlist.CanEdit || !Session.Connected) return;
        var token = lifetime.Token;
        await ReconnectProgress();
        if (token.IsCancellationRequested || InitialReviewIndex is not { } index) return;
        if (Working) { error = "Pause playlist preparation before choosing a recording."; return; }
        await OpenReview(index);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Playlist.CanEdit) return;
        var returnTo = Playlist.Tracks.Count > 0 ? "keep-playlist" : "add-playlist-song";
        if (hadProgress && !ShowProgress)
            await JS.InvokeVoidAsync("familyhub.restoreFocus", "transfer-progress-action", returnTo);
        if (hadReconnect && (watchError is null || ShowProgress))
            await JS.InvokeVoidAsync("familyhub.restoreFocus", "transfer-reconnect", ShowProgress ? "transfer-progress-action" : returnTo);
        hadReconnect = watchError is not null && !ShowProgress;
        hadProgress = ShowProgress;
        var controls = Playlist.Tracks.Select((track, index) => (track, index))
            .Where(row => NeedsAttention(row.track)).Select(row => "review-recording-" + row.index).ToHashSet();
        if (controls.Count > 0) controls.Add("review-recordings-summary");
        if (Status is { Mode: not "download" } status)
            controls.UnionWith(status.Recent.Where(RecentNeedsAttention).Select(item => "review-recent-" + item.Index));
        if (CanMatch) controls.Add("transfer-match");
        foreach (var removed in previousControls.Except(controls))
            await JS.InvokeVoidAsync("familyhub.restoreFocus", removed, "playlist-transfer-progress");
        previousControls = controls;
        if (reviewOpen) { reviewOpen = false; await JS.InvokeVoidAsync("familyhub.showDialog", "transfer-review-dialog", "transfer-review-close"); }
        if (reviewClose) { reviewClose = false; await JS.InvokeVoidAsync("familyhub.closeDialog", "transfer-review-dialog", "playlist-transfer-progress"); }
        if (openDialog) { openDialog = false; await JS.InvokeVoidAsync("familyhub.showDialog", "transfer-import-dialog", "transfer-url"); }
        if (closeDialog) { closeDialog = false; await JS.InvokeVoidAsync("familyhub.closeDialog", "transfer-import-dialog", "playlist-transfer-progress"); }
    }
    private void OpenImport(string value)
    {
        if (Working || requesting) return;
        appendImport = false; provider = value; url = ""; error = null; openDialog = true;
    }
    public async Task OpenAppendImport()
    {
        if (Working || requesting) { await JS.InvokeVoidAsync("familyhub.focus", "transfer-progress-action"); return; }
        OpenImport("auto"); appendImport = true;
        await InvokeAsync(StateHasChanged);
    }
    private Task CloseImport() => JS.InvokeVoidAsync("familyhub.closeDialog", "transfer-import-dialog", "playlist-menu-toggle").AsTask();
    private async Task Import()
    {
        if (requesting || Working) return;
        requesting = true; error = null;
        try
        {
            Status = await Api.RequestJsonAsync<TransferStatus>(HttpMethod.Post, Path + "/import", new { provider, url, revision = Playlist.Revision, append = appendImport, owner_id = Playlist.OwnerId }, lifetime!.Token);
            dismissed = false; published = null; watchError = null; closeDialog = true;
            _ = Poll(lifetime.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { error = FriendlyError(ex); }
        finally { requesting = false; }
    }
    private async Task Start(string mode)
    {
        if (mode == "download" ? DownloadUnavailable : requesting || Working) return;
        requesting = true; error = null;
        try
        {
            Status = await Api.RequestJsonAsync<TransferStatus>(HttpMethod.Post, PreparePath, new { mode }, lifetime!.Token);
            dismissed = false; published = null; watchError = null;
            _ = Poll(lifetime.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { error = FriendlyError(ex); }
        finally { requesting = false; }
    }
    private async Task ProgressAction()
    {
        if (requesting) return;
        if (watchError is not null) { await ReconnectProgress(); return; }
        if (!Working)
        {
            await JS.InvokeVoidAsync("familyhub.focus", Playlist.Tracks.Count > 0 ? "keep-playlist" : "add-playlist-song");
            dismissed = true;
            return;
        }
        if (Status?.State == "pausing") return;
        requesting = true;
        try { Status = await Api.RequestJsonAsync<TransferStatus>(HttpMethod.Delete, PreparePath, new { }, lifetime!.Token); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { error = FriendlyError(ex); }
        finally { requesting = false; }
    }
    private async Task Poll(CancellationToken token)
    {
        if (polling && pollingToken == token) return;
        polling = true; pollingToken = token;
        try
        {
            while (!token.IsCancellationRequested && Working)
            {
                await Task.Delay(1500, token);
                await ReadProgress(token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (!disposed && !token.IsCancellationRequested)
            {
                watchError = ProgressError(ex);
                await InvokeAsync(StateHasChanged);
            }
        }
        finally { if (pollingToken == token) polling = false; }
    }
    private async Task ReconnectProgress()
    {
        if (requesting || lifetime is null || !Session.Connected) return;
        var token = lifetime.Token;
        requesting = true;
        try
        {
            await ReadProgress(token);
            watchError = null;
            if (Working) _ = Poll(token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (!token.IsCancellationRequested) watchError = ProgressError(ex); }
        finally { if (!token.IsCancellationRequested) requesting = false; }
    }
    private async Task ReadProgress(CancellationToken token)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(token);
        timeout.CancelAfter(TimeSpan.FromSeconds(15));
        var status = await Api.RequestJsonAsync<TransferStatus>(HttpMethod.Get, PreparePath, cancellationToken: timeout.Token, background: true);
        token.ThrowIfCancellationRequested();
        Status = status;
        var snapshot = (status.Phase, status.State, status.Processed, status.Saved, status.Found, status.Review, status.Failed);
        if (status.State == "idle" || status.Phase == "reading" && Working || snapshot == published) return;
        await Session.RefreshCatalogueAsync(timeout.Token);
        token.ThrowIfCancellationRequested();
        published = snapshot;
        await Updated.InvokeAsync();
    }
    private static string ProgressError(Exception ex) => ex switch
    {
        FamilyHubApiException { StatusCode: 404 } => FriendlyError(ex),
        OperationCanceledException => "The server took too long to report download progress.",
        _ => "The app lost its connection to download progress. The server can keep working."
    };
    private static string FriendlyError(Exception ex) => ex is FamilyHubApiException { StatusCode: 404 }
        ? "Update the FamilyHub server to use playlist import and server downloads."
        : NoticeText.Error(ex, "The playlist operation could not finish. Try again.");
    public void Dispose() { disposed = true; lifetime?.Cancel(); lifetime?.Dispose(); }
    private sealed record TransferStatus
    {
        [JsonPropertyName("index")] public int Index { get; init; }
        [JsonPropertyName("active_downloads")] public List<TransferStatus> ActiveDownloads { get; init; } = [];
        [JsonPropertyName("state")] public string State { get; init; } = "idle";
        [JsonPropertyName("mode")] public string Mode { get; init; } = "match";
        [JsonPropertyName("download_after_matching")] public bool DownloadAfterMatching { get; init; }
        [JsonPropertyName("phase")] public string Phase { get; init; } = "matching";
        [JsonPropertyName("file_phase")] public string FilePhase { get; init; } = "";
        [JsonPropertyName("download_bytes")] public long DownloadBytes { get; init; }
        [JsonPropertyName("download_total_bytes")] public long? DownloadTotalBytes { get; init; }
        [JsonPropertyName("playlist_revision")] public int PlaylistRevision { get; init; }
        [JsonPropertyName("start_index")] public int StartIndex { get; init; }
        [JsonPropertyName("cursor")] public int Cursor { get; init; }
        [JsonPropertyName("completed_after")] public HashSet<int> CompletedAfter { get; init; } = [];
        [JsonPropertyName("total")] public int Total { get; init; }
        [JsonPropertyName("loaded")] public int Loaded { get; init; }
        [JsonPropertyName("processed")] public int Processed { get; init; }
        [JsonPropertyName("found")] public int Found { get; init; }
        [JsonPropertyName("saved")] public int Saved { get; init; }
        [JsonPropertyName("review")] public int Review { get; init; }
        [JsonPropertyName("failed")] public int Failed { get; init; }
        [JsonPropertyName("title")] public string Title { get; init; } = "";
        [JsonPropertyName("message")] public string Message { get; init; } = "";
        [JsonPropertyName("recent")] public List<TransferItem> Recent { get; init; } = [];
    }
    private sealed record TransferItem
    {
        [JsonPropertyName("index")] public int Index { get; init; }
        [JsonPropertyName("title")] public string Title { get; init; } = "";
        [JsonPropertyName("artist")] public string Artist { get; init; } = "";
        [JsonPropertyName("state")] public string State { get; init; } = "";
    }
}
