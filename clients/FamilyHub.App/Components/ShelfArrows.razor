@inject IJSRuntime JS
@* A sideways Home shelf with round previous and next buttons over its cover row. They show with a
   mouse on hover or keyboard focus, hide at either end, and are absent on touch screens. *@
<div class="shelf-frame">
    @ChildContent
    <button type="button" class="shelf-arrow is-back is-end" data-shelf="@Target" data-dir="-1" aria-controls="@Target" aria-label="@($"Scroll {Label} back")" @onclick="() => Scroll(-1)"><MusicIcon Name="back" /></button>
    <button type="button" class="shelf-arrow is-forward is-end" data-shelf="@Target" data-dir="1" aria-controls="@Target" aria-label="@($"Scroll {Label} forward")" @onclick="() => Scroll(1)"><MusicIcon Name="forward" /></button>
</div>
@code {
    [Parameter, EditorRequired] public string Target { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Task Scroll(int direction) => JS.InvokeVoidAsync("familyhub.scrollShelf", Target, direction).AsTask();
    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await PlaybackInterop.TryInvokeVoidAsync(JS, "familyhub.watchShelf", Target);
}
