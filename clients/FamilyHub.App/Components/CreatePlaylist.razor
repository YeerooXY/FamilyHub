@inject MusicSession Session
@inject IJSRuntime JS
@using Microsoft.Maui.ApplicationModel
@using Microsoft.Maui.ApplicationModel.DataTransfer

@* Create playlist: one screen for an empty playlist, a pasted link from a supported site (detected
   from the link itself), or songs and folders from this device through the upload dialog. *@
<dialog id="create-playlist-dialog" class="popup-panel popup-centered create-playlist-screen animated-dialog" aria-labelledby="create-playlist-heading" data-return-focus="create-playlist" @onclose="Reset">
    <div class="dialog-heading"><h2 id="create-playlist-heading" tabindex="-1">Create playlist</h2><button class="quiet" aria-label="Close create playlist" @onclick="Close"><MusicIcon Name="close" /></button></div>
    <form class="create-playlist-form inline-form" @onsubmit="Submit" @onsubmit:preventDefault>
        <label class="create-field">
            <span>Name</span>
            <input id="new-playlist" @bind="name" @bind:event="oninput" placeholder="@NamePlaceholder" maxlength="200" autocomplete="off" />
        </label>

        <section class="create-section" aria-labelledby="create-link-title">
            <h3 id="create-link-title">Import from a link</h3>
            <div class="create-link create-link-with-paste @(Source is { } linkSite ? "is-" + linkSite : "") @(link.Length > 0 && Source is null ? "is-unknown" : "")">
                <button class="create-link-paste" type="button" disabled="@(Files > 0 || busy)" @onclick="PasteLink">Paste</button>
                <label class="sr" for="new-playlist-url">Playlist link</label>
                <input id="new-playlist-url" type="url" @bind="link" @bind:event="oninput" @bind:after="LinkEdited" placeholder="Playlist URL" autocomplete="off" spellcheck="false" disabled="@(Files > 0 || busy)" />
                @if (link.Length > 0) { <button type="button" class="create-link-clear" aria-label="Clear link" @onclick="ClearLink"><MusicIcon Name="close" /></button> }
            </div>
            <output class="create-clipboard-preview" aria-label="Clipboard preview" for="new-playlist-url">@clipboardPreview</output>
            <Notice Level="@(Source is null ? "warning" : "info")" Message="@LinkStatus" />
            <MusicProviders Sites="Sites" Detected="@Source" />
        </section>

        @* A pasted link replaces the device choices; they fold away and come back when the link is cleared. *@
        <section class="create-section create-collapse @(Source is not null ? "is-collapsed" : "")" aria-labelledby="create-files-title" inert="@(Source is not null)"><div>
            <h3 id="create-files-title">Add songs from this device</h3>
            <UploadSongs @ref="uploader" Prefix="create-upload" SubmitId="create-playlist-submit" Illustrated="true" Disabled="DeviceLocked" Changed="StateHasChanged" />
        </div></section>

        <section class="create-section create-options" aria-label="Playlist options">
            <label class="create-toggle"><span><strong>Share with the family</strong><small>Everyone on this server can see and play it.</small></span><input type="checkbox" role="switch" @bind="shared" /></label>
            @if (Source is not null)
            {
                <label class="create-toggle"><span><strong>Download songs to the server</strong><small>You can pause downloads from the playlist.</small></span><input type="checkbox" role="switch" @bind="download" /></label>
            }
        </section>

        <Notice Level="error" Message="@error" />
        <div class="actions">
            <button type="button" @onclick="Close">Cancel</button>
            <button id="create-playlist-submit" class="primary" type="submit" aria-disabled="@Aria(busy || uploader?.Busy == true || (link.Length > 0 && Source is null))">@SubmitLabel</button>
        </div>
    </form>
</dialog>

@code {
    [Parameter] public EventCallback<MusicPlaylist> Created { get; set; }

    private static readonly string[] Sites = ["spotify", "youtube", "soundcloud", "deezer"];
    private UploadSongs? uploader;
    private string name = "", link = "", autoName = "";
    private bool findingName;
    private CancellationTokenSource? nameLookup;
    private bool shared = true, download = true, busy;
    private string? error, clipboardPreview;

    private static string Aria(bool value) => value ? "true" : "false";
    // Same rule as the server (music_web/link_playlists.detect); the server checks again.
    private string? Source
    {
        get
        {
            if (!Uri.TryCreate(link.Trim(), UriKind.Absolute, out var uri) || uri.Scheme != "https" || uri.UserInfo.Length > 0 || !uri.IsDefaultPort) return null;
            return uri.Host.ToLowerInvariant() switch
            {
                "open.spotify.com" => "spotify",
                "www.youtube.com" or "youtube.com" or "music.youtube.com" or "youtu.be" => "youtube",
                "soundcloud.com" or "www.soundcloud.com" or "m.soundcloud.com" => "soundcloud",
                "www.deezer.com" or "deezer.com" => "deezer",
                _ => null
            };
        }
    }

    private string LinkStatus => link.Length == 0 || Source is not null ? ""
        : "This site isn't supported. Use a Spotify, YouTube, SoundCloud or Deezer playlist link.";
    private string NamePlaceholder => Source is { } site ? findingName ? "Finding the name on " + MusicProviders.SiteName(site) + "..." : "Name from " + MusicProviders.SiteName(site)
        : uploader?.FolderName is { Length: > 0 } folder ? folder : "My playlist";

    // The clear button disappears with the link, so focus moves back to the link field.
    private async Task ClearLink() { link = ""; error = null; var changed = LinkEdited(); await JS.InvokeVoidAsync("familyhub.focus", "new-playlist-url"); await changed; }
    private void Reset() { nameLookup?.Cancel(); name = link = autoName = ""; findingName = false; shared = download = true; error = clipboardPreview = null; busy = false; uploader?.Clear(); }

    private Task LinkEdited()
    {
        error = clipboardPreview = null;
        return LinkChanged();
    }

    private async Task PasteLink()
    {
        if (Files > 0 || busy) return;
        var value = await JS.InvokeAsync<string?>("familyhub.clipboardText");
        if (value is null)
        {
            try { value = await MainThread.InvokeOnMainThreadAsync(Clipboard.Default.GetTextAsync); }
            catch (Exception exception) when (exception is InvalidOperationException or NotSupportedException or PermissionException) { }
        }
        if (Files > 0 || busy || !await JS.InvokeAsync<bool>("familyhub.focusInOpenDialog", "new-playlist-url")) return;
        value = value?.Trim();
        if (string.IsNullOrEmpty(value) || value.Length > 300 || value.Any(char.IsControl))
        {
            error = "Copy one playlist link, then paste it here.";
            return;
        }
        error = null;
        clipboardPreview = link = value;
        await LinkChanged();
    }

    // A pasted link fills the name field from the site; a name the owner typed is kept.
    private async Task LinkChanged()
    {
        nameLookup?.Cancel(); nameLookup = null; findingName = false;
        if (name == autoName) name = "";
        autoName = "";
        if (Source is null || Session.Api is null) return;
        var lookup = nameLookup = new CancellationTokenSource();
        var url = link.Trim();
        findingName = true;
        try
        {
            await Task.Delay(300, lookup.Token);
            var found = await Session.Api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Get, "/api/playlists/link-name?url=" + Uri.EscapeDataString(url), cancellationToken: lookup.Token);
            var resolved = found.TryGetProperty("name", out var value) ? value.GetString() ?? "" : "";
            if (lookup.IsCancellationRequested) return;
            if (resolved.Length > 0 && name.Length == 0) name = autoName = resolved;
        }
        catch (Exception exception) when (exception is not OutOfMemoryException) { }
        finally { if (nameLookup == lookup) { findingName = false; StateHasChanged(); } }
    }
    private int Files => uploader?.SelectedCount ?? 0;
    private bool DeviceLocked => busy || Source is not null || uploader?.Busy == true;
    private string SubmitLabel => busy ? "Working..." : Source is not null ? "Import playlist"
        : Files > 0 ? uploader!.Busy ? "Uploading..." : uploader.Finished ? "Done" : $"Upload {Files} {(Files == 1 ? "song" : "songs")}"
        : "Create empty playlist";
    private Task Close() => JS.InvokeVoidAsync("familyhub.closeDialog", "create-playlist-dialog", "create-playlist").AsTask();

    private async Task Submit()
    {
        if (busy || (link.Length > 0 && Source is null)) return;
        if (Source is null && uploader is { SelectedCount: > 0 } files)
        {
            if (files.Busy) return;
            // Songs from this device: upload into the new playlist here, then Done opens it.
            if (!files.Finished) { await files.UploadInto(name.Trim().Length > 0 ? name.Trim() : files.FolderName.Length > 0 ? files.FolderName : "New playlist", shared); return; }
            var key = files.CreatedPlaylistKey;
            await JS.InvokeVoidAsync("familyhub.closeDialog", "create-playlist-dialog", "content");
            if (Session.Playlists.FirstOrDefault(p => p.OwnerId + ":" + p.Id == key) is { } made) await Created.InvokeAsync(made);
            return;
        }
        busy = true; error = null;
        try
        {
            var source = Source;
            var typed = name.Trim();
            await Session.CreatePlaylistAsync(typed.Length > 0 ? typed : "New playlist");
            var playlist = Session.Playlists.Last();
            if (!shared) { await Session.EditPlaylistAsync(playlist, new { shared = false }); playlist = Session.Playlists.FirstOrDefault(p => p.Id == playlist.Id && p.OwnerId == playlist.OwnerId) ?? playlist; }
            if (source is not null)
                await Session.Api!.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, "/api/playlists/" + playlist.Id + "/import",
                    new { provider = source, url = link.Trim(), revision = playlist.Revision, download, name = typed.Length > 0 ? typed : null });
            await JS.InvokeVoidAsync("familyhub.closeDialog", "create-playlist-dialog", "content");
            await Created.InvokeAsync(playlist);
            await JS.InvokeVoidAsync("FamilyHubNotices.toast", source is null ? "Playlist created." : "Playlist import started.");
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = NoticeText.Error(exception); }
        finally { busy = false; }
    }
}
