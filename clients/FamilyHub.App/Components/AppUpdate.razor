@inject MusicSession Session

@if (AppUpdater.Platform is not null && available is not null)
{
    <div class="app-update @(Compact ? "compact-update" : "")">
        <button id="@Id" type="button" aria-label="@Label" title="@(string.IsNullOrEmpty(message) ? Label : message)" @onclick="Update" aria-disabled="@(working ? "true" : "false")"><MusicIcon Name="download" />@if (!Compact) { @Label }</button>
        <p class="quality-help" role="status">@message</p>
    </div>
}

@code {
    [Parameter] public bool Compact { get; set; }
    private bool working;
    [Parameter] public string Id { get; set; } = "app-update";
    [Parameter] public EventCallback<AppRelease> Available { get; set; }
    [Parameter] public AppRelease? InitialRelease { get; set; }
    private AppRelease? lastInitialRelease;
    protected override void OnParametersSet()
    {
        if (InitialRelease != lastInitialRelease)
        { lastInitialRelease = InitialRelease; available = InitialRelease; message = InitialRelease is null ? "" : DescribeRelease(InitialRelease); }
    }
    private AppRelease? available;
    private string message = "";
    private static string DescribeRelease(AppRelease release) => $"Version {release.Version} available · {release.Size / (1024d * 1024):0} MB. " +
        (AppUpdater.Platform == "windows-x64" ? "Playback stops when the app restarts. Saved music and profiles are kept." : "Open the downloaded APK to install it. Saved music and profiles are kept.");
    private string Label => working ? "Downloading..." : AppUpdater.Platform == "windows-x64" ? "Download and restart" : "Download update";

    private async Task Update()
    {
        if (working || available is null) return;
        working = true;
        try
        {
            var api = Session.Api ?? throw new InvalidOperationException("Connect to your FamilyHub server to check for updates.");
            message = "Downloading update...";
            await AppUpdater.InstallAsync(api, available, percent =>
            {
                message = $"Downloading update... {percent}%";
                _ = InvokeAsync(StateHasChanged);
            });
            if (AppUpdater.Platform != "windows-x64") message = "Open the downloaded APK to install the update.";
        }
        catch (FamilyHubApiException error) when (error.StatusCode == 404)
        { message = "This update is unavailable. Try again later."; }
        catch (OperationCanceledException) { message = "The update request timed out. Try again."; }
        catch (HttpRequestException) { message = "Could not download the update. Check your connection and try again."; }
        catch (Exception error) { message = error.Message; }
        finally { working = false; }
    }
}
