@inject MusicSession Session
@inject PublicAppReleases PublicReleases

@if (AppUpdater.Platform is not null && available is not null)
{
    <div class="app-update @(Compact ? "compact-update" : "")">
        <button id="@Id" type="button" aria-label="@Label" title="@Label" @onclick="Update" aria-disabled="@(working ? "true" : "false")"><MusicIcon Name="download" />@if (!Compact) { @Label }</button>
        @if (!Compact) { <Notice Level="@(failed ? "error" : "info")" Message="@message" /> }
    </div>
}

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool VersionInHeading { get; set; }
    private bool working, failed;
    [Parameter] public string Id { get; set; } = "app-update";
    [Parameter] public EventCallback<AppRelease> Available { get; set; }
    [Parameter] public AppRelease? InitialRelease { get; set; }
    private AppRelease? lastInitialRelease;
    protected override void OnParametersSet()
    {
        if (InitialRelease != lastInitialRelease)
        { lastInitialRelease = InitialRelease; available = InitialRelease; message = InitialRelease is null ? "" : DescribeRelease(InitialRelease); }
    }
    private AppRelease? available;
    private string message = "";
    private string DescribeRelease(AppRelease release) => (VersionInHeading ? "" : $"Version {release.Version} is available. ")
        + (AppUpdater.UpdatesInSideStore
            ? "In SideStore, tap Update next to FamilyHub Music."
            : $"Download size is {release.Size / (1024d * 1024):0} MB. "
                + (AppUpdater.Platform == "windows-x64" ? "Playback stops when the app restarts." : "Open the downloaded APK to install it."));
    private string Label => Compact && Available.HasDelegate ? "Update available"
        : AppUpdater.UpdatesInSideStore ? "Open SideStore" : working ? "Downloading..." : AppUpdater.Platform == "windows-x64" ? "Download and restart" : "Download update";

    private async Task Update()
    {
        if (working || available is null) return;
        if (Compact && Available.HasDelegate)
        {
            await Available.InvokeAsync(available);
            return;
        }
        working = true; failed = false;
        try
        {
            if (!AppUpdater.UpdatesInSideStore) message = "Downloading update...";
            await AppUpdater.InstallAsync(Session.Api, PublicReleases, available, percent =>
            {
                message = $"Downloading update... {percent}%";
                _ = InvokeAsync(StateHasChanged);
            });
            if (AppUpdater.Platform == "android") message = "Open the downloaded APK to install the update.";
        }
        catch (FamilyHubApiException error) when (error.StatusCode == 404)
        { failed = true; message = "This update is unavailable. Try again later."; }
        catch (OperationCanceledException) { failed = true; message = "The update request timed out. Try again."; }
        catch (HttpRequestException) { failed = true; message = "Could not download the update. Check your connection and try again."; }
        catch (Exception error) { failed = true; message = NoticeText.Error(error, "The update could not finish. Try again."); }
        finally
        {
            working = false;
            if (Compact && (failed || AppUpdater.Platform == "android")) Session.SetMessage(message, failed ? "error" : "info");
        }
    }
}
