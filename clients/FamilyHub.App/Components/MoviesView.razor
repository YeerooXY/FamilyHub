@implements IAsyncDisposable
@inject MusicSession Session
@inject MusicPlayer Player
@inject IJSRuntime JS
@using Microsoft.Maui.Networking

<div class="service-status-stage">
    <div @ref="host" id="movie-service-content" class="movie-library" data-native-fullscreen="@(OperatingSystem.IsWindows() ? "true" : null)"></div>
    <ServiceStatus Active="failed" FullSection="true" Detail="Check the Jellyfin connection for this profile."
                   RetryLabel="Retry movies" Retry="Load" Busy="loading" AutoRetry="true" RecoveryTarget="#movie-service-content" />
</div>

@code {
    [Parameter] public string? InitialRoute { get; set; }
    [Parameter] public bool KeepInitialFocus { get; set; }
    [Parameter] public EventCallback<(string? Route, string Action)> NavigationChanged { get; set; }

    private ElementReference host;
    private IJSObjectReference? module, shelf;
    private DotNetObjectReference<MoviesView>? callback;
    private FamilyHub.Client.Core.FamilyHubApi? movieApi;
    private string? mediaTicket;
    private readonly CancellationTokenSource closed = new();
    private bool failed, loading;
#if WINDOWS
    private bool disposing;
#endif

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Load();
    }

    private async Task Load()
    {
        if (loading || closed.IsCancellationRequested) return;
        loading = true;
        var started = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var api = Session.Api ?? throw new InvalidOperationException();
            movieApi = api;
            var viewer = new { server = Session.Server, profile = Session.User };
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./movies.js");
            await module.InvokeVoidAsync("showMovieLoading", host);
            callback ??= DotNetObjectReference.Create(this);
            var preferences = await module.InvokeAsync<System.Text.Json.JsonElement>("readMoviePreferences", viewer);
            if (closed.IsCancellationRequested) return;
            if (preferences.TryGetProperty("layoutPreview", out var preview) && preview.ValueKind == System.Text.Json.JsonValueKind.True)
            {
                shelf = await module.InvokeAsync<IJSObjectReference>("openMovies", host, null, callback, viewer);
                if (closed.IsCancellationRequested) { await shelf.InvokeVoidAsync("close"); return; }
                failed = false;
                return;
            }
            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(closed.Token);
            timeout.CancelAfter(TimeSpan.FromSeconds(10));
            var connection = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, "/api/movies/session",
                new { device = Guid.NewGuid().ToString("N") }, cancellationToken: timeout.Token);
            mediaTicket = connection.GetProperty("media_ticket").GetString();
            if (closed.IsCancellationRequested) return;
            var remaining = Math.Max(1, 10000 - (int)started.ElapsedMilliseconds);
            shelf = await module.InvokeAsync<IJSObjectReference>("openMovies", host, connection, callback, viewer, remaining);
            if (closed.IsCancellationRequested) { await shelf.InvokeVoidAsync("close"); return; }
            Connectivity.Current.ConnectivityChanged += MovieConnectionChanged;
            failed = false;
            if (InitialRoute is not null) await RestoreNavigation(InitialRoute, KeepInitialFocus);
        }
        catch (Exception) when (!closed.IsCancellationRequested)
        {
            failed = true;
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("showMovieLoading", host, false); }
                catch (JSDisconnectedException) { }
                catch (JSException) { }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            loading = false;
            if (!closed.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    public async Task RestoreNavigation(string? route, bool keepFocus)
    {
        if (shelf is null || closed.IsCancellationRequested) return;
        try { await shelf.InvokeVoidAsync("restoreNavigation", route, keepFocus); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task MovieNavigationChanged(string? route, string action) =>
        closed.IsCancellationRequested ? Task.CompletedTask : NavigationChanged.InvokeAsync((route, action));

    // The server validates the bounded playback diagnostics before logging them.
    [JSInvokable]
    public async Task MovieEvent(string kind, string method, string title, int? minutes, System.Text.Json.JsonElement? diagnostics)
    {
        try
        {
            if (movieApi is { } api && ReferenceEquals(api, Session.Api) && !closed.IsCancellationRequested)
                await api.RequestJsonAsync<System.Text.Json.JsonElement?>(HttpMethod.Post, "/api/movies/report",
                    new { kind, method, title, minutes, diagnostics }, cancellationToken: closed.Token);
        }
        catch (Exception) { }
    }

    // A title missing from the library: ask the server where it can be watched. Answers as JSON text; the search text is not logged.
    [JSInvokable]
    public async Task<string> MovieFind(string query)
    {
        string Error(string message) => System.Text.Json.JsonSerializer.Serialize(new { error = message });
        try
        {
            if (Session.Api is not { } api) return Error("Sign in again to search the web.");
            var reply = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, "/api/movies/find", new { query }, cancellationToken: closed.Token);
            return reply.GetRawText();
        }
        catch (FamilyHubApiException error) when (error.StatusCode == 429) { return Error("Wait a minute before searching the web again."); }
        catch (FamilyHubApiException error) when (error.StatusCode == 503) { return Error("Searching the web is not set up on this server."); }
        catch (Exception) when (!closed.IsCancellationRequested) { return Error("The web search did not finish. Try again."); }
        catch (Exception) { return Error(""); }
    }

    [JSInvokable]
    public Task<string> MovieRequestSearch(string query) => SendMovieRequest("/api/movies/request-search", new { query });

    [JSInvokable]
    public Task<string> MovieMatches(string query) => SendMovieRequest("/api/movies/matches", new { query });
    [JSInvokable]
    public Task<string> MovieSeasonEpisodes(int series, int season) => SendMovieRequest("/api/movies/season-episodes", new { series, season });

    [JSInvokable]
    public Task<string> MovieReleaseSearch(string query) => SendMovieRequest("/api/movies/releases", new { query });

    [JSInvokable]
    public Task<string> MovieDownload(string guid, int indexerId, string title) =>
        SendMovieRequest("/api/movies/download", new { guid, indexer_id = indexerId, title });

    [JSInvokable]
    public Task<string> MovieYouTubeMetadata(string[] ids) =>
        SendMovieRequest("/api/movies/youtube-metadata", new { ids });

    [JSInvokable]
    public Task<string> MovieYouTubeDownload(string url, string title) =>
        SendMovieRequest("/api/movies/youtube-download", new { url, title });

    [JSInvokable]
    public Task<string> MovieVideaSearch(string query) => SendMovieRequest("/api/movies/videa-search", new { query });

    [JSInvokable]
    public Task<string> MovieVideaDownload(string url, string title) =>
        SendMovieRequest("/api/movies/videa-download", new { url, title });

    [JSInvokable]
    public Task<string> MovieVideaSeasonDownload(string title, System.Text.Json.JsonElement[] episodes) =>
        SendMovieRequest("/api/movies/videa-download", new { title, episodes });

    [JSInvokable]
    public Task<string> MovieDownloads() => SendMovieRequest("/api/movies/downloads");

    [JSInvokable]
    public Task<string> MovieAudioSources(string item, int offset) =>
        SendMovieRequest("/api/movies/audio-sources?item=" + Uri.EscapeDataString(item) + "&offset=" + offset);

    [JSInvokable]
    public Task<string> MovieAddAudio(string item, string source, int streamIndex, string language, string title) =>
        SendMovieRequest("/api/movies/audio-track", new { item, source, stream_index = streamIndex, language, title, ticket = mediaTicket });

    [JSInvokable]
    public Task<string> MovieDeleteAudioSource(string job, string result) =>
        SendMovieRequest("/api/movies/audio-track/" + Uri.EscapeDataString(job) + "/delete-source", new { result });

    [JSInvokable]
    public async Task<string> MovieLibrary(string path, string query, System.Text.Json.JsonElement? payload)
    {
        if (closed.IsCancellationRequested || movieApi is not { } api || !ReferenceEquals(api, Session.Api)) return "{}";
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(closed.Token);
        timeout.CancelAfter(TimeSpan.FromSeconds(12));
        try
        {
            var result = await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, "/api/movies/library",
                new { ticket = mediaTicket, path, query, payload }, timeout.Token);
            return result.GetRawText();
        }
        catch (Exception error) when (error is FamilyHubApiException or HttpRequestException or OperationCanceledException or InvalidDataException or ObjectDisposedException)
        { return "{}"; }
    }

    [JSInvokable]
    public Task<string> MovieRequest(string kind, int id, int? season) => SendMovieRequest("/api/movies/request", new { kind, id, season });

    private async Task<string> SendMovieRequest(string path, object? payload = null)
    {
        string Error(string text) => System.Text.Json.JsonSerializer.Serialize(new { error = text });
        try
        {
            if (Session.Api is not { } api) return Error("Sign in again and try again.");
            var reply = await api.RequestJsonAsync<System.Text.Json.JsonElement>(
                payload is null ? HttpMethod.Get : HttpMethod.Post, path, payload, cancellationToken: closed.Token);
            return reply.GetRawText();
        }
        catch (FamilyHubApiException error) { return Error(error.Message); }
        catch (OperationCanceledException) when (closed.IsCancellationRequested) { return Error(""); }
        catch (Exception) { return Error("The server did not respond. Try again."); }
    }

    // Web results open in the browser app; only a YouTube watch link is accepted.
    [JSInvokable]
    public async Task MovieOpenLink(string url)
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out var link) && link.Scheme == "https" && link.Host == "www.youtube.com"
            && link.IsDefaultPort && link.UserInfo.Length == 0 && link.Fragment.Length == 0
            && link.AbsolutePath == "/watch" && System.Text.RegularExpressions.Regex.IsMatch(link.Query, @"^\?v=[A-Za-z0-9_-]{11}$"))
            await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(link);
    }

    // Mobile uses landscape and system bars. On Windows, leaving playback restores the window.
    [JSInvokable]
    public Task MovieScreen(bool playing)
    {
        PlayerScreen.Set(playing);
        return playing ? Task.CompletedTask : MovieWindowFullscreen(false);
    }

    [JSInvokable]
#if WINDOWS
    public async Task<bool> MovieWindowFullscreen(bool on)
    {
        var fullscreen = await Microsoft.Maui.ApplicationModel.MainThread.InvokeOnMainThreadAsync(() =>
            WindowsWindowChrome.SetMovieFullscreen(on && !disposing && PlayerScreen.Playing));
        if (!on) await JS.InvokeVoidAsync("familyhub.refreshChrome");
        return fullscreen;
    }
#else
    public Task<bool> MovieWindowFullscreen(bool on) => Task.FromResult(false);
#endif

    [JSInvokable]
    public string MovieConnectionKind() => ConnectionKind.Current;

    private void MovieConnectionChanged(object? sender, ConnectivityChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        if (closed.IsCancellationRequested || shelf is null) return;
        try { await shelf.InvokeVoidAsync("connectionChanged"); }
        catch (JSDisconnectedException) { }
    });

    [JSInvokable]
    public async Task MovieStarted()
    {
        if (!closed.IsCancellationRequested && Player.Playing && !Player.RemoteActive)
            await Player.PauseLocallyAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Connectivity.Current.ConnectivityChanged -= MovieConnectionChanged;
#if WINDOWS
        disposing = true;
#endif
        try
        {
            await MovieScreen(false);
            if (shelf is not null) { await shelf.InvokeVoidAsync("close"); await shelf.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally
        {
            closed.Cancel();
            callback?.Dispose();
            if (mediaTicket is { } ticket && movieApi is { } api && ReferenceEquals(api, Session.Api))
            {
                try
                {
                    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(4));
                    await api.RequestJsonAsync<System.Text.Json.JsonElement>(HttpMethod.Post, "/api/movies/media/close", new { ticket }, timeout.Token);
                }
                catch (Exception error) when (error is FamilyHubApiException or HttpRequestException or OperationCanceledException or InvalidDataException or ObjectDisposedException) { }
            }
        }
    }
}
