@implements IDisposable
@inject MusicPlayer Player
@inject MusicSession Session
@inject IJSRuntime JS

@* Lyrics for the playing song: a preview card under the controls and a full view that
   follows the song. Songs without lyrics show nothing. *@
@if (lyrics is { State: "synced" or "plain" } current && Player.Current is { } track)
{
    if (Expanded)
    {
        <section id="lyrics-view" class="lyrics-view" role="dialog" aria-modal="true" aria-labelledby="lyrics-title" @onkeydown="KeyDown" @onkeydown:stopPropagation="true">
            <header class="lyrics-header">
                <button id="lyrics-close" class="quiet" aria-label="Close lyrics" title="Close lyrics" @onclick="Close"><MusicIcon Name="chevron-down" /></button>
                <TrackCover @key="track.Id" Track="track" />
                <div><strong id="lyrics-title">@track.Title</strong><span>@track.Channel</span></div>
                @if (current.State == "synced")
                {
                    <div class="lyrics-timing" role="group" aria-label="Lyrics timing">
                        <button id="lyrics-earlier" class="quiet" @onclick="() => Nudge(.5)" aria-label="Show lyrics earlier">Earlier</button>
                        <span aria-live="polite">@ShiftLabel</span>
                        <button id="lyrics-later" class="quiet" @onclick="() => Nudge(-.5)" aria-label="Show lyrics later">Later</button>
                    </div>
                }
            </header>
            @if (current.State == "synced")
            {
                <ol class="lyrics-lines">
                    @for (var i = 0; i < current.Lines.Count; i++)
                    {
                        var line = current.Lines[i]; var index = i;
                        <li @key="index"><button id="lyric-@index" class="lyric-line @(index == active ? "is-active" : index < active ? "is-past" : "")" aria-current="@(index == active ? "true" : null)"
                                aria-disabled="@(SeekAllowed ? "false" : "true")" @onclick="() => Seek(line.Time - shift)">@(string.IsNullOrWhiteSpace(line.Text) ? "♪" : line.Text)</button></li>
                    }
                </ol>
            }
            else { <p class="lyrics-plain">@current.Text</p> }
        </section>
    }
    else
    {
        <button id="lyrics-preview" class="lyrics-preview" @onclick="Open" aria-label="Open lyrics">
            <strong>Lyrics</strong>
            @foreach (var text in PreviewLines(current)) { <span>@text</span> }
        </button>
    }
}

@code {
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<bool> AvailabilityChanged { get; set; }
    private bool reported;
    private void Report() { if (Available != reported) { reported = Available; _ = AvailabilityChanged.InvokeAsync(reported); } }

    // Lyrics for recently played songs; small enough to keep for the session.
    private static readonly Dictionary<string, SongLyrics> cache = [];
    private SongLyrics? lyrics;
    private string? loadedFor, requestedFor;
    private DateTime retryAt;
    private int active = -1, revealed = -1;
    private CancellationTokenSource? loading;

    public bool Available => lyrics is { State: "synced" or "plain" };
    private bool SeekAllowed => Player.CanSeek && !Player.FollowingHost;

    protected override void OnInitialized() { Player.Changed += Changed; Session.Changed += Changed; Load(); }

    private void Changed() => _ = InvokeAsync(() =>
    {
        // A phone can be offline when the song starts (screen off, refresh timeout); ask again once it reconnects.
        if (Player.Current?.Id != loadedFor || (loadedFor is not null && lyrics is null && requestedFor is null && Session.Connected && DateTime.UtcNow >= retryAt))
        { Load(); StateHasChanged(); return; }
        // Redraw only when the highlighted line moves, not on every progress update.
        var next = ActiveLine();
        if (next != active) { active = next; StateHasChanged(); }
    });

    private int ActiveLine()
    {
        if (lyrics is not { State: "synced" } synced) return -1;
        var position = Estimate() + .25 + shift;
        var index = -1;
        for (var i = 0; i < synced.Lines.Count && synced.Lines[i].Time <= position; i++) index = i;
        return index;
    }

    // The player reports its position in steps; between reports, count the time played.
    private double lastPosition = -1;
    private readonly System.Diagnostics.Stopwatch sincePosition = new();
    private double Estimate()
    {
        var position = Player.Position;
        if (position != lastPosition || !Player.Playing) { lastPosition = position; sincePosition.Restart(); return position; }
        return position + Math.Min(1.5, sincePosition.Elapsed.TotalSeconds);
    }

    // Per-song timing nudge, kept on this device: LRCLIB times follow the studio release,
    // and an upload can start slightly differently. Positive shows lines earlier.
    private double shift;
    private string ShiftLabel => shift == 0 ? "Original timing" : Math.Abs(shift).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + (shift > 0 ? " s earlier" : " s later");
    private static string ShiftKey(string id) => "lyrics-shift:" + id;
    private void Nudge(double seconds)
    {
        if (loadedFor is not { } id) return;
        shift = Math.Clamp(shift + seconds, -10, 10);
        Preferences.Default.Set(ShiftKey(id), shift);
        active = ActiveLine(); revealed = -1;
    }

    private void Load()
    {
        loading?.Cancel();
        loadedFor = Player.Current?.Id; requestedFor = null; lyrics = null; active = revealed = -1;
        shift = loadedFor is { } song ? Preferences.Default.Get(ShiftKey(song), 0d) : 0;
        if (loadedFor is not { } id || Session.Api is not { } api || !Session.Connected) { _ = Collapse(); return; }
        lock (cache) if (cache.TryGetValue(id, out var known)) { lyrics = known; active = ActiveLine(); return; }
        var cancel = loading = new CancellationTokenSource();
        requestedFor = id;
        _ = Task.Run(async () =>
        {
            try
            {
                var result = await api.GetLyricsAsync(id, cancel.Token, background: true);
                lock (cache) { if (cache.Count >= 60) cache.Clear(); cache[id] = result; }
                await InvokeAsync(() => { if (loadedFor != id) return; lyrics = result; active = ActiveLine(); StateHasChanged(); });
            }
            // No lyrics card while the server cannot answer; try again in half a minute.
            catch (Exception) when (!cancel.IsCancellationRequested) { await InvokeAsync(() => { if (loadedFor == id) { requestedFor = null; retryAt = DateTime.UtcNow.AddSeconds(30); } }); }
            catch (Exception) { }
        });
        _ = Collapse();
    }

    private async Task Collapse() { if (Expanded && lyrics is null) await ExpandedChanged.InvokeAsync(false); }

    private IEnumerable<string> PreviewLines(SongLyrics current)
    {
        if (current.State == "plain") return current.Text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3);
        var start = Math.Max(0, active);
        return current.Lines.Skip(start).Where(l => !string.IsNullOrWhiteSpace(l.Text)).Take(3).Select(l => l.Text);
    }

    private async Task Open() { await ExpandedChanged.InvokeAsync(true); revealed = -1; }
    private async Task Close() { await ExpandedChanged.InvokeAsync(false); await JS.InvokeVoidAsync("familyhub.focusVisible", "lyrics-preview", "sheet-lyrics", "player-more"); }
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    private async Task Seek(double time)
    {
        if (!SeekAllowed) return;
        try { await Player.SeekAsync(Math.Max(0, time)); } catch (Exception) { /* Seeking unavailable for this song. */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Report();
        if (!Expanded || lyrics is null) { revealed = -1; return; }
        if (revealed == -1) await JS.InvokeVoidAsync("familyhub.focus", "lyrics-close");
        if (active >= 0 && active != revealed) { revealed = active; await JS.InvokeVoidAsync("familyhub.revealLyric", "lyric-" + active); }
        else if (revealed == -1) revealed = -2;
    }

    public void Dispose() { Player.Changed -= Changed; Session.Changed -= Changed; loading?.Cancel(); }
}
